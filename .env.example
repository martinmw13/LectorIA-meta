# Copy to .env.local and fill in. Never commit real values.
# Meta API key, brought by the user (BYOK)
META_API_KEY=
# Model: muse-spark-1.3-contributor in dev, muse-spark-1.3 in public
META_MODEL=
# Jev API key for emotion classification
JEV_API_KEY=
# Pinned Jev model, e.g. jev-1.14.0
JEV_MODEL=
# Baseten API key for the offline pipeline
BASETEN_API_KEY=
# Modal token id for Muse Glimmer jobs
MODAL_TOKEN_ID=
# Modal token secret for Muse Glimmer jobs
MODAL_TOKEN_SECRET=
# Deployed Glimmer endpoint URL on Modal
GLIMMER_URL=
# Upstash Redis REST URL for quotas
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token for quotas
UPSTASH_REDIS_REST_TOKEN=
# HMAC key for the anonymous cookie
SESSION_SECRET=
# Salt for hashed IPs
IP_HASH_SALT=
# Turnstile secret for the per-session check
TURNSTILE_SECRET_KEY=
# Blob store token for generated images
BLOB_READ_WRITE_TOKEN=
