{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c41f","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":106,"recorded_at":1780531400000207,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c733be73758010b113a96e6b45","command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"text":"Read text file `server/images/env.test.ts`.\n1|import { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n2|import { readImageEnv } from \"./env\";\n3|\n4|const BASE = {\n5|  BLOB_READ_WRITE_TOKEN: \"test-blob\",\n6|  META_API_KEY: \"test-meta\",\n7|  SESSION_SECRET: \"test-session\",\n8|  IP_HASH_SALT: \"test-salt\",\n9|} as const;\n10|\n11|const REDIS_KEYS = [\n12|  \"UPSTASH_REDIS_REST_URL\",\n13|  \"UPSTASH_REDIS_REST_TOKEN\",\n14|  \"KV_REST_API_URL\",\n15|  \"KV_REST_API_TOKEN\",\n16|  \"KV_REST_API_READ_ONLY_TOKEN\",\n17|] as const;\n18|\n19|let saved: Record<string, string | undefined>;\n20|\n21|beforeEach(() => {\n22|  saved = {};\n23|  for (const k of [...Object.keys(BASE), ...REDIS_KEYS]) saved[k] = process.env[k];\n24|  Object.assign(process.env, BASE);\n25|  for (const k of REDIS_KEYS) delete process.env[k];\n26|});\n27|\n28|afterEach(() => {\n29|  for (const k of Object.keys(saved)) {\n30|    if (saved[k] === undefined) delete process.env[k];\n31|    else process.env[k] = saved[k];\n32|  }\n33|});\n34|\n35|describe(\"readImageEnv redis fallback\", () => {\n36|  it(\"prefers UPSTASH_* when both are set\", () => {\n37|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n38|    process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n39|    process.env.KV_REST_API_URL = \"https://kv-url\";\n40|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n41|    const env = readImageEnv();\n42|    expect(env.upstashUrl).toBe(\"https://upstash-url\");\n43|    expect(env.upstashToken).toBe(\"upstash-token\");\n44|  });\n45|\n46|  it(\"uses KV_REST_API_* when UPSTASH_* is absent\", () => {\n47|    process.env.KV_REST_API_URL = \"https://kv-url\";\n48|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n49|    const env = readImageEnv();\n50|    expect(env.upstashUrl).toBe(\"https://kv-url\");\n51|    expect(env.upstashToken).toBe(\"kv-token\");\n52|  });\n53|\n54|  it(\"uses KV_REST_API_* when UPSTASH_* is empty\", () => {\n55|    process.env.UPSTASH_REDIS_REST_URL = \"\";\n56|    process.env.UPSTASH_REDIS_REST_TOKEN = \"\";\n57|    process.env.KV_REST_API_URL = \"https://kv-url\";\n58|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n59|    const env = readImageEnv();\n60|    expect(env.upstashUrl).toBe(\"https://kv-url\");\n61|    expect(env.upstashToken).toBe(\"kv-token\");\n62|  });\n63|\n64|  it(\"falls back each value independently\", () => {\n65|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n66|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n67|    const env = readImageEnv();\n68|    expect(env.upstashUrl).toBe(\"https://upstash-url\");\n69|    expect(env.upstashToken).toBe(\"kv-token\");\n70|  });\n71|\n72|  it(\"does not accept the read-only token alone\", () => {\n73|    process.env.KV_REST_API_URL = \"https://kv-url\";\n74|    process.env.KV_REST_API_READ_ONLY_TOKEN = \"read-only-token\";\n75|    expect(() => readImageEnv()).toThrow(\n76|      \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\",\n77|    );\n78|  });\n79|\n80|  it(\"defaults the daily spend cap to 1.5 USD\", () => {\n81|    delete process.env.DAILY_SPEND_CAP_USD;\n82|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n83|    process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n84|    expect(readImageEnv().dailySpendCapMicro).toBe(1_500_000);\n85|  });\n86|\n87|  it(\"honors a finite non-negative DAILY_SPEND_CAP_USD\", () => {\n88|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n89|    process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n90|    process.env.DAILY_SPEND_CAP_USD = \"2\";\n91|    expect(readImageEnv().dailySpendCapMicro).toBe(2_000_000);\n92|  });\n93|\n94|  it.each([\"abc\", \"-3\", \"Infinity\"])(\n95|    \"falls back to 1.5 USD for %s\",\n96|    (value) => {\n97|      process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n98|      process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n99|      process.env.DAILY_SPEND_CAP_USD = value;\n100|      expect(readImageEnv().dailySpendCapMicro).toBe(1_500_000);\n101|    },\n102|  );\n103|\n104|  it(\"missing-env error lists names only, never values\", () => {\n105|    process.env.UPSTASH_REDIS_REST_URL = \"https://secret-url-value\";\n106|    let message = \"\";\n107|    try {\n108|      readImageEnv();\n109|    } catch (e) {\n110|      message = (e as Error).message;\n111|    }\n112|    expect(message).toContain(\"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\");\n113|    expect(message).not.toContain(\"secret-url-value\");\n114|  });\n115|});"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c421","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":107,"recorded_at":1780531400000209,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c734e5777eb9d58e66414664f6","command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"text":"Read text file `core/images.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import {\n3|  DAILY_SPEND_TTL_SEC,\n4|  budgetExceeded,\n5|  buildCaption,\n6|  buildPrompt,\n7|  canRelease,\n8|  createMemoryKV,\n9|  dailySpendKey,\n10|  imageCostMicro,\n11|  imageKey,\n12|  indexKeyFor,\n13|  lockKeyFor,\n14|  overQuota,\n15|  parseImageRequest,\n16|  quotaKeys,\n17|  spendKey,\n18|  validateAgainstBook,\n19|} from \"./images\";\n20|import { IMAGE_COST_MICRO } from \"./types\";\n21|\n22|const book = {\n23|  id: \"oz\",\n24|  textVersion: \"t123\",\n25|  paragraphNs: new Set([1, 2, 3]),\n26|  sceneIds: new Set([\"c1s1\"]),\n27|};\n28|\n29|describe(\"parseImageRequest\", () => {\n30|  it(\"accepts a good passage body\", () => {\n31|    expect(\n32|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 }),\n33|    ).toEqual({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 });\n34|  });\n35|\n36|  it(\"accepts a good scene body\", () => {\n37|    expect(\n38|      parseImageRequest({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }),\n39|    ).toEqual({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" });\n40|  });\n41|\n42|  it(\"rejects a bad kind\", () => {\n43|    expect(() => parseImageRequest({ kind: \"chapter\", bookId: \"oz\" })).toThrow();\n44|  });\n45|\n46|  it(\"rejects extra fields\", () => {\n47|    expect(() =>\n48|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1, extra: 1 }),\n49|    ).toThrow();\n50|  });\n51|\n52|  it(\"rejects a non-integer n\", () => {\n53|    expect(() =>\n54|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1.5 }),\n55|    ).toThrow();\n56|  });\n57|\n58|  it(\"rejects non-objects\", () => {\n59|    for (const bad of [null, [], \"x\", 42]) {\n60|      expect(() => parseImageRequest(bad)).toThrow();\n61|    }\n62|  });\n63|});\n64|\n65|describe(\"validateAgainstBook\", () => {\n66|  it(\"accepts matching passage and scene\", () => {\n67|    expect(() =>\n68|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1 }, book),\n69|    ).not.toThrow();\n70|    expect(() =>\n71|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }, book),\n72|    ).not.toThrow();\n73|  });\n74|\n75|  it(\"rejects unknown book, wrong version, out of range n, unknown scene\", () => {\n76|    expect(() =>\n77|      validateAgainstBook({ kind: \"passage\", bookId: \"dorothy\", textVersion: \"t123\", n: 1 }, book),\n78|    ).toThrow();\n79|    expect(() =>\n80|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"old\", n: 1 }, book),\n81|    ).toThrow();\n82|    expect(() =>\n83|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 99 }, book),\n84|    ).toThrow();\n85|    expect(() =>\n86|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"nope\" }, book),\n87|    ).toThrow();\n88|  });\n89|});\n90|\n91|describe(\"imageKey\", () => {\n92|  it(\"uses only the start paragraph for passages\", () => {\n93|    expect(imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 7 })).toBe(\n94|      \"images/oz/t123/v1/p7.webp\",\n95|    );\n96|  });\n97|\n98|  it(\"uses the scene id for scenes\", () => {\n99|    expect(imageKey({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" })).toBe(\n100|      \"images/oz/t123/v1/scene-c1s1.webp\",\n101|    );\n102|  });\n103|\n104|  it(\"differs by book, version, and paragraph\", () => {\n105|    const a = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 1 });\n106|    const b = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t2\", n: 1 });\n107|    const c = imageKey({ kind: \"passage\", bookId: \"other\", textVersion: \"t1\", n: 1 });\n108|    const d = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 2 });\n109|    expect(new Set([a, b, c, d]).size).toBe(4);\n110|    expect(indexKeyFor(a)).toContain(a);\n111|    expect(lockKeyFor(a)).toContain(a);\n112|    expect(indexKeyFor(a)).not.toBe(lockKeyFor(a));\n113|  });\n114|});\n115|\n116|describe(\"buildPrompt\", () => {\n117|  const base = {\n118|    sceneTitle: \"The Cyclone\",\n119|    sceneClip: \"Gray prairie and a small house.\",\n120|  };\n121|\n122|  it(\"uses the trusted passage text and names the style guards\", () => {\n123|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"Dorothy ran outside.\", ...base });\n124|    expect(prompt).toContain(\"Dorothy ran outside.\");\n125|    expect(prompt).toContain(\"silver shoes\");\n126|    expect(prompt).toContain(\"No text\");\n127|    expect(prompt).toContain(\"no ruby slippers\");\n128|    expect(prompt).toContain(\"1939 MGM\");\n129|  });\n130|\n131|  it(\"clips a long passage near 600 chars\", () => {\n132|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"x\".repeat(2000), ...base });\n133|    const passagePart = prompt.split(\"Context:\")[0] ?? \"\";\n134|    expect(passagePart.length).toBeLessThan(900);\n135|  });\n136|\n137|  it(\"builds a scene prompt from the scene clip\", () => {\n138|    const prompt = buildPrompt({ kind: \"scene\", passageText: \"\", ...base });\n139|    expect(prompt).toContain(\"The Cyclone\");\n140|    expect(prompt).toContain(\"silver shoes\");\n141|  });\n142|});\n143|\n144|describe(\"buildCaption\", () => {\n145|  it(\"uses the scene title for scenes\", () => {\n146|    expect(buildCaption({ kind: \"scene\", sceneTitle: \"The Cyclone\", passageText: \"x\" })).toBe(\n147|      \"The Cyclone\",\n148|    );\n149|  });\n150|\n151|  it(\"uses the first words for passages\", () => {\n152|    expect(\n153|      buildCaption({ kind: \"passage\", sceneTitle: \"T\", passageText: \"Dorothy lived in Kansas.\" }),\n154|    ).toBe(\"Dorothy lived in Kansas.\");\n155|    expect(\n156|      buildCaption({\n157|        kind: \"passage\",\n158|        sceneTitle: \"T\",\n159|        passageText: \"one two three four five six seven eight nine ten eleven\",\n160|      }),\n161|    ).toBe(\"one two three four five six seven eight nine ten…\");\n162|  });\n163|});\n164|\n165|describe(\"quota and budget helpers\", () => {\n166|  it(\"refuses the 6th image per key\", () => {\n167|    expect(overQuota(5)).toBe(false);\n168|    expect(overQuota(6)).toBe(true);\n169|  });\n170|\n171|  it(\"builds day-scoped quota keys\", () => {\n172|    const keys = quotaKeys({ day: \"2026-10-27\", ipHash: \"h\", anonId: \"a\" });\n173|    expect(keys.ip).toContain(\"2026-10-27\");\n174|    expect(keys.anon).toContain(\"2026-10-27\");\n175|    expect(keys.ip).not.toBe(keys.anon);\n176|  });\n177|\n178|  it(\"flags a spend total over the cap\", () => {\n179|    expect(budgetExceeded(11_000_000, 10_000_000)).toBe(true);\n180|    expect(budgetExceeded(10_000_000, 10_000_000)).toBe(false);\n181|    expect(imageCostMicro()).toBe(IMAGE_COST_MICRO);\n182|  });\n183|\n184|  it(\"builds day-scoped daily spend keys with a 48 h TTL\", () => {\n185|    expect(dailySpendKey(\"2026-10-27\")).toBe(\"img:spend:daily:2026-10-27\");\n186|    expect(dailySpendKey(\"2026-10-28\")).not.toBe(dailySpendKey(\"2026-10-27\"));\n187|    expect(dailySpendKey(\"2026-10-28\")).not.toBe(spendKey());\n188|    expect(DAILY_SPEND_TTL_SEC).toBe(172800);\n189|  });\n190|\n191|  it(\"compares lock tokens\", () => {\n192|    expect(canRelease(\"t\", \"t\")).toBe(true);\n193|    expect(canRelease(\"t\", \"other\")).toBe(false);\n194|    expect(canRelease(\"t\", null)).toBe(false);\n195|  });\n196|});\n197|\n198|describe(\"memory KV lock\", () => {\n199|  it(\"gives a second requester pending and releases only with the token\", async () => {\n200|    const kv = createMemoryKV();\n201|    expect(await kv.setNxEx(\"k\", \"t1\", 60)).toBe(true);\n202|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(false);\n203|    expect(await kv.releaseIfToken(\"k\", \"t2\")).toBe(false);\n204|    expect(await kv.releaseIfToken(\"k\", \"t1\")).toBe(true);\n205|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(true);\n206|  });\n207|\n208|  it(\"supports quota counters with refund\", async () => {\n209|    const kv = createMemoryKV();\n210|    for (let i = 0; i < 5; i++) await kv.incr(\"q\");\n211|    expect(overQuota(await kv.incr(\"q\"))).toBe(true);\n212|    expect(await kv.decr(\"q\")).toBe(5);\n213|  });\n214|\n215|  it(\"supports the spend reserve and refund\", async () => {\n216|    const kv = createMemoryKV();\n217|    expect(await kv.incrBy(\"spend\", IMAGE_COST_MICRO)).toBe(IMAGE_COST_MICRO);\n218|    expect(budgetExceeded(IMAGE_COST_MICRO, 10_000_000)).toBe(false);\n219|    expect(await kv.decrBy(\"spend\", IMAGE_COST_MICRO)).toBe(0);\n220|  });\n221|});"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c423","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":108,"recorded_at":1780531400000211,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c735cd73ec8f961c382af0097a","command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"text":"Read text file `server/images/handler.ts`.\n1|import \"server-only\";\n2|import { loadOzBook } from \"@/server/books\";\n3|import { MSG_BAD_REQUEST, MSG_UNAVAILABLE, parseImageRequest, validateAgainstBook } from \"@/core/images\";\n4|import type { ImageRequest, ImageResponse } from \"@/core/images\";\n5|import { MAX_IMAGE_BODY_BYTES, readBodyCapped } from \"./body\";\n6|import { readImageEnv } from \"./env\";\n7|import { createRestKV } from \"./kv\";\n8|import { createBlobStore } from \"./blob\";\n9|import { createMetaClient } from \"./meta\";\n10|import { orchestrate } from \"./orchestrate\";\n11|import type { ImageContent } from \"./orchestrate\";\n12|import { issueAnonId, parseAnonCookie, serializeAnonCookie, verifyAnonCookie } from \"./cookies\";\n13|import { clientIp, utcDay } from \"./quota\";\n14|\n15|function toResponse(res: ImageResponse): { json: ImageResponse; status: number } {\n16|  if (res.status === \"ready\" || res.status === \"pending\") return { json: res, status: 200 };\n17|  const status = res.code === \"bad_request\" ? 400 : res.code === \"quota\" ? 429 : 503;\n18|  return { json: res, status };\n19|}\n20|\n21|export async function handleImagesPost(req: Request): Promise<Response> {\n22|  const capped = await readBodyCapped(req, MAX_IMAGE_BODY_BYTES);\n23|  if (!capped.ok) {\n24|    return Response.json(\n25|      { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n26|      { status: capped.reason === \"too_large\" ? 413 : 400 },\n27|    );\n28|  }\n29|\n30|  let parsed: ImageRequest;\n31|  try {\n32|    parsed = parseImageRequest(JSON.parse(capped.text));\n33|  } catch {\n34|    return Response.json(\n35|      { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n36|      { status: 400 },\n37|    );\n38|  }\n39|\n40|  let env;\n41|  try {\n42|    env = readImageEnv();\n43|  } catch (e) {\n44|    const message = e instanceof Error ? e.message : \"\";\n45|    const prefix = \"missing image env:\";\n46|    const names = message.startsWith(prefix) ? message.slice(prefix.length).trim() : \"\";\n47|    console.warn(`image env missing: ${names}`);\n48|    return Response.json(\n49|      { status: \"error\", code: \"unavailable\", message: MSG_UNAVAILABLE } satisfies ImageResponse,\n50|      { status: 503 },\n51|    );\n52|  }\n53|\n54|  try {\n55|    const { book, scenes } = loadOzBook();\n56|    try {\n57|      validateAgainstBook(\n58|        parsed,\n59|        {\n60|          id: book.id,\n61|          textVersion: book.textVersion,\n62|          paragraphNs: new Set(book.paragraphs.map((p) => p.n)),\n63|          sceneIds: new Set(scenes.map((s) => s.id)),\n64|        },\n65|      );\n66|    } catch {\n67|      return Response.json(\n68|        { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n69|        { status: 400 },\n70|      );\n71|    }\n72|\n73|    const byN = new Map(book.paragraphs.map((p) => [p.n, p.text]));\n74|    const sceneOf = scenes.find((s) =>\n75|      parsed.kind === \"passage\" ? parsed.n >= s.start_n && parsed.n <= s.end_n : s.id === parsed.sceneId,\n76|    );\n77|    const sceneParas = sceneOf\n78|      ? book.paragraphs.filter((p) => p.n >= sceneOf.start_n && p.n <= sceneOf.end_n)\n79|      : [];\n80|    const content: ImageContent = {\n81|      passageText: parsed.kind === \"passage\" ? (byN.get(parsed.n) ?? \"\") : \"\",\n82|      sceneTitle: sceneOf?.title ?? \"\",\n83|      sceneClip: sceneParas.map((p) => p.text).join(\" \"),\n84|    };\n85|\n86|    const cookieValue = parseAnonCookie(req.headers.get(\"cookie\"));\n87|    let anonId = cookieValue ? verifyAnonCookie(cookieValue, env.sessionSecret) : null;\n88|    let setCookie: string | null = null;\n89|    if (!anonId) {\n90|      const issued = issueAnonId(env.sessionSecret);\n91|      anonId = issued.id;\n92|      setCookie = serializeAnonCookie(issued.value);\n93|    }\n94|\n95|    const res = await orchestrate(parsed, {\n96|      kv: createRestKV(env.upstashUrl, env.upstashToken),\n97|      store: createBlobStore(),\n98|      generate: createMetaClient(env.metaKey),\n99|      env,\n100|      content,\n101|      ip: clientIp(req.headers.get(\"x-forwarded-for\")),\n102|      anonId,\n103|      day: utcDay(),\n104|    });\n105|\n106|    const { json, status } = toResponse(res);\n107|    const headers = setCookie ? { \"Set-Cookie\": setCookie } : undefined;\n108|    return Response.json(json, { status, headers });\n109|  } catch {\n110|    console.error(\"image request failed\");\n111|    return Response.json(\n112|      { status: \"error\", code: \"unavailable\", message: MSG_UNAVAILABLE } satisfies ImageResponse,\n113|      { status: 503 },\n114|    );\n115|  }\n116|}"}}
