{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c455","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":133,"recorded_at":1780531400000261,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","event":{"chunk":"Read text file `server/images/orchestrate.ts`.\n1|import \"server-only\";\n2|import { randomUUID } from \"node:crypto\";\n3|import {\n4|  DAILY_SPEND_TTL_SEC,\n5|  MSG_FAILED,\n6|  MSG_QUOTA,\n7|  MSG_BUDGET_TOTAL,\n8|  MSG_BUDGET_DAILY,\n9|  LOCK_TTL_SEC,\n10|  buildCaption,\n11|  buildPrompt,\n12|  budgetExceeded,\n13|  dailySpendKey,\n14|  imageCostMicro,\n15|  imageKey,\n16|  indexKeyFor,\n17|  lockKeyFor,\n18|  spendKey,\n19|} from \"@/core/images\";\n20|import type { ImageGenerator, ImageRequest, ImageResponse, ImageStore, KV } from \"@/core/images\";\n21|import type { ImageEnv } from \"./env\";\n22|import { verifyHuman } from \"./human\";\n23|import { checkQuota, hashIp, quotaKeysFor, refundQuota } from \"./quota\";\n24|\n25|export interface ImageContent {\n26|  passageText: string;\n27|  sceneTitle: string;\n28|  sceneClip: string;\n29|}\n30|\n31|export interface OrchestrateDeps {\n32|  kv: KV;\n33|  store: ImageStore;\n34|  generate: ImageGenerator;\n35|  env: ImageEnv;\n36|  content: ImageContent;\n37|  ip: string;\n38|  anonId: string;\n39|  day: string;\n40|  token?: string;\n41|}\n42|\n43|// One pass, no skipped steps: hit -> lock -> human -> quota -> budget ->\n44|// generate -> store -> index -> release. Every failure after the reserve\n45|// refunds quota and budget and releases the lock.\n46|export async function orchestrate(\n47|  req: ImageRequest,\n48|  deps: OrchestrateDeps,\n49|): Promise<ImageResponse> {\n50|  const key = imageKey(req);\n51|  const indexKey = indexKeyFor(key);\n52|  const lockKey = lockKeyFor(key);\n53|  // deps.day is the UTC day string (YYYY-MM-DD), shared with quota keys.\n54|  const dailyKey = dailySpendKey(deps.day);\n55|\n56|  const indexed = await deps.kv.get(indexKey);\n57|  if (indexed) {\n58|    return { status: \"ready\", url: indexed, cached: true, caption: captionFor(req, deps.content) };\n59|  }\n60|  const existing = await deps.store.findUrl(key);\n61|  if (existing) {\n62|    await deps.kv.set(indexKey, existing);\n63|    return { status: \"ready\", url: existing, cached: true, caption: captionFor(req, deps.content) };\n64|  }\n65|\n66|  const token = deps.token ?? randomUUID();\n67|  if (!(await deps.kv.setNxEx(lockKey, token, LOCK_TTL_SEC))) return { status: \"pending\" };\n68|\n69|  // Best-effort unlock: a release failure must never turn into a client 500.\n70|  const release = async (): Promise<void> => {\n71|    try {\n72|      await deps.kv.releaseIfToken(lockKey, token);\n73|    } catch {\n74|      // Lock expires on its own; nothing to do.\n75|    }\n76|  };\n77|\n78|  const keys = quotaKeysFor({ day: deps.day, ip: deps.ip, salt: deps.env.ipSalt, anonId: deps.anonId });\n79|  let quotaTaken = false;\n80|  let spendTaken = false;\n81|  let dailySpendTaken = false;\n82|  // Best-effort refunds that clear their flag only after the write lands,\n83|  // so the outer catch refunds each reserve exactly once.\n84|  const refundQuotaOnce = async (): Promise<void> => {\n85|    try {\n86|      await refundQuota(deps.kv, keys);\n87|      quotaTaken = false;\n88|    } catch {\n89|      // Redis down: nothing reserved server-side to retry against.\n90|    }\n91|  };\n92|  const refundSpendOnce = async (): Promise<void> => {\n93|    try {\n94|      await deps.kv.decrBy(spendKey(), imageCostMicro());\n95|      spendTaken = false;\n96|    } catch {\n97|      // Redis down: nothing reserved server-side to retry against.\n98|    }\n99|  };\n100|  const refundDailySpendOnce = async (): Promise<void> => {\n101|    try {\n102|      await deps.kv.decrBy(dailyKey, imageCostMicro());\n103|      dailySpendTaken = false;\n104|    } catch {\n105|      // Redis down: nothing reserved server-side to retry against.\n106|    }\n107|  };\n108|\n109|  try {\n110|    if (!verifyHuman()) {\n111|      await release();\n112|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n113|    }\n114|\n115|    if (!(await checkQuota(deps.kv, keys)).ok) {\n116|      await release();\n117|      return { status: \"error\", code: \"quota\", message: MSG_QUOTA };\n118|    }\n119|    quotaTaken = true;\n120|\n121|    // Both caps apply only to requests paid with our key. The future\n122|    // BYOK path must skip these reserves and check its own key instead.\n123|    const total = await deps.kv.incrBy(spendKey(), imageCostMicro());\n124|    spendTaken = true;\n125|    if (budgetExceeded(total, deps.env.spendCapMicro)) {\n126|      await refundSpendOnce();\n127|      await refundQuotaOnce();\n128|      await release();\n129|      return { status: \"error\", code: \"budget\", message: MSG_BUDGET_TOTAL };\n130|    }\n131|\n132|    const dailyTotal = await deps.kv.incrBy(dailyKey, imageCostMicro());\n133|    dailySpendTaken = true;\n134|    // Refresh the expiry on every reserve: cheap, idempotent, and keeps\n135|    // the key alive through a busy day without a separate read.\n136|    await deps.kv.expire(dailyKey, DAILY_SPEND_TTL_SEC);\n137|    if (budgetExceeded(dailyTotal, deps.env.dailySpendCapMicro)) {\n138|      await refundDailySpendOnce();\n139|      await refundSpendOnce();\n140|      await refundQuotaOnce();\n141|      await release();\n142|      return { status: \"error\", code: \"daily_budget\", message: MSG_BUDGET_DAILY };\n143|    }\n144|\n145|    let bytes: Uint8Array;\n146|    try {\n147|      bytes = await deps.generate.generate(\n148|        buildPrompt({\n149|          kind: req.kind,\n150|          passageText: deps.content.passageText,\n151|          sceneTitle: deps.content.sceneTitle,\n152|          sceneClip: deps.content.sceneClip,\n153|        }),\n154|      );\n155|    } catch {\n156|      await refundDailySpendOnce();\n157|      await refundSpendOnce();\n158|      await refundQuotaOnce();\n159|      await release();\n160|      console.error(\"image generate failed\");\n161|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n162|    }\n163|\n164|    try {\n165|      const url = await deps.store.save(key, bytes);\n166|      try {\n167|        await deps.kv.set(indexKey, url);\n168|      } catch {\n169|        console.error(\"image index failed\");\n170|        await release();\n171|        return { status: \"ready\", url, cached: false, caption: captionFor(req, deps.content) };\n172|      }\n173|      await release();\n174|      return { status: \"ready\", url, cached: false, caption: captionFor(req, deps.content) };\n175|    } catch {\n176|      // A lost save race leaves the winner's file behind; backfill from it.\n177|      const raced = await deps.store.findUrl(key);\n178|      if (raced) {\n179|        try {\n180|          await deps.kv.set(indexKey, raced);\n181|        } catch {\n182|          console.error(\"image index failed\");\n183|        }\n184|        await release();\n185|        return { status: \"ready\", url: raced, cached: true, caption: captionFor(req, deps.content) };\n186|      }\n187|      await refundDailySpendOnce();\n188|      await refundSpendOnce();\n189|      await refundQuotaOnce();\n190|      await release();\n191|      console.error(\"image store failed\");\n192|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n193|    }\n194|  } catch {\n195|    if (dailySpendTaken) await refundDailySpendOnce();\n196|    if (spendTaken) await refundSpendOnce();\n197|    if (quotaTaken) await refundQuotaOnce();\n198|    await release();\n199|    console.error(\"image request failed\");\n200|    return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n201|  }\n202|}\n203|\n204|function captionFor(req: ImageRequest, content: ImageContent): string {\n205|  return buildCaption({\n206|    kind: req.kind,\n207|    sceneTitle: content.sceneTitle,\n208|    passageText: content.passageText,\n209|  });\n210|}","final_result":true,"kind":"output","task_id":"01a182c7-3f8a-76c1-92e9-b60c3d235b97"},"kind":"task_lifecycle","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"task_id":"01a182c7-3f8a-76c1-92e9-b60c3d235b97","task_stream":{"id":"01a182c7-3f8a-76c1-92e9-b60c3d235b97","kind":"task"}}}
