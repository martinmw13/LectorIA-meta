{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3d1","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":67,"recorded_at":1780531400000129,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c72e4a76b4ab762f95583420c0","command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"text":"Read text file `server/images/env.ts`.\n1|import \"server-only\";\n2|\n3|// Reads image env once per request. Any missing key means unavailable:\n4|// with no quotas or budget configured, the route must never spend.\n5|export interface ImageEnv {\n6|  upstashUrl: string;\n7|  upstashToken: string;\n8|  metaKey: string;\n9|  sessionSecret: string;\n10|  ipSalt: string;\n11|  spendCapMicro: number;\n12|  dailySpendCapMicro: number;\n13|}\n14|\n15|// Vercel's Upstash marketplace integration injects KV_REST_API_* names.\n16|// UPSTASH_* wins when non-empty, else the KV_* fallback applies per value.\n17|// The read-only token is never used (we write).\n18|const URL_NAMES = \"UPSTASH_REDIS_REST_URL|KV_REST_API_URL\";\n19|const TOKEN_NAMES = \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\";\n20|\n21|const REQUIRED = [\n22|  \"BLOB_READ_WRITE_TOKEN\",\n23|  \"META_API_KEY\",\n24|  \"SESSION_SECRET\",\n25|  \"IP_HASH_SALT\",\n26|] as const;\n27|\n28|export function readImageEnv(from: NodeJS.ProcessEnv = process.env): ImageEnv {\n29|  const upstashUrl = from.UPSTASH_REDIS_REST_URL || from.KV_REST_API_URL;\n30|  const upstashToken = from.UPSTASH_REDIS_REST_TOKEN || from.KV_REST_API_TOKEN;\n31|  const missing = [\n32|    upstashUrl ? null : URL_NAMES,\n33|    upstashToken ? null : TOKEN_NAMES,\n34|    ...REQUIRED.filter((k) => !from[k]),\n35|  ].filter((m): m is string => m !== null);\n36|  if (missing.length > 0) throw new Error(`missing image env: ${missing.join(\",\")}`);\n37|  const capUsd = Number(from.SPEND_CAP_USD ?? \"10\");\n38|  const dailyCapUsd = Number(from.DAILY_SPEND_CAP_USD ?? \"1.5\");\n39|  return {\n40|    upstashUrl: upstashUrl as string,\n41|    upstashToken: upstashToken as string,\n42|    metaKey: from.META_API_KEY as string,\n43|    sessionSecret: from.SESSION_SECRET as string,\n44|    ipSalt: from.IP_HASH_SALT as string,\n45|    spendCapMicro: Math.round((Number.isFinite(capUsd) ? capUsd : 10) * 1_000_000),\n46|    dailySpendCapMicro: Math.round(\n47|      (Number.isFinite(dailyCapUsd) && dailyCapUsd >= 0 ? dailyCapUsd : 1.5) * 1_000_000,\n48|    ),\n49|  };\n50|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3d3","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":68,"recorded_at":1780531400000131,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c72f7571798896ba1bb628ca93","command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"text":"Read text file `server/images/quota.ts`.\n1|import \"server-only\";\n2|import { createHmac } from \"node:crypto\";\n3|import { QUOTA_TTL_SEC, overQuota, quotaKeys } from \"@/core/images\";\n4|import type { KV } from \"@/core/images\";\n5|\n6|// Per-person quota: 5 new images per day, counted by hashed IP and by\n7|// anonymous cookie, whichever runs out first. Day keys are UTC dates.\n8|export function utcDay(now: Date = new Date()): string {\n9|  return now.toISOString().slice(0, 10);\n10|}\n11|\n12|export function hashIp(ip: string, salt: string): string {\n13|  return createHmac(\"sha256\", salt).update(ip).digest(\"hex\");\n14|}\n15|\n16|export function clientIp(forwardedFor: string | null | undefined): string {\n17|  return (forwardedFor ?? \"\").split(\",\")[0]?.trim() || \"unknown\";\n18|}\n19|\n20|export async function checkQuota(\n21|  kv: KV,\n22|  keys: { ip: string; anon: string },\n23|): Promise<{ ok: true } | { ok: false }> {\n24|  const ipCount = await kv.incr(keys.ip);\n25|  await kv.expire(keys.ip, QUOTA_TTL_SEC);\n26|  const anonCount = await kv.incr(keys.anon);\n27|  await kv.expire(keys.anon, QUOTA_TTL_SEC);\n28|  if (overQuota(ipCount) || overQuota(anonCount)) {\n29|    await kv.decr(keys.ip);\n30|    await kv.decr(keys.anon);\n31|    return { ok: false };\n32|  }\n33|  return { ok: true };\n34|}\n35|\n36|export async function refundQuota(kv: KV, keys: { ip: string; anon: string }): Promise<void> {\n37|  await kv.decr(keys.ip);\n38|  await kv.decr(keys.anon);\n39|}\n40|\n41|export function quotaKeysFor(args: { day: string; ip: string; salt: string; anonId: string }): {\n42|  ip: string;\n43|  anon: string;\n44|} {\n45|  return quotaKeys({ day: args.day, ipHash: hashIp(args.ip, args.salt), anonId: args.anonId });\n46|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3d5","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":69,"recorded_at":1780531400000133,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c7308876b5a767861996ba84a4","command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"text":"Read text file `core/images.ts`.\n1|// Pure image logic: validation, cache keys, prompts, quota and budget\n2|// helpers. No env reads, no network, no secrets. Server modules inject\n3|// the KV, store, and generator clients defined here.\n4|import { IMAGE_COST_MICRO, PROMPT_VERSION } from \"./types\";\n5|import type { ImageKind, ImageRequest } from \"./types\";\n6|\n7|export type { ImageErrorCode, ImageKind, ImageRequest, ImageResponse } from \"./types\";\n8|\n9|export const DAILY_IMAGE_LIMIT = 5;\n10|export const QUOTA_TTL_SEC = 48 * 3600;\n11|export const LOCK_TTL_SEC = 150;\n12|export const MAX_PASSAGE_CHARS = 600;\n13|export const MAX_SCENE_CLIP_CHARS = 1200;\n14|\n15|export const MSG_BAD_REQUEST = \"That request was not valid. Try again.\";\n16|export const MSG_QUOTA = \"You reached your limit of 5 images per day. Come back tomorrow.\";\n17|export const MSG_BUDGET_TOTAL =\n18|  \"Our free credits for the hackathon are used up. Thanks for reading with us! \" +\n19|  \"You can keep going by bringing your own key.\";\n20|export const MSG_BUDGET_DAILY =\n21|  \"So many readers today that our free credits for today are used up. \" +\n22|  \"Come back tomorrow, or bring your own key.\";\n23|export const MSG_UNAVAILABLE = \"Images are unavailable right now.\";\n24|export const MSG_FAILED = \"Could not generate the image. Try again.\";\n25|export const MSG_RETRY = \"The image is taking longer than expected. Try again.\";\n26|\n27|export class ImageValidationError extends Error {\n28|  constructor() {\n29|    super(\"invalid image request\");\n30|    this.name = \"ImageValidationError\";\n31|  }\n32|}\n33|\n34|// Minimal store surface the route needs; Upstash REST and Blob clients\n35|// implement these in server/, tests use the memory fake below.\n36|export interface KV {\n37|  get(key: string): Promise<string | null>;\n38|  setNxEx(key: string, value: string, exSec: number): Promise<boolean>;\n39|  set(key: string, value: string): Promise<void>;\n40|  incr(key: string): Promise<number>;\n41|  incrBy(key: string, by: number): Promise<number>;\n42|  decr(key: string): Promise<number>;\n43|  decrBy(key: string, by: number): Promise<number>;\n44|  expire(key: string, sec: number): Promise<void>;\n45|  releaseIfToken(key: string, token: string): Promise<boolean>;\n46|}\n47|\n48|export interface ImageStore {\n49|  findUrl(path: string): Promise<string | null>;\n50|  save(path: string, bytes: Uint8Array): Promise<string>;\n51|}\n52|\n53|export interface ImageGenerator {\n54|  generate(prompt: string): Promise<Uint8Array>;\n55|}\n56|\n57|function isRecord(json: unknown): json is Record<string, unknown> {\n58|  return typeof json === \"object\" && json !== null && !Array.isArray(json);\n59|}\n60|\n61|// Strict parse at the trust boundary: exact fields only, so a client\n62|// bug cannot silently spend budget on a misread request.\n63|export function parseImageRequest(json: unknown): ImageRequest {\n64|  if (!isRecord(json)) throw new ImageValidationError();\n65|  const { kind } = json;\n66|  if (kind === \"passage\") {\n67|    const keys = Object.keys(json).sort().join(\",\");\n68|    if (keys !== \"bookId,kind,n,textVersion\") throw new ImageValidationError();\n69|    if (typeof json.bookId !== \"string\" || json.bookId.length === 0) throw new ImageValidationError();\n70|    if (typeof json.textVersion !== \"string\" || json.textVersion.length === 0) {\n71|      throw new ImageValidationError();\n72|    }\n73|    if (typeof json.n !== \"number\" || !Number.isInteger(json.n)) throw new ImageValidationError();\n74|    return { kind: \"passage\", bookId: json.bookId, textVersion: json.textVersion, n: json.n };\n75|  }\n76|  if (kind === \"scene\") {\n77|    const keys = Object.keys(json).sort().join(\",\");\n78|    if (keys !== \"bookId,kind,sceneId,textVersion\") throw new ImageValidationError();\n79|    if (typeof json.bookId !== \"string\" || json.bookId.length === 0) throw new ImageValidationError();\n80|    if (typeof json.textVersion !== \"string\" || json.textVersion.length === 0) {\n81|      throw new ImageValidationError();\n82|    }\n83|    if (typeof json.sceneId !== \"string\" || json.sceneId.length === 0) throw new ImageValidationError();\n84|    return { kind: \"scene\", bookId: json.bookId, textVersion: json.textVersion, sceneId: json.sceneId };\n85|  }\n86|  throw new ImageValidationError();\n87|}\n88|\n89|export interface BookRef {\n90|  id: string;\n91|  textVersion: string;\n92|  paragraphNs: Set<number>;\n93|  sceneIds: Set<string>;\n94|}\n95|\n96|// Checks the parsed request against the frozen book text.\n97|export function validateAgainstBook(req: ImageRequest, book: BookRef): void {\n98|  if (req.bookId !== book.id) throw new ImageValidationError();\n99|  if (req.textVersion !== book.textVersion) throw new ImageValidationError();\n100|  if (req.kind === \"passage\") {\n101|    if (!book.paragraphNs.has(req.n)) throw new ImageValidationError();\n102|    return;\n103|  }\n104|  if (!book.sceneIds.has(req.sceneId)) throw new ImageValidationError();\n105|}\n106|\n107|// One paragraph maps to one image; one scene maps to one image.\n108|export function imageKey(req: ImageRequest): string {\n109|  const base = `images/${req.bookId}/${req.textVersion}/${PROMPT_VERSION}`;\n110|  return req.kind === \"passage\" ? `${base}/p${req.n}.webp` : `${base}/scene-${req.sceneId}.webp`;\n111|}\n112|\n113|export function indexKeyFor(key: string): string {\n114|  return `img:index:${key}`;\n115|}\n116|\n117|export function lockKeyFor(key: string): string {\n118|  return `img:lock:${key}`;\n119|}\n120|\n121|export function quotaKeys(args: { day: string; ipHash: string; anonId: string }): {\n122|  ip: string;\n123|  anon: string;\n124|} {\n125|  return {\n126|    ip: `img:quota:ip:${args.day}:${args.ipHash}`,\n127|    anon: `img:quota:anon:${args.day}:${args.anonId}`,\n128|  };\n129|}\n130|\n131|export function spendKey(): string {\n132|  return \"img:spend:micro\";\n133|}\n134|\n135|// Daily spend counter for our key. The day is the UTC day string\n136|// YYYY-MM-DD the caller already uses for quota keys, so the daily\n137|// cap resets on UTC rollover together with per-person quota.\n138|export const DAILY_SPEND_TTL_SEC = 48 * 3600;\n139|\n140|export function dailySpendKey(day: string): string {\n141|  return `img:spend:daily:${day}`;\n142|}\n143|\n144|export function overQuota(count: number): boolean {\n145|  return count > DAILY_IMAGE_LIMIT;\n146|}\n147|\n148|export function budgetExceeded(totalAfterReserve: number, capMicro: number): boolean {\n149|  return totalAfterReserve > capMicro;\n150|}\n151|\n152|export function imageCostMicro(): number {\n153|  return IMAGE_COST_MICRO;\n154|}\n155|\n156|// Lets the route compare lock tokens without touching Redis twice.\n157|export function canRelease(expected: string, actual: string | null): boolean {\n158|  return actual !== null && actual === expected;\n159|}\n160|\n161|function clip(text: string, max: number): string {\n162|  const clean = text.replace(/\\s+/g, \" \").trim();\n163|  if (clean.length <= max) return clean;\n164|  return clean.slice(0, max).trimEnd();\n165|}\n166|\n167|// Prompt from trusted server-side book text only. The client sends\n168|// ordinals and ids, never free text, so there is no injection path.\n169|export function buildPrompt(args: {\n170|  kind: ImageKind;\n171|  passageText: string;\n172|  sceneTitle: string;\n173|  sceneClip: string;\n174|}): string {\n175|  const style =\n176|    \"Illustration in the style of W. W. Denslow's 1900 first-edition \" +\n177|    \"illustrations for The Wonderful Wizard of Oz: flat color, bold black \" +\n178|    \"ink outlines, limited palette. Dorothy wears silver shoes. Nothing \" +\n179|    \"from the 1939 MGM film, no ruby slippers, no film look. No text, \" +\n180|    \"no captions, no lettering in the image.\";\n181|  if (args.kind === \"scene\") {\n182|    return (\n183|      `Scene \"${args.sceneTitle}\". ${clip(args.sceneClip, MAX_SCENE_CLIP_CHARS)}. ${style}`\n184|    );\n185|  }\n186|  return (\n187|    `Scene \"${args.sceneTitle}\". Passage: ${clip(args.passageText, MAX_PASSAGE_CHARS)}. ` +\n188|    `Context: ${clip(args.sceneClip, MAX_SCENE_CLIP_CHARS)}. ${style}`\n189|  );\n190|}\n191|\n192|export function buildCaption(args: {\n193|  kind: ImageKind;\n194|  sceneTitle: string;\n195|  passageText: string;\n196|}): string {\n197|  if (args.kind === \"scene\") return args.sceneTitle;\n198|  const words = args.passageText.replace(/\\s+/g, \" \").trim().split(\" \").slice(0, 10);\n199|  const head = words.join(\" \");\n200|  return words.length >= 10 ? `${head}…` : head;\n201|}\n202|\n203|// In-memory KV for tests. Expiries are checked against Date.now.\n204|export function createMemoryKV(): KV & { clear(): void } {\n205|  const values = new Map<string, string>();\n206|  const expiresAt = new Map<string, number>();\n207|  function live(key: string): boolean {\n208|    const until = expiresAt.get(key);\n209|    if (until !== undefined && Date.now() >= until) {\n210|      values.delete(key);\n211|      expiresAt.delete(key);\n212|      return false;\n213|    }\n214|    return true;\n215|  }\n216|  function num(key: string): number {\n217|    return Number(values.get(key) ?? \"0\");\n218|  }\n219|  return {\n220|    async get(key: string): Promise<string | null> {\n221|      if (!live(key)) return null;\n222|      return values.get(key) ?? null;\n223|    },\n224|    async setNxEx(key: string, value: string, exSec: number): Promise<boolean> {\n225|      if (live(key) && values.has(key)) return false;\n226|      values.set(key, value);\n227|      expiresAt.set(key, Date.now() + exSec * 1000);\n228|      return true;\n229|    },\n230|    async set(key: string, value: string): Promise<void> {\n231|      values.set(key, value);\n232|      expiresAt.delete(key);\n233|    },\n234|    async incr(key: string): Promise<number> {\n235|      const next = num(key) + 1;\n236|      values.set(key, String(next));\n237|      return next;\n238|    },\n239|    async incrBy(key: string, by: number): Promise<number> {\n240|      const next = num(key) + by;\n241|      values.set(key, String(next));\n242|      return next;\n243|    },\n244|    async decr(key: string): Promise<number> {\n245|      const next = num(key) - 1;\n246|      values.set(key, String(next));\n247|      return next;\n248|    },\n249|    async decrBy(key: string, by: number): Promise<number> {\n250|      const next = num(key) - by;\n251|      values.set(key, String(next));\n252|      return next;\n253|    },\n254|    async expire(key: string, sec: number): Promise<void> {\n255|      if (values.has(key)) expiresAt.set(key, Date.now() + sec * 1000);\n256|    },\n257|    async releaseIfToken(key: string, token: string): Promise<boolean> {\n258|      if (!live(key)) return false;\n259|      if (values.get(key) !== token) return false;\n260|      values.delete(key);\n261|      expiresAt.delete(key);\n262|      return true;\n263|    },\n264|    clear(): void {\n265|      values.clear();\n266|      expiresAt.clear();\n267|    },\n268|  };\n269|}"}}
