{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c413","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":100,"recorded_at":1780531400000195,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","event":{"chunk":"Read text file `server/images/handler.ts`.\n1|import \"server-only\";\n2|import { loadOzBook } from \"@/server/books\";\n3|import { MSG_BAD_REQUEST, MSG_UNAVAILABLE, parseImageRequest, validateAgainstBook } from \"@/core/images\";\n4|import type { ImageRequest, ImageResponse } from \"@/core/images\";\n5|import { MAX_IMAGE_BODY_BYTES, readBodyCapped } from \"./body\";\n6|import { readImageEnv } from \"./env\";\n7|import { createRestKV } from \"./kv\";\n8|import { createBlobStore } from \"./blob\";\n9|import { createMetaClient } from \"./meta\";\n10|import { orchestrate } from \"./orchestrate\";\n11|import type { ImageContent } from \"./orchestrate\";\n12|import { issueAnonId, parseAnonCookie, serializeAnonCookie, verifyAnonCookie } from \"./cookies\";\n13|import { clientIp, utcDay } from \"./quota\";\n14|\n15|function toResponse(res: ImageResponse): { json: ImageResponse; status: number } {\n16|  if (res.status === \"ready\" || res.status === \"pending\") return { json: res, status: 200 };\n17|  const status = res.code === \"bad_request\" ? 400 : res.code === \"quota\" ? 429 : 503;\n18|  return { json: res, status };\n19|}\n20|\n21|export async function handleImagesPost(req: Request): Promise<Response> {\n22|  const capped = await readBodyCapped(req, MAX_IMAGE_BODY_BYTES);\n23|  if (!capped.ok) {\n24|    return Response.json(\n25|      { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n26|      { status: capped.reason === \"too_large\" ? 413 : 400 },\n27|    );\n28|  }\n29|\n30|  let parsed: ImageRequest;\n31|  try {\n32|    parsed = parseImageRequest(JSON.parse(capped.text));\n33|  } catch {\n34|    return Response.json(\n35|      { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n36|      { status: 400 },\n37|    );\n38|  }\n39|\n40|  let env;\n41|  try {\n42|    env = readImageEnv();\n43|  } catch (e) {\n44|    const message = e instanceof Error ? e.message : \"\";\n45|    const prefix = \"missing image env:\";\n46|    const names = message.startsWith(prefix) ? message.slice(prefix.length).trim() : \"\";\n47|    console.warn(`image env missing: ${names}`);\n48|    return Response.json(\n49|      { status: \"error\", code: \"unavailable\", message: MSG_UNAVAILABLE } satisfies ImageResponse,\n50|      { status: 503 },\n51|    );\n52|  }\n53|\n54|  try {\n55|    const { book, scenes } = loadOzBook();\n56|    try {\n57|      validateAgainstBook(\n58|        parsed,\n59|        {\n60|          id: book.id,\n61|          textVersion: book.textVersion,\n62|          paragraphNs: new Set(book.paragraphs.map((p) => p.n)),\n63|          sceneIds: new Set(scenes.map((s) => s.id)),\n64|        },\n65|      );\n66|    } catch {\n67|      return Response.json(\n68|        { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n69|        { status: 400 },\n70|      );\n71|    }\n72|\n73|    const byN = new Map(book.paragraphs.map((p) => [p.n, p.text]));\n74|    const sceneOf = scenes.find((s) =>\n75|      parsed.kind === \"passage\" ? parsed.n >= s.start_n && parsed.n <= s.end_n : s.id === parsed.sceneId,\n76|    );\n77|    const sceneParas = sceneOf\n78|      ? book.paragraphs.filter((p) => p.n >= sceneOf.start_n && p.n <= sceneOf.end_n)\n79|      : [];\n80|    const content: ImageContent = {\n81|      passageText: parsed.kind === \"passage\" ? (byN.get(parsed.n) ?? \"\") : \"\",\n82|      sceneTitle: sceneOf?.title ?? \"\",\n83|      sceneClip: sceneParas.map((p) => p.text).join(\" \"),\n84|    };\n85|\n86|    const cookieValue = parseAnonCookie(req.headers.get(\"cookie\"));\n87|    let anonId = cookieValue ? verifyAnonCookie(cookieValue, env.sessionSecret) : null;\n88|    let setCookie: string | null = null;\n89|    if (!anonId) {\n90|      const issued = issueAnonId(env.sessionSecret);\n91|      anonId = issued.id;\n92|      setCookie = serializeAnonCookie(issued.value);\n93|    }\n94|\n95|    const res = await orchestrate(parsed, {\n96|      kv: createRestKV(env.upstashUrl, env.upstashToken),\n97|      store: createBlobStore(),\n98|      generate: createMetaClient(env.metaKey),\n99|      env,\n100|      content,\n101|      ip: clientIp(req.headers.get(\"x-forwarded-for\")),\n102|      anonId,\n103|      day: utcDay(),\n104|    });\n105|\n106|    const { json, status } = toResponse(res);\n107|    const headers = setCookie ? { \"Set-Cookie\": setCookie } : undefined;\n108|    return Response.json(json, { status, headers });\n109|  } catch {\n110|    console.error(\"image request failed\");\n111|    return Response.json(\n112|      { status: \"error\", code: \"unavailable\", message: MSG_UNAVAILABLE } satisfies ImageResponse,\n113|      { status: 503 },\n114|    );\n115|  }\n116|}","final_result":true,"kind":"output","task_id":"01a182c7-37d3-7390-bd7b-e78628baaf49"},"kind":"task_lifecycle","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"task_id":"01a182c7-37d3-7390-bd7b-e78628baaf49","task_stream":{"id":"01a182c7-37d3-7390-bd7b-e78628baaf49","kind":"task"}}}
