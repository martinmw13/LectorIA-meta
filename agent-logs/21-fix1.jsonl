{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c417","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":102,"recorded_at":1780531400000199,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","event":{"chunk":"Read text file `server/images/env.test.ts`.\n1|import { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n2|import { readImageEnv } from \"./env\";\n3|\n4|const BASE = {\n5|  BLOB_READ_WRITE_TOKEN: \"test-blob\",\n6|  META_API_KEY: \"test-meta\",\n7|  SESSION_SECRET: \"test-session\",\n8|  IP_HASH_SALT: \"test-salt\",\n9|} as const;\n10|\n11|const REDIS_KEYS = [\n12|  \"UPSTASH_REDIS_REST_URL\",\n13|  \"UPSTASH_REDIS_REST_TOKEN\",\n14|  \"KV_REST_API_URL\",\n15|  \"KV_REST_API_TOKEN\",\n16|  \"KV_REST_API_READ_ONLY_TOKEN\",\n17|] as const;\n18|\n19|let saved: Record<string, string | undefined>;\n20|\n21|beforeEach(() => {\n22|  saved = {};\n23|  for (const k of [...Object.keys(BASE), ...REDIS_KEYS]) saved[k] = process.env[k];\n24|  Object.assign(process.env, BASE);\n25|  for (const k of REDIS_KEYS) delete process.env[k];\n26|});\n27|\n28|afterEach(() => {\n29|  for (const k of Object.keys(saved)) {\n30|    if (saved[k] === undefined) delete process.env[k];\n31|    else process.env[k] = saved[k];\n32|  }\n33|});\n34|\n35|describe(\"readImageEnv redis fallback\", () => {\n36|  it(\"prefers UPSTASH_* when both are set\", () => {\n37|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n38|    process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n39|    process.env.KV_REST_API_URL = \"https://kv-url\";\n40|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n41|    const env = readImageEnv();\n42|    expect(env.upstashUrl).toBe(\"https://upstash-url\");\n43|    expect(env.upstashToken).toBe(\"upstash-token\");\n44|  });\n45|\n46|  it(\"uses KV_REST_API_* when UPSTASH_* is absent\", () => {\n47|    process.env.KV_REST_API_URL = \"https://kv-url\";\n48|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n49|    const env = readImageEnv();\n50|    expect(env.upstashUrl).toBe(\"https://kv-url\");\n51|    expect(env.upstashToken).toBe(\"kv-token\");\n52|  });\n53|\n54|  it(\"uses KV_REST_API_* when UPSTASH_* is empty\", () => {\n55|    process.env.UPSTASH_REDIS_REST_URL = \"\";\n56|    process.env.UPSTASH_REDIS_REST_TOKEN = \"\";\n57|    process.env.KV_REST_API_URL = \"https://kv-url\";\n58|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n59|    const env = readImageEnv();\n60|    expect(env.upstashUrl).toBe(\"https://kv-url\");\n61|    expect(env.upstashToken).toBe(\"kv-token\");\n62|  });\n63|\n64|  it(\"falls back each value independently\", () => {\n65|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n66|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n67|    const env = readImageEnv();\n68|    expect(env.upstashUrl).toBe(\"https://upstash-url\");\n69|    expect(env.upstashToken).toBe(\"kv-token\");\n70|  });\n71|\n72|  it(\"does not accept the read-only token alone\", () => {\n73|    process.env.KV_REST_API_URL = \"https://kv-url\";\n74|    process.env.KV_REST_API_READ_ONLY_TOKEN = \"read-only-token\";\n75|    expect(() => readImageEnv()).toThrow(\n76|      \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\",\n77|    );\n78|  });\n79|\n80|  it(\"defaults the daily spend cap to 1.5 USD\", () => {\n81|    delete process.env.DAILY_SPEND_CAP_USD;\n82|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n83|    process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n84|    expect(readImageEnv().dailySpendCapMicro).toBe(1_500_000);\n85|  });\n86|\n87|  it(\"honors a finite non-negative DAILY_SPEND_CAP_USD\", () => {\n88|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n89|    process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n90|    process.env.DAILY_SPEND_CAP_USD = \"2\";\n91|    expect(readImageEnv().dailySpendCapMicro).toBe(2_000_000);\n92|  });\n93|\n94|  it.each([\"abc\", \"-3\", \"Infinity\"])(\n95|    \"falls back to 1.5 USD for %s\",\n96|    (value) => {\n97|      process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n98|      process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n99|      process.env.DAILY_SPEND_CAP_USD = value;\n100|      expect(readImageEnv().dailySpendCapMicro).toBe(1_500_000);\n101|    },\n102|  );\n103|\n104|  it(\"missing-env error lists names only, never values\", () => {\n105|    process.env.UPSTASH_REDIS_REST_URL = \"https://secret-url-value\";\n106|    let message = \"\";\n107|    try {\n108|      readImageEnv();\n109|    } catch (e) {\n110|      message = (e as Error).message;\n111|    }\n112|    expect(message).toContain(\"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\");\n113|    expect(message).not.toContain(\"secret-url-value\");\n114|  });\n115|});","final_result":true,"kind":"output","task_id":"01a182c7-37c8-7201-8ac5-2a17603e1354"},"kind":"task_lifecycle","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"task_id":"01a182c7-37c8-7201-8ac5-2a17603e1354","task_stream":{"id":"01a182c7-37c8-7201-8ac5-2a17603e1354","kind":"task"}}}
