{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c41b","stream":{"kind":"session","id":"01a182c7-1fa3-7740-b1c6-efc1a8b254a1"},"sequence":104,"recorded_at":1780531400000203,"record_type":"event","durability":"durable","causation_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","event":{"chunk":"Read text file `core/images.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import {\n3|  DAILY_SPEND_TTL_SEC,\n4|  budgetExceeded,\n5|  buildCaption,\n6|  buildPrompt,\n7|  canRelease,\n8|  createMemoryKV,\n9|  dailySpendKey,\n10|  imageCostMicro,\n11|  imageKey,\n12|  indexKeyFor,\n13|  lockKeyFor,\n14|  overQuota,\n15|  parseImageRequest,\n16|  quotaKeys,\n17|  spendKey,\n18|  validateAgainstBook,\n19|} from \"./images\";\n20|import { IMAGE_COST_MICRO } from \"./types\";\n21|\n22|const book = {\n23|  id: \"oz\",\n24|  textVersion: \"t123\",\n25|  paragraphNs: new Set([1, 2, 3]),\n26|  sceneIds: new Set([\"c1s1\"]),\n27|};\n28|\n29|describe(\"parseImageRequest\", () => {\n30|  it(\"accepts a good passage body\", () => {\n31|    expect(\n32|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 }),\n33|    ).toEqual({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 });\n34|  });\n35|\n36|  it(\"accepts a good scene body\", () => {\n37|    expect(\n38|      parseImageRequest({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }),\n39|    ).toEqual({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" });\n40|  });\n41|\n42|  it(\"rejects a bad kind\", () => {\n43|    expect(() => parseImageRequest({ kind: \"chapter\", bookId: \"oz\" })).toThrow();\n44|  });\n45|\n46|  it(\"rejects extra fields\", () => {\n47|    expect(() =>\n48|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1, extra: 1 }),\n49|    ).toThrow();\n50|  });\n51|\n52|  it(\"rejects a non-integer n\", () => {\n53|    expect(() =>\n54|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1.5 }),\n55|    ).toThrow();\n56|  });\n57|\n58|  it(\"rejects non-objects\", () => {\n59|    for (const bad of [null, [], \"x\", 42]) {\n60|      expect(() => parseImageRequest(bad)).toThrow();\n61|    }\n62|  });\n63|});\n64|\n65|describe(\"validateAgainstBook\", () => {\n66|  it(\"accepts matching passage and scene\", () => {\n67|    expect(() =>\n68|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1 }, book),\n69|    ).not.toThrow();\n70|    expect(() =>\n71|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }, book),\n72|    ).not.toThrow();\n73|  });\n74|\n75|  it(\"rejects unknown book, wrong version, out of range n, unknown scene\", () => {\n76|    expect(() =>\n77|      validateAgainstBook({ kind: \"passage\", bookId: \"dorothy\", textVersion: \"t123\", n: 1 }, book),\n78|    ).toThrow();\n79|    expect(() =>\n80|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"old\", n: 1 }, book),\n81|    ).toThrow();\n82|    expect(() =>\n83|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 99 }, book),\n84|    ).toThrow();\n85|    expect(() =>\n86|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"nope\" }, book),\n87|    ).toThrow();\n88|  });\n89|});\n90|\n91|describe(\"imageKey\", () => {\n92|  it(\"uses only the start paragraph for passages\", () => {\n93|    expect(imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 7 })).toBe(\n94|      \"images/oz/t123/v1/p7.webp\",\n95|    );\n96|  });\n97|\n98|  it(\"uses the scene id for scenes\", () => {\n99|    expect(imageKey({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" })).toBe(\n100|      \"images/oz/t123/v1/scene-c1s1.webp\",\n101|    );\n102|  });\n103|\n104|  it(\"differs by book, version, and paragraph\", () => {\n105|    const a = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 1 });\n106|    const b = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t2\", n: 1 });\n107|    const c = imageKey({ kind: \"passage\", bookId: \"other\", textVersion: \"t1\", n: 1 });\n108|    const d = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 2 });\n109|    expect(new Set([a, b, c, d]).size).toBe(4);\n110|    expect(indexKeyFor(a)).toContain(a);\n111|    expect(lockKeyFor(a)).toContain(a);\n112|    expect(indexKeyFor(a)).not.toBe(lockKeyFor(a));\n113|  });\n114|});\n115|\n116|describe(\"buildPrompt\", () => {\n117|  const base = {\n118|    sceneTitle: \"The Cyclone\",\n119|    sceneClip: \"Gray prairie and a small house.\",\n120|  };\n121|\n122|  it(\"uses the trusted passage text and names the style guards\", () => {\n123|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"Dorothy ran outside.\", ...base });\n124|    expect(prompt).toContain(\"Dorothy ran outside.\");\n125|    expect(prompt).toContain(\"silver shoes\");\n126|    expect(prompt).toContain(\"No text\");\n127|    expect(prompt).toContain(\"no ruby slippers\");\n128|    expect(prompt).toContain(\"1939 MGM\");\n129|  });\n130|\n131|  it(\"clips a long passage near 600 chars\", () => {\n132|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"x\".repeat(2000), ...base });\n133|    const passagePart = prompt.split(\"Context:\")[0] ?? \"\";\n134|    expect(passagePart.length).toBeLessThan(900);\n135|  });\n136|\n137|  it(\"builds a scene prompt from the scene clip\", () => {\n138|    const prompt = buildPrompt({ kind: \"scene\", passageText: \"\", ...base });\n139|    expect(prompt).toContain(\"The Cyclone\");\n140|    expect(prompt).toContain(\"silver shoes\");\n141|  });\n142|});\n143|\n144|describe(\"buildCaption\", () => {\n145|  it(\"uses the scene title for scenes\", () => {\n146|    expect(buildCaption({ kind: \"scene\", sceneTitle: \"The Cyclone\", passageText: \"x\" })).toBe(\n147|      \"The Cyclone\",\n148|    );\n149|  });\n150|\n151|  it(\"uses the first words for passages\", () => {\n152|    expect(\n153|      buildCaption({ kind: \"passage\", sceneTitle: \"T\", passageText: \"Dorothy lived in Kansas.\" }),\n154|    ).toBe(\"Dorothy lived in Kansas.\");\n155|    expect(\n156|      buildCaption({\n157|        kind: \"passage\",\n158|        sceneTitle: \"T\",\n159|        passageText: \"one two three four five six seven eight nine ten eleven\",\n160|      }),\n161|    ).toBe(\"one two three four five six seven eight nine ten…\");\n162|  });\n163|});\n164|\n165|describe(\"quota and budget helpers\", () => {\n166|  it(\"refuses the 6th image per key\", () => {\n167|    expect(overQuota(5)).toBe(false);\n168|    expect(overQuota(6)).toBe(true);\n169|  });\n170|\n171|  it(\"builds day-scoped quota keys\", () => {\n172|    const keys = quotaKeys({ day: \"2026-10-27\", ipHash: \"h\", anonId: \"a\" });\n173|    expect(keys.ip).toContain(\"2026-10-27\");\n174|    expect(keys.anon).toContain(\"2026-10-27\");\n175|    expect(keys.ip).not.toBe(keys.anon);\n176|  });\n177|\n178|  it(\"flags a spend total over the cap\", () => {\n179|    expect(budgetExceeded(11_000_000, 10_000_000)).toBe(true);\n180|    expect(budgetExceeded(10_000_000, 10_000_000)).toBe(false);\n181|    expect(imageCostMicro()).toBe(IMAGE_COST_MICRO);\n182|  });\n183|\n184|  it(\"builds day-scoped daily spend keys with a 48 h TTL\", () => {\n185|    expect(dailySpendKey(\"2026-10-27\")).toBe(\"img:spend:daily:2026-10-27\");\n186|    expect(dailySpendKey(\"2026-10-28\")).not.toBe(dailySpendKey(\"2026-10-27\"));\n187|    expect(dailySpendKey(\"2026-10-28\")).not.toBe(spendKey());\n188|    expect(DAILY_SPEND_TTL_SEC).toBe(172800);\n189|  });\n190|\n191|  it(\"compares lock tokens\", () => {\n192|    expect(canRelease(\"t\", \"t\")).toBe(true);\n193|    expect(canRelease(\"t\", \"other\")).toBe(false);\n194|    expect(canRelease(\"t\", null)).toBe(false);\n195|  });\n196|});\n197|\n198|describe(\"memory KV lock\", () => {\n199|  it(\"gives a second requester pending and releases only with the token\", async () => {\n200|    const kv = createMemoryKV();\n201|    expect(await kv.setNxEx(\"k\", \"t1\", 60)).toBe(true);\n202|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(false);\n203|    expect(await kv.releaseIfToken(\"k\", \"t2\")).toBe(false);\n204|    expect(await kv.releaseIfToken(\"k\", \"t1\")).toBe(true);\n205|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(true);\n206|  });\n207|\n208|  it(\"supports quota counters with refund\", async () => {\n209|    const kv = createMemoryKV();\n210|    for (let i = 0; i < 5; i++) await kv.incr(\"q\");\n211|    expect(overQuota(await kv.incr(\"q\"))).toBe(true);\n212|    expect(await kv.decr(\"q\")).toBe(5);\n213|  });\n214|\n215|  it(\"supports the spend reserve and refund\", async () => {\n216|    const kv = createMemoryKV();\n217|    expect(await kv.incrBy(\"spend\", IMAGE_COST_MICRO)).toBe(IMAGE_COST_MICRO);\n218|    expect(budgetExceeded(IMAGE_COST_MICRO, 10_000_000)).toBe(false);\n219|    expect(await kv.decrBy(\"spend\", IMAGE_COST_MICRO)).toBe(0);\n220|  });\n221|});","final_result":true,"kind":"output","task_id":"01a182c7-37ce-7ed2-bd54-7ce1e8d853a0"},"kind":"task_lifecycle","run_stream":{"id":"01a182c7-21ae-7563-b8aa-8495f4c7e6b2","kind":"run"},"task_id":"01a182c7-37ce-7ed2-bd54-7ce1e8d853a0","task_stream":{"id":"01a182c7-37ce-7ed2-bd54-7ce1e8d853a0","kind":"task"}}}
