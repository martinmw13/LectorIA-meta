ew Uint8Array([9])),\n208|    };\n209|    const res = await orchestrate(passage, d);\n210|    expect(res).toEqual({ status: \"error\", code: \"daily_budget\", message: MSG_BUDGET_DAILY });\n211|    expect(calls).toBe(0);\n212|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n213|    expect(await d.kv.get(dailySpendKey(\"2026-10-27\"))).toBe(\"0\");\n214|    // Lock released: a new request generates instead of pending.\n215|    const retry = await orchestrate(passage, {\n216|      ...d,\n217|      env: { ...env, dailySpendCapMicro: 1_500_000 },\n218|      generate: { generate: async () => new Uint8Array([7]) },\n219|    });\n220|    expect(retry.status).toBe(\"ready\");\n221|  });\n222|\n223|  it(\"resets the daily cap on a new UTC day\", async () => {\n224|    const tiny = { ...env, dailySpendCapMicro: 10_000 };\n225|    const d = deps({ env: tiny });\n226|    expect((await orchestrate(passage, d)).status).toBe(\"ready\");\n227|    const refused = await orchestrate(\n228|      { ...passage, n: 4 },\n229|      { ...d, ip: \"9.9.9.9\", anonId: \"fresh-1\" },\n230|    );\n231|    expect(refused).toMatchObject({ status: \"error\", code: \"daily_budget\" });\n232|    // A fresh key: the day-27 index entry would serve n=3 from cache.\n233|    const next = await orchestrate({ ...passage, n: 5 }, { ...d, day: \"2026-10-28\" });\n234|    expect(next.status).toBe(\"ready\");\n235|    expect(await d.kv.get(dailySpendKey(\"2026-10-28\"))).toBe(\"10000\");\n236|  });\n237|\n238|  it(\"still enforces the total cap with the total message\", async () => {\n239|    const d = deps({ env: { ...env, spendCapMicro: 1 } });\n240|    const res = await orchestrate(passage, d);\n241|    expect(res).toEqual({ status: \"error\", code: \"budget\", message: MSG_BUDGET_TOTAL });\n242|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n243|  });\n244|\n245|  it(\"refunds the daily counter when generation fails\", async () => {\n246|    const d = deps();\n247|    d.generate = {\n248|      generate: async () => {\n249|        throw new Error(\"meta secret internals 500\");\n250|      },\n251|    };\n252|    const res = await orchestrate(passage, d);\n253|    expect(res).toMatchObject({ status: \"error\", code: \"unavailable\" });\n254|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n255|    expect(await d.kv.get(dailySpendKey(\"2026-10-27\"))).toBe(\"0\");\n256|  });\n257|\n258|  it(\"leaves both counters alone on a cached hit\", async () => {\n259|    const d = deps();\n260|    const first = await orchestrate(passage, d);\n261|    expect(first.status).toBe(\"ready\");\n262|    const second = await orchestrate(passage, d);\n263|    expect(second).toMatchObject({ status: \"ready\", cached: true });\n264|    expect(await d.kv.get(spendKey())).toBe(\"10000\");\n265|    expect(await d.kv.get(dailySpendKey(\"2026-10-27\"))).toBe(\"10000\");\n266|  });\n267|\n268|  it(\"recovers from a lost save race through the winner file\", async () => {\n269|    const files = new Map<string, Uint8Array>();\n270|    const d = deps();\n271|    d.store = {\n272|      findUrl: async (path) => (files.has(path) ? `https://blob.example/${path}` : null),\n273|      save: async (path, bytes) => {\n274|        files.set(path, bytes);\n275|        throw new Error(\"race lost\");\n276|      },\n277|    };\n278|    const res = await orchestrate(passage, d);\n279|    expect(res).toMatchObject({ status: \"ready\", cached: true });\n280|  });\n281|});"}}
