{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3dd","stream":{"kind":"session","id":"01a1832d-22a7-7bd3-b4f8-0a937add9938"},"sequence":73,"recorded_at":1780531400000141,"record_type":"event","durability":"durable","causation_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","event":{"chunk":"Read text file `core/narration.ts`.\n(493 line(s) above)\n494|// Modal L4, about USD 0.80/h.\n495|export const KOKORO_L4_USD_PER_SEC = 0.000222;\n496|\n497|// About 15 chars of audio per second, GPU time about 2% of audio after\n498|// encode, plus 8 s of cold start/overhead. Integer micro-dollars.\n499|export function estimateNarrationMicro(chars: number): number {\n500|  return Math.ceil((Math.max(0, chars) / 15 * 0.02 + 8) * KOKORO_L4_USD_PER_SEC * 1e6);\n501|}\n502|\n503|export function actualNarrationMicro(gpuSec: number): number {\n504|  return Math.ceil(Math.max(0, gpuSec) * KOKORO_L4_USD_PER_SEC * 1e6);\n505|}","final_result":true,"kind":"output","task_id":"01a1832d-3d65-7961-ae80-68c92dceee7f"},"kind":"task_lifecycle","run_stream":{"id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","kind":"run"},"task_id":"01a1832d-3d65-7961-ae80-68c92dceee7f","task_stream":{"id":"01a1832d-3d65-7961-ae80-68c92dceee7f","kind":"task"}}}
