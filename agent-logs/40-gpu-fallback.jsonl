{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3a9","stream":{"kind":"session","id":"01a1832d-22a7-7bd3-b4f8-0a937add9938"},"sequence":47,"recorded_at":1780531400000089,"record_type":"event","durability":"durable","causation_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1832d2c5c765fb7748530234ac78f","command_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","kind":"run"},"text":"Read text file `core/narration.ts`.\n1|// Pure narration logic: sentence split, chunking, cache keys, manifest\n2|// validation, playback helpers, and cost math. No env, no network,\n3|// no crypto, no node: imports; callers inject hashing.\n4|export const NARRATION_VOICE = \"af_heart\";\n5|export const NARRATION_MODEL = \"kokoro-82m/0.9.4\";\n6|export const NARRATION_SPEED = 0.95;\n7|export const NARRATION_FORMAT = 2;\n8|export const SENTENCE_GAP_SEC = 0.3;\n9|export const PARAGRAPH_GAP_SEC = 0.7;\n10|\n11|export interface SentenceSpan {\n12|  start: number;\n13|  end: number;\n14|}\n15|\n16|export interface NarrationChunk {\n17|  n: number;\n18|  start: number;\n19|  end: number;\n20|  text: string;\n21|}\n22|\n23|const CLOSERS = new Set([\"”\", \"’\", '\"', \"'\", \")\", \"]\"]);\n24|\n25|// Lowercase words that end with a period without ending a sentence.\n26|const ABBREVIATIONS = new Set([\n27|  \"mr\", \"mrs\", \"ms\", \"dr\", \"st\", \"mt\", \"prof\", \"sr\", \"jr\",\n28|  \"rev\", \"lt\", \"col\", \"gen\", \"capt\", \"sgt\", \"ave\", \"blvd\", \"rd\", \"no\",\n29|]);\n30|\n31|function isTerminator(char: string): boolean {\n32|  return char === \".\" || char === \"!\" || char === \"?\" || char === \"…\";\n33|}\n34|\n35|function isSpace(char: string | undefined): boolean {\n36|  return char === undefined || /\\s/.test(char);\n37|}\n38|\n39|// Word of lette