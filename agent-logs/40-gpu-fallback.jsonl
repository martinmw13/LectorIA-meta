{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bb","stream":{"kind":"session","id":"01a1832d-22a7-7bd3-b4f8-0a937add9938"},"sequence":568,"recorded_at":1780531400001131,"record_type":"event","durability":"durable","causation_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","event":{"chunk":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"grep -n \\\"cap refuses\\\" -A 40 pipeline/narrate.test.ts | head -60\",\n  \"description\": \"Read the failing cap test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"127:  it(\\\"stops spending once the cap refuses\\\", async () => {\\n128-    const dir = mkdtempSync(join(tmpdir(), \\\"narrate-cap-\\\"));\\n129-    setupBook(dir);\\n130-    const { synthesize, calls } = fakeSynthesize();\\n131-    const { store } = memoryStore();\\n132-\\n133-    const stats = await runNarrate({ bookKey: \\\"oz\\\", force: false, dir }, { synthesize, store, capUsd: 0 });\\n134-    expect(stats.stopped).toBe(true);\\n135-    expect(calls()).toBe(0);\\n136-    expect(stats.estimatedMicro).toBe(0);\\n137-\\n138-    // A zero estimate would still reserve; with a real cap the first\\n139-    // chapter generates and the rest stop.\\n140-    const dir2 = mkdtempSync(join(tmpdir(), \\\"narrate-cap2-\\\"));\\n141-    setupBook(dir2);\\n142-    const again = fakeSynthesize();\\n143-    const store2 = memoryStore();\\n144-    const stats2 = await runNarrate({ bookKey: \\\"oz\\\", force: false, dir: dir2 }, { synthesize: again.synthesize, store: store2.store, capUsd: 0.002 });\\n145-    expect(stats2.stopped).toBe(true);\\n146-    expect(again.calls()).toBeLessThan(2);\\n147-    expect(again.calls()).toBeGreaterThanOrEqual(1);\\n148-  });\\n149-\\n150-  it(\\\"writes the ready chapters with no input and fails when one chapter fails\\\", async () => {\\n151-    const dir = mkdtempSync(join(