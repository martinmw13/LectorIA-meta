);\n327|  const timed: ({ t0: number; t1: number } | null)[] = display.map(() => null);\n328|  let i = 0;\n329|  let j = 0;\n330|  while (i < display.length) {\n331|    while (j < tokens.length && norms[j] === \"\") j += 1;\n332|    if (j >= tokens.length) break;\n333|    const word = display[i] as { start: number; end: number; norm: string };\n334|    const tok = tokens[j] as WordToken;\n335|    if (word.norm === norms[j]) {\n336|      timed[i] = { t0: tok.t0, t1: tok.t1 };\n337|      i += 1;\n338|      j += 1;\n339|      continue;\n340|    }\n341|    // One token covering several display words: its norm is the\n342|    // concatenation of theirs, joined without whitespace (\"well-known\").\n343|    let joined = word.norm;\n344|    let k = i;\n345|    while (k + 1 < display.length && k + 1 < i + 4 && joined.length < (norms[j] as string).length) {\n346|      const prev = display[k] as { start: number; end: number; norm: string };\n347|      const next = display[k + 1] as { start: number; end: number; norm: string };\n348|      if (/\\s/.test(text.slice(prev.end, next.start))) break;\n349|      joined += next.norm;\n350|      k += 1;\n351|      if (joined === norms[j]) break;\n352|    }\n353|    if (k > i && joined === norms[j]) {\n354|      const total =\n355|        display.slice(i, k + 1).reduce((sum, d) => sum + (d.end - d.start), 0) || 1;\n356|      let edge = tok.t0;\n357|      for (let m = i; m <= k; m++) {\n358|        const part = display[m] as { start: number; end: number; norm: string };\n359|        const share = ((part.end - part.start) / total) * (tok.t1 - tok.t0);\n360|        timed[m] = { t0: edge, t1: edge + share };\n361|        edge += share;\n362|      }\n363|      i = k + 1;\n364|      j += 1;\n365|      continue;\n366|    }\n367|    let advanced = false;\n368|    for (let a = 1; a <= 3 && j + a < tokens.length; a++) {\n369|      if (norms[j + a] === word.norm) {\n370|        j += a;\n371|        advanced = true;\n372|        break;\n373|      }\n374|    }\n375|    if (!advanced) {\n376|      for (let b = 1; b <= 3 && i + b < display.length; b++) {\n377|        if ((display[i + b] as { norm: string }).norm === norms[j]) {\n378|          i += b;\n379|          advanced = true;\n380|          break;\n381|        }\n382|      }\n383|    }\n384|    if (advanced) continue;\n385|    // Neither side matches (a number Kokoro spells out): both move on\n386|    // and the display word interpolates below.\n387|    i += 1;\n388|    j += 1;\n389|  }\n390|  for (let a = 0; a < display.length; a++) {\n391|    if (timed[a] !== null) continue;\n392|    let b = a;\n393|    while (b + 1 < display.length && timed[b + 1] === null) b += 1;\n394|    const lo = a > 0 ? (timed[a - 1] as { t0: number; t1: number }).t1 : span.t0;\n395|    const hi = b + 1 < display.length ? (timed[b + 1] as { t0: number; t1: number }).t0 : span.t1;\n396|    const from = Math.min(lo, hi);\n397|    const to = Math.max(lo, hi);\n398|    const count = b - a + 1;\n399|    for (let m = a; m <= b; m++) {\n400|      timed[m] = { t0: from + ((to - from) * (m - a)) / count, t1: from + ((to - from) * (m - a + 1)) / count };\n401|    }\n402|    a = b;\n403|  }\n404|  const round3 = (v: number): number => Math.round(v * 1000) / 1000;\n405|  const clamp = (v: number): number => Math.min(span.t1, Math.max(span.t0, v));\n406|  let prevT0 = span.t0;\n407|  return display.map((d, index) => {\n408|    const t = timed[index] as { t0: number; t1: number };\n409|    let t0 = clamp(round3(t.t0));\n410|    let t1 = clamp(round3(t.t1));\n411|    if (t0 < prevT0) t0 = prevT0;\n412|    if (t1 < t0) t1 = t0;\n413|    prevT0 = t0;\n414|    return [d.start, d.end, t0, t1];\n415|  });\n416|}\n417|\n418|// Binary search: index of the last word with t0 <= t, so the highlight\n419|// stays on a word through the gap after it. -1 before the first.\n420|export function activeWordAt(chunk: { w: number[] }, tSec: number): number {\n421|  const count = Math.floor(chunk.w.length / 4);\n422|  let lo = 0;\n423|  let hi = count - 1;\n424|  let found = -1;\n425|  while (lo <= hi) {\n426|    const mid = (lo + hi) >> 1;\n427|    if ((chunk.w[mid * 4 + 2] as number) <= tSec) {\n428|      found = mid;\n429|      lo = mid + 1;\n430|    } else {\n431|      hi = mid - 1;\n432|    }\n433|  }\n434|  return found;\n435|}\n436|\n437|// Click-to-seek: the word covering charOffset in paragraph n, with its\n438|// chunk and word indexes and start time. Null when outside any word.\n439|export function wordAt(\n440|  narration: { chunks: { n: number; start: number; end: number; w: number[] }[] },\n441|  n: number,\n442|  charOffset: number,\n443|): { chunk: number; word: number; t0: number } | null {\n444|  for (let c = 0; c < narration.chunks.length; c++) {\n445|    const chunk = narration.chunks[c] as { n: number; start: number; end: number; w: number[] };\n446|    if (chunk.n !== n || charOffset < chunk.start || charOffset >= chunk.end) continue;\n447|    const count = Math.floor(chunk.w.length / 4);\n448|    for (let k = 0; k < count; k++) {\n449|      const s = chunk.w[k * 4] as number;\n450|      const e = chunk.w[k * 4 + 1] as number;\n451|      if (s <= charOffset && charOffset < e) {\n452|        return { chunk: c, word: k, t0: chunk.w[k * 4 + 2] as number };\n453|      }\n454|    }\n455|    return null;\n456|  }\n457|  return null;\n458|}\n459|\n460|// Playback range for a scene: t0 of the first chunk with n >= startN\n461|// through t1 of the last chunk with n <= endN. Null when empty.\n462|export function sceneSpan(\n463|  narration: { chunks: { n: number; t0: number; t1: number }[] },\n464|  startN: number,\n465|  endN: number,\n466|): { startSec: number; endSec: number } | null {\n467|  let startSec: number | null = null;\n468|  let endSec: number | null = null;\n469|  for (const chunk of narration.chunks) {\n470|    if (chunk.n < startN || chunk.n > endN) continue;\n471|    if (startSec === null) startSec = chunk.t0;\n472|    endSec = chunk.t1;\n473|  }\n474|  if (startSec === null || endSec === null) return null;\n475|  return { startSec, endSec };\n476|}\n477|\n478|export type PrepareEvent = \"upload\" | \"enter\" | \"jump\";\n479|\n480|// Owner's rolling window: upload warms chapters 1-2 while the book is\n481|// processed; entering N warms N+1 and N+2; jumping to N warms N and N+1.\n482|export function chaptersToPrepare(event: PrepareEvent, ch: number, totalChapters: number): number[] {\n483|  const wanted = event === \"upload\" ? [1, 2] : event === \"enter\" ? [ch + 1, ch + 2] : [ch, ch + 1];\n484|  const seen = new Set<number>();\n485|  const out: number[] = [];\n486|  for (const n of wanted) {\n487|    if (n < 1 || n > totalChapters || seen.has(n)) continue;\n488|    seen.add(n);\n489|    out.push(n);\n490|  }\n491|  return out;\n492|}\n493|\n494|// Modal L4, about USD 0.80/h.\n495|export const KOKORO_L4_USD_PER_SEC = 0.000222;\n496|\n497|// About 15 chars of audio per second, GPU time about 2% of audio after\n498|// encode, plus 8 s of cold start/overhead. Integer micro-dollars.\n499|export function estimateNarrationMicro(chars: number): number {\n500|  return Math.ceil((Math.max(0, chars) / 15 * 0.02 + 8) * KOKORO_L4_USD_PER_SEC * 1e6);\n(more lines below)"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3ab","stream":{"kind":"session","id":"01a1832d-22a7-7bd3-b4f8-0a937add9938"},"sequence":48,"recorded_at":1780531400000091,"record_type":"event","durability":"durable","causation_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1832d2d72723b9d666bd4bb4b00d8","command_id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1832d-2557-7c22-bf4d-f6336f6f7b2d","kind":"run"},"text":"Read text file `docs/contracts/narration.md`.\n1|# Narration\n2|\n3|Read-aloud narration, one compact mp3 per chapter plus a per-chapter\n4|manifest with sentence timings. The unit is the chapter (owner\n5|decision): the reader plays any scene by seeking to its first sentence\n6|(`sceneSpan`) and highlights the sentence being read (`activeChunkAt`).\n7|Voice Kokoro-82M `af_heart` at speed 0.95, generated on a Modal GPU\n8|function that scales to zero.\n9|\n10|## Manifest\n11|\n12|`ChapterNarration` in `core/narration.ts`: `format: 2`, `key`, `src`,\n13|`durationSec`, `voice`, `model`, `speed`, and `chunks` with `n`\n14|(paragraph ordinal), `start`/`end` (char offsets into the paragraph),\n15|`t0`/`t1` (seconds), and `w` (word timings, below).\n16|`parseChapterNarration` throws on any bad field: it is a trust\n17|boundary, since the reader fetches this JSON. `src` is an `https:`\n18|URL or a same-origin path under `/narration/`.\n19|\n20|## Word timings\n21|\n22|No forced alignment: the Modal function returns each Kokoro token\n23|timestamp with chapter-absolute seconds per span, and `alignWords`\n24|maps them onto display words (`/[\\p{L}\\p{N}]+(?:['’][\\p{L}\\p{N}]+)*/u`,\n25|so \"Oz’s\" and \"didn't\" are one word and punctuation never\n26|highlights). Both sides compare on NFKD lowercase letters and digits\n27|with apostrophes dropped, in order with a lookahead of 3 either way;\n28|a token spanning several display words (\"well-known\") splits its time\n29|by character length. Words left without time interpolate between\n30|their neighbours; all times are clamped to the span and monotonic.\n31|`w` is flat `[start, end, t0, t1, ...]` with paragraph-relative char\n32|offsets and seconds, validated (multiple of 4, offsets in range,\n33|times in range, sorted) and required. `activeWordAt` drives the\n34|highlight, `wordAt` drives click-to-seek. Cost: 4 numbers per word,\n35|about 25 KB per chapter manifest.\n36|\n37|## Cache key\n38|\n39|`narrationKeyInput` builds a canonical string from the\n40|NFC-normalized, whitespace-collapsed chunk texts joined with `\"\\n\"`,\n41|plus voice, model, speed, and format. Callers hash it with SHA-256;\n42|`narrationKey` returns `narration/v2/<voice>/<first 32 hex>`. Same\n43|text + voice + model + speed gives the same key, any edit gives a new\n44|one. Audio lives at `<key>.mp3`, the manifest at `<key>.json`, as\n45|deterministic public Blob paths; the Redis index `narr:idx:<key>`\n46|holds the manifest JSON. Oz is pregenerated through the same keys, so\n47|a second reader of the same text gets it free.\n48|\n49|## Concurrency\n50|\n51|One reusable function, `ensureChapterNarration` in\n52|`core/narration-cache.ts`, serves the offline Oz run and the future\n53|upload route: index hit, then store hit with index backfill, then lock\n54|`narr:lock:<key>` (TTL 300 s, `setNxEx`; a null acquire means\n55|`pending`), one index re-check, budget reserve, synthesize, put audio\n56|and manifest, index set, release. Cache hits never touch the lock or\n57|the budget; failures refund once and release. No error text leaves the\n58|function.\n59|\n60|## Spend\n61|\n62|Integer micro-dollars. `estimateNarrationMicro(chars)` reserves the\n63|cap before generating: about 15 chars of audio per second, GPU time\n64|about 2% of audio after encode, plus 8 s of cold start/overhead, at\n65|the Modal L4 rate (`KOKORO_L4_USD_PER_SEC`, about USD 0.80/h). The\n66|server reserves on both the global spend key and the daily spend key\n67|(`spendKey()`, `dailySpendKey(day)` from `core/images`), refunding\n68|both past either cap; the global `DAILY_SPEND_CAP_USD` applies. The\n69|offline run caps with `NARRATION_CAP_USD` (default 2) and stops with a\n70|report instead of spending more. Worked number: an average Oz chapter\n71|of ~9,000 chars is about 10 min of audio, about 20 s of warm GPU,\n72|about USD 0.004.\n73|\n74|## Rolling window\n75|\n76|The owner warms two chapters ahead: at upload, chapters 1 and 2 while\n77|the book is processed; entering chapter N ensures N+1 and N+2; jumping\n78|to N ensures N and N+1. `chaptersToPrepare` in `core/narration.ts`\n79|computes the window; the client asks, the server dedupes through the\n80|index and lock.\n81|\n82|## Cold start\n83|\n84|About 15–30 s for the first chapter after the function scaled to zero\n85|(`scaledown_window=60`), warm calls a few seconds per chapter. The\n86|2-ahead window hides it after chapter 1. While a chapter is pending,\n87|the Read aloud control shows a quiet \"Getting the voice ready…\"\n88|state.\n89|\n90|## Operations\n91|\n92|Deploy with `modal deploy pipeline/modal/narrate.py`; the app\n93|`lectoria-narration` scales to zero a minute after the last call, and\n94|`modal app stop lectoria-narration` removes it entirely.\n95|\n96|## Open items\n97|\n98|Upload route wiring (uses `server/narration/cache.ts`, no route yet);\n99|Blob vs `public/` for Oz (same keys either way, so switching is a\n100|re-run)."}}
