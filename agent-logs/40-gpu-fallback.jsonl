Integer micro-dollars. `estimateNarrationMicro(chars)` reserves the\\n45|cap before generating: about 15 chars of audio per second, GPU time\\n46|about 2% of audio after encode, plus 8 s of cold start/overhead, at\\n47|the Modal L4 rate (`KOKORO_L4_USD_PER_SEC`, about USD 0.80/h). The\\n48|server reserves on both the global spend key and the daily spend key\\n49|(`spendKey()`, `dailySpendKey(day)` from `core/images`), refunding\\n50|both past either cap; the global `DAILY_SPEND_CAP_USD` applies. The\\n51|offline run caps with `NARRATION_CAP_USD` (default 2) and stops with a\\n52|report instead of spending more. Worked number: an average Oz chapter\\n53|of ~9,000 chars is about 10 min of audio, about 20 s of warm GPU,\\n54|about USD 0.004.\\n55|\\n56|## Rolling window\\n57|\\n58|The owner warms two chapters ahead: at upload, chapters 1 and 2 while\\n59|the book is processed; entering chapter N ensures N+1 and N+2; jumping\\n60|to N ensures N and N+1. `chaptersToPrepare` in `core/narration.ts`\\n61|computes the window; the client asks, the server dedupes through the\\n62|index and lock.\\n63|\\n64|## Cold start\\n65|\\n66|About 15–30 s for the first chapter after the function scaled to zero\\n67|(`scaledown_window=60`), warm calls a few seconds per chapter. The\\n68|2-ahead window hides it after chapter 1. While a chapter is pending,\\n69|the Read aloud control shows a quiet \\\"Getting the voice ready…\\\"\\n70|state.\\n71|\\n72|## Operations\\n73|\\n74|Deploy with `modal deploy pipeline/modal/narrate.py`; the app\\n75|`lectoria-narration` scales to zero a minute after the last call, and\\n76|`modal app stop lectoria-narration` removes it entirely.\\n77|\\n78|## Open items\\n79|\\n80|Upload route wiring (uses `server/narration/cache.ts`, no route yet);\\n81|Blob vs `public/` for Oz (same keys either way, so switching is a\\n82|re-run).\",\"final_result\":true,\"kind\":\"output\",\"task_id\":\"01a18312-6043-7913-962e-52a352fa3944\"},\"kind\":\"task_lifecycle\",\"run_stream\":{\"id\":\"01a18312-3ebd-70c3-8f6c-7db8865c3ec9\",\"kind\":\"run\"},\"task_id\":\"01a18312-6043-7913-962e-52a352fa3944\",\"task_stream\":{\"id\":\"01a18312-6043-7913-962e-52a352fa3944\",\"kind\":\"task\"}}}\nagent-logs/40-review-2.jsonl:113:{\"schema_version\":1,\"id\":\"018f0000-0000-7000-8000-00000000c42d\",\"stream\":{\"kind\":\"session\",\"id\":\"01a18312-3d0b-77c0-a917-0314e675541a\"},\"sequence\":113,\"recorded_at\":1780531400000221,\"record_type\":\"event\",\"durability\":\"durable\",\"causation_id\":\"01a18312-3ebd-70c3-8f6c-7db8865c3ec9\",\"payload_type\":\"task.lifecycle.output\",\"payload_schema_version\":1,\"payload\":{\"command_id\":\"01a18312-3ebd-70c3-8f6c-7db8865c3ec9\",\"event\":{\"chunk\":\"Read text file `/workspace/wt-40/core/narration.ts`.\\n1|// Pure narration logic: sentence split, chunking, cache keys, manifest\\n2|// validation, playback helpers, and cost math. No env, no network,\\n3|// no crypto, no node: imports; callers inject hashing.\\n4|export const NARRATION_VOICE = \\\"af_heart\\\";\\n5|export const NARRATION_MODEL = \\\"kokoro-82m/0.9.4\\\";\\n6|export const NARRATION_SPEED = 0.95;\\n7|export const NARRATION_FORMAT = 1;\\n8|export const SENTENCE_GAP_SEC = 0.3;\\n9|export const PARAGRAPH_GAP_SEC = 0.7;\\n10|\\n11|export interface SentenceSpan {\\n12|  start: number;\\n13|  end: number;\\n14|}\\n15|\\n16|export interface NarrationChunk {\\n17|  n: number;\\n18|  start: number;\\n19|  end: number;\\n20|  text: string;\\n21|}\\n22|\\n23|const CLOSERS = new Set([\\\"”\\\", \\\"’\\\", '\\\"', \\\"'\\\", \\\")\\\", \\\"]\\\"]);\\n24|\\n25|// Lowercase words that end with a period without ending a sentence.\\n26|const ABBREVIATIONS = new Set([\\n27|  \\\"mr\\\", \\\"mrs\\\", \\\"ms\\\", \\\"dr\\\", \\\"st\\\", \\\"mt\\\", \\\"prof\\\", \\\"sr\\\", \\\"jr\\\",\\n28|  \\\"rev\\\", \\\"lt\\\", \\\"col\\\", \\\"gen\\\", \\\"capt\\\", \\\"sgt\\\", \\\"ave\\\", \\\"blvd\\\", \\\"rd\\\", \\\"no\\\",\\n29|]);\\n30|\\n31|function isTerminator(char: string): boolean {\\n32|  return char === \\\".\\\" || char === \\\"!\\\" || char === \\\"?\\\" || char === \\\"…\\\";\\n33|}\\n34|\\n35|function isSpace(char: string | undefined): boolean {\\n36|  return char === undefined || /\\\\s/.test(char);\\n37|}\\n38|\\n39|// Word of letters directly before index (exclusive), lowercased.\\n40|function wordBefore(text: string, index: number): string {\\n41|  let i = index - 1;\\n42|  while (i >= 0 && /[A-Za-z]/.test(text[i] as string)) i -= 1;\\n43|  return text.slice(i + 1, index).toLowerCase();\\n44|}\\n45|\\n46|function wordCount(piece: string): number {\\n47|  const words = piece.split(/\\\\s+/).filter((w) => w.length > 0);\\n48|  return words.length;\\n49|}\\n50|\\n51|// Char offsets into the paragraph text, trimmed of surrounding\\n52|// whitespace, covering every non-space char. A sentence ends at a\\n53|// terminator plus closing quotes/brackets followed by whitespace.\\n54|export function splitSentences(text: string): SentenceSpan[] {\\n55|  const raw: SentenceSpan[] = [];\\n56|  let pieceStart = -1;\\n57|  let i = 0;\\n58|  while (i < text.length) {\\n59|    const char = text[i] as string;\\n60|    if (/\\\\s/.test(char)) {\\n61|      i += 1;\\n62|      continue;\\n63|    }\\n64|    if (pieceStart === -1) pieceStart = i;\\n65|    if (isTerminator(char)) {\\n66|      let end = i + 1;\\n67|      while (end < text.length && CLOSERS.has(text[end] as string)) end += 1;\\n68|      if (isSpace(text[end])) {\\n69|        if (char === \\\".\\\") {\\n70|          const word = wordBefore(text, i);\\n71|          const singleInitial = /^[A-Z]$/.test(text.slice(i - 1, i));\\n72|          if (singleInitial || ABBREVIATIONS.has(word)) {\\n73|            i += 1;\\n74|            continue;\\n75|          }\\n76|        }\\n77|        // Trim trailing whitespace inside the piece (there is none:\\n78|        // the piece ends at a terminator or closer).\\n79|        raw.push({ start: pieceStart, end });\\n80|        pieceStart = -1;\\n81|        i = end;\\n82|        continue;\\n83|      }\\n84|    }\\n85|    i += 1;\\n86|  }\\n87|  if (pieceStart !== -1) {\\n88|    let end = text.length;\\n89|    while (end > pieceStart && /\\\\s/.test(text[end - 1] as string)) end -= 1;\\n90|    raw.push({ start: pieceStart, end });\\n91|  }\\n92|  if (raw.length === 0) return [];\\n93|  // Merge a piece shorter than 3 words into the previous sentence\\n94|  // (or the next one if first), keeping offsets exact.\\n95|  const merged: SentenceSpan[] = [];\\n96|  for (const span of raw) {\\n97|    const piece = text.slice(span.start, span.end);\\n98|    if (wordCount(piece) >= 3 || merged.length === 0) {\\n99|      merged.push({ ...span });\\n100|      continue;\\n101|    }\\n102|    const prev = merged[merged.length - 1] as SentenceSpan;\\n103|    prev.end = span.end;\\n104|  }\\n105|  if (merged.length > 1) {\\n106|    const first = merged[0] as SentenceSpan;\\n107|    if (wordCount(text.slice(first.start, first.end)) < 3) {\\n108|      const next = merged[1] as SentenceSpan;\\n109|      next.start = first.start;\\n110|      merged.shift();\\n111|    }\\n112|  }\\n113|  return merged;\\n114|}\\n115|\\n116|export function chapterChunks(paragraphs: { n: number; text: string }[]): {\\n117|  chunks: NarrationChunk[];\\n118|  gaps: number[];\\n119|} {\\n120|  const chunks: NarrationChunk[] = [];\\n121|  const paraOf: number[] = [];\\n122|  paragraphs.forEach((para, paraIndex) => {\\n123|    for (const span of splitSentences(para.text)) {\\n124|      chunks.push({ n: para.n, start: span.start, end: span.end, text: para.text.slice(span.start, span.end) });\\n125|      paraOf.push(paraIndex);\\n126|    }\\n127|  });\\n128|  const gaps = chunks.map((_, i) => {\\n129|    if (i === chunks.length - 1) return 0;\\n130|    return paraOf[i] !== paraOf[i + 1] ? PARAGRAPH_GAP_SEC : SENTENCE_GAP_SEC;\\n131|  });\\n132|  return { chunks, gaps };\\n133|}\\n134|\\n135|export function normalizeChunkText(text: string): string 