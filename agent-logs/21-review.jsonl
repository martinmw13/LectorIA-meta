{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c413","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":100,"recorded_at":1780531400000195,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182ca9e377334b6962e798769960b","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `server/images/orchestrate.ts`.\n1|import \"server-only\";\n2|import { randomUUID } from \"node:crypto\";\n3|import {\n4|  DAILY_SPEND_TTL_SEC,\n5|  MSG_FAILED,\n6|  MSG_QUOTA,\n7|  MSG_CREDITS_OUT,\n8|  LOCK_TTL_SEC,\n9|  buildCaption,\n10|  buildPrompt,\n11|  budgetExceeded,\n12|  dailySpendKey,\n13|  imageCostMicro,\n14|  imageKey,\n15|  indexKeyFor,\n16|  lockKeyFor,\n17|  spendKey,\n18|} from \"@/core/images\";\n19|import type { ImageGenerator, ImageRequest, ImageResponse, ImageStore, KV } from \"@/core/images\";\n20|import type { ImageEnv } from \"./env\";\n21|import { verifyHuman } from \"./human\";\n22|import { checkQuota, hashIp, quotaKeysFor, refundQuota } from \"./quota\";\n23|\n24|export interface ImageContent {\n25|  passageText: string;\n26|  sceneTitle: string;\n27|  sceneClip: string;\n28|}\n29|\n30|export interface OrchestrateDeps {\n31|  kv: KV;\n32|  store: ImageStore;\n33|  generate: ImageGenerator;\n34|  env: ImageEnv;\n35|  content: ImageContent;\n36|  ip: string;\n37|  anonId: string;\n38|  day: string;\n39|  token?: string;\n40|}\n41|\n42|// One pass, no skipped steps: hit -> lock -> human -> quota -> budget ->\n43|// generate -> store -> index -> release. Every failure after the reserve\n44|// refunds quota and budget and releases the lock.\n45|export async function orchestrate(\n46|  req: ImageRequest,\n47|  deps: OrchestrateDeps,\n48|): Promise<ImageResponse> {\n49|  const key = imageKey(req);\n50|  const indexKey = indexKeyFor(key);\n51|  const lockKey = lockKeyFor(key);\n52|  // deps.day is the UTC day string (YYYY-MM-DD), shared with quota keys.\n53|  const dailyKey = dailySpendKey(deps.day);\n54|\n55|  const indexed = await deps.kv.get(indexKey);\n56|  if (indexed) {\n57|    return { status: \"ready\", url: indexed, cached: true, caption: captionFor(req, deps.content) };\n58|  }\n59|  const existing = await deps.store.findUrl(key);\n60|  if (existing) {\n61|    await deps.kv.set(indexKey, existing);\n62|    return { status: \"ready\", url: existing, cached: true, caption: captionFor(req, deps.content) };\n63|  }\n64|\n65|  const token = deps.token ?? randomUUID();\n66|  if (!(await deps.kv.setNxEx(lockKey, token, LOCK_TTL_SEC))) return { status: \"pending\" };\n67|\n68|  // Best-effort unlock: a release failure must never turn into a client 500.\n69|  const release = async (): Promise<void> => {\n70|    try {\n71|      await deps.kv.releaseIfToken(lockKey, token);\n72|    } catch {\n73|      // Lock expires on its own; nothing to do.\n74|    }\n75|  };\n76|\n77|  const keys = quotaKeysFor({ day: deps.day, ip: deps.ip, salt: deps.env.ipSalt, anonId: deps.anonId });\n78|  let quotaTaken = false;\n79|  let spendTaken = false;\n80|  let dailySpendTaken = false;\n81|  // Best-effort refunds that clear their flag only after the write lands,\n82|  // so the outer catch refunds each reserve exactly once.\n83|  const refundQuotaOnce = async (): Promise<void> => {\n84|    try {\n85|      await refundQuota(deps.kv, keys);\n86|      quotaTaken = false;\n87|    } catch {\n88|      // Redis down: nothing reserved server-side to retry against.\n89|    }\n90|  };\n91|  const refundSpendOnce = async (): Promise<void> => {\n92|    try {\n93|      await deps.kv.decrBy(spendKey(), imageCostMicro());\n94|      spendTaken = false;\n95|    } catch {\n96|      // Redis down: nothing reserved server-side to retry against.\n97|    }\n98|  };\n99|  const refundDailySpendOnce = async (): Promise<void> => {\n100|    try {\n101|      await deps.kv.decrBy(dailyKey, imageCostMicro());\n102|      dailySpendTaken = false;\n103|    } catch {\n104|      // Redis down: nothing reserved server-side to retry against.\n105|    }\n106|  };\n107|\n108|  try {\n109|    if (!verifyHuman()) {\n110|      await release();\n111|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n112|    }\n113|\n114|    if (!(await checkQuota(deps.kv, keys)).ok) {\n115|      await release();\n116|      return { status: \"error\", code: \"quota\", message: MSG_QUOTA };\n117|    }\n118|    quotaTaken = true;\n119|\n120|    // Both caps apply only to requests paid with our key. The future\n121|    // BYOK path must skip these reserves and check its own key instead.\n122|    const total = await deps.kv.incrBy(spendKey(), imageCostMicro());\n123|    spendTaken = true;\n124|    if (budgetExceeded(total, deps.env.spendCapMicro)) {\n125|      await refundSpendOnce();\n126|      await refundQuotaOnce();\n127|      await release();\n128|      return { status: \"error\", code: \"budget\", message: MSG_CREDITS_OUT };\n129|    }\n130|\n131|    const dailyTotal = await deps.kv.incrBy(dailyKey, imageCostMicro());\n132|    dailySpendTaken = true;\n133|    // Refresh the expiry on every reserve: cheap, idempotent, and keeps\n134|    // the key alive through a busy day without a separate read.\n135|    await deps.kv.expire(dailyKey, DAILY_SPEND_TTL_SEC);\n136|    if (budgetExceeded(dailyTotal, deps.env.dailySpendCapMicro)) {\n137|      await refundDailySpendOnce();\n138|      await refundSpendOnce();\n139|      await refundQuotaOnce();\n140|      await release();\n141|      return { status: \"error\", code: \"daily_budget\", message: MSG_CREDITS_OUT };\n142|    }\n143|\n144|    let bytes: Uint8Array;\n145|    try {\n146|      bytes = await deps.generate.generate(\n147|        buildPrompt({\n148|          kind: req.kind,\n149|          passageText: deps.content.passageText,\n150|          sceneTitle: deps.content.sceneTitle,\n151|          sceneClip: deps.content.sceneClip,\n152|        }),\n153|      );\n154|    } catch {\n155|      await refundDailySpendOnce();\n156|      await refundSpendOnce();\n157|      await refundQuotaOnce();\n158|      await release();\n159|      console.error(\"image generate failed\");\n160|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n161|    }\n162|\n163|    try {\n164|      const url = await deps.store.save(key, bytes);\n165|      try {\n166|        await deps.kv.set(indexKey, url);\n167|      } catch {\n168|        console.error(\"image index failed\");\n169|        await release();\n170|        return { status: \"ready\", url, cached: false, caption: captionFor(req, deps.content) };\n171|      }\n172|      await release();\n173|      return { status: \"ready\", url, cached: false, caption: captionFor(req, deps.content) };\n174|    } catch {\n175|      // A lost save race leaves the winner's file behind; backfill from it.\n176|      const raced = await deps.store.findUrl(key);\n177|      if (raced) {\n178|        try {\n179|          await deps.kv.set(indexKey, raced);\n180|        } catch {\n181|          console.error(\"image index failed\");\n182|        }\n183|        await release();\n184|        return { status: \"ready\", url: raced, cached: true, caption: captionFor(req, deps.content) };\n185|      }\n186|      await refundDailySpendOnce();\n187|      await refundSpendOnce();\n188|      await refundQuotaOnce();\n189|      await release();\n190|      console.error(\"image store failed\");\n191|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n192|    }\n193|  } catch {\n194|    if (dailySpendTaken) await refundDailySpendOnce();\n195|    if (spendTaken) await refundSpendOnce();\n196|    if (quotaTaken) await refundQuotaOnce();\n197|    await release();\n198|    console.error(\"image request failed\");\n199|    return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n200|  }\n201|}\n202|\n203|function captionFor(req: ImageRequest, content: ImageContent): string {\n204|  return buildCaption({\n205|    kind: req.kind,\n206|    sceneTitle: content.sceneTitle,\n207|    passageText: content.passageText,\n208|  });\n209|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c415","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":101,"recorded_at":1780531400000197,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182ca9f6270a7956c8079501a4ac4","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `server/images/quota.ts`.\n1|import \"server-only\";\n2|import { createHmac } from \"node:crypto\";\n3|import { QUOTA_TTL_SEC, overQuota, quotaKeys } from \"@/core/images\";\n4|import type { KV } from \"@/core/images\";\n5|\n6|// Per-person quota: 5 new images per day, counted by hashed IP and by\n7|// anonymous cookie, whichever runs out first. Day keys are UTC dates.\n8|export function utcDay(now: Date = new Date()): string {\n9|  return now.toISOString().slice(0, 10);\n10|}\n11|\n12|export function hashIp(ip: string, salt: string): string {\n13|  return createHmac(\"sha256\", salt).update(ip).digest(\"hex\");\n14|}\n15|\n16|export function clientIp(forwardedFor: string | null | undefined): string {\n17|  return (forwardedFor ?? \"\").split(\",\")[0]?.trim() || \"unknown\";\n18|}\n19|\n20|export async function checkQuota(\n21|  kv: KV,\n22|  keys: { ip: string; anon: string },\n23|): Promise<{ ok: true } | { ok: false }> {\n24|  const ipCount = await kv.incr(keys.ip);\n25|  await kv.expire(keys.ip, QUOTA_TTL_SEC);\n26|  const anonCount = await kv.incr(keys.anon);\n27|  await kv.expire(keys.anon, QUOTA_TTL_SEC);\n28|  if (overQuota(ipCount) || overQuota(anonCount)) {\n29|    await kv.decr(keys.ip);\n30|    await kv.decr(keys.anon);\n31|    return { ok: false };\n32|  }\n33|  return { ok: true };\n34|}\n35|\n36|export async function refundQuota(kv: KV, keys: { ip: string; anon: string }): Promise<void> {\n37|  await kv.decr(keys.ip);\n38|  await kv.decr(keys.anon);\n39|}\n40|\n41|export function quotaKeysFor(args: { day: string; ip: string; salt: string; anonId: string }): {\n42|  ip: string;\n43|  anon: string;\n44|} {\n45|  return quotaKeys({ day: args.day, ipHash: hashIp(args.ip, args.salt), anonId: args.anonId });\n46|}\n47|\n48|// Free uploaded-book processing: one book per person for the whole\n49|// hackathon. Keys carry no day so the limit never resets; the TTL (~10\n50|// days) only bounds Redis growth. No route or wiring yet, just the hook.\n51|export const FREE_BOOKS_PER_PERSON = 1;\n52|export const BOOK_QUOTA_TTL_SEC = 10 * 24 * 3600;\n53|\n54|export function bookQuotaKeys(args: { ipHash: string; anonId: string }): {\n55|  ip: string;\n56|  anon: string;\n57|} {\n58|  return {\n59|    ip: `books:quota:ip:${args.ipHash}`,\n60|    anon: `books:quota:anon:${args.anonId}`,\n61|  };\n62|}\n63|\n64|export function bookQuotaKeysFor(args: { ip: string; salt: string; anonId: string }): {\n65|  ip: string;\n66|  anon: string;\n67|} {\n68|  return bookQuotaKeys({ ipHash: hashIp(args.ip, args.salt), anonId: args.anonId });\n69|}\n70|\n71|export async function checkBookQuota(\n72|  kv: KV,\n73|  keys: { ip: string; anon: string },\n74|): Promise<{ ok: true } | { ok: false }> {\n75|  const ipCount = await kv.incr(keys.ip);\n76|  await kv.expire(keys.ip, BOOK_QUOTA_TTL_SEC);\n77|  const anonCount = await kv.incr(keys.anon);\n78|  await kv.expire(keys.anon, BOOK_QUOTA_TTL_SEC);\n79|  if (ipCount > FREE_BOOKS_PER_PERSON || anonCount > FREE_BOOKS_PER_PERSON) {\n80|    await kv.decr(keys.ip);\n81|    await kv.decr(keys.anon);\n82|    return { ok: false };\n83|  }\n84|  return { ok: true };\n85|}\n86|\n87|export async function refundBookQuota(kv: KV, keys: { ip: string; anon: string }): Promise<void> {\n88|  await kv.decr(keys.ip);\n89|  await kv.decr(keys.anon);\n90|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c417","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":102,"recorded_at":1780531400000199,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182caa091706da1c19dae69c06d20","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `server/images/env.ts`.\n1|import \"server-only\";\n2|\n3|// Reads image env once per request. Any missing key means unavailable:\n4|// with no quotas or budget configured, the route must never spend.\n5|export interface ImageEnv {\n6|  upstashUrl: string;\n7|  upstashToken: string;\n8|  metaKey: string;\n9|  sessionSecret: string;\n10|  ipSalt: string;\n11|  spendCapMicro: number;\n12|  dailySpendCapMicro: number;\n13|}\n14|\n15|// Vercel's Upstash marketplace integration injects KV_REST_API_* names.\n16|// UPSTASH_* wins when non-empty, else the KV_* fallback applies per value.\n17|// The read-only token is never used (we write).\n18|const URL_NAMES = \"UPSTASH_REDIS_REST_URL|KV_REST_API_URL\";\n19|const TOKEN_NAMES = \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\";\n20|\n21|const REQUIRED = [\n22|  \"BLOB_READ_WRITE_TOKEN\",\n23|  \"META_API_KEY\",\n24|  \"SESSION_SECRET\",\n25|  \"IP_HASH_SALT\",\n26|] as const;\n27|\n28|export function readImageEnv(from: NodeJS.ProcessEnv = process.env): ImageEnv {\n29|  const upstashUrl = from.UPSTASH_REDIS_REST_URL || from.KV_REST_API_URL;\n30|  const upstashToken = from.UPSTASH_REDIS_REST_TOKEN || from.KV_REST_API_TOKEN;\n31|  const missing = [\n32|    upstashUrl ? null : URL_NAMES,\n33|    upstashToken ? null : TOKEN_NAMES,\n34|    ...REQUIRED.filter((k) => !from[k]),\n35|  ].filter((m): m is string => m !== null);\n36|  if (missing.length > 0) throw new Error(`missing image env: ${missing.join(\",\")}`);\n37|  const capUsd = Number(from.SPEND_CAP_USD ?? \"10\");\n38|  const dailyCapUsd = Number(from.DAILY_SPEND_CAP_USD ?? \"2\");\n39|  return {\n40|    upstashUrl: upstashUrl as string,\n41|    upstashToken: upstashToken as string,\n42|    metaKey: from.META_API_KEY as string,\n43|    sessionSecret: from.SESSION_SECRET as string,\n44|    ipSalt: from.IP_HASH_SALT as string,\n45|    spendCapMicro: Math.round((Number.isFinite(capUsd) ? capUsd : 10) * 1_000_000),\n46|    dailySpendCapMicro: Math.round(\n47|      (Number.isFinite(dailyCapUsd) && dailyCapUsd >= 0 ? dailyCapUsd : 2) * 1_000_000,\n48|    ),\n49|  };\n50|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c419","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":103,"recorded_at":1780531400000201,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182caa1c675fcada375754b193428","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `core/images.ts`.\n1|// Pure image logic: validation, cache keys, prompts, quota and budget\n2|// helpers. No env reads, no network, no secrets. Server modules inject\n3|// the KV, store, and generator clients defined here.\n4|import { IMAGE_COST_MICRO, PROMPT_VERSION } from \"./types\";\n5|import type { ImageKind, ImageRequest } from \"./types\";\n6|\n7|export type { ImageErrorCode, ImageKind, ImageRequest, ImageResponse } from \"./types\";\n8|\n9|export const DAILY_IMAGE_LIMIT = 5;\n10|export const QUOTA_TTL_SEC = 48 * 3600;\n11|export const LOCK_TTL_SEC = 150;\n12|export const MAX_PASSAGE_CHARS = 600;\n13|export const MAX_SCENE_CLIP_CHARS = 1200;\n14|\n15|export const MSG_BAD_REQUEST = \"That request was not valid. Try again.\";\n16|export const MSG_QUOTA = \"You reached your limit of 5 images per day. Come back tomorrow.\";\n17|export const MSG_CREDITS_OUT =\n18|  \"So many people loved this that we've run out of credits to share. \" +\n19|  \"Feel free to bring your own key! Meanwhile, The Wonderful Wizard of Oz \" +\n20|  \"is ready to read, with its soundtrack and illustrations.\";\n21|export const CREDITS_OUT_LIBRARY_HREF = \"/\";\n22|export const MSG_UNAVAILABLE = \"Images are unavailable right now.\";\n23|export const MSG_FAILED = \"Could not generate the image. Try again.\";\n24|export const MSG_RETRY = \"The image is taking longer than expected. Try again.\";\n25|\n26|export class ImageValidationError extends Error {\n27|  constructor() {\n28|    super(\"invalid image request\");\n29|    this.name = \"ImageValidationError\";\n30|  }\n31|}\n32|\n33|// Minimal store surface the route needs; Upstash REST and Blob clients\n34|// implement these in server/, tests use the memory fake below.\n35|export interface KV {\n36|  get(key: string): Promise<string | null>;\n37|  setNxEx(key: string, value: string, exSec: number): Promise<boolean>;\n38|  set(key: string, value: string): Promise<void>;\n39|  incr(key: string): Promise<number>;\n40|  incrBy(key: string, by: number): Promise<number>;\n41|  decr(key: string): Promise<number>;\n42|  decrBy(key: string, by: number): Promise<number>;\n43|  expire(key: string, sec: number): Promise<void>;\n44|  releaseIfToken(key: string, token: string): Promise<boolean>;\n45|}\n46|\n47|export interface ImageStore {\n48|  findUrl(path: string): Promise<string | null>;\n49|  save(path: string, bytes: Uint8Array): Promise<string>;\n50|}\n51|\n52|export interface ImageGenerator {\n53|  generate(prompt: string): Promise<Uint8Array>;\n54|}\n55|\n56|function isRecord(json: unknown): json is Record<string, unknown> {\n57|  return typeof json === \"object\" && json !== null && !Array.isArray(json);\n58|}\n59|\n60|// Strict parse at the trust boundary: exact fields only, so a client\n61|// bug cannot silently spend budget on a misread request.\n62|export function parseImageRequest(json: unknown): ImageRequest {\n63|  if (!isRecord(json)) throw new ImageValidationError();\n64|  const { kind } = json;\n65|  if (kind === \"passage\") {\n66|    const keys = Object.keys(json).sort().join(\",\");\n67|    if (keys !== \"bookId,kind,n,textVersion\") throw new ImageValidationError();\n68|    if (typeof json.bookId !== \"string\" || json.bookId.length === 0) throw new ImageValidationError();\n69|    if (typeof json.textVersion !== \"string\" || json.textVersion.length === 0) {\n70|      throw new ImageValidationError();\n71|    }\n72|    if (typeof json.n !== \"number\" || !Number.isInteger(json.n)) throw new ImageValidationError();\n73|    return { kind: \"passage\", bookId: json.bookId, textVersion: json.textVersion, n: json.n };\n74|  }\n75|  if (kind === \"scene\") {\n76|    const keys = Object.keys(json).sort().join(\",\");\n77|    if (keys !== \"bookId,kind,sceneId,textVersion\") throw new ImageValidationError();\n78|    if (typeof json.bookId !== \"string\" || json.bookId.length === 0) throw new ImageValidationError();\n79|    if (typeof json.textVersion !== \"string\" || json.textVersion.length === 0) {\n80|      throw new ImageValidationError();\n81|    }\n82|    if (typeof json.sceneId !== \"string\" || json.sceneId.length === 0) throw new ImageValidationError();\n83|    return { kind: \"scene\", bookId: json.bookId, textVersion: json.textVersion, sceneId: json.sceneId };\n84|  }\n85|  throw new ImageValidationError();\n86|}\n87|\n88|export interface BookRef {\n89|  id: string;\n90|  textVersion: string;\n91|  paragraphNs: Set<number>;\n92|  sceneIds: Set<string>;\n93|}\n94|\n95|// Checks the parsed request against the frozen book text.\n96|export function validateAgainstBook(req: ImageRequest, book: BookRef): void {\n97|  if (req.bookId !== book.id) throw new ImageValidationError();\n98|  if (req.textVersion !== book.textVersion) throw new ImageValidationError();\n99|  if (req.kind === \"passage\") {\n100|    if (!book.paragraphNs.has(req.n)) throw new ImageValidationError();\n101|    return;\n102|  }\n103|  if (!book.sceneIds.has(req.sceneId)) throw new ImageValidationError();\n104|}\n105|\n106|// One paragraph maps to one image; one scene maps to one image.\n107|export function imageKey(req: ImageRequest): string {\n108|  const base = `images/${req.bookId}/${req.textVersion}/${PROMPT_VERSION}`;\n109|  return req.kind === \"passage\" ? `${base}/p${req.n}.webp` : `${base}/scene-${req.sceneId}.webp`;\n110|}\n111|\n112|export function indexKeyFor(key: string): string {\n113|  return `img:index:${key}`;\n114|}\n115|\n116|export function lockKeyFor(key: string): string {\n117|  return `img:lock:${key}`;\n118|}\n119|\n120|export function quotaKeys(args: { day: string; ipHash: string; anonId: string }): {\n121|  ip: string;\n122|  anon: string;\n123|} {\n124|  return {\n125|    ip: `img:quota:ip:${args.day}:${args.ipHash}`,\n126|    anon: `img:quota:anon:${args.day}:${args.anonId}`,\n127|  };\n128|}\n129|\n130|export function spendKey(): string {\n131|  return \"img:spend:micro\";\n132|}\n133|\n134|// Daily spend counter for our key. The day is the UTC day string\n135|// YYYY-MM-DD the caller already uses for quota keys, so the daily\n136|// cap resets on UTC rollover together with per-person quota.\n137|export const DAILY_SPEND_TTL_SEC = 48 * 3600;\n138|\n139|export function dailySpendKey(day: string): string {\n140|  return `img:spend:daily:${day}`;\n141|}\n142|\n143|export function overQuota(count: number): boolean {\n144|  return count > DAILY_IMAGE_LIMIT;\n145|}\n146|\n147|export function budgetExceeded(totalAfterReserve: number, capMicro: number): boolean {\n148|  return totalAfterReserve > capMicro;\n149|}\n150|\n151|export function imageCostMicro(): number {\n152|  return IMAGE_COST_MICRO;\n153|}\n154|\n155|// Lets the route compare lock tokens without touching Redis twice.\n156|export function canRelease(expected: string, actual: string | null): boolean {\n157|  return actual !== null && actual === expected;\n158|}\n159|\n160|function clip(text: string, max: number): string {\n161|  const clean = text.replace(/\\s+/g, \" \").trim();\n162|  if (clean.length <= max) return clean;\n163|  return clean.slice(0, max).trimEnd();\n164|}\n165|\n166|// Prompt from trusted server-side book text only. The client sends\n167|// ordinals and ids, never free text, so there is no injection path.\n168|export function buildPrompt(args: {\n169|  kind: ImageKind;\n170|  passageText: string;\n171|  sceneTitle: string;\n172|  sceneClip: string;\n173|}): string {\n174|  const style =\n175|    \"Illustration in the style of W. W. Denslow's 1900 first-edition \" +\n176|    \"illustrations for The Wonderful Wizard of Oz: flat color, bold black \" +\n177|    \"ink outlines, limited palette. Dorothy wears silver shoes. Nothing \" +\n178|    \"from the 1939 MGM film, no ruby slippers, no film look. No text, \" +\n179|    \"no captions, no lettering in the image.\";\n180|  if (args.kind === \"scene\") {\n181|    return (\n182|      `Scene \"${args.sceneTitle}\". ${clip(args.sceneClip, MAX_SCENE_CLIP_CHARS)}. ${style}`\n183|    );\n184|  }\n185|  return (\n186|    `Scene \"${args.sceneTitle}\". Passage: ${clip(args.passageText, MAX_PASSAGE_CHARS)}. ` +\n187|    `Context: ${clip(args.sceneClip, MAX_SCENE_CLIP_CHARS)}. ${style}`\n188|  );\n189|}\n190|\n191|export function buildCaption(args: {\n192|  kind: ImageKind;\n193|  sceneTitle: string;\n194|  passageText: string;\n195|}): string {\n196|  if (args.kind === \"scene\") return args.sceneTitle;\n197|  const words = args.passageText.replace(/\\s+/g, \" \").trim().split(\" \").slice(0, 10);\n198|  const head = words.join(\" \");\n199|  return words.length >= 10 ? `${head}…` : head;\n200|}\n201|\n202|// In-memory KV for tests. Expiries are checked against Date.now.\n203|export function createMemoryKV(): KV & { clear(): void } {\n204|  const values = new Map<string, string>();\n205|  const expiresAt = new Map<string, number>();\n206|  function live(key: string): boolean {\n207|    const until = expiresAt.get(key);\n208|    if (until !== undefined && Date.now() >= until) {\n209|      values.delete(key);\n210|      expiresAt.delete(key);\n211|      return false;\n212|    }\n213|    return true;\n214|  }\n215|  function num(key: string): number {\n216|    return Number(values.get(key) ?? \"0\");\n217|  }\n218|  return {\n219|    async get(key: string): Promise<string | null> {\n220|      if (!live(key)) return null;\n221|      return values.get(key) ?? null;\n222|    },\n223|    async setNxEx(key: string, value: string, exSec: number): Promise<boolean> {\n224|      if (live(key) && values.has(key)) return false;\n225|      values.set(key, value);\n226|      expiresAt.set(key, Date.now() + exSec * 1000);\n227|      return true;\n228|    },\n229|    async set(key: string, value: string): Promise<void> {\n230|      values.set(key, value);\n231|      expiresAt.delete(key);\n232|    },\n233|    async incr(key: string): Promise<number> {\n234|      const next = num(key) + 1;\n235|      values.set(key, String(next));\n236|      return next;\n237|    },\n238|    async incrBy(key: string, by: number): Promise<number> {\n239|      const next = num(key) + by;\n240|      values.set(key, String(next));\n241|      return next;\n242|    },\n243|    async decr(key: string): Promise<number> {\n244|      const next = num(key) - 1;\n245|      values.set(key, String(next));\n246|      return next;\n247|    },\n248|    async decrBy(key: string, by: number): Promise<number> {\n249|      const next = num(key) - by;\n250|      values.set(key, String(next));\n251|      return next;\n252|    },\n253|    async expire(key: string, sec: number): Promise<void> {\n254|      if (values.has(key)) expiresAt.set(key, Date.now() + sec * 1000);\n255|    },\n256|    async releaseIfToken(key: string, token: string): Promise<boolean> {\n257|      if (!live(key)) return false;\n258|      if (values.get(key) !== token) return false;\n259|      values.delete(key);\n260|      expiresAt.delete(key);\n261|      return true;\n262|    },\n263|    clear(): void {\n264|      values.clear();\n265|      expiresAt.clear();\n266|    },\n267|  };\n268|}"}}
