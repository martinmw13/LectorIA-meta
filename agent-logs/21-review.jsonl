{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c407","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":94,"recorded_at":1780531400000183,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","event":{"chunk":"Read text file `server/images/quota.ts`.\n1|import \"server-only\";\n2|import { createHmac } from \"node:crypto\";\n3|import { QUOTA_TTL_SEC, overQuota, quotaKeys } from \"@/core/images\";\n4|import type { KV } from \"@/core/images\";\n5|\n6|// Per-person quota: 5 new images per day, counted by hashed IP and by\n7|// anonymous cookie, whichever runs out first. Day keys are UTC dates.\n8|export function utcDay(now: Date = new Date()): string {\n9|  return now.toISOString().slice(0, 10);\n10|}\n11|\n12|export function hashIp(ip: string, salt: string): string {\n13|  return createHmac(\"sha256\", salt).update(ip).digest(\"hex\");\n14|}\n15|\n16|export function clientIp(forwardedFor: string | null | undefined): string {\n17|  return (forwardedFor ?? \"\").split(\",\")[0]?.trim() || \"unknown\";\n18|}\n19|\n20|export async function checkQuota(\n21|  kv: KV,\n22|  keys: { ip: string; anon: string },\n23|): Promise<{ ok: true } | { ok: false }> {\n24|  const ipCount = await kv.incr(keys.ip);\n25|  await kv.expire(keys.ip, QUOTA_TTL_SEC);\n26|  const anonCount = await kv.incr(keys.anon);\n27|  await kv.expire(keys.anon, QUOTA_TTL_SEC);\n28|  if (overQuota(ipCount) || overQuota(anonCount)) {\n29|    await kv.decr(keys.ip);\n30|    await kv.decr(keys.anon);\n31|    return { ok: false };\n32|  }\n33|  return { ok: true };\n34|}\n35|\n36|export async function refundQuota(kv: KV, keys: { ip: string; anon: string }): Promise<void> {\n37|  await kv.decr(keys.ip);\n38|  await kv.decr(keys.anon);\n39|}\n40|\n41|export function quotaKeysFor(args: { day: string; ip: string; salt: string; anonId: string }): {\n42|  ip: string;\n43|  anon: string;\n44|} {\n45|  return quotaKeys({ day: args.day, ipHash: hashIp(args.ip, args.salt), anonId: args.anonId });\n46|}\n47|\n48|// Free uploaded-book processing: one book per person for the whole\n49|// hackathon. Keys carry no day so the limit never resets; the TTL (~10\n50|// days) only bounds Redis growth. No route or wiring yet, just the hook.\n51|export const FREE_BOOKS_PER_PERSON = 1;\n52|export const BOOK_QUOTA_TTL_SEC = 10 * 24 * 3600;\n53|\n54|export function bookQuotaKeys(args: { ipHash: string; anonId: string }): {\n55|  ip: string;\n56|  anon: string;\n57|} {\n58|  return {\n59|    ip: `books:quota:ip:${args.ipHash}`,\n60|    anon: `books:quota:anon:${args.anonId}`,\n61|  };\n62|}\n63|\n64|export function bookQuotaKeysFor(args: { ip: string; salt: string; anonId: string }): {\n65|  ip: string;\n66|  anon: string;\n67|} {\n68|  return bookQuotaKeys({ ipHash: hashIp(args.ip, args.salt), anonId: args.anonId });\n69|}\n70|\n71|export async function checkBookQuota(\n72|  kv: KV,\n73|  keys: { ip: string; anon: string },\n74|): Promise<{ ok: true } | { ok: false }> {\n75|  const ipCount = await kv.incr(keys.ip);\n76|  await kv.expire(keys.ip, BOOK_QUOTA_TTL_SEC);\n77|  const anonCount = await kv.incr(keys.anon);\n78|  await kv.expire(keys.anon, BOOK_QUOTA_TTL_SEC);\n79|  if (ipCount > FREE_BOOKS_PER_PERSON || anonCount > FREE_BOOKS_PER_PERSON) {\n80|    await kv.decr(keys.ip);\n81|    await kv.decr(keys.anon);\n82|    return { ok: false };\n83|  }\n84|  return { ok: true };\n85|}\n86|\n87|export async function refundBookQuota(kv: KV, keys: { ip: string; anon: string }): Promise<void> {\n88|  await kv.decr(keys.ip);\n89|  await kv.decr(keys.anon);\n90|}","final_result":true,"kind":"output","task_id":"01a182ca-a392-7600-aede-753daefc6ff2"},"kind":"task_lifecycle","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"task_id":"01a182ca-a392-7600-aede-753daefc6ff2","task_stream":{"id":"01a182ca-a392-7600-aede-753daefc6ff2","kind":"task"}}}
