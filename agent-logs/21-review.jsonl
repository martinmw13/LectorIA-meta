{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3b5","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":53,"recorded_at":1780531400000101,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","event":{"chunk":"{\n  \"chunk_id\": \"exec-2-1\",\n  \"command\": \"git diff origin/main...HEAD\",\n  \"description\": \"Show full diff for review\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"diff --git a/core/images.test.ts b/core/images.test.ts\\nindex a74b8c8..8d2903b 100644\\n--- a/core/images.test.ts\\n+++ b/core/images.test.ts\\n@@ -1,10 +1,12 @@\\n import { describe, expect, it } from \\\"vitest\\\";\\n import {\\n+  DAILY_SPEND_TTL_SEC,\\n   budgetExceeded,\\n   buildCaption,\\n   buildPrompt,\\n   canRelease,\\n   createMemoryKV,\\n+  dailySpendKey,\\n   imageCostMicro,\\n   imageKey,\\n   indexKeyFor,\\n@@ -12,6 +14,7 @@ import {\\n   overQuota,\\n   parseImageRequest,\\n   quotaKeys,\\n+  spendKey,\\n   validateAgainstBook,\\n } from \\\"./images\\\";\\n import { IMAGE_COST_MICRO } from \\\"./types\\\";\\n@@ -178,6 +181,13 @@ describe(\\\"quota and budget helpers\\\", () => {\\n     expect(imageCostMicro()).toBe(IMAGE_COST_MICRO);\\n   });\\n \\n+  it(\\\"builds day-scoped daily spend keys with a 48 h TTL\\\", () => {\\n+    expect(dailySpendKey(\\\"2026-10-27\\\")).toBe(\\\"img:spend:daily:2026-10-27\\\");\\n+    expect(dailySpendKey(\\\"2026-10-28\\\")).not.toBe(dailySpendKey(\\\"2026-10-27\\\"));\\n+    expect(dailySpendKey(\\\"2026-10-28\\\")).not.toBe(spendKey());\\n+    expect(DAILY_SPEND_TTL_SEC).toBe(172800);\\n+  });\\n+\\n   it(\\\"compares lock tokens\\\", () => {\\n     expect(canRelease(\\\"t\\\", \\\"t\\\")).toBe(true);\\n     expect(canRelease(\\\"t\\\", \\\"other\\\")).toBe(false);\\ndiff --git a/core/images.ts b/core/images.ts\\nindex 9c90dd5..5ad2e89 100644\\n--- a/core/images.ts\\n+++ b/core/images.ts\\n@@ -14,7 +14,11 @@ export const MAX_SCENE_CLIP_CHARS = 1200;\\n \\n export const MSG_BAD_REQUEST = \\\"That request was not valid. Try again.\\\";\\n export const MSG_QUOTA = \\\"You reached your limit of 5 images per day. Come back tomorrow.\\\";\\n-export const MSG_BUDGET = \\\"The generation limit was reached. Try again later.\\\";\\n+export const MSG_CREDITS_OUT =\\n+  \\\"So many people loved this that we've run out of credits to share. \\\" +\\n+  \\\"Feel free to bring your own key! Meanwhile, The Wonderful Wizard of Oz \\\" +\\n+  \\\"is ready to read, with its soundtrack and illustrations.\\\";\\n+export const CREDITS_OUT_LIBRARY_HREF = \\\"/\\\";\\n export const MSG_UNAVAILABLE = \\\"Images are unavailable right now.\\\";\\n export const MSG_FAILED = \\\"Could not generate the image. Try again.\\\";\\n export const MSG_RETRY = \\\"The image is taking longer than expected. Try again.\\\";\\n@@ -127,6 +131,15 @@ export function spendKey(): string {\\n   return \\\"img:spend:micro\\\";\\n }\\n \\n+// Daily spend counter for our key. The day is the UTC day string\\n+// YYYY-MM-DD the caller already uses for quota keys, so the daily\\n+// cap resets on UTC rollover together with per-person quota.\\n+export const DAILY_SPEND_TTL_SEC = 48 * 3600;\\n+\\n+export function dailySpendKey(day: string): string {\\n+  return `img:spend:daily:${day}`;\\n+}\\n+\\n export function overQuota(count: number): boolean {\\n   return count > DAILY_IMAGE_LIMIT;\\n }\\ndiff --git a/core/types.ts b/core/types.ts\\nindex b5a7440..42cffb9 100644\\n--- a/core/types.ts\\n+++ b/core/types.ts\\n@@ -108,7 +108,7 @@ export interface SceneRequest {\\n \\n export type ImageRequest = PassageRequest | SceneRequest;\\n \\n-export type ImageErrorCode = \\\"quota\\\" | \\\"budget\\\" | \\\"unavailable\\\" | \\\"bad_request\\\";\\n+export type ImageErrorCode = \\\"quota\\\" | \\\"budget\\\" | \\\"daily_budget\\\" | \\\"unavailable\\\" | \\\"bad_request\\\";\\n \\n export type ImageResponse =\\n   | { status: \\\"ready\\\"; url: string; cached: boolean; caption: string }\\ndiff --git a/docs/contracts.md b/docs/contracts.md\\nindex 2c4bb6d..4e0babd 100644\\n--- a/docs/contracts.md\\n+++ b/docs/contracts.md\\n@@ -300,24 +300,33 @@ scene\\\" uses the scene id from the route.\\n \\n Responses (typed in `core/types.ts`): `{ status: \\\"ready\\\", url, cached,\\n caption }` with a Vercel Blob URL, never bytes; `{ status: \\\"pending\\\" }`\\n-when another request holds the lock, in which case the client reposts\\n-every 3 s up to about 2 minutes; `{ status: \\\"error\\\", code, message }`\\n-where code is `quota`, `budget`, `unavailable`, or `bad_request` with a\\n-friendly English message. Caption is the scene title for scenes and the\\n-first words of the paragraph for passages, built server-side.\\n+when another request holds the lock, so the client reposts\\n+every 3 s up to ~2 minutes; `{ status: \\\"error\\\", code, message }`\\n+where code is `quota`, `budget`, `daily_budget`, `unavailable`, or\\n+`bad_request` with a friendly English message. Both `budget` and\\n+`daily_budget` answer `MSG_CREDITS_OUT` (`core/images.ts`): the free\\n+credits ran out, bring your own key, and meanwhile the Oz reader is\\n+ready with its soundtrack and illustrations. It never says \\\"come back\\n+tomorrow\\\". The UI links the Oz sentence via `CREDITS_OUT_LIBRARY_HREF`\\n+(`\\\"/\\\"`). Caption is the scene title, or the paragraph's first words,\\n+built server-side.\\n \\n The passage cache key is book plus start paragraph plus `textVersion`\\n-plus `PROMPT_VERSION` (`v1`); the scene key is book plus scene id plus\\n-the same versions. Both map to a deterministic Blob path\\n-(`addRandomSuffix: false`, `allowOverwrite: false`). An Upstash Redis\\n-index maps key to Blob URL, so hits are one GET; on an index miss the\\n-server lists by exact path prefix (head equivalent) before generating\\n-and backfills the index.\\n-A Redis lock per key returns `pending` to concurrent requests. Quota is\\n-5 new images per person per day by hashed IP and signed cookie,\\n-whichever runs out first; a shared spend counter in integer\\n-micro-dollars sits under `SPEND_CAP_USD` (default 10). Failures refund\\n-quota and budget and release the lock.\\n+plus `PROMPT_VERSION` (`v1`); the scene key swaps in the scene id.\\n+Both map to a deterministic Blob path (`addRandomSuffix: false`,\\n+`allowOverwrite: false`). An Upstash Redis index maps key to Blob URL,\\n+so hits are one GET; on an index miss the server lists by path prefix\\n+before generating and backfills the index.\\n+Quota is 5 new images per person per day by hashed IP and signed\\n+cookie, whichever runs out first; a shared spend counter in integer\\n+micro-dollars sits under `SPEND_CAP_USD` (default 10), plus a daily\\n+counter per UTC day under `DAILY_SPEND_CAP_USD` (default 2, 48 h key\\n+TTL). Failures refund quota and both counters and release the lock.\\n+Both caps apply only to requests paid with our key; a future\\n+bring-your-own-key path skips them. Free uploads allow one book per\\n+person (`FREE_BOOKS_PER_PERSON` = 1, hashed IP plus anon cookie, no\\n+day, ~10-day TTL; `checkBookQuota`/`refundBookQuota` in\\n+`server/images/quota.ts`, no route yet).\\n \\n ## Chat api\\n \\ndiff --git a/server/images/env.test.ts b/server/images/env.test.ts\\nindex c87d324..03382bc 100644\\n--- a/server/images/env.test.ts\\n+++ b/server/images/env.test.ts\\n@@ -77,6 +77,30 @@ describe(\\\"readImageEnv redis fallback\\\", () => {\\n     );\\n   });\\n \\n+  it(\\\"defaults the daily spend cap to 2 USD\\\", () => {\\n+    delete process.env.DAILY_SPEND_CAP_USD;\\n+    process.env.UPSTASH_REDIS_REST_URL = \\\"https://upstash-url\\\";\\n+    process.env.UPSTASH_REDIS_REST_TOKEN = \\\"upstash-token\\\";\\n+    expect(readImageEnv().dailySpendCapMicro).toBe(2_000_000);\\n+  });\\n+\\n+  it(\\\"honors a