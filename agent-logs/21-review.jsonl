{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40f","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":98,"recorded_at":1780531400000191,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","event":{"chunk":"Read text file `core/images.ts`.\n1|// Pure image logic: validation, cache keys, prompts, quota and budget\n2|// helpers. No env reads, no network, no secrets. Server modules inject\n3|// the KV, store, and generator clients defined here.\n4|import { IMAGE_COST_MICRO, PROMPT_VERSION } from \"./types\";\n5|import type { ImageKind, ImageRequest } from \"./types\";\n6|\n7|export type { ImageErrorCode, ImageKind, ImageRequest, ImageResponse } from \"./types\";\n8|\n9|export const DAILY_IMAGE_LIMIT = 5;\n10|export const QUOTA_TTL_SEC = 48 * 3600;\n11|export const LOCK_TTL_SEC = 150;\n12|export const MAX_PASSAGE_CHARS = 600;\n13|export const MAX_SCENE_CLIP_CHARS = 1200;\n14|\n15|export const MSG_BAD_REQUEST = \"That request was not valid. Try again.\";\n16|export const MSG_QUOTA = \"You reached your limit of 5 images per day. Come back tomorrow.\";\n17|export const MSG_CREDITS_OUT =\n18|  \"So many people loved this that we've run out of credits to share. \" +\n19|  \"Feel free to bring your own key! Meanwhile, The Wonderful Wizard of Oz \" +\n20|  \"is ready to read, with its soundtrack and illustrations.\";\n21|export const CREDITS_OUT_LIBRARY_HREF = \"/\";\n22|export const MSG_UNAVAILABLE = \"Images are unavailable right now.\";\n23|export const MSG_FAILED = \"Could not generate the image. Try again.\";\n24|export const MSG_RETRY = \"The image is taking longer than expected. Try again.\";\n25|\n26|export class ImageValidationError extends Error {\n27|  constructor() {\n28|    super(\"invalid image request\");\n29|    this.name = \"ImageValidationError\";\n30|  }\n31|}\n32|\n33|// Minimal store surface the route needs; Upstash REST and Blob clients\n34|// implement these in server/, tests use the memory fake below.\n35|export interface KV {\n36|  get(key: string): Promise<string | null>;\n37|  setNxEx(key: string, value: string, exSec: number): Promise<boolean>;\n38|  set(key: string, value: string): Promise<void>;\n39|  incr(key: string): Promise<number>;\n40|  incrBy(key: string, by: number): Promise<number>;\n41|  decr(key: string): Promise<number>;\n42|  decrBy(key: string, by: number): Promise<number>;\n43|  expire(key: string, sec: number): Promise<void>;\n44|  releaseIfToken(key: string, token: string): Promise<boolean>;\n45|}\n46|\n47|export interface ImageStore {\n48|  findUrl(path: string): Promise<string | null>;\n49|  save(path: string, bytes: Uint8Array): Promise<string>;\n50|}\n51|\n52|export interface ImageGenerator {\n53|  generate(prompt: string): Promise<Uint8Array>;\n54|}\n55|\n56|function isRecord(json: unknown): json is Record<string, unknown> {\n57|  return typeof json === \"object\" && json !== null && !Array.isArray(json);\n58|}\n59|\n60|// Strict parse at the trust boundary: exact fields only, so a client\n61|// bug cannot silently spend budget on a misread request.\n62|export function parseImageRequest(json: unknown): ImageRequest {\n63|  if (!isRecord(json)) throw new ImageValidationError();\n64|  const { kind } = json;\n65|  if (kind === \"passage\") {\n66|    const keys = Object.keys(json).sort().join(\",\");\n67|    if (keys !== \"bookId,kind,n,textVersion\") throw new ImageValidationError();\n68|    if (typeof json.bookId !== \"string\" || json.bookId.length === 0) throw new ImageValidationError();\n69|    if (typeof json.textVersion !== \"string\" || json.textVersion.length === 0) {\n70|      throw new ImageValidationError();\n71|    }\n72|    if (typeof json.n !== \"number\" || !Number.isInteger(json.n)) throw new ImageValidationError();\n73|    return { kind: \"passage\", bookId: json.bookId, textVersion: json.textVersion, n: json.n };\n74|  }\n75|  if (kind === \"scene\") {\n76|    const keys = Object.keys(json).sort().join(\",\");\n77|    if (keys !== \"bookId,kind,sceneId,textVersion\") throw new ImageValidationError();\n78|    if (typeof json.bookId !== \"string\" || json.bookId.length === 0) throw new ImageValidationError();\n79|    if (typeof json.textVersion !== \"string\" || json.textVersion.length === 0) {\n80|      throw new ImageValidationError();\n81|    }\n82|    if (typeof json.sceneId !== \"string\" || json.sceneId.length === 0) throw new ImageValidationError();\n83|    return { kind: \"scene\", bookId: json.bookId, textVersion: json.textVersion, sceneId: json.sceneId };\n84|  }\n85|  throw new ImageValidationError();\n86|}\n87|\n88|export interface BookRef {\n89|  id: string;\n90|  textVersion: string;\n91|  paragraphNs: Set<number>;\n92|  sceneIds: Set<string>;\n93|}\n94|\n95|// Checks the parsed request against the frozen book text.\n96|export function validateAgainstBook(req: ImageRequest, book: BookRef): void {\n97|  if (req.bookId !== book.id) throw new ImageValidationError();\n98|  if (req.textVersion !== book.textVersion) throw new ImageValidationError();\n99|  if (req.kind === \"passage\") {\n100|    if (!book.paragraphNs.has(req.n)) throw new ImageValidationError();\n101|    return;\n102|  }\n103|  if (!book.sceneIds.has(req.sceneId)) throw new ImageValidationError();\n104|}\n105|\n106|// One paragraph maps to one image; one scene maps to one image.\n107|export function imageKey(req: ImageRequest): string {\n108|  const base = `images/${req.bookId}/${req.textVersion}/${PROMPT_VERSION}`;\n109|  return req.kind === \"passage\" ? `${base}/p${req.n}.webp` : `${base}/scene-${req.sceneId}.webp`;\n110|}\n111|\n112|export function indexKeyFor(key: string): string {\n113|  return `img:index:${key}`;\n114|}\n115|\n116|export function lockKeyFor(key: string): string {\n117|  return `img:lock:${key}`;\n118|}\n119|\n120|export function quotaKeys(args: { day: string; ipHash: string; anonId: string }): {\n121|  ip: string;\n122|  anon: string;\n123|} {\n124|  return {\n125|    ip: `img:quota:ip:${args.day}:${args.ipHash}`,\n126|    anon: `img:quota:anon:${args.day}:${args.anonId}`,\n127|  };\n128|}\n129|\n130|export function spendKey(): string {\n131|  return \"img:spend:micro\";\n132|}\n133|\n134|// Daily spend counter for our key. The day is the UTC day string\n135|// YYYY-MM-DD the caller already uses for quota keys, so the daily\n136|// cap resets on UTC rollover together with per-person quota.\n137|export const DAILY_SPEND_TTL_SEC = 48 * 3600;\n138|\n139|export function dailySpendKey(day: string): string {\n140|  return `img:spend:daily:${day}`;\n141|}\n142|\n143|export function overQuota(count: number): boolean {\n144|  return count > DAILY_IMAGE_LIMIT;\n145|}\n146|\n147|export function budgetExceeded(totalAfterReserve: number, capMicro: number): boolean {\n148|  return totalAfterReserve > capMicro;\n149|}\n150|\n151|export function imageCostMicro(): number {\n152|  return IMAGE_COST_MICRO;\n153|}\n154|\n155|// Lets the route compare lock tokens without touching Redis twice.\n156|export function canRelease(expected: string, actual: string | null): boolean {\n157|  return actual !== null && actual === expected;\n158|}\n159|\n160|function clip(text: string, max: number): string {\n161|  const clean = text.replace(/\\s+/g, \" \").trim();\n162|  if (clean.length <= max) return clean;\n163|  return clean.slice(0, max).trimEnd();\n164|}\n165|\n166|// Prompt from trusted server-side book text only. The client sends\n167|// ordinals and ids, never free text, so there is no injection path.\n168|export function buildPrompt(args: {\n169|  kind: ImageKind;\n170|  passageText: string;\n171|  sceneTitle: string;\n172|  sceneClip: string;\n173|}): string {\n174|  const style =\n175|    \"Illustration in the style of W. W. Denslow's 1900 first-edition \" +\n176|    \"illustrations for The Wonderful Wizard of Oz: flat color, bold black \" +\n177|    \"ink outlines, limited palette. Dorothy wears silver shoes. Nothing \" +\n178|    \"from the 1939 MGM film, no ruby slippers, no film look. No text, \" +\n179|    \"no captions, no lettering in the image.\";\n180|  if (args.kind === \"scene\") {\n181|    return (\n182|      `Scene \"${args.sceneTitle}\". ${clip(args.sceneClip, MAX_SCENE_CLIP_CHARS)}. ${style}`\n183|    );\n184|  }\n185|  return (\n186|    `Scene \"${args.sceneTitle}\". Passage: ${clip(args.passageText, MAX_PASSAGE_CHARS)}. ` +\n187|    `Context: ${clip(args.sceneClip, MAX_SCENE_CLIP_CHARS)}. ${style}`\n188|  );\n189|}\n190|\n191|export function buildCaption(args: {\n192|  kind: ImageKind;\n193|  sceneTitle: string;\n194|  passageText: string;\n195|}): string {\n196|  if (args.kind === \"scene\") return args.sceneTitle;\n197|  const words = args.passageText.replace(/\\s+/g, \" \").trim().split(\" \").slice(0, 10);\n198|  const head = words.join(\" \");\n199|  return words.length >= 10 ? `${head}…` : head;\n200|}\n201|\n202|// In-memory KV for tests. Expiries are checked against Date.now.\n203|export function createMemoryKV(): KV & { clear(): void } {\n204|  const values = new Map<string, string>();\n205|  const expiresAt = new Map<string, number>();\n206|  function live(key: string): boolean {\n207|    const until = expiresAt.get(key);\n208|    if (until !== undefined && Date.now() >= until) {\n209|      values.delete(key);\n210|      expiresAt.delete(key);\n211|      return false;\n212|    }\n213|    return true;\n214|  }\n215|  function num(key: string): number {\n216|    return Number(values.get(key) ?? \"0\");\n217|  }\n218|  return {\n219|    async get(key: string): Promise<string | null> {\n220|      if (!live(key)) return null;\n221|      return values.get(key) ?? null;\n222|    },\n223|    async setNxEx(key: string, value: string, exSec: number): Promise<boolean> {\n224|      if (live(key) && values.has(key)) return false;\n225|      values.set(key, value);\n226|      expiresAt.set(key, Date.now() + exSec * 1000);\n227|      return true;\n228|    },\n229|    async set(key: string, value: string): Promise<void> {\n230|      values.set(key, value);\n231|      expiresAt.delete(key);\n232|    },\n233|    async incr(key: string): Promise<number> {\n234|      const next = num(key) + 1;\n235|      values.set(key, String(next));\n236|      return next;\n237|    },\n238|    async incrBy(key: string, by: number): Promise<number> {\n239|      const next = num(key) + by;\n240|      values.set(key, String(next));\n241|      return next;\n242|    },\n243|    async decr(key: string): Promise<number> {\n244|      const next = num(key) - 1;\n245|      values.set(key, String(next));\n246|      return next;\n247|    },\n248|    async decrBy(key: string, by: number): Promise<number> {\n249|      const next = num(key) - by;\n250|      values.set(key, String(next));\n251|      return next;\n252|    },\n253|    async expire(key: string, sec: number): Promise<void> {\n254|      if (values.has(key)) expiresAt.set(key, Date.now() + sec * 1000);\n255|    },\n256|    async releaseIfToken(key: string, token: string): Promise<boolean> {\n257|      if (!live(key)) return false;\n258|      if (values.get(key) !== token) return false;\n259|      values.delete(key);\n260|      expiresAt.delete(key);\n261|      return true;\n262|    },\n263|    clear(): void {\n264|      values.clear();\n265|      expiresAt.clear();\n266|    },\n267|  };\n268|}","final_result":true,"kind":"output","task_id":"01a182ca-a39f-74a0-a2a8-01b33615b70e"},"kind":"task_lifecycle","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"task_id":"01a182ca-a39f-74a0-a2a8-01b33615b70e","task_stream":{"id":"01a182ca-a39f-74a0-a2a8-01b33615b70e","kind":"task"}}}
