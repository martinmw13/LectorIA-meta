{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40b","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":96,"recorded_at":1780531400000187,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","event":{"chunk":"Read text file `server/images/env.ts`.\n1|import \"server-only\";\n2|\n3|// Reads image env once per request. Any missing key means unavailable:\n4|// with no quotas or budget configured, the route must never spend.\n5|export interface ImageEnv {\n6|  upstashUrl: string;\n7|  upstashToken: string;\n8|  metaKey: string;\n9|  sessionSecret: string;\n10|  ipSalt: string;\n11|  spendCapMicro: number;\n12|  dailySpendCapMicro: number;\n13|}\n14|\n15|// Vercel's Upstash marketplace integration injects KV_REST_API_* names.\n16|// UPSTASH_* wins when non-empty, else the KV_* fallback applies per value.\n17|// The read-only token is never used (we write).\n18|const URL_NAMES = \"UPSTASH_REDIS_REST_URL|KV_REST_API_URL\";\n19|const TOKEN_NAMES = \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\";\n20|\n21|const REQUIRED = [\n22|  \"BLOB_READ_WRITE_TOKEN\",\n23|  \"META_API_KEY\",\n24|  \"SESSION_SECRET\",\n25|  \"IP_HASH_SALT\",\n26|] as const;\n27|\n28|export function readImageEnv(from: NodeJS.ProcessEnv = process.env): ImageEnv {\n29|  const upstashUrl = from.UPSTASH_REDIS_REST_URL || from.KV_REST_API_URL;\n30|  const upstashToken = from.UPSTASH_REDIS_REST_TOKEN || from.KV_REST_API_TOKEN;\n31|  const missing = [\n32|    upstashUrl ? null : URL_NAMES,\n33|    upstashToken ? null : TOKEN_NAMES,\n34|    ...REQUIRED.filter((k) => !from[k]),\n35|  ].filter((m): m is string => m !== null);\n36|  if (missing.length > 0) throw new Error(`missing image env: ${missing.join(\",\")}`);\n37|  const capUsd = Number(from.SPEND_CAP_USD ?? \"10\");\n38|  const dailyCapUsd = Number(from.DAILY_SPEND_CAP_USD ?? \"2\");\n39|  return {\n40|    upstashUrl: upstashUrl as string,\n41|    upstashToken: upstashToken as string,\n42|    metaKey: from.META_API_KEY as string,\n43|    sessionSecret: from.SESSION_SECRET as string,\n44|    ipSalt: from.IP_HASH_SALT as string,\n45|    spendCapMicro: Math.round((Number.isFinite(capUsd) ? capUsd : 10) * 1_000_000),\n46|    dailySpendCapMicro: Math.round(\n47|      (Number.isFinite(dailyCapUsd) && dailyCapUsd >= 0 ? dailyCapUsd : 2) * 1_000_000,\n48|    ),\n49|  };\n50|}","final_result":true,"kind":"output","task_id":"01a182ca-a397-72c1-ab84-9b06b1b3af7e"},"kind":"task_lifecycle","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"task_id":"01a182ca-a397-72c1-ab84-9b06b1b3af7e","task_stream":{"id":"01a182ca-a397-72c1-ab84-9b06b1b3af7e","kind":"task"}}}
