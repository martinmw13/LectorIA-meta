{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c46b","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":144,"recorded_at":1780531400000283,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182caf73874a7acdfb85dfe822a74","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `server/images/orchestrate.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import {\n3|  MSG_CREDITS_OUT,\n4|  createMemoryKV,\n5|  dailySpendKey,\n6|  imageKey,\n7|  lockKeyFor,\n8|  spendKey,\n9|} from \"@/core/images\";\n10|import type { ImageGenerator, ImageRequest, ImageStore } from \"@/core/images\";\n11|import type { ImageEnv } from \"./env\";\n12|import { orchestrate } from \"./orchestrate\";\n13|import type { OrchestrateDeps } from \"./orchestrate\";\n14|\n15|const env: ImageEnv = {\n16|  upstashUrl: \"https://x\",\n17|  upstashToken: \"t\",\n18|  metaKey: \"m\",\n19|  sessionSecret: \"s\",\n20|  ipSalt: \"salt\",\n21|  spendCapMicro: 10_000_000,\n22|  dailySpendCapMicro: 1_500_000,\n23|};\n24|\n25|const content = {\n26|  passageText: \"Dorothy lived in the midst of the great Kansas prairies.\",\n27|  sceneTitle: \"Gray Life on the Prairie\",\n28|  sceneClip: \"Gray prairie and a small house.\",\n29|};\n30|\n31|const passage: ImageRequest = { kind: \"passage\", bookId: \"oz\", textVersion: \"t\", n: 3 };\n32|\n33|function deps(over: Partial<OrchestrateDeps> = {}): OrchestrateDeps {\n34|  const files = new Map<string, Uint8Array>();\n35|  const store: ImageStore = {\n36|    findUrl: async (path) =>\n37|      files.has(path) ? `https://blob.example/${path}` : null,\n38|    save: async (path, bytes) => {\n39|      if (files.has(path)) throw new Error(\"overwrite\");\n40|      files.set(path, bytes);\n41|      return `https://blob.example/${path}`;\n42|    },\n43|  };\n44|  const generate: ImageGenerator = {\n45|    generate: async () => new Uint8Array([1, 2, 3]),\n46|  };\n47|  return {\n48|    kv: createMemoryKV(),\n49|    store,\n50|    generate,\n51|    env,\n52|    content,\n53|    ip: \"1.2.3.4\",\n54|    anonId: \"anon-1\",\n55|    day: \"2026-10-27\",\n56|    ...over,\n57|  };\n58|}\n59|\n60|describe(\"orchestrate\", () => {\n61|  it(\"returns a cached hit without touching Meta, quota, or budget\", async () => {\n62|    const d = deps();\n63|    let calls = 0;\n64|    d.generate = { generate: async () => (calls++, new Uint8Array([9])) };\n65|    const first = await orchestrate(passage, d);\n66|    expect(first.status).toBe(\"ready\");\n67|    expect(calls).toBe(1);\n68|\n69|    const d2 = deps({ kv: d.kv, store: d.store, generate: d.generate });\n70|    const second = await orchestrate(passage, d2);\n71|    expect(second).toMatchObject({ status: \"ready\", cached: true });\n72|    expect(calls).toBe(1);\n73|    expect(await d.kv.get(spendKey())).toBe(\"10000\");\n74|  });\n75|\n76|  it(\"backfills the index from Blob when Redis missed\", async () => {\n77|    const d = deps();\n78|    await d.store.save(\"images/oz/t/v1/p3.webp\", new Uint8Array([1]));\n79|    let calls = 0;\n80|    d.generate = { generate: async () => (calls++, new Uint8Array([9])) };\n81|    const res = await orchestrate(passage, d);\n82|    expect(res).toMatchObject({ status: \"ready\", cached: true });\n83|    expect(calls).toBe(0);\n84|  });\n85|\n86|  it(\"gives pending to a second requester holding no lock\", async () => {\n87|    const d = deps();\n88|    let releaseGen!: (bytes: Uint8Array) => void;\n89|    let genCalled!: () => void;\n90|    const called = new Promise<void>((resolve) => (genCalled = resolve));\n91|    d.generate = {\n92|      generate: () =>\n93|        new Promise<Uint8Array>((resolve) => {\n94|          releaseGen = resolve;\n95|          genCalled();\n96|        }),\n97|    };\n98|    const held = orchestrate(passage, { ...d, token: \"owner\" });\n99|    await called;\n100|    const res = await orchestrate(passage, { ...d, token: \"other\" });\n101|    expect(res).toEqual({ status: \"pending\" });\n102|    releaseGen(new Uint8Array([1]));\n103|    expect(await held).toMatchObject({ status: \"ready\" });\n104|  });\n105|\n106|  it(\"refuses the 6th image per person and refunds both counters\", async () => {\n107|    const d = deps();\n108|    for (let i = 0; i < 5; i++) {\n109|      // Distinct keys: repeat taps on one paragraph hit the cache for free.\n110|      const key: ImageRequest = { ...passage, n: 100 + i };\n111|      const res = await orchestrate(key, { ...d, anonId: `fresh-${i}` });\n112|      expect(res.status).toBe(\"ready\");\n113|    }\n114|    const kv = d.kv;\n115|    const before = await kv.get(spendKey());\n116|    const res = await orchestrate(passage, { ...d, anonId: \"fresh-5\" });\n117|    expect(res).toMatchObject({ status: \"error\", code: \"quota\" });\n118|    // Refund keeps counters at 5 so a new day key starts clean logic holds;\n119|    // spend did not move for the refused call.\n120|    expect(await kv.get(spendKey())).toBe(before);\n121|  });\n122|\n123|  it(\"refunds quota and budget on Meta failure with no raw error text\", async () => {\n124|    const d = deps();\n125|    d.generate = {\n126|      generate: async () => {\n127|        throw new Error(\"meta secret internals 500\");\n128|      },\n129|    };\n130|    const res = await orchestrate(passage, d);\n131|    expect(res).toMatchObject({ status: \"error\", code: \"unavailable\" });\n132|    expect(JSON.stringify(res)).not.toContain(\"secret internals\");\n133|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n134|    // Lock released: a new request generates instead of pending.\n135|    const retry = await orchestrate(passage, {\n136|      ...d,\n137|      generate: { generate: async () => new Uint8Array([7]) },\n138|    });\n139|    expect(retry.status).toBe(\"ready\");\n140|  });\n141|\n142|  it(\"refuses over the spend cap and refunds the reserve\", async () => {\n143|    const d = deps({ env: { ...env, spendCapMicro: 1 } });\n144|    const res = await orchestrate(passage, d);\n145|    expect(res).toMatchObject({ status: \"error\", code: \"budget\" });\n146|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n147|  });\n148|\n149|  it(\"refuses when the cookie counter runs out while IPs stay fresh\", async () => {\n150|    const d = deps();\n151|    for (let i = 0; i < 5; i++) {\n152|      const res = await orchestrate({ ...passage, n: 400 + i }, { ...d, ip: `10.0.0.${i}` });\n153|      expect(res.status).toBe(\"ready\");\n154|    }\n155|    const res = await orchestrate({ ...passage, n: 405 }, { ...d, ip: \"10.9.9.9\" });\n156|    expect(res).toMatchObject({ status: \"error\", code: \"quota\" });\n157|    expect(await d.kv.get(spendKey())).toBe(\"50000\");\n158|  });\n159|\n160|  it(\"resets quota on UTC day rollover\", async () => {\n161|    const d = deps();\n162|    for (let i = 0; i < 5; i++) {\n163|      const res = await orchestrate({ ...passage, n: 200 + i }, { ...d, day: \"2026-10-27\" });\n164|      expect(res.status).toBe(\"ready\");\n165|    }\n166|    const refused = await orchestrate(passage, { ...d, day: \"2026-10-27\" });\n167|    expect(refused).toMatchObject({ status: \"error\", code: \"quota\" });\n168|    const next = await orchestrate({ ...passage, n: 300 }, { ...d, day: \"2026-10-28\" });\n169|    expect(next.status).toBe(\"ready\");\n170|  });\n171|\n172|  it(\"returns generic text when KV throws after the lock\", async () => {\n173|    const d = deps();\n174|    const kv = { ...d.kv, incrBy: async (): Promise<number> => {\n175|      throw new Error(\"kv-boom-marker\");\n176|    } };\n177|    const res = await orchestrate(passage, { ...d, kv });\n178|    expect(res).toMatchObject({ status: \"error\", code: \"unavailable\" });\n179|    expect(JSON.stringify(res)).not.toContain(\"kv-boom-marker\");\n180|    expect(await kv.setNxEx(lockKeyFor(imageKey(passage)), \"probe\", 150)).toBe(true);\n181|  });\n182|\n183|  it(\"returns ready with the URL when the index write fails\", async () => {\n184|    const d = deps();\n185|    d.kv.set = async () => {\n186|      throw new Error(\"index-boom-marker\");\n187|    };\n188|    const res = await orchestrate(passage, d);\n189|    expect(res).toMatchObject({ status: \"ready\", cached: false });\n190|    expect(JSON.stringify(res)).not.toContain(\"index-boom-marker\");\n191|    expect(await d.kv.setNxEx(lockKeyFor(imageKey(passage)), \"probe\", 150)).toBe(true);\n192|  });\n193|\n194|  it(\"tracks the daily counter under the daily cap\", async () => {\n195|    const d = deps();\n196|    const res = await orchestrate(passage, d);\n197|    expect(res.status).toBe(\"ready\");\n198|    expect(await d.kv.get(spendKey())).toBe(\"10000\");\n199|    expect(await d.kv.get(dailySpendKey(\"2026-10-27\"))).toBe(\"10000\");\n200|  });\n201|\n202|  it(\"refuses over the daily cap with a refund and no generate call\", async () => {\n203|    const d = deps({ env: { ...env, dailySpendCapMicro: 1 } });\n204|    let calls = 0;\n205|    d.generate = {\n206|      generate: async () => (calls++, new Uint8Array([9])),\n207|    };\n208|    const res = await orchestrate(passage, d);\n209|    expect(res).toEqual({ status: \"error\", code: \"daily_budget\", message: MSG_CREDITS_OUT });\n210|    expect(calls).toBe(0);\n211|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n212|    expect(await d.kv.get(dailySpendKey(\"2026-10-27\"))).toBe(\"0\");\n213|    // Lock released: a new request generates instead of pending.\n214|    const retry = await orchestrate(passage, {\n215|      ...d,\n216|      env: { ...env, dailySpendCapMicro: 1_500_000 },\n217|      generate: { generate: async () => new Uint8Array([7]) },\n218|    });\n219|    expect(retry.status).toBe(\"ready\");\n220|  });\n221|\n222|  it(\"resets the daily cap on a new UTC day\", async () => {\n223|    const tiny = { ...env, dailySpendCapMicro: 10_000 };\n224|    const d = deps({ env: tiny });\n225|    expect((await orchestrate(passage, d)).status).toBe(\"ready\");\n226|    const refused = await orchestrate(\n227|      { ...passage, n: 4 },\n228|      { ...d, ip: \"9.9.9.9\", anonId: \"fresh-1\" },\n229|    );\n230|    expect(refused).toMatchObject({ status: \"error\", code: \"daily_budget\" });\n231|    // A fresh key: the day-27 index entry would serve n=3 from cache.\n232|    const next = await orchestrate({ ...passage, n: 5 }, { ...d, day: \"2026-10-28\" });\n233|    expect(next.status).toBe(\"ready\");\n234|    expect(await d.kv.get(dailySpendKey(\"2026-10-28\"))).toBe(\"10000\");\n235|  });\n236|\n237|  it(\"still enforces the total cap with the total message\", async () => {\n238|    const d = deps({ env: { ...env, spendCapMicro: 1 } });\n239|    const res = await orchestrate(passage, d);\n240|    expect(res).toEqual({ status: \"error\", code: \"budget\", message: MSG_CREDITS_OUT });\n241|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n242|  });\n243|\n244|  it(\"refunds the daily counter when generation fails\", async () => {\n245|    const d = deps();\n246|    d.generate = {\n247|      generate: async () => {\n248|        throw new Error(\"meta secret internals 500\");\n249|      },\n250|    };\n251|    const res = await orchestrate(passage, d);\n252|    expect(res).toMatchObject({ status: \"error\", code: \"unavailable\" });\n253|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n254|    expect(await d.kv.get(dailySpendKey(\"2026-10-27\"))).toBe(\"0\");\n255|  });\n256|\n257|  it(\"leaves both counters alone on a cached hit\", async () => {\n258|    const d = deps();\n259|    const first = await orchestrate(passage, d);\n260|    expect(first.status).toBe(\"ready\");\n261|    const second = await orchestrate(passage, d);\n262|    expect(second).toMatchObject({ status: \"ready\", cached: true });\n263|    expect(await d.kv.get(spendKey())).toBe(\"10000\");\n264|    expect(await d.kv.get(dailySpendKey(\"2026-10-27\"))).toBe(\"10000\");\n265|  });\n266|\n267|  it(\"recovers from a lost save race through the winner file\", async () => {\n268|    const files = new Map<string, Uint8Array>();\n269|    const d = deps();\n270|    d.store = {\n271|      findUrl: async (path) => (files.has(path) ? `https://blob.example/${path}` : null),\n272|      save: async (path, bytes) => {\n273|        files.set(path, bytes);\n274|        throw new Error(\"race lost\");\n275|      },\n276|    };\n277|    const res = await orchestrate(passage, d);\n278|    expect(res).toMatchObject({ status: \"ready\", cached: true });\n279|  });\n280|});"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c46d","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":145,"recorded_at":1780531400000285,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182caf8717071a1eb80b1da14ee69","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `docs/contracts.md`.\n1|# Contracts\n2|\n3|Music generation must never block the reader. Each module below owns one\n4|job and can be swapped without touching the others. Import direction is\n5|`core <- server` and `core <- app`. Server and client components never\n6|import each other. `app/page.tsx` may import `server/books.ts`. Client\n7|files never do.\n8|\n9|## Book data\n10|\n11|`data/books/oz/book.json` holds the frozen text: id, title, author,\n12|`textVersion` hash, chapters with `start_n` and `end_n`, and paragraphs\n13|with `id`, `ch`, `n`, and `text`. `analysis.json` is the scene source\n14|the reader consumes: the same scenes plus Jev vectors, the Muse\n15|override, and the `final` emotion. `scenes.json` is the pipeline\n16|intermediate that `analysis.json` mirrors. The reader consumes the book\n17|fields, scene ranges and titles, and the `final` vector with intensity\n18|and tempo. It never sees `jev`, `muse_override`, or provenance.\n19|`core/reader.ts` defines `buildReaderModel`, which joins paragraphs to\n20|scenes by ordinal range and throws on unordered scenes or on paragraphs\n21|covered zero or two times. The `resplit` pipeline step (after\n22|`classify`, before `cluster`) cuts candidate scenes into ~100 to 160\n23|word windows, classifies each window with Jev, and splits at the\n24|strongest persistent dominant-emotion shift (auto at margin 0.30,\n25|Muse decides 0.15 to 0.30, none below). The first part keeps the\n26|scene id with letter-suffixed later parts; provenance lands under\n27|`provenance.resplit` in `analysis.json`: one entry per cut (`from`,\n28|`at_n`, `margin`, `window_left`/`window_right` from the window means,\n29|`final_left`/`final_right` from the re-classified parts,\n30|`decided_by`), plus `merged_back` (parts re-classified to the same top\n31|emotion and folded back), `rejected` (Muse declined), and\n32|`window_failures` (Jev failed, scene left whole) and `muse_failures` (Muse resplit call or titles failed, scene left whole).\n33|\n34|## Scene reader\n35|\n36|One static route per scene (`app/leer/[sceneId]`, `dynamicParams`\n37|false); `/` redirects to the first scene. The layout mounts the music\n38|container once and passes slim metadata for all scenes: id, chapter,\n39|and emotion triple only. Each scene page builds its view with\n40|`buildSceneView` and ships only that scene's text, its chapter title,\n41|and neighbor ids. Sub-pages come from `paginateScene`, which closes a\n42|page when the next paragraph would pass 250 words or the line budget\n43|(`FIRST_PAGE_LINES` 16 on page one, `LINES_PER_PAGE` 17 after, each\n44|paragraph costing `ceil(chars / CHARS_PER_LINE)` lines with\n45|`CHARS_PER_LINE` 68), split at paragraph boundaries. The pager moves sub-pages in client state and\n46|pushes routes with `router.push`, never `<Link>`; going back lands on\n47|the previous scene's last sub-page through a one-shot client flag, never\n48|a URL param, so prerendered pages stay static. The client never\n49|receives other scenes' text, titles, or summaries. The progress line\n50|reads `Chapter 1 · The Cyclone`, a spaced separator, then `Scene 1 of 4\n51|· Page 1 of 3` as two spans on one line. Book type is 1.1875rem / 1.7\n52|with no paragraph gaps and a 1.5em first-line indent on following\n53|paragraphs. The word budget stays the upper bound and the line budget\n54|keeps every sub-page inside 1280×800 without scroll.\n55|\n56|## Music library\n57|\n58|The library is a static `public/music/manifest.json`, version 3, fetched\n59|by the client from `/music/manifest.json`. A static file needs no route,\n60|ships from the CDN, and swaps by replacing files only. Tracks may be\n61|several minutes long and are not loops unless marked so. A version 2\n62|manifest migrates inline to one implicit `default` soundtrack of style\n63|`orchestral`.\n64|\n65|`MusicManifest = { version, styles, soundtracks, tracks, playlists }`.\n66|`StyleInfo = { id, name }` where `id` is a lowercase slug and `name` is\n67|the display name. `Soundtrack = { id, name, style }` plus\n68|optional `credit`. `Track = { id, src, title, emotion, vector,\n69|intensity, tempo, durationSec, soundtrack, style }` plus optional\n70|`startSec` (default 0, where playback starts on first play and on each\n71|loop), `endSec` (default the media end, where the track stops or loops),\n72|`gainDb` (default 0, a loudness trim in dB, in -24..12),\n73|`loop` (default true), `source` (`generated`, `jamendo`, or\n74|`recording`), `artist`, `composer`, `license`, `attribution`, and\n75|`sourceUrl` (https only). `durationSec` is the playable length: the\n76|segment end (or the file end) minus `startSec`. `startSec` and `endSec`\n77|are absolute media times with `startSec < endSec`; `endSec` stays within\n78|`startSec + durationSec`. The player scales volume by the track gain and\n79|ends or loops at `effectiveEnd`, the earlier of `endSec` and the loaded\n80|media end. `emotion` is the hand label: one of the 8\n81|emotion ids in `core/types.ts`. The vector covers the 8 ids with finite\n82|entries in 0..1. Every track names a soundtrack id, every track style\n83|matches its soundtrack style, and every style is a listed style id.\n84|`core/music.ts` owns `parseManifest`, which rejects unknown versions,\n85|duplicate ids, unknown soundtrack or style ids, style mismatches,\n86|missing fields, bad vectors, NaN entries, out-of-range numbers,\n87|a negative `startSec`, a bad `gainDb` or `endSec`, unknown `source`\n88|values, a non-boolean\n89|`playlistOnly`, and any `src`\n90|that is not a `/music/` path or `https` URL. Unknown fields stay\n91|ignored. A soundtrack with no\n92|tracks parses. The reader calls it on every fetch, so a bad drop-in\n93|fails loudly in dev. Remote audio lives on one Blob store, so\n94|`media-src` in `next.config.ts` lists exactly\n95|`https://3vuhzq2wmortnuxj.public.blob.vercel-storage.com`. Build the\n96|manifest with `npm run build:music data/music/labels.json\n97|data/music/library.json --out public/music/manifest.json`, which runs\n98|`pipeline/labels-to-manifest.ts` and validates the result before\n99|writing.\n100|\n101|`Track.playlistOnly` defaults to false. A true value marks a playlist\n102|only track: it still names a soundtrack and style, but no emotion pick\n103|ever returns it. `MusicManifest.playlists` holds\n104|`Playlist = { id, label, trackIds }` entries, most notably\n105|`just-play-chopin`. A missing key parses as an empty list, and a v2\n106|migration gives an empty list. Parse rejects duplicate playlist ids,\n107|empty labels, non-array `trackIds`, and any `trackIds` entry that names\n108|no track, with the playlist and the id in the message.\n109|\n110|## Selection\n111|\n112|`MusicSelection = { style }` is the session: `style` scopes every pick.\n113|There is one mode only. Every scheduled select ranges over all tracks in\n114|the current style and draws among the tracks with the scene emotion (or\n115|the best same-style tracks when the emotion is missing) within\n116|`randomTolerance` (0.05) of the best score, keeps the current track when\n117|it is eligible, and avoids an immediate repeat otherwise. The style is\n118|the user's choice, changed with the style selector. The default style is\n119|the first listed style with tracks; a stored style with tracks wins. The\n120|session persists `{ style, volume, muted }` in localStorage under\n121|`lectoria.music.v1`. Old values with `mode` or `soundtrackId` load by\n122|`style` alone and ignore unknown fields; a stored object without\n123|`volume` or `muted` loads `volume: null` and `muted: false`. A bad\n124|`volume` (not a finite number in 0..1) loads null and the player starts\n125|at 0.8; a bad `muted` loads false. A stored style with no tracks falls\n126|back to the default. Storage exceptions never break playback. Dwell\n127|and min-track rules hold. The core never calls `Math.random`; the\n128|reader injects it and tests pass a seeded stub.\n129|\n130|## Next track and style change\n131|\n132|`nextTrack` cycles same-emotion tracks in score order across the whole\n133|style, wrapping and skipping the current, then the best same-style track\n134|overall when the emotion is missing. A null scene cycles the style set\n135|in id order. One track or none gives null.\n136|\n137|`requestStyleChange` picks the best match for the scene in the new style\n138|by score. It never crosses styles. The scheduler applies it at once\n139|with the normal crossfade and holds the choice like a Next. There is no\n140|mix toggle and no soundtrack-change button.\n141|\n142|## Playlist mode\n143|\n144|`SchedulerState.playlist` holds `{ id, index }` while a fixed playlist\n145|plays. `enterPlaylist` switches at once to the first `trackIds` entry\n146|with `crossfadeSec`, no dwell and no min-track rule. While it is on,\n147|scene changes update the active scene but never switch, `requestNext`\n148|and `noteTrackEnded` advance to the next entry in order and wrap from\n149|the last to the first, and playlist tracks run to their end because the\n150|player forces looping off. `exitPlaylist` clears the playlist state and\n151|switches at once to the best match for the current scene under the\n152|restored selection. The playlist is never persisted, so a reload returns\n153|to emotion mode. The style selector stays disabled while it is on, and\n154|the style list hides styles with only playlist tracks.\n155|\n156|## Similarity and config\n157|\n158|`Similarity = (scene, track, weights) => number`, where\n159|`SceneSignal = { vector, intensity, tempo }`. The default is\n160|`bhattacharyyaSimilarity`: both 8-emotion vectors renormalize to sum 1\n161|(an all-zero vector gives an affinity of 0), `E` is the sum of\n162|`sqrt(s_k * t_k)`, and the score is `weights.emotion * E` plus\n163|`weights.intensity` and `weights.tempo` each for intensity and tempo\n164|closeness. Scoring and ranking pass the resolved config weights in, so\n165|a weights override changes the ranking. `cosineSimilarity` over\n166|`buildFeatures` output stays as an exported alternative. One exported object,\n167|`MUSIC_CONFIG`, holds `similarity`, `weights`, `dwellSec` (20),\n168|`sceneEntryDwellSec` (5), `minTrackSec` (45), `crossfadeSec` (3), and\n169|`randomTolerance` (0.05). Everything else reads from it. Ranking ties go\n170|to the lower track id. Route entries use `sceneEntryDwellSec` as the\n171|dwell override; scoring and overrides are unchanged. One path scopes,\n172|ranks, and draws: `audibleTracks` is the one playlist-only filter,\n173|`compareTrackId` the one tie-break, `rankScored` scores each track once\n174|(best first, ties to lower id), and `selectScheduled` runs the tolerance\n175|window, keep-current, and min-track hold with one rng call per draw.\n176|\n177|## Music session\n178|\n179|`core/music-session.ts` is the single policy owner behind the reader.\n180|The reader sends intents (`sceneEntered`, `tick`, `skip`, `previous`,\n181|`styleChanged`, `trackEnded`, `playlistToggled`) through\n182|`startSession` and `dispatch` with explicit `nowSec` and `rng` values,\n183|so all timing is testable without timers or a render. `dispatch`\n184|returns the same session object when nothing changed, so the 1 s tick\n185|rerenders nothing. The reader cues music on scene entry only: one\n186|`sceneEntered` per route id, gated by an id comparison, so sub-page\n187|moves never reach the session. The session holds the scheduler state,\n188|the Previous history, the selection, the fade, and the replay nonce,\n189|and derives the view the player renders: track id, fade, nonce,\n190|canPrev/canSkip, playlist flag, style.\n191|\n192|## Selection scheduler\n193|\n194|`core/music-schedule.ts` is a pure state machine. The session calls\n195|`observeScene`, `tickScheduler`, `requestNext`, `noteTrackEnded`,\n196|`requestManualTrack`, `switchStyle`, `enterPlaylist`, and\n197|`exitPlaylist` with explicit `nowSec` values, so all timing is testable\n198|without timers. State holds the current track id and when it started, the active\n199|scene id, the pending scene id and since when, and the skip override\n200|with the scene it belongs to.\n201|\n202|A newly entered scene becomes pending and the dwell clock restarts, so\n203|fast scrolling keeps only the newest scene. The first track ever plays\n204|at once with no dwell. After the pending scene holds for `dwellSec` it\n205|becomes active and the override clears. Then a scheduled select draws\n206|among the in-style tracks within `randomTolerance` of the best score,\n207|keeping the current track when it is eligible, and switches to the\n208|drawn track only once the current track played `minTrackSec`. A tick\n209|passes the active scene back through the same draw, so a hold from\n210|`minTrackSec` releases on time, unless a skip override stands: ticks\n211|return no change while it is set, and only a new scene promotion\n212|clears it. A switch reports the normal crossfade length (3 s, 0 s for\n213|the first track ever). The skip choice holds until the next scene change;\n214|after that, dwell and the draw apply with the override track as the\n215|current track. A null scene means a failed analysis with no vector, so\n216|it never triggers a switch. A non-looping track that ends fades into\n217|the best remaining track, excluding the one that ended, and clears the\n218|skip override.\n219|\n220|## Player\n221|\n222|`app/player.tsx` takes the track, `replayNonce`, the fade length for\n223|the latest switch, `canPrev`/`canSkip` with their handlers, volume and\n224|mute with their handlers, the style list with the current style and its\n225|handler, the end-of-track handler, and the playlist props\n226|(`playlistOn`, `playlistLabel`, `onTogglePlaylist`,\n227|`controlsDisabled`). It owns two `audio`\n228|elements, play state, volume, and the equal-power crossfade\n229|(cos/sin gains over the fade time, driven by `requestAnimationFrame`).\n230|It never uses the `loop` attribute. Volume lives in a ref, so the slider\n231|never re-runs the track effect or touches `src`. A new track request\n232|mid-fade cancels the pending fade and fades from the audible element to\n233|the newest track. On load each track seeks to `startSec` once metadata\n234|is available. Long tracks with `loop` true crossfade into the other\n235|element playing the same track from `startSec` when `currentTime`\n236|reaches `duration - fade`, where `fade` is the latest scheduler fade\n237|length, or the config `crossfadeSec` when none was reported yet. When\n238|`loop` is false the player reports the end and the scheduler picks the\n239|next-best track excluding the ended one. Pause stops both elements and\n240|freezes the fade in place; play resumes the audible elements from the\n241|frozen point. Audio starts once, on the first press, with fade 0.\n242|Audio starts only after the user presses play. Reduced motion is read in\n243|state with a change listener and affects visuals only, never the fade.\n244|\n245|The bar is one sticky row, 56 px tall: the `Lectoria` wordmark left,\n246|the player centre, the Chopin button and the source icon link right.\n247|The inner row is centered with 24 px side padding, one bottom hairline\n248|in the border token, and nothing touching the viewport edges. The inner\n249|max-width is 56rem, wider than the 65ch book column on purpose so the\n250|full now-playing line fits at 1280 px. The player holds Previous,\n251|Play/Pause, Next, the now-playing line (flexible space, `min-width`\n252|16rem, truncated with an ellipsis, full line in the `title` tooltip),\n253|a mute icon button (`aria-pressed`, `aria-label` `Mute` / `Unmute`, the\n254|icon shows the muted state), a volume slider with `aria-label` `Volume`\n255|(96 px) next to it, a style selector with `aria-label`\n256|`Orchestra / Piano` and no visible label text listing only styles that\n257|have tracks (hidden while fewer than two qualify), then the Chopin\n258|button and the source icon link. The transport and mute buttons and the\n259|source icon link are icon-only inline SVGs (`currentColor`, 32 px hit\n260|area), quiet and neutral, Meta blue on hover and focus-visible, each\n261|with `aria-label` and `title`; the source link reads `Music source\n262|(opens in new tab)`. Previous walks the session history and restarts\n263|the current track with no history, including the current playlist piece\n264|in playlist mode; Next cycles same-emotion tracks in the style.\n265|A `Just play Chopin` round image button (`/art/chopin-just-play-me.png`,\n266|40 px, `alt` and `aria-label` `Just play Chopin`) appears only when\n267|the manifest defines that playlist with tracks; it carries\n268|`aria-pressed`, and while pressed it shows a 2 px Meta-blue ring plus\n269|scale 1.05. The now-playing line shows `display title · composer\n270|· source`: `displayTitle` drops quoted nicknames, key phrases, and\n271|opus/catalogue suffixes from the track title, and the source is the\n272|artist plus ` / <platform>` when the attribution names Musopen or\n273|Jamendo and the artist does not already say it, dropped when it would\n274|repeat the performer. The full manifest title plus the license and full\n275|attribution sits in the `title` tooltip. On manifest failure the reader\n276|still renders and the bar shows a short neutral note. UI motion stays\n277|under 200 ms. Controls are real buttons and inputs with labels, visible\n278|focus, and keyboard use. `app/player.tsx` keeps the audio engine,\n279|transport, and bar layout; `app/player-controls.tsx` holds the style\n280|selector and the playlist toggle; `app/music-prefs.ts` owns the storage\n281|helper. The heading keeps `h2:focus:not(:focus-visible){outline:none}`\n282|so mouse navigation shows no box while keyboard focus keeps its ring.\n283|No user-visible emotion labels exist; ids stay as they are.\n284|`core/music-credit.ts` builds the line as a pure function with tests,\n285|including the pure `displayTitle`.\n286|`core/music-history.ts` is the bounded history stack the session banks\n287|automatic switches on; `requestManualTrack` in `core/music-schedule.ts`\n288|holds a manual pick.\n289|\n290|## Image api\n291|\n292|`POST /api/images` (Node runtime, `maxDuration` 120). Request is a\n293|discriminated union: `{ kind: \"passage\", bookId, textVersion, n }` names\n294|the paragraph where the selection starts, `{ kind: \"scene\", bookId,\n295|textVersion, sceneId }` names the scene. Validation is strict: known\n296|book, matching `textVersion`, integer `n` inside the book, known\n297|`sceneId`. Any other body is a 400 with a generic English message.\n298|The client sends ordinals and ids only, never text. \"Illustrate\n299|scene\" uses the scene id from the route.\n300|\n301|Responses (typed in `core/types.ts`): `{ status: \"ready\", url, cached,\n302|caption }` with a Vercel Blob URL, never bytes; `{ status: \"pending\" }`\n303|when another request holds the lock, so the client reposts\n304|every 3 s up to ~2 minutes; `{ status: \"error\", code, message }`\n305|where code is `quota`, `budget`, `daily_budget`, `unavailable`, or\n306|`bad_request` with a friendly English message. Both `budget` and\n307|`daily_budget` answer `MSG_CREDITS_OUT` (`core/images.ts`): the free\n308|credits ran out, bring your own key, and meanwhile the Oz reader is\n309|ready with its soundtrack and illustrations. It never says \"come back\n310|tomorrow\". The UI links the Oz sentence via `CREDITS_OUT_LIBRARY_HREF`\n311|(`\"/\"`). Caption is the scene title, or the paragraph's first words,\n312|built server-side.\n313|\n314|The passage cache key is book plus start paragraph plus `textVersion`\n315|plus `PROMPT_VERSION` (`v1`); the scene key swaps in the scene id.\n316|Both map to a deterministic Blob path (`addRandomSuffix: false`,\n317|`allowOverwrite: false`). An Upstash Redis index maps key to Blob URL,\n318|so hits are one GET; on an index miss the server lists by path prefix\n319|before generating and backfills the index.\n320|Quota is 5 new images per person per day by hashed IP and signed\n321|cookie, whichever runs out first; a shared spend counter in integer\n322|micro-dollars sits under `SPEND_CAP_USD` (default 10), plus a daily\n323|counter per UTC day under `DAILY_SPEND_CAP_USD` (default 2, 48 h key\n324|TTL). Failures refund quota and both counters and release the lock.\n325|Both caps apply only to requests paid with our key; a future\n326|bring-your-own-key path skips them. Free uploads allow one book per\n327|person (`FREE_BOOKS_PER_PERSON` = 1, hashed IP plus anon cookie, no\n328|day, ~10-day TTL; `checkBookQuota`/`refundBookQuota` in\n329|`server/images/quota.ts`, no route yet).\n330|\n331|## Chat api\n332|\n333|Contract only, no routes. Request `{ bookId, textVersion, positionN,\n334|spoilerMode, messages }` carries the chat history and the reader\n335|position. The response is streamed text. The server builds context from\n336|the book text up to `positionN`, or the whole book when `spoilerMode` is\n337|on, with the book prefix first and the question last so readers share\n338|the prompt cache. The system prompt answers only from that text and\n339|refuses the rest. Types live in `core/types.ts`.\n340|\n341|## Quotas and budget\n342|\n343|Server only. Spend is counted in integer micro-dollars: reserve with\n344|Redis `INCRBY` before each model call, refund with `DECRBY` after, one\n345|reserve per call including retries. The server clamps every model tool\n346|argument. Clients never see keys or raw errors. Generic messages go to\n347|the client, details stay in server logs."}}
