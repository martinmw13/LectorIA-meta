{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55f","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":266,"recorded_at":1780531400000527,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182cb4da27718b2e5e5596c4f0f3c","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `server/images/handler.ts`.\n1|import \"server-only\";\n2|import { loadOzBook } from \"@/server/books\";\n3|import { MSG_BAD_REQUEST, MSG_UNAVAILABLE, parseImageRequest, validateAgainstBook } from \"@/core/images\";\n4|import type { ImageRequest, ImageResponse } from \"@/core/images\";\n5|import { MAX_IMAGE_BODY_BYTES, readBodyCapped } from \"./body\";\n6|import { readImageEnv } from \"./env\";\n7|import { createRestKV } from \"./kv\";\n8|import { createBlobStore } from \"./blob\";\n9|import { createMetaClient } from \"./meta\";\n10|import { orchestrate } from \"./orchestrate\";\n11|import type { ImageContent } from \"./orchestrate\";\n12|import { issueAnonId, parseAnonCookie, serializeAnonCookie, verifyAnonCookie } from \"./cookies\";\n13|import { clientIp, utcDay } from \"./quota\";\n14|\n15|function toResponse(res: ImageResponse): { json: ImageResponse; status: number } {\n16|  if (res.status === \"ready\" || res.status === \"pending\") return { json: res, status: 200 };\n17|  const status = res.code === \"bad_request\" ? 400 : res.code === \"quota\" ? 429 : 503;\n18|  return { json: res, status };\n19|}\n20|\n21|export async function handleImagesPost(req: Request): Promise<Response> {\n22|  const capped = await readBodyCapped(req, MAX_IMAGE_BODY_BYTES);\n23|  if (!capped.ok) {\n24|    return Response.json(\n25|      { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n26|      { status: capped.reason === \"too_large\" ? 413 : 400 },\n27|    );\n28|  }\n29|\n30|  let parsed: ImageRequest;\n31|  try {\n32|    parsed = parseImageRequest(JSON.parse(capped.text));\n33|  } catch {\n34|    return Response.json(\n35|      { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n36|      { status: 400 },\n37|    );\n38|  }\n39|\n40|  let env;\n41|  try {\n42|    env = readImageEnv();\n43|  } catch (e) {\n44|    const message = e instanceof Error ? e.message : \"\";\n45|    const prefix = \"missing image env:\";\n46|    const names = message.startsWith(prefix) ? message.slice(prefix.length).trim() : \"\";\n47|    console.warn(`image env missing: ${names}`);\n48|    return Response.json(\n49|      { status: \"error\", code: \"unavailable\", message: MSG_UNAVAILABLE } satisfies ImageResponse,\n50|      { status: 503 },\n51|    );\n52|  }\n53|\n54|  try {\n55|    const { book, scenes } = loadOzBook();\n56|    try {\n57|      validateAgainstBook(\n58|        parsed,\n59|        {\n60|          id: book.id,\n61|          textVersion: book.textVersion,\n62|          paragraphNs: new Set(book.paragraphs.map((p) => p.n)),\n63|          sceneIds: new Set(scenes.map((s) => s.id)),\n64|        },\n65|      );\n66|    } catch {\n67|      return Response.json(\n68|        { status: \"error\", code: \"bad_request\", message: MSG_BAD_REQUEST } satisfies ImageResponse,\n69|        { status: 400 },\n70|      );\n71|    }\n72|\n73|    const byN = new Map(book.paragraphs.map((p) => [p.n, p.text]));\n74|    const sceneOf = scenes.find((s) =>\n75|      parsed.kind === \"passage\" ? parsed.n >= s.start_n && parsed.n <= s.end_n : s.id === parsed.sceneId,\n76|    );\n77|    const sceneParas = sceneOf\n78|      ? book.paragraphs.filter((p) => p.n >= sceneOf.start_n && p.n <= sceneOf.end_n)\n79|      : [];\n80|    const content: ImageContent = {\n81|      passageText: parsed.kind === \"passage\" ? (byN.get(parsed.n) ?? \"\") : \"\",\n82|      sceneTitle: sceneOf?.title ?? \"\",\n83|      sceneClip: sceneParas.map((p) => p.text).join(\" \"),\n84|    };\n85|\n86|    const cookieValue = parseAnonCookie(req.headers.get(\"cookie\"));\n87|    let anonId = cookieValue ? verifyAnonCookie(cookieValue, env.sessionSecret) : null;\n88|    let setCookie: string | null = null;\n89|    if (!anonId) {\n90|      const issued = issueAnonId(env.sessionSecret);\n91|      anonId = issued.id;\n92|      setCookie = serializeAnonCookie(issued.value);\n93|    }\n94|\n95|    const res = await orchestrate(parsed, {\n96|      kv: createRestKV(env.upstashUrl, env.upstashToken),\n97|      store: createBlobStore(),\n98|      generate: createMetaClient(env.metaKey),\n99|      env,\n100|      content,\n101|      ip: clientIp(req.headers.get(\"x-forwarded-for\")),\n102|      anonId,\n103|      day: utcDay(),\n104|    });\n105|\n106|    const { json, status } = toResponse(res);\n107|    const headers = setCookie ? { \"Set-Cookie\": setCookie } : undefined;\n108|    return Response.json(json, { status, headers });\n109|  } catch {\n110|    console.error(\"image request failed\");\n111|    return Response.json(\n112|      { status: \"error\", code: \"unavailable\", message: MSG_UNAVAILABLE } satisfies ImageResponse,\n113|      { status: 503 },\n114|    );\n115|  }\n116|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c561","stream":{"kind":"session","id":"01a182ca-7bb7-7a61-a4b7-1ef2c324c0fc"},"sequence":267,"recorded_at":1780531400000529,"record_type":"event","durability":"durable","causation_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182cb4ec77151a77d2e5635adc616","command_id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182ca-7dd9-7f20-823e-846b82dbf7e6","kind":"run"},"text":"Read text file `app/picture-panel.tsx`.\n1|\"use client\";\n2|\n3|import { useCallback, useEffect, useRef, useState } from \"react\";\n4|import { MSG_FAILED, MSG_RETRY } from \"@/core/images\";\n5|import type { ImageResponse } from \"@/core/images\";\n6|import { pickStartN } from \"./picture-selection\";\n7|import type { ParaEntry } from \"./picture-selection\";\n8|\n9|export type PictureCard =\n10|  | { phase: \"idle\" }\n11|  | { phase: \"loading\" }\n12|  | { phase: \"ready\"; url: string; caption: string; cached: boolean }\n13|  | { phase: \"error\"; message: string };\n14|\n15|const POLL_MS = 3000;\n16|const POLL_MAX = 40;\n17|\n18|function paraOf(node: Node | null): Element | null {\n19|  if (!node) return null;\n20|  const el = node.nodeType === Node.TEXT_NODE ? node.parentElement : (node as Element);\n21|  return el?.closest?.(\"p[id]\") ?? null;\n22|}\n23|\n24|async function postImage(body: unknown): Promise<ImageResponse> {\n25|  const res = await fetch(\"/api/images\", {\n26|    method: \"POST\",\n27|    headers: { \"Content-Type\": \"application/json\" },\n28|    body: JSON.stringify(body),\n29|  });\n30|  return (await res.json()) as ImageResponse;\n31|}\n32|\n33|// Scene illustration state: the client sends ordinals and ids only,\n34|// never text. The scene id comes from the route, never from a DOM scan.\n35|// The image survives sub-page moves and clears on scene change because\n36|// the scene view remounts per scene id.\n37|export function usePictureScene({\n38|  bookId,\n39|  textVersion,\n40|  sceneId,\n41|}: {\n42|  bookId: string;\n43|  textVersion: string;\n44|  sceneId: string;\n45|}) {\n46|  const [card, setCard] = useState<PictureCard>({ phase: \"idle\" });\n47|  const [popover, setPopover] = useState<{ top: number; left: number } | null>(null);\n48|  const viewRef = useRef<HTMLDivElement | null>(null);\n49|  const popRef = useRef<HTMLButtonElement | null>(null);\n50|  const pollLeft = useRef(0);\n51|\n52|  const hidePopover = useCallback(() => setPopover(null), []);\n53|\n54|  const request = useCallback(async (body: unknown) => {\n55|    setPopover(null);\n56|    setCard({ phase: \"loading\" });\n57|    pollLeft.current = POLL_MAX;\n58|    for (;;) {\n59|      let res: ImageResponse;\n60|      try {\n61|        res = await postImage(body);\n62|      } catch {\n63|        setCard({ phase: \"error\", message: MSG_FAILED });\n64|        return;\n65|      }\n66|      if (res.status === \"ready\") {\n67|        setCard({ phase: \"ready\", url: res.url, caption: res.caption, cached: res.cached });\n68|        return;\n69|      }\n70|      if (res.status === \"error\") {\n71|        setCard({ phase: \"error\", message: res.message });\n72|        return;\n73|      }\n74|      pollLeft.current -= 1;\n75|      if (pollLeft.current <= 0) {\n76|        setCard({ phase: \"error\", message: MSG_RETRY });\n77|        return;\n78|      }\n79|      await new Promise((done) => setTimeout(done, POLL_MS));\n80|    }\n81|  }, []);\n82|\n83|  const illustrateScene = useCallback(() => {\n84|    if (!sceneId || card.phase === \"loading\") return;\n85|    void request({ kind: \"scene\", bookId, textVersion, sceneId });\n86|  }, [bookId, textVersion, sceneId, request, card.phase]);\n87|\n88|  const illustratePassage = useCallback(() => {\n89|    const view = viewRef.current;\n90|    const sel = window.getSelection();\n91|    if (!view || !sel || !sel.rangeCount) return;\n92|    const entries: ParaEntry[] = [...view.querySelectorAll(\"p[id][data-n]\")].map((el) => ({\n93|      id: el.id,\n94|      n: Number(el.getAttribute(\"data-n\")),\n95|    }));\n96|    const n = pickStartN(entries, paraOf(sel.anchorNode)?.id ?? null, paraOf(sel.focusNode)?.id ?? null);\n97|    if (n === null || !Number.isInteger(n) || card.phase === \"loading\") return;\n98|    void request({ kind: \"passage\", bookId, textVersion, n });\n99|  }, [bookId, textVersion, request, card.phase]);\n100|\n101|  const dismissCard = useCallback(() => setCard({ phase: \"idle\" }), []);\n102|\n103|  // \"Picture this\" popover: on mouseup, after a frame, show it above the\n104|  // selection when the trimmed text is at least 3 chars inside the scene.\n105|  // Hidden while an image loads.\n106|  useEffect(() => {\n107|    const view = viewRef.current;\n108|    if (!view) return;\n109|    let frame = 0;\n110|    const onMouseUp = () => {\n111|      cancelAnimationFrame(frame);\n112|      frame = requestAnimationFrame(() => {\n113|        const sel = window.getSelection();\n114|        const text = sel?.toString().trim() ?? \"\";\n115|        if (!sel || sel.isCollapsed || text.length < 3 || !sel.rangeCount) {\n116|          setPopover(null);\n117|          return;\n118|        }\n119|        if (!view.contains(sel.anchorNode) || !view.contains(sel.focusNode)) {\n120|          setPopover(null);\n121|          return;\n122|        }\n123|        const box = sel.getRangeAt(0).getBoundingClientRect();\n124|        const host = view.getBoundingClientRect();\n125|        setPopover({\n126|          top: box.top - host.top - 8,\n127|          left: box.left - host.left + box.width / 2,\n128|        });\n129|      });\n130|    };\n131|    view.addEventListener(\"mouseup\", onMouseUp);\n132|    return () => {\n133|      cancelAnimationFrame(frame);\n134|      view.removeEventListener(\"mouseup\", onMouseUp);\n135|    };\n136|  }, [sceneId]);\n137|\n138|  // Any mousedown outside the popover dismisses it, as does Escape.\n139|  useEffect(() => {\n140|    if (!popover) return;\n141|    const onDown = (event: MouseEvent) => {\n142|      if (!popRef.current?.contains(event.target as Node | null)) setPopover(null);\n143|    };\n144|    const onKey = (event: KeyboardEvent) => {\n145|      if (event.key === \"Escape\") setPopover(null);\n146|    };\n147|    document.addEventListener(\"mousedown\", onDown);\n148|    document.addEventListener(\"keydown\", onKey);\n149|    return () => {\n150|      document.removeEventListener(\"mousedown\", onDown);\n151|      document.removeEventListener(\"keydown\", onKey);\n152|    };\n153|  }, [popover]);\n154|\n155|  const loading = card.phase === \"loading\";\n156|  return {\n157|    card,\n158|    popover: loading ? null : popover,\n159|    viewRef,\n160|    popRef,\n161|    illustrateScene,\n162|    illustratePassage,\n163|    hidePopover,\n164|    dismissCard,\n165|  };\n166|}\n167|\n168|// Inline result slot under the scene heading: image, loading, and error\n169|// share one place, with a dismiss button on the finished card.\n170|export function PictureSlot({\n171|  card,\n172|  onDismiss,\n173|}: {\n174|  card: PictureCard;\n175|  onDismiss: () => void;\n176|}) {\n177|  if (card.phase === \"idle\") return null;\n178|  return (\n179|    <div className=\"picture-slot\">\n180|      {card.phase === \"ready\" ? (\n181|        <figure className=\"picture-card\">\n182|          <img src={card.url} alt={card.caption} className=\"picture-img\" />\n183|          <figcaption>\n184|            {card.caption} <span className=\"picture-flag\">{card.cached ? \"Saved\" : \"New\"}</span>\n185|            <button\n186|              type=\"button\"\n187|              className=\"picture-dismiss\"\n188|              onClick={onDismiss}\n189|              aria-label=\"Dismiss image\"\n190|              title=\"Dismiss image\"\n191|            >\n192|              ×\n193|            </button>\n194|          </figcaption>\n195|        </figure>\n196|      ) : card.phase === \"loading\" ? (\n197|        <div className=\"picture-loading\" role=\"status\" aria-label=\"Illustrating\">\n198|          Illustrating…\n199|        </div>\n200|      ) : (\n201|        <p className=\"picture-error\" role=\"alert\">\n202|          {card.message}\n203|        </p>\n204|      )}\n205|    </div>\n206|  );\n207|}"}}
