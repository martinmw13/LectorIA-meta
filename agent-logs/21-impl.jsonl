;\n171|  }\n172|  return (\n173|    `Scene \"${args.sceneTitle}\". Passage: ${clip(args.passageText, MAX_PASSAGE_CHARS)}. ` +\n174|    `Context: ${clip(args.sceneClip, MAX_SCENE_CLIP_CHARS)}. ${style}`\n175|  );\n176|}\n177|\n178|export function buildCaption(args: {\n179|  kind: ImageKind;\n180|  sceneTitle: string;\n181|  passageText: string;\n182|}): string {\n183|  if (args.kind === \"scene\") return args.sceneTitle;\n184|  const words = args.passageText.replace(/\\s+/g, \" \").trim().split(\" \").slice(0, 10);\n185|  const head = words.join(\" \");\n186|  return words.length >= 10 ? `${head}…` : head;\n187|}\n188|\n189|// In-memory KV for tests. Expiries are checked against Date.now.\n190|export function createMemoryKV(): KV & { clear(): void } {\n191|  const values = new Map<string, string>();\n192|  const expiresAt = new Map<string, number>();\n193|  function live(key: string): boolean {\n194|    const until = expiresAt.get(key);\n195|    if (until !== undefined && Date.now() >= until) {\n196|      values.delete(key);\n197|      expiresAt.delete(key);\n198|      return false;\n199|    }\n200|    return true;\n201|  }\n202|  function num(key: string): number {\n203|    return Number(values.get(key) ?? \"0\");\n204|  }\n205|  return {\n206|    async get(key: string): Promise<string | null> {\n207|      if (!live(key)) return null;\n208|      return values.get(key) ?? null;\n209|    },\n210|    async setNxEx(key: string, value: string, exSec: number): Promise<boolean> {\n211|      if (live(key) && values.has(key)) return false;\n212|      values.set(key, value);\n213|      expiresAt.set(key, Date.now() + exSec * 1000);\n214|      return true;\n215|    },\n216|    async set(key: string, value: string): Promise<void> {\n217|      values.set(key, value);\n218|      expiresAt.delete(key);\n219|    },\n220|    async incr(key: string): Promise<number> {\n221|      const next = num(key) + 1;\n222|      values.set(key, String(next));\n223|      return next;\n224|    },\n225|    async incrBy(key: string, by: number): Promise<number> {\n226|      const next = num(key) + by;\n227|      values.set(key, String(next));\n228|      return next;\n229|    },\n230|    async decr(key: string): Promise<number> {\n231|      const next = num(key) - 1;\n232|      values.set(key, String(next));\n233|      return next;\n234|    },\n235|    async decrBy(key: string, by: number): Promise<number> {\n236|      const next = num(key) - by;\n237|      values.set(key, String(next));\n238|      return next;\n239|    },\n240|    async expire(key: string, sec: number): Promise<void> {\n241|      if (values.has(key)) expiresAt.set(key, Date.now() + sec * 1000);\n242|    },\n243|    async releaseIfToken(key: string, token: string): Promise<boolean> {\n244|      if (!live(key)) return false;\n245|      if (values.get(key) !== token) return false;\n246|      values.delete(key);\n247|      expiresAt.delete(key);\n248|      return true;\n249|    },\n250|    clear(): void {\n251|      values.clear();\n252|      expiresAt.clear();\n253|    },\n254|  };\n255|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e3","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":76,"recorded_at":1780531400000147,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c30f0877e5a9357e88819a584f","command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"text":"Read text file `core/types.ts`.\n1|// Shared shapes for the book pipeline. Every type stored in data files\n2|// lives here so core never imports from pipeline.\n3|export const EMOTIONS = [\n4|  \"calma\",\n5|  \"alegria\",\n6|  \"tristeza\",\n7|  \"suspenso\",\n8|  \"misterio\",\n9|  \"aventura\",\n10|  \"combate\",\n11|  \"asombro\",\n12|] as const;\n13|\n14|export type EmotionId = (typeof EMOTIONS)[number];\n15|export type JevEmotionId = EmotionId | \"unknown\";\n16|\n17|export interface Book {\n18|  id: string;\n19|  title: string;\n20|  author: string;\n21|  source: { gutenberg: number; url: string };\n22|  textVersion: string;\n23|  chapters: Chapter[];\n24|  paragraphs: Paragraph[];\n25|}\n26|\n27|export interface Chapter {\n28|  ch: number;\n29|  title: string;\n30|  start_n: number;\n31|  end_n: number;\n32|}\n33|\n34|export interface Paragraph {\n35|  id: string;\n36|  ch: number;\n37|  n: number;\n38|  text: string;\n39|}\n40|\n41|export interface SceneInput {\n42|  start_n: number;\n43|  end_n: number;\n44|  title: string;\n45|  summary: string;\n46|  characters: string[];\n47|}\n48|\n49|export interface Scene extends SceneInput {\n50|  id: string;\n51|  ch: number;\n52|}\n53|\n54|export type Vector8 = Record<EmotionId, number>;\n55|export type Vector9 = Record<JevEmotionId, number>;\n56|\n57|// Jev classification of one scene. A hard failure leaves this null and\n58|// stores no vector, so the scene keeps the previous track.\n59|export interface JevResult {\n60|  vector: Vector9;\n61|  choice: JevEmotionId;\n62|  confidence: number;\n63|  intensity: number;\n64|  intensity_confidence: number;\n65|  tempo: number;\n66|  tempo_confidence: number;\n67|  model: string;\n68|  input_tokens: number;\n69|  output_tokens: number;\n70|}\n71|\n72|export interface OverrideResult {\n73|  vector: Vector8;\n74|  reason: string;\n75|  model: string;\n76|}\n77|\n78|export interface SceneEmotion {\n79|  jev: JevResult | null;\n80|  muse_override: OverrideResult | null;\n81|  final: { vector: Vector8; intensity: number; tempo: number } | null;\n82|  error: string | null;\n83|}\n84|\n85|export type AnalyzedScene = Scene & SceneEmotion;\n86|\n87|export const LOW_CONFIDENCE = 0.6;\n88|export const FEATURE_WEIGHTS = { intensity: 0.5, tempo: 0.5 } as const;\n89|\n90|// Image API contract. Passage names the paragraph where the selection\n91|// starts; scene names the scene id. The cache key holds only the key\n92|// fields plus PROMPT_VERSION, so a repeat tap reuses the stored image.\n93|export type ImageKind = \"passage\" | \"scene\";\n94|\n95|export interface PassageRequest {\n96|  kind: \"passage\";\n97|  bookId: string;\n98|  textVersion: string;\n99|  n: number;\n100|}\n101|\n102|export interface SceneRequest {\n103|  kind: \"scene\";\n104|  bookId: string;\n105|  textVersion: string;\n106|  sceneId: string;\n107|}\n108|\n109|export type ImageRequest = PassageRequest | SceneRequest;\n110|\n111|export type ImageErrorCode = \"quota\" | \"budget\" | \"unavailable\" | \"bad_request\";\n112|\n113|export type ImageResponse =\n114|  | { status: \"ready\"; url: string; cached: boolean; caption: string }\n115|  | { status: \"pending\" }\n116|  | { status: \"error\"; code: ImageErrorCode; message: string };\n117|\n118|export const PROMPT_VERSION = \"v1\" as const;\n119|\n120|// shortcut: USD 0.01 per image per the spike, revisit if Meta reprices.\n121|export const IMAGE_COST_MICRO = 10000 as const;\n122|\n123|export interface ChatMessage {\n124|  role: \"user\" | \"assistant\";\n125|  text: string;\n126|}\n127|\n128|// Chat API contract. Server builds context from the book text up to\n129|// positionN (whole book when spoilerMode), prefix first, question last.\n130|export interface ChatRequest {\n131|  bookId: string;\n132|  textVersion: string;\n133|  positionN: number;\n134|  spoilerMode: boolean;\n135|  messages: ChatMessage[];\n136|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e5","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":77,"recorded_at":1780531400000149,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c3100c759087e055d352aa7bf6","command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"text":"Read text file `server/images/env.ts`.\n1|import \"server-only\";\n2|\n3|// Reads image env once per request. Any missing key means unavailable:\n4|// with no quotas or budget configured, the route must never spend.\n5|export interface ImageEnv {\n6|  upstashUrl: string;\n7|  upstashToken: string;\n8|  metaKey: string;\n9|  sessionSecret: string;\n10|  ipSalt: string;\n11|  spendCapMicro: number;\n12|}\n13|\n14|// Vercel's Upstash marketplace integration injects KV_REST_API_* names.\n15|// UPSTASH_* wins when non-empty, else the KV_* fallback applies per value.\n16|// The read-only token is never used (we write).\n17|const URL_NAMES = \"UPSTASH_REDIS_REST_URL|KV_REST_API_URL\";\n18|const TOKEN_NAMES = \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\";\n19|\n20|const REQUIRED = [\n21|  \"BLOB_READ_WRITE_TOKEN\",\n22|  \"META_API_KEY\",\n23|  \"SESSION_SECRET\",\n24|  \"IP_HASH_SALT\",\n25|] as const;\n26|\n27|export function readImageEnv(from: NodeJS.ProcessEnv = process.env): ImageEnv {\n28|  const upstashUrl = from.UPSTASH_REDIS_REST_URL || from.KV_REST_API_URL;\n29|  const upstashToken = from.UPSTASH_REDIS_REST_TOKEN || from.KV_REST_API_TOKEN;\n30|  const missing = [\n31|    upstashUrl ? null : URL_NAMES,\n32|    upstashToken ? null : TOKEN_NAMES,\n33|    ...REQUIRED.filter((k) => !from[k]),\n34|  ].filter((m): m is string => m !== null);\n35|  if (missing.length > 0) throw new Error(`missing image env: ${missing.join(\",\")}`);\n36|  const capUsd = Number(from.SPEND_CAP_USD ?? \"10\");\n37|  return {\n38|    upstashUrl: upstashUrl as string,\n39|    upstashToken: upstashToken as string,\n40|    metaKey: from.META_API_KEY as string,\n41|    sessionSecret: from.SESSION_SECRET as string,\n42|    ipSalt: from.IP_HASH_SALT as string,\n43|    spendCapMicro: Math.round((Number.isFinite(capUsd) ? capUsd : 10) * 1_000_000),\n44|  };\n45|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e7","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":78,"recorded_at":1780531400000151,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c3112073c8b31a327a7b13b27d","command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"text":"Read text file `server/images/orchestrate.ts`.\n1|import \"server-only\";\n2|import { randomUUID } from \"node:crypto\";\n3|import {\n4|  MSG_FAILED,\n5|  MSG_QUOTA,\n6|  MSG_BUDGET,\n7|  LOCK_TTL_SEC,\n8|  buildCaption,\n9|  buildPrompt,\n10|  budgetExceeded,\n11|  imageCostMicro,\n12|  imageKey,\n13|  indexKeyFor,\n14|  lockKeyFor,\n15|  spendKey,\n16|} from \"@/core/images\";\n17|import type { ImageGenerator, ImageRequest, ImageResponse, ImageStore, KV } from \"@/core/images\";\n18|import type { ImageEnv } from \"./env\";\n19|import { verifyHuman } from \"./human\";\n20|import { checkQuota, hashIp, quotaKeysFor, refundQuota } from \"./quota\";\n21|\n22|export interface ImageContent {\n23|  passageText: string;\n24|  sceneTitle: string;\n25|  sceneClip: string;\n26|}\n27|\n28|export interface OrchestrateDeps {\n29|  kv: KV;\n30|  store: ImageStore;\n31|  generate: ImageGenerator;\n32|  env: ImageEnv;\n33|  content: ImageContent;\n34|  ip: string;\n35|  anonId: string;\n36|  day: string;\n37|  token?: string;\n38|}\n39|\n40|// One pass, no skipped steps: hit -> lock -> human -> quota -> budget ->\n41|// generate -> store -> index -> release. Every failure after the reserve\n42|// refunds quota and budget and releases the lock.\n43|export async function orchestrate(\n44|  req: ImageRequest,\n45|  deps: OrchestrateDeps,\n46|): Promise<ImageResponse> {\n47|  const key = imageKey(req);\n48|  const indexKey = indexKeyFor(key);\n49|  const lockKey = lockKeyFor(key);\n50|\n51|  const indexed = await deps.kv.get(indexKey);\n52|  if (indexed) {\n53|    return { status: \"ready\", url: indexed, cached: true, caption: captionFor(req, deps.content) };\n54|  }\n55|  const existing = await deps.store.findUrl(key);\n56|  if (existing) {\n57|    await deps.kv.set(indexKey, existing);\n58|    return { status: \"ready\", url: existing, cached: true, caption: captionFor(req, deps.content) };\n59|  }\n60|\n61|  const token = deps.token ?? randomUUID();\n62|  if (!(await deps.kv.setNxEx(lockKey, token, LOCK_TTL_SEC))) return { status: \"pending\" };\n63|\n64|  // Best-effort unlock: a release failure must never turn into a client 500.\n65|  const release = async (): Promise<void> => {\n66|    try {\n67|      await deps.kv.releaseIfToken(lockKey, token);\n68|    } catch {\n69|      // Lock expires on its own; nothing to do.\n70|    }\n71|  };\n72|\n73|  const keys = quotaKeysFor({ day: deps.day, ip: deps.ip, salt: deps.env.ipSalt, anonId: deps.anonId });\n74|  let quotaTaken = false;\n75|  let spendTaken = false;\n76|  // Best-effort refunds that clear their flag only after the write lands,\n77|  // so the outer catch refunds each reserve exactly once.\n78|  const refundQuotaOnce = async (): Promise<void> => {\n79|    try {\n80|      await refundQuota(deps.kv, keys);\n81|      quotaTaken = false;\n82|    } catch {\n83|      // Redis down: nothing reserved server-side to retry against.\n84|    }\n85|  };\n86|  const refundSpendOnce = async (): Promise<void> => {\n87|    try {\n88|      await deps.kv.decrBy(spendKey(), imageCostMicro());\n89|      spendTaken = false;\n90|    } catch {\n91|      // Redis down: nothing reserved server-side to retry against.\n92|    }\n93|  };\n94|\n95|  try {\n96|    if (!verifyHuman()) {\n97|      await release();\n98|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n99|    }\n100|\n101|    if (!(await checkQuota(deps.kv, keys)).ok) {\n102|      await release();\n103|      return { status: \"error\", code: \"quota\", message: MSG_QUOTA };\n104|    }\n105|    quotaTaken = true;\n106|\n107|    const total = await deps.kv.incrBy(spendKey(), imageCostMicro());\n108|    spendTaken = true;\n109|    if (budgetExceeded(total, deps.env.spendCapMicro)) {\n110|      await refundSpendOnce();\n111|      await refundQuotaOnce();\n112|      await release();\n113|      return { status: \"error\", code: \"budget\", message: MSG_BUDGET };\n114|    }\n115|\n116|    let bytes: Uint8Array;\n117|    try {\n118|      bytes = await deps.generate.generate(\n119|        buildPrompt({\n120|          kind: req.kind,\n121|          passageText: deps.content.passageText,\n122|          sceneTitle: deps.content.sceneTitle,\n123|          sceneClip: deps.content.sceneClip,\n124|        }),\n125|      );\n126|    } catch {\n127|      await refundSpendOnce();\n128|      await refundQuotaOnce();\n129|      await release();\n130|      console.error(\"image generate failed\");\n131|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n132|    }\n133|\n134|    try {\n135|      const url = await deps.store.save(key, bytes);\n136|      try {\n137|        await deps.kv.set(indexKey, url);\n138|      } catch {\n139|        console.error(\"image index failed\");\n140|        await release();\n141|        return { status: \"ready\", url, cached: false, caption: captionFor(req, deps.content) };\n142|      }\n143|      await release();\n144|      return { status: \"ready\", url, cached: false, caption: captionFor(req, deps.content) };\n145|    } catch {\n146|      // A lost save race leaves the winner's file behind; backfill from it.\n147|      const raced = await deps.store.findUrl(key);\n148|      if (raced) {\n149|        try {\n150|          await deps.kv.set(indexKey, raced);\n151|        } catch {\n152|          console.error(\"image index failed\");\n153|        }\n154|        await release();\n155|        return { status: \"ready\", url: raced, cached: true, caption: captionFor(req, deps.content) };\n156|      }\n157|      await refundSpendOnce();\n158|      await refundQuotaOnce();\n159|      await release();\n160|      console.error(\"image store failed\");\n161|      return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n162|    }\n163|  } catch {\n164|    if (spendTaken) await refundSpendOnce();\n165|    if (quotaTaken) await refundQuotaOnce();\n166|    await release();\n167|    console.error(\"image request failed\");\n168|    return { status: \"error\", code: \"unavailable\", message: MSG_FAILED };\n169|  }\n170|}\n171|\n172|function captionFor(req: ImageRequest, content: ImageContent): string {\n173|  return buildCaption({\n174|    kind: req.kind,\n175|    sceneTitle: content.sceneTitle,\n176|    passageText: content.passageText,\n177|  });\n178|}"}}
