{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c801","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":603,"recorded_at":1780531400001201,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","event":{"chunk":"edited\nchanged lines: lines 121-128\n--- original\n+++ updated\n@@\n-    const total = await deps.kv.incrBy(spendKey(), imageCostMicro());\n-    spendTaken = true;\n-    if (budgetExceeded(total, deps.env.spendCapMicro)) {\n-      await refundSpendOnce();\n-      await refundQuotaOnce();\n-      await release();\n-      return { status: \"error\", code: \"budget\", message: MSG_BUDGET };\n-    }\n+    // Both caps apply only to requests paid with our key. The future\n+    // BYOK path must skip these reserves and check its own key instead.\n+    const total = await deps.kv.incrBy(spendKey(), imageCostMicro());\n+    spendTaken = true;\n+    if (budgetExceeded(total, deps.env.spendCapMicro)) {\n+      await refundSpendOnce();\n+      await refundQuotaOnce();\n+      await release();\n+      return { status: \"error\", code: \"budget\", message: MSG_BUDGET_TOTAL };\n+    }\n+\n+    const dailyTotal = await deps.kv.incrBy(dailyKey, imageCostMicro());\n+    dailySpendTaken = true;\n+    // Refresh the expiry on every reserve: cheap, idempotent, and keeps\n+    // the key alive through a busy day without a separate read.\n+    await deps.kv.expire(dailyKey, DAILY_SPEND_TTL_SEC);\n+    if (budgetExceeded(dailyTotal, deps.env.dailySpendCapMicro)) {\n+      await refundDailySpendOnce();\n+      await refundSpendOnce();\n+      await refundQuotaOnce();\n+      await release();\n+      return { status: \"error\", code: \"daily_budget\", message: MSG_BUDGET_DAILY };\n+    }\n","final_result":true,"kind":"output","task_id":"01a182c4-582a-7223-8e12-90a04296c9e8"},"kind":"task_lifecycle","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"task_id":"01a182c4-582a-7223-8e12-90a04296c9e8","task_stream":{"id":"01a182c4-582a-7223-8e12-90a04296c9e8","kind":"task"}}}
