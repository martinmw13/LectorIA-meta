{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cf","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":194,"recorded_at":1780531400000383,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c3229775af948bfad1bd9ed981","command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"text":"Read text file `server/images/env.test.ts`.\n1|import { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n2|import { readImageEnv } from \"./env\";\n3|\n4|const BASE = {\n5|  BLOB_READ_WRITE_TOKEN: \"test-blob\",\n6|  META_API_KEY: \"test-meta\",\n7|  SESSION_SECRET: \"test-session\",\n8|  IP_HASH_SALT: \"test-salt\",\n9|} as const;\n10|\n11|const REDIS_KEYS = [\n12|  \"UPSTASH_REDIS_REST_URL\",\n13|  \"UPSTASH_REDIS_REST_TOKEN\",\n14|  \"KV_REST_API_URL\",\n15|  \"KV_REST_API_TOKEN\",\n16|  \"KV_REST_API_READ_ONLY_TOKEN\",\n17|] as const;\n18|\n19|let saved: Record<string, string | undefined>;\n20|\n21|beforeEach(() => {\n22|  saved = {};\n23|  for (const k of [...Object.keys(BASE), ...REDIS_KEYS]) saved[k] = process.env[k];\n24|  Object.assign(process.env, BASE);\n25|  for (const k of REDIS_KEYS) delete process.env[k];\n26|});\n27|\n28|afterEach(() => {\n29|  for (const k of Object.keys(saved)) {\n30|    if (saved[k] === undefined) delete process.env[k];\n31|    else process.env[k] = saved[k];\n32|  }\n33|});\n34|\n35|describe(\"readImageEnv redis fallback\", () => {\n36|  it(\"prefers UPSTASH_* when both are set\", () => {\n37|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n38|    process.env.UPSTASH_REDIS_REST_TOKEN = \"upstash-token\";\n39|    process.env.KV_REST_API_URL = \"https://kv-url\";\n40|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n41|    const env = readImageEnv();\n42|    expect(env.upstashUrl).toBe(\"https://upstash-url\");\n43|    expect(env.upstashToken).toBe(\"upstash-token\");\n44|  });\n45|\n46|  it(\"uses KV_REST_API_* when UPSTASH_* is absent\", () => {\n47|    process.env.KV_REST_API_URL = \"https://kv-url\";\n48|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n49|    const env = readImageEnv();\n50|    expect(env.upstashUrl).toBe(\"https://kv-url\");\n51|    expect(env.upstashToken).toBe(\"kv-token\");\n52|  });\n53|\n54|  it(\"uses KV_REST_API_* when UPSTASH_* is empty\", () => {\n55|    process.env.UPSTASH_REDIS_REST_URL = \"\";\n56|    process.env.UPSTASH_REDIS_REST_TOKEN = \"\";\n57|    process.env.KV_REST_API_URL = \"https://kv-url\";\n58|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n59|    const env = readImageEnv();\n60|    expect(env.upstashUrl).toBe(\"https://kv-url\");\n61|    expect(env.upstashToken).toBe(\"kv-token\");\n62|  });\n63|\n64|  it(\"falls back each value independently\", () => {\n65|    process.env.UPSTASH_REDIS_REST_URL = \"https://upstash-url\";\n66|    process.env.KV_REST_API_TOKEN = \"kv-token\";\n67|    const env = readImageEnv();\n68|    expect(env.upstashUrl).toBe(\"https://upstash-url\");\n69|    expect(env.upstashToken).toBe(\"kv-token\");\n70|  });\n71|\n72|  it(\"does not accept the read-only token alone\", () => {\n73|    process.env.KV_REST_API_URL = \"https://kv-url\";\n74|    process.env.KV_REST_API_READ_ONLY_TOKEN = \"read-only-token\";\n75|    expect(() => readImageEnv()).toThrow(\n76|      \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\",\n77|    );\n78|  });\n79|\n80|  it(\"missing-env error lists names only, never values\", () => {\n81|    process.env.UPSTASH_REDIS_REST_URL = \"https://secret-url-value\";\n82|    let message = \"\";\n83|    try {\n84|      readImageEnv();\n85|    } catch (e) {\n86|      message = (e as Error).message;\n87|    }\n88|    expect(message).toContain(\"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\");\n89|    expect(message).not.toContain(\"secret-url-value\");\n90|  });\n91|});"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d1","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":195,"recorded_at":1780531400000385,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c323a372bc875dcb3dafbbe065","command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"text":"Read text file `server/images/orchestrate.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import { createMemoryKV, imageKey, lockKeyFor, spendKey } from \"@/core/images\";\n3|import type { ImageGenerator, ImageRequest, ImageStore } from \"@/core/images\";\n4|import type { ImageEnv } from \"./env\";\n5|import { orchestrate } from \"./orchestrate\";\n6|import type { OrchestrateDeps } from \"./orchestrate\";\n7|\n8|const env: ImageEnv = {\n9|  upstashUrl: \"https://x\",\n10|  upstashToken: \"t\",\n11|  metaKey: \"m\",\n12|  sessionSecret: \"s\",\n13|  ipSalt: \"salt\",\n14|  spendCapMicro: 10_000_000,\n15|};\n16|\n17|const content = {\n18|  passageText: \"Dorothy lived in the midst of the great Kansas prairies.\",\n19|  sceneTitle: \"Gray Life on the Prairie\",\n20|  sceneClip: \"Gray prairie and a small house.\",\n21|};\n22|\n23|const passage: ImageRequest = { kind: \"passage\", bookId: \"oz\", textVersion: \"t\", n: 3 };\n24|\n25|function deps(over: Partial<OrchestrateDeps> = {}): OrchestrateDeps {\n26|  const files = new Map<string, Uint8Array>();\n27|  const store: ImageStore = {\n28|    findUrl: async (path) =>\n29|      files.has(path) ? `https://blob.example/${path}` : null,\n30|    save: async (path, bytes) => {\n31|      if (files.has(path)) throw new Error(\"overwrite\");\n32|      files.set(path, bytes);\n33|      return `https://blob.example/${path}`;\n34|    },\n35|  };\n36|  const generate: ImageGenerator = {\n37|    generate: async () => new Uint8Array([1, 2, 3]),\n38|  };\n39|  return {\n40|    kv: createMemoryKV(),\n41|    store,\n42|    generate,\n43|    env,\n44|    content,\n45|    ip: \"1.2.3.4\",\n46|    anonId: \"anon-1\",\n47|    day: \"2026-10-27\",\n48|    ...over,\n49|  };\n50|}\n51|\n52|describe(\"orchestrate\", () => {\n53|  it(\"returns a cached hit without touching Meta, quota, or budget\", async () => {\n54|    const d = deps();\n55|    let calls = 0;\n56|    d.generate = { generate: async () => (calls++, new Uint8Array([9])) };\n57|    const first = await orchestrate(passage, d);\n58|    expect(first.status).toBe(\"ready\");\n59|    expect(calls).toBe(1);\n60|\n61|    const d2 = deps({ kv: d.kv, store: d.store, generate: d.generate });\n62|    const second = await orchestrate(passage, d2);\n63|    expect(second).toMatchObject({ status: \"ready\", cached: true });\n64|    expect(calls).toBe(1);\n65|    expect(await d.kv.get(spendKey())).toBe(\"10000\");\n66|  });\n67|\n68|  it(\"backfills the index from Blob when Redis missed\", async () => {\n69|    const d = deps();\n70|    await d.store.save(\"images/oz/t/v1/p3.webp\", new Uint8Array([1]));\n71|    let calls = 0;\n72|    d.generate = { generate: async () => (calls++, new Uint8Array([9])) };\n73|    const res = await orchestrate(passage, d);\n74|    expect(res).toMatchObject({ status: \"ready\", cached: true });\n75|    expect(calls).toBe(0);\n76|  });\n77|\n78|  it(\"gives pending to a second requester holding no lock\", async () => {\n79|    const d = deps();\n80|    let releaseGen!: (bytes: Uint8Array) => void;\n81|    let genCalled!: () => void;\n82|    const called = new Promise<void>((resolve) => (genCalled = resolve));\n83|    d.generate = {\n84|      generate: () =>\n85|        new Promise<Uint8Array>((resolve) => {\n86|          releaseGen = resolve;\n87|          genCalled();\n88|        }),\n89|    };\n90|    const held = orchestrate(passage, { ...d, token: \"owner\" });\n91|    await called;\n92|    const res = await orchestrate(passage, { ...d, token: \"other\" });\n93|    expect(res).toEqual({ status: \"pending\" });\n94|    releaseGen(new Uint8Array([1]));\n95|    expect(await held).toMatchObject({ status: \"ready\" });\n96|  });\n97|\n98|  it(\"refuses the 6th image per person and refunds both counters\", async () => {\n99|    const d = deps();\n100|    for (let i = 0; i < 5; i++) {\n101|      // Distinct keys: repeat taps on one paragraph hit the cache for free.\n102|      const key: ImageRequest = { ...passage, n: 100 + i };\n103|      const res = await orchestrate(key, { ...d, anonId: `fresh-${i}` });\n104|      expect(res.status).toBe(\"ready\");\n105|    }\n106|    const kv = d.kv;\n107|    const before = await kv.get(spendKey());\n108|    const res = await orchestrate(passage, { ...d, anonId: \"fresh-5\" });\n109|    expect(res).toMatchObject({ status: \"error\", code: \"quota\" });\n110|    // Refund keeps counters at 5 so a new day key starts clean logic holds;\n111|    // spend did not move for the refused call.\n112|    expect(await kv.get(spendKey())).toBe(before);\n113|  });\n114|\n115|  it(\"refunds quota and budget on Meta failure with no raw error text\", async () => {\n116|    const d = deps();\n117|    d.generate = {\n118|      generate: async () => {\n119|        throw new Error(\"meta secret internals 500\");\n120|      },\n121|    };\n122|    const res = await orchestrate(passage, d);\n123|    expect(res).toMatchObject({ status: \"error\", code: \"unavailable\" });\n124|    expect(JSON.stringify(res)).not.toContain(\"secret internals\");\n125|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n126|    // Lock released: a new request generates instead of pending.\n127|    const retry = await orchestrate(passage, {\n128|      ...d,\n129|      generate: { generate: async () => new Uint8Array([7]) },\n130|    });\n131|    expect(retry.status).toBe(\"ready\");\n132|  });\n133|\n134|  it(\"refuses over the spend cap and refunds the reserve\", async () => {\n135|    const d = deps({ env: { ...env, spendCapMicro: 1 } });\n136|    const res = await orchestrate(passage, d);\n137|    expect(res).toMatchObject({ status: \"error\", code: \"budget\" });\n138|    expect(await d.kv.get(spendKey())).toBe(\"0\");\n139|  });\n140|\n141|  it(\"refuses when the cookie counter runs out while IPs stay fresh\", async () => {\n142|    const d = deps();\n143|    for (let i = 0; i < 5; i++) {\n144|      const res = await orchestrate({ ...passage, n: 400 + i }, { ...d, ip: `10.0.0.${i}` });\n145|      expect(res.status).toBe(\"ready\");\n146|    }\n147|    const res = await orchestrate({ ...passage, n: 405 }, { ...d, ip: \"10.9.9.9\" });\n148|    expect(res).toMatchObject({ status: \"error\", code: \"quota\" });\n149|    expect(await d.kv.get(spendKey())).toBe(\"50000\");\n150|  });\n151|\n152|  it(\"resets quota on UTC day rollover\", async () => {\n153|    const d = deps();\n154|    for (let i = 0; i < 5; i++) {\n155|      const res = await orchestrate({ ...passage, n: 200 + i }, { ...d, day: \"2026-10-27\" });\n156|      expect(res.status).toBe(\"ready\");\n157|    }\n158|    const refused = await orchestrate(passage, { ...d, day: \"2026-10-27\" });\n159|    expect(refused).toMatchObject({ status: \"error\", code: \"quota\" });\n160|    const next = await orchestrate({ ...passage, n: 300 }, { ...d, day: \"2026-10-28\" });\n161|    expect(next.status).toBe(\"ready\");\n162|  });\n163|\n164|  it(\"returns generic text when KV throws after the lock\", async () => {\n165|    const d = deps();\n166|    const kv = { ...d.kv, incrBy: async (): Promise<number> => {\n167|      throw new Error(\"kv-boom-marker\");\n168|    } };\n169|    const res = await orchestrate(passage, { ...d, kv });\n170|    expect(res).toMatchObject({ status: \"error\", code: \"unavailable\" });\n171|    expect(JSON.stringify(res)).not.toContain(\"kv-boom-marker\");\n172|    expect(await kv.setNxEx(lockKeyFor(imageKey(passage)), \"probe\", 150)).toBe(true);\n173|  });\n174|\n175|  it(\"returns ready with the URL when the index write fails\", async () => {\n176|    const d = deps();\n177|    d.kv.set = async () => {\n178|      throw new Error(\"index-boom-marker\");\n179|    };\n180|    const res = await orchestrate(passage, d);\n181|    expect(res).toMatchObject({ status: \"ready\", cached: false });\n182|    expect(JSON.stringify(res)).not.toContain(\"index-boom-marker\");\n183|    expect(await d.kv.setNxEx(lockKeyFor(imageKey(passage)), \"probe\", 150)).toBe(true);\n184|  });\n185|\n186|  it(\"recovers from a lost save race through the winner file\", async () => {\n187|    const files = new Map<string, Uint8Array>();\n188|    const d = deps();\n189|    d.store = {\n190|      findUrl: async (path) => (files.has(path) ? `https://blob.example/${path}` : null),\n191|      save: async (path, bytes) => {\n192|        files.set(path, bytes);\n193|        throw new Error(\"race lost\");\n194|      },\n195|    };\n196|    const res = await orchestrate(passage, d);\n197|    expect(res).toMatchObject({ status: \"ready\", cached: true });\n198|  });\n199|});"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d3","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":196,"recorded_at":1780531400000387,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a182c324ee75de93195c05baf67d03","command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"text":"Read text file `core/images.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import {\n3|  budgetExceeded,\n4|  buildCaption,\n5|  buildPrompt,\n6|  canRelease,\n7|  createMemoryKV,\n8|  imageCostMicro,\n9|  imageKey,\n10|  indexKeyFor,\n11|  lockKeyFor,\n12|  overQuota,\n13|  parseImageRequest,\n14|  quotaKeys,\n15|  validateAgainstBook,\n16|} from \"./images\";\n17|import { IMAGE_COST_MICRO } from \"./types\";\n18|\n19|const book = {\n20|  id: \"oz\",\n21|  textVersion: \"t123\",\n22|  paragraphNs: new Set([1, 2, 3]),\n23|  sceneIds: new Set([\"c1s1\"]),\n24|};\n25|\n26|describe(\"parseImageRequest\", () => {\n27|  it(\"accepts a good passage body\", () => {\n28|    expect(\n29|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 }),\n30|    ).toEqual({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 });\n31|  });\n32|\n33|  it(\"accepts a good scene body\", () => {\n34|    expect(\n35|      parseImageRequest({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }),\n36|    ).toEqual({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" });\n37|  });\n38|\n39|  it(\"rejects a bad kind\", () => {\n40|    expect(() => parseImageRequest({ kind: \"chapter\", bookId: \"oz\" })).toThrow();\n41|  });\n42|\n43|  it(\"rejects extra fields\", () => {\n44|    expect(() =>\n45|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1, extra: 1 }),\n46|    ).toThrow();\n47|  });\n48|\n49|  it(\"rejects a non-integer n\", () => {\n50|    expect(() =>\n51|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1.5 }),\n52|    ).toThrow();\n53|  });\n54|\n55|  it(\"rejects non-objects\", () => {\n56|    for (const bad of [null, [], \"x\", 42]) {\n57|      expect(() => parseImageRequest(bad)).toThrow();\n58|    }\n59|  });\n60|});\n61|\n62|describe(\"validateAgainstBook\", () => {\n63|  it(\"accepts matching passage and scene\", () => {\n64|    expect(() =>\n65|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1 }, book),\n66|    ).not.toThrow();\n67|    expect(() =>\n68|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }, book),\n69|    ).not.toThrow();\n70|  });\n71|\n72|  it(\"rejects unknown book, wrong version, out of range n, unknown scene\", () => {\n73|    expect(() =>\n74|      validateAgainstBook({ kind: \"passage\", bookId: \"dorothy\", textVersion: \"t123\", n: 1 }, book),\n75|    ).toThrow();\n76|    expect(() =>\n77|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"old\", n: 1 }, book),\n78|    ).toThrow();\n79|    expect(() =>\n80|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 99 }, book),\n81|    ).toThrow();\n82|    expect(() =>\n83|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"nope\" }, book),\n84|    ).toThrow();\n85|  });\n86|});\n87|\n88|describe(\"imageKey\", () => {\n89|  it(\"uses only the start paragraph for passages\", () => {\n90|    expect(imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 7 })).toBe(\n91|      \"images/oz/t123/v1/p7.webp\",\n92|    );\n93|  });\n94|\n95|  it(\"uses the scene id for scenes\", () => {\n96|    expect(imageKey({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" })).toBe(\n97|      \"images/oz/t123/v1/scene-c1s1.webp\",\n98|    );\n99|  });\n100|\n101|  it(\"differs by book, version, and paragraph\", () => {\n102|    const a = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 1 });\n103|    const b = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t2\", n: 1 });\n104|    const c = imageKey({ kind: \"passage\", bookId: \"other\", textVersion: \"t1\", n: 1 });\n105|    const d = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 2 });\n106|    expect(new Set([a, b, c, d]).size).toBe(4);\n107|    expect(indexKeyFor(a)).toContain(a);\n108|    expect(lockKeyFor(a)).toContain(a);\n109|    expect(indexKeyFor(a)).not.toBe(lockKeyFor(a));\n110|  });\n111|});\n112|\n113|describe(\"buildPrompt\", () => {\n114|  const base = {\n115|    sceneTitle: \"The Cyclone\",\n116|    sceneClip: \"Gray prairie and a small house.\",\n117|  };\n118|\n119|  it(\"uses the trusted passage text and names the style guards\", () => {\n120|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"Dorothy ran outside.\", ...base });\n121|    expect(prompt).toContain(\"Dorothy ran outside.\");\n122|    expect(prompt).toContain(\"silver shoes\");\n123|    expect(prompt).toContain(\"No text\");\n124|    expect(prompt).toContain(\"no ruby slippers\");\n125|    expect(prompt).toContain(\"1939 MGM\");\n126|  });\n127|\n128|  it(\"clips a long passage near 600 chars\", () => {\n129|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"x\".repeat(2000), ...base });\n130|    const passagePart = prompt.split(\"Context:\")[0] ?? \"\";\n131|    expect(passagePart.length).toBeLessThan(900);\n132|  });\n133|\n134|  it(\"builds a scene prompt from the scene clip\", () => {\n135|    const prompt = buildPrompt({ kind: \"scene\", passageText: \"\", ...base });\n136|    expect(prompt).toContain(\"The Cyclone\");\n137|    expect(prompt).toContain(\"silver shoes\");\n138|  });\n139|});\n140|\n141|describe(\"buildCaption\", () => {\n142|  it(\"uses the scene title for scenes\", () => {\n143|    expect(buildCaption({ kind: \"scene\", sceneTitle: \"The Cyclone\", passageText: \"x\" })).toBe(\n144|      \"The Cyclone\",\n145|    );\n146|  });\n147|\n148|  it(\"uses the first words for passages\", () => {\n149|    expect(\n150|      buildCaption({ kind: \"passage\", sceneTitle: \"T\", passageText: \"Dorothy lived in Kansas.\" }),\n151|    ).toBe(\"Dorothy lived in Kansas.\");\n152|    expect(\n153|      buildCaption({\n154|        kind: \"passage\",\n155|        sceneTitle: \"T\",\n156|        passageText: \"one two three four five six seven eight nine ten eleven\",\n157|      }),\n158|    ).toBe(\"one two three four five six seven eight nine ten…\");\n159|  });\n160|});\n161|\n162|describe(\"quota and budget helpers\", () => {\n163|  it(\"refuses the 6th image per key\", () => {\n164|    expect(overQuota(5)).toBe(false);\n165|    expect(overQuota(6)).toBe(true);\n166|  });\n167|\n168|  it(\"builds day-scoped quota keys\", () => {\n169|    const keys = quotaKeys({ day: \"2026-10-27\", ipHash: \"h\", anonId: \"a\" });\n170|    expect(keys.ip).toContain(\"2026-10-27\");\n171|    expect(keys.anon).toContain(\"2026-10-27\");\n172|    expect(keys.ip).not.toBe(keys.anon);\n173|  });\n174|\n175|  it(\"flags a spend total over the cap\", () => {\n176|    expect(budgetExceeded(11_000_000, 10_000_000)).toBe(true);\n177|    expect(budgetExceeded(10_000_000, 10_000_000)).toBe(false);\n178|    expect(imageCostMicro()).toBe(IMAGE_COST_MICRO);\n179|  });\n180|\n181|  it(\"compares lock tokens\", () => {\n182|    expect(canRelease(\"t\", \"t\")).toBe(true);\n183|    expect(canRelease(\"t\", \"other\")).toBe(false);\n184|    expect(canRelease(\"t\", null)).toBe(false);\n185|  });\n186|});\n187|\n188|describe(\"memory KV lock\", () => {\n189|  it(\"gives a second requester pending and releases only with the token\", async () => {\n190|    const kv = createMemoryKV();\n191|    expect(await kv.setNxEx(\"k\", \"t1\", 60)).toBe(true);\n192|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(false);\n193|    expect(await kv.releaseIfToken(\"k\", \"t2\")).toBe(false);\n194|    expect(await kv.releaseIfToken(\"k\", \"t1\")).toBe(true);\n195|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(true);\n196|  });\n197|\n198|  it(\"supports quota counters with refund\", async () => {\n199|    const kv = createMemoryKV();\n200|    for (let i = 0; i < 5; i++) await kv.incr(\"q\");\n201|    expect(overQuota(await kv.incr(\"q\"))).toBe(true);\n202|    expect(await kv.decr(\"q\")).toBe(5);\n203|  });\n204|\n205|  it(\"supports the spend reserve and refund\", async () => {\n206|    const kv = createMemoryKV();\n207|    expect(await kv.incrBy(\"spend\", IMAGE_COST_MICRO)).toBe(IMAGE_COST_MICRO);\n208|    expect(budgetExceeded(IMAGE_COST_MICRO, 10_000_000)).toBe(false);\n209|    expect(await kv.decrBy(\"spend\", IMAGE_COST_MICRO)).toBe(0);\n210|  });\n211|});"}}
