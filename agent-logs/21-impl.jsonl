{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cb","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":192,"recorded_at":1780531400000379,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","event":{"chunk":"Read text file `core/images.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import {\n3|  budgetExceeded,\n4|  buildCaption,\n5|  buildPrompt,\n6|  canRelease,\n7|  createMemoryKV,\n8|  imageCostMicro,\n9|  imageKey,\n10|  indexKeyFor,\n11|  lockKeyFor,\n12|  overQuota,\n13|  parseImageRequest,\n14|  quotaKeys,\n15|  validateAgainstBook,\n16|} from \"./images\";\n17|import { IMAGE_COST_MICRO } from \"./types\";\n18|\n19|const book = {\n20|  id: \"oz\",\n21|  textVersion: \"t123\",\n22|  paragraphNs: new Set([1, 2, 3]),\n23|  sceneIds: new Set([\"c1s1\"]),\n24|};\n25|\n26|describe(\"parseImageRequest\", () => {\n27|  it(\"accepts a good passage body\", () => {\n28|    expect(\n29|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 }),\n30|    ).toEqual({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 2 });\n31|  });\n32|\n33|  it(\"accepts a good scene body\", () => {\n34|    expect(\n35|      parseImageRequest({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }),\n36|    ).toEqual({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" });\n37|  });\n38|\n39|  it(\"rejects a bad kind\", () => {\n40|    expect(() => parseImageRequest({ kind: \"chapter\", bookId: \"oz\" })).toThrow();\n41|  });\n42|\n43|  it(\"rejects extra fields\", () => {\n44|    expect(() =>\n45|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1, extra: 1 }),\n46|    ).toThrow();\n47|  });\n48|\n49|  it(\"rejects a non-integer n\", () => {\n50|    expect(() =>\n51|      parseImageRequest({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1.5 }),\n52|    ).toThrow();\n53|  });\n54|\n55|  it(\"rejects non-objects\", () => {\n56|    for (const bad of [null, [], \"x\", 42]) {\n57|      expect(() => parseImageRequest(bad)).toThrow();\n58|    }\n59|  });\n60|});\n61|\n62|describe(\"validateAgainstBook\", () => {\n63|  it(\"accepts matching passage and scene\", () => {\n64|    expect(() =>\n65|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 1 }, book),\n66|    ).not.toThrow();\n67|    expect(() =>\n68|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" }, book),\n69|    ).not.toThrow();\n70|  });\n71|\n72|  it(\"rejects unknown book, wrong version, out of range n, unknown scene\", () => {\n73|    expect(() =>\n74|      validateAgainstBook({ kind: \"passage\", bookId: \"dorothy\", textVersion: \"t123\", n: 1 }, book),\n75|    ).toThrow();\n76|    expect(() =>\n77|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"old\", n: 1 }, book),\n78|    ).toThrow();\n79|    expect(() =>\n80|      validateAgainstBook({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 99 }, book),\n81|    ).toThrow();\n82|    expect(() =>\n83|      validateAgainstBook({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"nope\" }, book),\n84|    ).toThrow();\n85|  });\n86|});\n87|\n88|describe(\"imageKey\", () => {\n89|  it(\"uses only the start paragraph for passages\", () => {\n90|    expect(imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t123\", n: 7 })).toBe(\n91|      \"images/oz/t123/v1/p7.webp\",\n92|    );\n93|  });\n94|\n95|  it(\"uses the scene id for scenes\", () => {\n96|    expect(imageKey({ kind: \"scene\", bookId: \"oz\", textVersion: \"t123\", sceneId: \"c1s1\" })).toBe(\n97|      \"images/oz/t123/v1/scene-c1s1.webp\",\n98|    );\n99|  });\n100|\n101|  it(\"differs by book, version, and paragraph\", () => {\n102|    const a = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 1 });\n103|    const b = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t2\", n: 1 });\n104|    const c = imageKey({ kind: \"passage\", bookId: \"other\", textVersion: \"t1\", n: 1 });\n105|    const d = imageKey({ kind: \"passage\", bookId: \"oz\", textVersion: \"t1\", n: 2 });\n106|    expect(new Set([a, b, c, d]).size).toBe(4);\n107|    expect(indexKeyFor(a)).toContain(a);\n108|    expect(lockKeyFor(a)).toContain(a);\n109|    expect(indexKeyFor(a)).not.toBe(lockKeyFor(a));\n110|  });\n111|});\n112|\n113|describe(\"buildPrompt\", () => {\n114|  const base = {\n115|    sceneTitle: \"The Cyclone\",\n116|    sceneClip: \"Gray prairie and a small house.\",\n117|  };\n118|\n119|  it(\"uses the trusted passage text and names the style guards\", () => {\n120|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"Dorothy ran outside.\", ...base });\n121|    expect(prompt).toContain(\"Dorothy ran outside.\");\n122|    expect(prompt).toContain(\"silver shoes\");\n123|    expect(prompt).toContain(\"No text\");\n124|    expect(prompt).toContain(\"no ruby slippers\");\n125|    expect(prompt).toContain(\"1939 MGM\");\n126|  });\n127|\n128|  it(\"clips a long passage near 600 chars\", () => {\n129|    const prompt = buildPrompt({ kind: \"passage\", passageText: \"x\".repeat(2000), ...base });\n130|    const passagePart = prompt.split(\"Context:\")[0] ?? \"\";\n131|    expect(passagePart.length).toBeLessThan(900);\n132|  });\n133|\n134|  it(\"builds a scene prompt from the scene clip\", () => {\n135|    const prompt = buildPrompt({ kind: \"scene\", passageText: \"\", ...base });\n136|    expect(prompt).toContain(\"The Cyclone\");\n137|    expect(prompt).toContain(\"silver shoes\");\n138|  });\n139|});\n140|\n141|describe(\"buildCaption\", () => {\n142|  it(\"uses the scene title for scenes\", () => {\n143|    expect(buildCaption({ kind: \"scene\", sceneTitle: \"The Cyclone\", passageText: \"x\" })).toBe(\n144|      \"The Cyclone\",\n145|    );\n146|  });\n147|\n148|  it(\"uses the first words for passages\", () => {\n149|    expect(\n150|      buildCaption({ kind: \"passage\", sceneTitle: \"T\", passageText: \"Dorothy lived in Kansas.\" }),\n151|    ).toBe(\"Dorothy lived in Kansas.\");\n152|    expect(\n153|      buildCaption({\n154|        kind: \"passage\",\n155|        sceneTitle: \"T\",\n156|        passageText: \"one two three four five six seven eight nine ten eleven\",\n157|      }),\n158|    ).toBe(\"one two three four five six seven eight nine ten…\");\n159|  });\n160|});\n161|\n162|describe(\"quota and budget helpers\", () => {\n163|  it(\"refuses the 6th image per key\", () => {\n164|    expect(overQuota(5)).toBe(false);\n165|    expect(overQuota(6)).toBe(true);\n166|  });\n167|\n168|  it(\"builds day-scoped quota keys\", () => {\n169|    const keys = quotaKeys({ day: \"2026-10-27\", ipHash: \"h\", anonId: \"a\" });\n170|    expect(keys.ip).toContain(\"2026-10-27\");\n171|    expect(keys.anon).toContain(\"2026-10-27\");\n172|    expect(keys.ip).not.toBe(keys.anon);\n173|  });\n174|\n175|  it(\"flags a spend total over the cap\", () => {\n176|    expect(budgetExceeded(11_000_000, 10_000_000)).toBe(true);\n177|    expect(budgetExceeded(10_000_000, 10_000_000)).toBe(false);\n178|    expect(imageCostMicro()).toBe(IMAGE_COST_MICRO);\n179|  });\n180|\n181|  it(\"compares lock tokens\", () => {\n182|    expect(canRelease(\"t\", \"t\")).toBe(true);\n183|    expect(canRelease(\"t\", \"other\")).toBe(false);\n184|    expect(canRelease(\"t\", null)).toBe(false);\n185|  });\n186|});\n187|\n188|describe(\"memory KV lock\", () => {\n189|  it(\"gives a second requester pending and releases only with the token\", async () => {\n190|    const kv = createMemoryKV();\n191|    expect(await kv.setNxEx(\"k\", \"t1\", 60)).toBe(true);\n192|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(false);\n193|    expect(await kv.releaseIfToken(\"k\", \"t2\")).toBe(false);\n194|    expect(await kv.releaseIfToken(\"k\", \"t1\")).toBe(true);\n195|    expect(await kv.setNxEx(\"k\", \"t2\", 60)).toBe(true);\n196|  });\n197|\n198|  it(\"supports quota counters with refund\", async () => {\n199|    const kv = createMemoryKV();\n200|    for (let i = 0; i < 5; i++) await kv.incr(\"q\");\n201|    expect(overQuota(await kv.incr(\"q\"))).toBe(true);\n202|    expect(await kv.decr(\"q\")).toBe(5);\n203|  });\n204|\n205|  it(\"supports the spend reserve and refund\", async () => {\n206|    const kv = createMemoryKV();\n207|    expect(await kv.incrBy(\"spend\", IMAGE_COST_MICRO)).toBe(IMAGE_COST_MICRO);\n208|    expect(budgetExceeded(IMAGE_COST_MICRO, 10_000_000)).toBe(false);\n209|    expect(await kv.decrBy(\"spend\", IMAGE_COST_MICRO)).toBe(0);\n210|  });\n211|});","final_result":true,"kind":"output","task_id":"01a182c3-264d-7b33-a7bb-a96e1a8e3fca"},"kind":"task_lifecycle","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"task_id":"01a182c3-264d-7b33-a7bb-a96e1a8e3fca","task_stream":{"id":"01a182c3-264d-7b33-a7bb-a96e1a8e3fca","kind":"task"}}}
