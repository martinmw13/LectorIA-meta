{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3cf","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":66,"recorded_at":1780531400000127,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"task.lifecycle.started","payload_schema_version":1,"payload":{"command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","event":{"kind":"started","span_id":"d7359f86af8eb871","task_id":"01a182c3-12b3-7803-88ed-12f008900a59"},"kind":"task_lifecycle","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"task_id":"01a182c3-12b3-7803-88ed-12f008900a59","task_stream":{"id":"01a182c3-12b3-7803-88ed-12f008900a59","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3d1","stream":{"kind":"session","id":"01a182c3-02b1-7b00-b777-e99423afebca"},"sequence":67,"recorded_at":1780531400000129,"record_type":"event","durability":"durable","causation_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a182c3-0455-7441-a92b-48bae0d92ab9","event":{"chunk":"Read text file `server/images/env.ts`.\n1|import \"server-only\";\n2|\n3|// Reads image env once per request. Any missing key means unavailable:\n4|// with no quotas or budget configured, the route must never spend.\n5|export interface ImageEnv {\n6|  upstashUrl: string;\n7|  upstashToken: string;\n8|  metaKey: string;\n9|  sessionSecret: string;\n10|  ipSalt: string;\n11|  spendCapMicro: number;\n12|}\n13|\n14|// Vercel's Upstash marketplace integration injects KV_REST_API_* names.\n15|// UPSTASH_* wins when non-empty, else the KV_* fallback applies per value.\n16|// The read-only token is never used (we write).\n17|const URL_NAMES = \"UPSTASH_REDIS_REST_URL|KV_REST_API_URL\";\n18|const TOKEN_NAMES = \"UPSTASH_REDIS_REST_TOKEN|KV_REST_API_TOKEN\";\n19|\n20|const REQUIRED = [\n21|  \"BLOB_READ_WRITE_TOKEN\",\n22|  \"META_API_KEY\",\n23|  \"SESSION_SECRET\",\n24|  \"IP_HASH_SALT\",\n25|] as const;\n26|\n27|export function readImageEnv(from: NodeJS.ProcessEnv = process.env): ImageEnv {\n28|  const upstashUrl = from.UPSTASH_REDIS_REST_URL || from.KV_REST_API_URL;\n29|  const upstashToken = from.UPSTASH_REDIS_REST_TOKEN || from.KV_REST_API_TOKEN;\n30|  const missing = [\n31|    upstashUrl ? null : URL_NAMES,\n32|    upstashToken ? null : TOKEN_NAMES,\n33|    ...REQUIRED.filter((k) => !from[k]),\n34|  ].filter((m): m is string => m !== null);\n35|  if (missing.length > 0) throw new Error(`missing image env: ${missing.join(\",\")}`);\n36|  const capUsd = Number(from.SPEND_CAP_USD ?? \"10\");\n37|  return {\n38|    upstashUrl: upstashUrl as string,\n39|    upstashToken: upstashToken as string,\n40|    metaKey: from.META_API_KEY as string,\n41|    sessionSecret: from.SESSION_SECRET as string,\n42|    ipSalt: from.IP_HASH_SALT as string,\n43|    spendCapMicro: Math.round((Number.isFinite(capUsd) ? capUsd : 10) * 1_000_000),\n44|  };\n45|}","final_result":true,"kind":"output","task_id":"01a182c3-12b0-7382-b5d0-91387a0f4f29"},"kind":"task_lifecycle","run_stream":{"id":"01a182c3-0455-7441-a92b-48bae0d92ab9","kind":"run"},"task_id":"01a182c3-12b0-7382-b5d0-91387a0f4f29","task_stream":{"id":"01a182c3-12b0-7382-b5d0-91387a0f4f29","kind":"task"}}}
