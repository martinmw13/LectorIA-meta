{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c957","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":774,"recorded_at":1780531400001543,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `core/reader.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import {\n3|  buildNavIndex,\n4|  buildReaderModel,\n5|  buildSceneView,\n6|  chapterTitleLines,\n7|  countWords,\n8|  estimateLines,\n9|  FIRST_PAGE_LINES,\n10|  INDENT_CHARS,\n11|  isSceneEntry,\n12|  LINES_PER_PAGE,\n13|  navReducer,\n14|  nextSceneEntry,\n15|  paginateScene,\n16|  panelCaption,\n17|  subPageCount,\n18|  subPageKind,\n19|  textPageAt,\n20|} from \"./reader\";\n21|import type { AnalyzedScene, Book, Vector8 } from \"./types\";\n22|import { EMOTIONS } from \"./types\";\n23|import type { MusicManifest, SelectEnv } from \"./music\";\n24|import type { SceneSignal, Track } from \"./music\";\n25|import { initScheduler, observeScene, tickScheduler } from \"./music-schedule\";\n26|import type { NavIndex } from \"./reader\";\n27|\n28|const book: Pick<Book, \"id\" | \"title\" | \"author\" | \"chapters\" | \"paragraphs\" | \"textVersion\"> = {\n29|  id: \"oz\",\n30|  textVersion: \"v1\",\n31|  title: \"Oz\",\n32|  author: \"Baum\",\n33|  chapters: [\n34|    { ch: 1, title: \"One\", start_n: 1, end_n: 3 },\n35|    { ch: 2, title: \"Two\", start_n: 4, end_n: 5 },\n36|  ],\n37|  paragraphs: [\n38|    { id: \"c1p1\", ch: 1, n: 1, text: \"a\" },\n39|    { id: \"c1p2\", ch: 1, n: 2, text: \"b\" },\n40|    { id: \"c1p3\", ch: 1, n: 3, text: \"c\" },\n41|    { id: \"c2p1\", ch: 2, n: 4, text: \"d\" },\n42|    { id: \"c2p2\", ch: 2, n: 5, text: \"e\" },\n43|  ],\n44|};\n45|\n46|function scene(over: Partial<AnalyzedScene> & { id: string }): AnalyzedScene {\n47|  return {\n48|    start_n: 1,\n49|    end_n: 1,\n50|    title: \"S\",\n51|    summary: \"\",\n52|    characters: [],\n53|    ch: 1,\n54|    jev: null,\n55|    muse_override: null,\n56|    final: null,\n57|    error: null,\n58|    ...over,\n59|  };\n60|}\n61|\n62|const scenes: AnalyzedScene[] = [\n63|  scene({ id: \"c1s1\", start_n: 1, end_n: 2, final: null, error: \"boom\" }),\n64|  scene({\n65|    id: \"c1s2\",\n66|    start_n: 3,\n67|    end_n: 3,\n68|    final: { vector: { calma: 1, alegria: 0, tristeza: 0, suspenso: 0, misterio: 0, aventura: 0, combate: 0, asombro: 0 }, intensity: 0.2, tempo: 0.3 },\n69|  }),\n70|  scene({ id: \"c2s1\", ch: 2, start_n: 4, end_n: 5, final: null, error: \"boom\" }),\n71|];\n72|\n73|describe(\"buildReaderModel\", () => {\n74|  it(\"builds chapters in reading order with every paragraph once\", () => {\n75|    const model = buildReaderModel(book, { scenes });\n76|    expect(model.bookId).toBe(\"oz\");\n77|    expect(model.chapters.map((c) => c.ch)).toEqual([1, 2]);\n78|    expect(model.chapters.flatMap((c) => c.scenes).map((s) => s.id)).toEqual([\"c1s1\", \"c1s2\", \"c2s1\"]);\n79|    expect(model.chapters.flatMap((c) => c.scenes).flatMap((s) => s.paragraphs.map((p) => p.n))).toEqual([1, 2, 3, 4, 5]);\n80|  });\n81|\n82|  it(\"keeps null emotion for failed scenes\", () => {\n83|    const model = buildReaderModel(book, { scenes });\n84|    expect(model.chapters[0]?.scenes[0]?.emotion).toBeNull();\n85|    expect(model.chapters[0]?.scenes[1]?.emotion?.intensity).toBe(0.2);\n86|  });\n87|\n88|  it(\"drops analysis internals\", () => {\n89|    const model = buildReaderModel(book, { scenes });\n90|    expect(JSON.stringify(model)).not.toContain(\"muse_override\");\n91|    expect(JSON.stringify(model)).not.toContain(\"jev\");\n92|  });\n93|\n94|  it(\"paginates the whole book with no loss, duplication, or reorder\", () => {\n95|    const model = buildReaderModel(book, { scenes });\n96|    const seen: number[] = [];\n97|    for (const chapter of model.chapters) {\n98|      for (const scene of chapter.scenes) {\n99|        const pages = paginateScene(scene.paragraphs, 3);\n100|        expect(pages.length).toBeGreaterThan(0);\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1833f-198b-7413-aaf7-6d488b76bded"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833f-198b-7413-aaf7-6d488b76bded","task_stream":{"id":"01a1833f-198b-7413-aaf7-6d488b76bded","kind":"task"}}}
