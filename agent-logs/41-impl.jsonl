// reach the session. Params can lag a render, so the last observed id\n43|// is compared before every scene entry.\n44|export function Reader({\n45|  scenes,\n46|  chapters,\n47|  bookTitle,\n48|  bookAuthor,\n49|  children,\n50|}: {\n51|  scenes: SlimScene[];\n52|  chapters: ChapterJump[];\n53|  bookTitle: string;\n54|  bookAuthor: string;\n55|  children: React.ReactNode;\n56|}) {\n57|  const routeParams = useParams();\n58|  const router = useRouter();\n59|  const param = routeParams?.sceneId;\n60|  const routeSceneId = typeof param === \"string\" ? param : null;\n61|  const [manifest, setManifest] = useState<MusicManifest | null>(null);\n62|  const [view, setView] = useState<SessionView | null>(null);\n63|  const [musicFailed, setMusicFailed] = useState(false);\n64|  // Volume, mute, style, and Chopin mode persist in one prefs object;\n65|  // the player stays a controlled view over them. State starts at the server\n66|  // defaults so hydration matches, then a mount effect applies stored\n67|  // prefs (parsed once) to volume, muted, and style via the prefs store.\n68|  const [volume, setVolume] = useState(DEFAULT_VOLUME);\n69|  const [muted, setMuted] = useState(false);\n70|  const [theme, setTheme] = useState<\"light\" | \"dark\">(\"light\");\n71|  const [devOpen, setDevOpen] = useState(false);\n72|  const prefsStoreRef = useRef(createMusicPrefsStore());\n73|  // Ref mirrors so send and persist handlers always read fresh values.\n74|  const volumeRef = useRef(volume);\n75|  volumeRef.current = volume;\n76|  const mutedRef = useRef(muted);\n77|  mutedRef.current = muted;\n78|  const byId = useMemo(() => new Map(scenes.map((s) => [s.id, s.emotion])), [scenes]);\n79|  const byIdRef = useRef(byId);\n80|  byIdRef.current = byId;\n81|  const manifestRef = useRef(manifest);\n82|  manifestRef.current = manifest;\n83|  const routeRef = useRef(routeSceneId);\n84|  routeRef.current = routeSceneId;\n85|  const sessionRef = useRef<MusicSession | null>(null);\n86|  const observedRef = useRef<string | null>(null);\n87|\n88|  // The one bridge into the session: builds the context (clock, rng,\n89|  // scene signals) and mirrors the view and a style change to state.\n90|  const send = useCallback((intent: MusicIntent) => {\n91|    const session = sessionRef.current;\n92|    const fetched = manifestRef.current;\n93|    if (!session || !fetched) return;\n94|    const next = dispatch(session, intent, {\n95|      manifest: fetched,\n96|      signalOf: (sceneId) => byIdRef.current.get(sceneId) ?? null,\n97|      routeSceneId: routeRef.current,\n98|      nowSec: Date.now() / 1000,\n99|      rng: Math.random,\n100|    });\n101|    sessionRef.current = next;\n102|    if (next.view !== session.view) setView(next.view);\n103|    if (next.selection !== session.selection || next.view.playlistOn !== session.view.playlistOn) {\n104|      prefsStoreRef.current.update({\n105|        style: next.selection.style,\n106|        playlist: next.view.playlistOn,\n107|      });\n108|    }\n109|  }, []);\n110|\n111|  // Stored prefs load once here, after the server-matching first render.\n112|  // Saves happen only on user actions below, so the defaults above never\n113|  // overwrite storage before this runs. The fetch below resolves later and\n114|  // reads the style through the store.\n115|  useEffect(() => {\n116|    const prefs = prefsStoreRef.current.load();\n117|    if (prefs !== null) {\n118|      if (prefs.volume !== null) setVolume(prefs.volume);\n119|      setMuted(prefs.muted);\n120|    }\n121|    try {\n122|      setTheme(initialTheme(window.localStorage.getItem(THEME_KEY)));\n123|    } catch {\n124|      // The inline script already set a theme; keep the default.\n125|    }\n126|    if (new URLSearchParams(window.location.search).has(\"dev\")) setDevOpen(true);\n127|  }, []);\n128|\n129|  useEffect(() => {\n130|    let cancelled = false;\n131|    fetch(\"/music/manifest.json\")\n132|      .then((res) => {\n133|        if (!res.ok) throw new Error(`manifest ${res.status}`);\n134|        return res.json();\n135|      })\n136|      .then((json: unknown) => {\n137|        if (cancelled) return;\n138|        const parsed = parseManifest(json);\n139|        setManifest(parsed);\n140|        const session = startSession(parsed, prefsStoreRef.current.load());\n141|        sessionRef.current = session;\n142|        setView(session.view);\n143|      })\n144|      .catch(() => {\n145|        if (!cancelled) setMusicFailed(true);\n146|      });\n147|    return () => {\n148|      cancelled = true;\n149|    };\n150|  }, []);\n151|\n152|  // Scene entry: exactly one sceneEntered per scene id, once the manifest\n153|  // lands. The first scene cues at once, so it plays on the first press.\n154|  useEffect(() => {\n155|    const gate = nextSceneEntry({\n156|      observedId: observedRef.current,\n157|      routeId: routeSceneId,\n158|      manifestReady: manifest !== null,\n159|    });\n160|    observedRef.current = gate.nextObservedId;\n161|    if (gate.shouldObserve && routeSceneId) send({ type: \"sceneEntered\", sceneId: routeSceneId });\n162|  }, [routeSceneId, manifest, send]);\n163|\n164|  useEffect(() => {\n165|    // Settle an expired entry dwell, or re-check the scene after a hold.\n166|    const timer = window.setInterval(() => {\n167|      send({ type: \"tick\" });\n168|    }, 1000);\n169|    return () => window.clearInterval(timer);\n170|  }, [send]);\n171|\n172|  // Developer view: Shift+D outside inputs, Escape closes.\n173|  useEffect(() => {\n174|    const onKey = (event: KeyboardEvent) => {\n175|      const target = event.target as HTMLElement | null;\n176|      const typing =\n177|        !!target &&\n178|        (target.tagName === \"INPUT\" ||\n179|          target.tagName === \"SELECT\" ||\n180|          target.tagName === \"TEXTAREA\" ||\n181|          target.isContentEditable);\n182|      if (event.key === \"Escape\") {\n183|        setDevOpen(false);\n184|        return;\n185|      }\n186|      if (typing) return;\n187|      if (event.shiftKey && (event.key === \"D\" || event.key === \"d\")) {\n188|        event.preventDefault();\n189|        setDevOpen((open) => !open);\n190|      }\n191|    };\n192|    window.addEventListener(\"keydown\", onKey);\n193|    return () => window.removeEventListener(\"keydown\", onKey);\n194|  }, []);\n195|\n196|  function skip() {\n197|    send({ type: \"skip\" });\n198|  }\n199|\n200|  // Previous: back to the last played track, held like a Next. With no\n201|  // history the current track restarts from zero through the replay path,\n202|  // including in playlist mode.\n203|  function goPrev() {\n204|    send({ type: \"previous\" });\n205|  }\n206|\n207|  function advanceMode(to?: MusicModeId) {\n208|    send({ type: \"modeAdvanced\", to });\n209|  }\n210|\n211|  function changeVolume(next: number) {\n212|    setVolume(next);\n213|    volumeRef.current = next;\n214|    prefsStoreRef.current.update({ volume: next });\n215|  }\n216|\n217|  function changeMuted(next: boolean) {\n218|    setMuted(next);\n219|    mutedRef.current = next;\n220|    prefsStoreRef.current.update({ muted: next });\n221|  }\n222|\n223|  function ended(trackId: string) {\n224|    send({ type: \"trackEnded\", trackId });\n225|  }\n226|\n227|  function toggleTheme() {\n228|    setTheme((current) => {\n229|      const next = current === \"dark\" ? \"light\" : \"dark\";\n230|      document.documentElement.setAttribute(\"data-theme\", next);\n231|      try {\n232|        window.localStorage.setItem(THEME_KEY, next);\n233|      } catch {\n234|        // The attribute already applies for the session.\n235|      }\n236|      return next;\n237|    });\n238|  }\n239|\n240|  function jumpChapter(ch: number) {\n241|    const found = chapters.find((c) => c.ch === ch);\n242|    if (found) router.push(`/leer/${found.firstSceneId}`);\n243|  }\n244|\n245|  const currentId = view?.currentId ?? null;\n246|  const track = manifest?.tracks.find((t) => t.id === currentId) ?? null;\n247|  const empty = manifest !== null && manifest.tracks.length === 0;\n248|  // Ordered music modes for the control: styles with tracks, then Chopin.\n249|  const modes = manifest ? musicModes(manifest) : [];\n250|  const modeCurrent = view ? currentMode(view) : null;\n251|  const playlistOn = view?.playlistOn ?? false;\n252|  // Previous restarts the track with no history (including the current\n253|  // playlist piece), so it stays on whenever a track is cued.\n254|  const canPrev = view?.canPrev ?? false;\n255|  const canSkip = view?.canSkip ?? false;\n256|\n257|  const bookIndex = routeSceneId ? scenes.findIndex((s) => s.id === routeSceneId) : -1;\n258|  const current = routeSceneId ? byId.get(routeSceneId) ?? null : null;\n259|  const devBars = current\n260|    ? EMOTIONS.map((id) => ({ label: DEV_LABELS[id], value: current.vector[id] ?? 0 }))\n261|    : [];\n262|\n263|  return (\n264|    <div className=\"folio\">\n265|      <TopLine\n266|        bookTitle={bookTitle}\n267|        author={bookAuthor}\n268|        ch={routeSceneId ? (scenes[bookIndex]?.ch ?? chapters[0]?.ch ?? 1) : 1}\n269|        chaptersTotal={chapters.length}\n270|        chapters={chapters}\n271|        onJumpChapter={jumpChapter}\n272|        theme={theme}\n273|        onToggleTheme={toggleTheme}\n274|      />\n275|      {children}\n276|      <div className=\"band-play\">\n277|        {musicFailed || empty ? (\n278|          <p className=\"player-note\">The music is resting. The book is all yours.</p>\n279|        ) : (\n280|          <Player\n281|            track={track}\n282|            replayNonce={view?.replayNonce ?? 0}\n283|            fadeSec={view?.fadeSec ?? 0}\n284|            canPrev={canPrev}\n285|            onPrev={goPrev}\n286|            canSkip={canSkip}\n287|            onSkip={skip}\n288|            volume={volume}\n289|            muted={muted}\n290|            onVolumeChange={changeVolume}\n291|            onMutedChange={changeMuted}\n292|            modes={modes}\n293|            current={modeCurrent}\n294|            onAdvance={advanceMode}\n295|            onEnded={ended}\n296|            playlistOn={playlistOn}\n297|          />\n298|        )}\n299|      </div>\n300|      <DevPanel\n301|        open={devOpen}\n302|        onClose={() => setDevOpen(false)}\n303|        sceneLabel={bookIndex >= 0 ? `scene ${bookIndex + 1} of ${scenes.length}` : \"no scene\"}\n304|        bars={devBars}\n305|        intensity={current?.intensity ?? null}\n306|        tempo={current?.tempo ?? null}\n307|        trackTitle={track?.title ?? \"No track cued\"}\n308|      />\n309|    </div>\n310|  );\n311|}","final_result":true,"kind":"output","task_id":"01a1833c-7233-7e30-8655-56c11aada0fe"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-7233-7e30-8655-56c11aada0fe","task_stream":{"id":"01a1833c-7233-7e30-8655-56c11aada0fe","kind":"task"}}}
