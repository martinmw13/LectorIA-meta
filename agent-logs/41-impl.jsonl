{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c859","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":647,"recorded_at":1780531400001289,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `core/reader.test.ts`.\n(168 line(s) above)\n169|\n170|  it(\"splits a c1s1-like 845-char paragraph into 2 pages with no page over budget\", () => {\n171|    const unit = \"The cyclone came swiftly across the prairie, howling loud. \";\n172|    const text = unit.repeat(14);\n173|    expect(text.length).toBeGreaterThan(FIRST_PAGE_LINES * 58);\n174|    const pages = paginateScene([{ id: \"c1p1\", n: 1, text }]);\n175|    expect(pages.length).toBe(2);\n176|    pages.forEach((page, i) => {\n177|      const lines = page.paragraphs.reduce((sum, q) => sum + estimateLines(q.text), 0);\n178|      expect(lines).toBeLessThanOrEqual(i === 0 ? FIRST_PAGE_LINES : LINES_PER_PAGE);\n179|    });\n180|    expect(pages.flatMap((p) => p.paragraphs.map((q) => q.text)).join(\"\")).toBe(text);\n181|    const frags = pages.flatMap((p) => p.paragraphs);\n182|    expect(frags.map((f) => f.n)).toEqual(frags.map(() => 1));\n183|    expect(frags[0]?.cont).toBeUndefined();\n184|    expect(frags.slice(1).every((f) => f.cont === true)).toBe(true);\n185|    expect(new Set(frags.map((f) => f.id)).size).toBe(frags.length);\n186|  });\n187|\n188|  it(\"prefers a sentence boundary, else a word boundary\", () => {\n189|    const unit = \"The cyclone came swiftly across the prairie, howling loud. \";\n190|    const pages = paginateScene([{ id: \"s\", n: 1, text: unit.repeat(14) }]);\n191|    const first = pages[0]?.paragraphs[0]?.text ?? \"\";\n192|    expect(/[.?!;][\"'”’)\\]]* $/.test(first)).toBe(true);\n193|    const words = paginateScene([{ id: \"w\", n: 2, text: \"word \".repeat(200) }]);\n194|    const wfirst = words[0]?.paragraphs[0]?.text ?? \"\";\n195|    expect(wfirst.endsWith(\" \")).toBe(true);\n196|    expect(words.flatMap((p) => p.paragraphs.map((q) => q.text)).join(\"\")).toBe(\"word \".repeat(200));\n197|  });\n198|\n199|  it(\"counts a two-line chapter title against every page budget\", () => {\n200|    expect(chapterTitleLines(\"The Cyclone\")).toBe(1);\n201|    expect(chapterTitleLines(\"The Discovery of Oz, the Terrible\")).toBe(2);\n202|    const paras = Array.from({ length: FIRST_PAGE_LINES }, (_, i) => ({ id: `t${i}`, n: i + 1, text: '\"Yes.\"' }));\n203|    expect(paginateScene(paras).length).toBe(1);\n204|    const wrapped = paginateScene(paras, 250, \"The Discovery of Oz, the Terrible\");\n205|    expect(wrapped.length).toBe(2);\n206|    for (const page of wrapped) {\n207|      const lines = page.paragraphs.reduce((sum, q) => sum + estimateLines(q.text), 0);\n208|      expect(lines).toBeLessThanOrEqual(FIRST_PAGE_LINES - 2);\n209|    }\n210|  });\n211|\n212|  it(\"paginates deterministically\", () => {\n213|    const paras = Array.from({ length: 40 }, (_, i) => ({ id: `e${i}`, n: i + 1, text: '\"Well?\"' }));\n214|    expect(paginateScene(paras)).toEqual(paginateScene(paras));\n215|    expect(paginateScene(paras).length).toBe(4);\n216|  });\n217|\n218|  it(\"counts words on whitespace\", () => {\n219|    expect(countWords(\"  hola   mundo\\n\")).toBe(2);\n220|  });\n221|\n222|  it(\"builds one scene view with chapter counts and neighbor ids\", () => {\n223|    const model = buildReaderModel(book, { scenes });\n224|    const view = buildSceneView(model, \"c1s2\", 3);\n225|    expect(view).toMatchObject({ sceneId: \"c1s2\", ch: 1, chapterTitle: \"One\", k: 2, n: 2 });\n226|    expect(view.prevSceneId).toBe(\"c1s1\");\n227|    expect(view.nextSceneId).toBe(\"c2s1\");\n228|    expect(view.pages.flatMap((p) => p.paragraphs.map((q) => q.n))).toEqual([3]);\n229|  });\n230|\n231|  it(\"crosses chapters at the edges and throws on unknown ids\", () => {\n232|    const model = buildReaderModel(book, { scenes });\n233|    const first = buildSceneView(model, \"c1s1\", 3);\n234|    expect(first.prevSceneId).toBeNull();\n235|    expect(first.nextSceneId).toBe(\"c1s2\");\n236|    const last = buildSceneView(model, \"c2s1\", 3);\n237|    expect(last.nextSceneId).toBeNull();\n238|    expect(last.prevSceneId).toBe(\"c1s2\");\n239|    expect(() => buildSceneView(model, \"nope\", 3)).toThrow();\n240|  });\n241|\n242|  it(\"throws on unordered scenes, gaps, overlaps, crossings\", () => {\n243|    expect(() => buildReaderModel(book, { scenes: [...scenes].reverse() })).toThrow();\n244|    const gap = scenes.filter((s) => s.id !== \"c1s2\");\n245|    expect(() => buildReaderModel(book, { scenes: gap })).toThrow();\n246|    const overlap = [...scenes];\n247|    overlap[1] = scene({ id: \"c1s2\", start_n: 2, end_n: 3, final: null, error: \"x\" });\n248|    expect(() => buildReaderModel(book, { scenes: overlap })).toThrow();\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1833e-c661-7fa1-ba12-2f5efdb6af0b"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833e-c661-7fa1-ba12-2f5efdb6af0b","task_stream":{"id":"01a1833e-c661-7fa1-ba12-2f5efdb6af0b","kind":"task"}}}
