{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fb","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":216,"recorded_at":1780531400000427,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/leer/scene-page.tsx`.\n1|// One scene view: heading, reading column, pictures, vault, pager.\n2|// Sub-page moves stay in client state; scene moves push a new route.\n3|// The chapter cover and end page are sub-pages of their scene, so\n4|// they never touch music state.\n5|\"use client\";\n6|\n7|import { Fragment, useEffect, useMemo, useRef, useState } from \"react\";\n8|import { useRouter } from \"next/navigation\";\n9|import { buildNavIndex, navReducer, subPageCount, subPageKind, textPageAt } from \"@/core/reader\";\n10|import type { NavAction, SceneView } from \"@/core/reader\";\n11|import { loadImageStylePref, saveImageStylePref } from \"../image-style\";\n12|import type { ImageStylePref } from \"../image-style\";\n13|import { BandPager, Divider } from \"../folio/chrome\";\n14|import { figuresAfter, groupFiguresByEndN, pageOfOrdinal } from \"../folio/figure-placement\";\n15|import { ImagePane } from \"../folio/image-pane\";\n16|import { InlineFigureView, SelectionPopover } from \"../folio/inline-figures\";\n17|import { Lightbox } from \"../folio/lightbox\";\n18|import { edges, readOnLabel, wheelTurn } from \"../folio/scroll-turn\";\n19|import type { WheelTurnState } from \"../folio/scroll-turn\";\n20|import { usePictures } from \"../folio/use-pictures\";\n21|import type { InlineFigure } from \"../folio/use-pictures\";\n22|import { PictureVault } from \"../folio/vault\";\n23|import {\n24|  chapterSetAside,\n25|  coverTitleLong,\n26|  markChapterEndReached,\n27|  markChapterSetAside,\n28|  markPanelsShownAnyway,\n29|  panelsUnlocked,\n30|} from \"../folio/panels\";\n31|import type { ChapterPanel } from \"../folio/panels\";\n32|import {\n33|  BlurredThumbs,\n34|  PanelsModal,\n35|  PanelsOfferCard,\n36|  PanelsQuietLink,\n37|  SpoilerGateDialog,\n38|} from \"../folio/panels-modal\";\n39|\n40|// One-shot entry intent: set just before pushing the previous scene\n41|// route, so the new page opens on its last sub-page. Client memory only,\n42|// never the URL, so prerendered pages stay static and a direct URL load\n43|// always starts at page 0.\n44|let enterAtEnd = false;\n45|\n46|// Survives scene remounts so one swipe never turns twice.\n47|let wheelState: WheelTurnState = { acc: 0, lockedUntil: 0, lastAt: 0 };\n48|\n49|// Set on every in-app scene push. The heading takes focus only when this\n50|// is set, so first load shows no focus ring.\n51|let hasNavigated = false;\n52|\n53|// True when the wheel target sits inside a nested scroller (picture\n54|// vault, player bar, modal grids): those scroll natively and never turn\n55|// pages. The reading column itself is not a nested scroller.\n56|function inNestedScroller(target: HTMLElement | null, readCol: HTMLElement | null): boolean {\n57|  let el: HTMLElement | null = target;\n58|  while (el !== null) {\n59|    if (el !== readCol) {\n60|      const overflowY = window.getComputedStyle(el).overflowY;\n61|      if ((overflowY === \"auto\" || overflowY === \"scroll\") && el.scrollHeight > el.clientHeight) {\n62|        return true;\n63|      }\n64|    }\n65|    el = el.parentElement;\n66|  }\n67|  return false;\n68|}\n69|\n70|function pulse(el: HTMLElement | null) {\n71|  if (!el) return;\n72|  el.classList.remove(\"pulse\");\n73|  void el.offsetWidth;\n74|  el.classList.add(\"pulse\");\n75|  window.setTimeout(() => el.classList.remove(\"pulse\"), 650);\n76|}\n77|\n78|// One scene view: sub-pages, keys, buttons, progress, chapter jump.\n79|// Sub-page moves stay in client state; scene moves push a new route.\n80|export function ScenePage({\n81|  view,\n82|  views,\n83|  bookId,\n84|  textVersion,\n85|  bookIndex,\n86|  bookTotal,\n87|  panels,\n88|  nextChapter,\n89|}: {\n90|  view: SceneView;\n91|  views: { sceneId: string; pages: number }[];\n92|  bookId: string;\n93|  textVersion: string;\n94|  bookIndex: number;\n95|  bookTotal: number;\n96|  panels: ChapterPanel[];\n97|  nextChapter: { ch: number; firstSceneId: string } | null;\n98|}) {\n99|  const [pref, setPref] = useState<ImageStylePref>({ kind: \"preset\", id: \"denslow\" });\n100|  const pic = usePictures({ bookId, textVersion, sceneId: view.sceneId, pref });\n101|  const router = useRouter();\n102|  const index = useMemo(() => buildNavIndex(views), [views]);\n103|  const cover = view.isChapterFirst;\n104|  const end = view.isChapterLast;\n105|  const coverLong = coverTitleLong(view.chapterTitle);\n106|  const total = subPageCount(view.pages.length, cover, end);\n107|  const lastPage = total - 1;\n108|  const [page, setPage] = useState(() => {\n109|    if (enterAtEnd) {\n110|      enterAtEnd = false;\n111|      return lastPage;\n112|    }\n113|    return 0;\n114|  });\n115|  const [panelsOpen, setPanelsOpen] = useState(false);\n116|  const [gateOpen, setGateOpen] = useState(false);\n117|  const [offerAside, setOfferAside] = useState(() => chapterSetAside(view.ch));\n118|  const gateOpener = useRef<HTMLElement | null>(null);\n119|  const headingRef = useRef<HTMLHeadingElement>(null);\n120|  const readColRef = useRef<HTMLDivElement | null>(null);\n121|  const figEls = useRef(new Map<string, HTMLElement>());\n122|  const kind = subPageKind(page, view.pages.length, cover, end);\n123|  const sub = kind === \"text\" ? (view.pages[textPageAt(page, cover)] ?? view.pages[0]) : undefined;\n124|  const textIndex = textPageAt(page, cover);\n125|  const atStart = view.prevSceneId === null && page === 0;\n126|  const atBookEnd = view.nextSceneId === null && page === lastPage;\n127|  const readOn =\n128|    kind === \"text\"\n129|      ? readOnLabel({\n130|          textIndex,\n131|          textCount: view.pages.length,\n132|          hasEndPage: end,\n133|          hasNextSceneInChapter: view.k < view.n,\n134|          ch: view.ch,\n135|        })\n136|      : null;\n137|\n138|  useEffect(() => {\n139|    setPref(loadImageStylePref());\n140|  }, []);\n141|\n142|  // The end page marks the chapter finished, unlocking the panels.\n143|  useEffect(() => {\n144|    if (kind === \"end\") markChapterEndReached(view.ch);\n145|  }, [kind, view.ch]);\n146|\n147|  function changePref(next: ImageStylePref) {\n148|    setPref(next);\n149|    saveImageStylePref(next);\n150|  }\n151|\n152|  function requestPanels(opener: HTMLElement | null) {\n153|    if (panelsUnlocked(view.ch)) {\n154|      setPanelsOpen(true);\n155|      return;\n156|    }\n157|    gateOpener.current = opener;\n158|    setGateOpen(true);\n159|  }\n160|\n161|  function showAnyway() {\n162|    markPanelsShownAnyway(view.ch);\n163|    setGateOpen(false);\n164|    setPanelsOpen(true);\n165|  }\n166|\n167|  function notYet() {\n168|    setGateOpen(false);\n169|    gateOpener.current?.focus?.();\n170|    gateOpener.current = null;\n171|  }\n172|\n173|  function readFirst() {\n174|    markChapterSetAside(view.ch);\n175|    setOfferAside(true);\n176|  }\n177|\n178|  function goNextChapter() {\n179|    if (!nextChapter) return;\n180|    hasNavigated = true;\n181|    router.push(`/leer/${nextChapter.firstSceneId}`);\n182|  }\n183|\n184|  const figsByN = useMemo(() => groupFiguresByEndN(pic.figures), [pic.figures]);\n185|\n186|  function gotoFigure(fig: InlineFigure) {\n187|    const at = pageOfOrdinal(view.pages, fig.endN);\n188|    if (at < 0) return;\n189|    setPage(at + (cover ? 1 : 0));\n190|    readColRef.current?.scrollTo(0, 0);\n191|    requestAnimationFrame(() => {\n192|      requestAnimationFrame(() => {\n193|        const el = figEls.current.get(fig.id) ?? null;\n194|        el?.scrollIntoView({ block: \"nearest\" });\n195|        pulse(el);\n196|      });\n197|    });\n198|  }\n199|\n200|  function gotoScenePicture() {\n201|    const img = document.querySelector(\".img-pane .pane-img\");\n202|    pulse(img instanceof HTMLElement ? img : null);\n203|  }\n204|\n205|  // Every pager move runs through navReducer; a new scene id means a\n206|  // route push, a same-scene result means a client sub-page move.\n207|  function move(action: NavAction) {\n208|    pic.hidePopover();\n209|    const next = navReducer({ sceneId: view.sceneId, page }, action, index);\n210|    if (next.sceneId !== view.sceneId) {\n211|      hasNavigated = true;\n212|      if (next.page > 0) enterAtEnd = true;\n213|      router.push(`/leer/${next.sceneId}`);\n214|      return;\n215|    }\n216|    if (next.page !== page) {\n217|      setPage(next.page);\n218|      readColRef.current?.scrollTo(0, 0);\n219|    }\n220|  }\n221|\n222|  function goNext() {\n223|    move({ kind: \"next\" });\n224|  }\n225|\n226|  function goPrev() {\n227|    move({ kind: \"prev\" });\n228|  }\n229|\n230|  // Scene entry resets orientation; sub-page moves keep the heading.\n231|  useEffect(() => {\n232|    if (hasNavigated) headingRef.current?.focus();\n233|    readColRef.current?.scrollTo(0, 0);\n234|  }, [view.sceneId]);\n235|\n236|  useEffect(() => {\n237|    const onKey = (event: KeyboardEvent) => {\n238|      if (event.metaKey || event.ctrlKey || event.altKey) return;\n239|      const target = event.target as HTMLElement | null;\n240|      if (\n241|        target &&\n242|        (target.tagName === \"INPUT\" ||\n243|          target.tagName === \"SELECT\" ||\n244|          target.tagName === \"TEXTAREA\" ||\n245|          target.isContentEditable)\n246|      ) {\n247|        return;\n248|      }\n249|      if (event.key === \"ArrowRight\") {\n250|        event.preventDefault();\n251|        goNext();\n252|      } else if (event.key === \"ArrowLeft\") {\n253|        event.preventDefault();\n254|        goPrev();\n255|      } else if (\n256|        event.key === \" \" ||\n257|        event.key === \"PageDown\" ||\n258|        event.key === \"ArrowDown\" ||\n259|        event.key === \"PageUp\" ||\n260|        event.key === \"ArrowUp\"\n261|      ) {\n262|        if (target !== null && target.tagName === \"BUTTON\") return;\n263|        const forward =\n264|          event.key === \"PageDown\" || event.key === \"ArrowDown\" || (event.key === \" \" && !event.shiftKey);\n265|        event.preventDefault();\n266|        const col = readColRef.current;\n267|        if (col !== null) {\n268|          const at = edges(col);\n269|          if ((forward && !at.atBottom) || (!forward && !at.atTop)) {\n270|            col.scrollBy({ top: (forward ? 1 : -1) * col.clientHeight * 0.85, behavior: \"smooth\" });\n271|            return;\n272|          }\n273|        }\n274|        if (forward) goNext();\n275|        else goPrev();\n276|      }\n277|    };\n278|    window.addEventListener(\"keydown\", onKey);\n279|    return () => window.removeEventListener(\"keydown\", onKey);\n280|  }, [page, view.sceneId, index, router]);\n281|\n282|  // Wheel and trackpad turn pages: at a column edge, an accumulated swipe\n283|  // calls goNext/goPrev. preventDefault only on a turn, so the column\n284|  // keeps scrolling natively until it rests on its edge.\n285|  useEffect(() => {\n286|    const onWheel = (event: WheelEvent) => {\n287|      if (panelsOpen || gateOpen || pic.lightbox.item !== null) return;\n288|      if (event.ctrlKey) return;\n289|      if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;\n290|      const target = event.target instanceof HTMLElement ? event.target : null;\n291|      const readCol = readColRef.current;\n292|      if (inNestedScroller(target, readCol)) return;\n293|      const at = readCol === null ? { atTop: true, atBottom: true } : edges(readCol);\n294|      const result = wheelTurn(wheelState, {\n295|        deltaY: event.deltaY,\n296|        deltaMode: event.deltaMode,\n297|        now: performance.now(),\n298|        atTop: at.atTop,\n299|        atBottom: at.atBottom,\n300|      });\n301|      wheelState = result.state;\n302|      if (result.turn === \"next\") {\n303|        event.preventDefault();\n304|        goNext();\n305|      } else if (result.turn === \"prev\") {\n306|        event.preventDefault();\n307|        goPrev();\n308|      }\n309|    };\n310|    window.addEventListener(\"wheel\", onWheel, { passive: false });\n311|    return () => window.removeEventListener(\"wheel\", onWheel);\n312|  }, [page, view.sceneId, index, router, panelsOpen, gateOpen, pic.lightbox.item]);\n313|\n314|  return (\n315|    <>\n316|      <ImagePane\n317|        // The cover always shows the placeholder: nothing to picture yet,\n318|        // and a cached scene picture would spoil the chapter.\n319|        card={kind === \"cover\" ? { phase: \"idle\" } : pic.card}\n320|        onPicture={() => pic.illustrateScene()}\n321|        onRetry={() => pic.illustrateScene()}\n322|        onClear={pic.clearScene}\n323|        onOpen={pic.lightbox.open}\n324|        bare={kind === \"cover\"}\n325|        onPictureChapter={\n326|          kind === \"cover\" ? null : kind === \"end\" ? () => setPanelsOpen(true) : requestPanels\n327|        }\n328|      />\n329|      <Divider />\n330|      <div className=\"read-col\" ref={readColRef} aria-label=\"Reading column\">\n331|        {kind === \"cover\" ? (\n332|          <>\n333|            <div className=\"kicker\">Chapter</div>\n334|            <p className=\"cover-num\" data-long={coverLong} aria-label={`Chapter ${view.ch}`}>\n335|              {view.ch}\n336|            </p>\n337|            <h1\n338|              className=\"chapter-title cover-title\"\n339|              data-long={coverLong}\n340|              id=\"scene-heading\"\n341|              ref={headingRef}\n342|              tabIndex={-1}\n343|            >\n344|              {view.chapterTitle}\n345|            </h1>\n346|            <hr className=\"cover-rule\" />\n347|            {offerAs