{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c651","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":387,"recorded_at":1780531400000769,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/skin.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import { DEFAULT_SKIN, isSkinId, SKINS } from \"./skin\";\n3|\n4|describe(\"skin\", () => {\n5|  it(\"ships only the default skin\", () => {\n6|    expect(SKINS).toEqual([\"default\"]);\n7|    expect(DEFAULT_SKIN).toBe(\"default\");\n8|  });\n9|\n10|  it(\"accepts only known skin ids\", () => {\n11|    expect(isSkinId(\"default\")).toBe(true);\n12|    expect(isSkinId(\"watercolor\")).toBe(false);\n13|    expect(isSkinId(undefined)).toBe(false);\n14|    expect(isSkinId(null)).toBe(false);\n15|  });\n16|});","final_result":true,"kind":"output","task_id":"01a1833c-e0d5-7510-9a49-833911f72a1f"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-e0d5-7510-9a49-833911f72a1f","task_stream":{"id":"01a1833c-e0d5-7510-9a49-833911f72a1f","kind":"task"}}}
