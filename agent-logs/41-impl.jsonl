{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fb","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":344,"recorded_at":1780531400000683,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/styles/folio.css`.\n1|/* Folio shell: top line, three columns, bottom band. The body never\n2|scrolls at desktop size; the reading column scrolls inside itself. */\n3|\n4|.folio {\n5|  --pane-w: 320px;\n6|  max-width: 1200px;\n7|  margin: 0 auto;\n8|  padding: 20px 40px 24px;\n9|  height: 100vh;\n10|  height: 100dvh;\n11|  display: grid;\n12|  grid-template-columns: var(--pane-w) 12px minmax(0, 1fr) 200px;\n13|  grid-template-rows: auto minmax(0, 1fr) auto;\n14|  grid-template-areas:\n15|    \"top top top top\"\n16|    \"pane div read margin\"\n17|    \"pager play play play\";\n18|}\n19|\n20|.top-line {\n21|  grid-area: top;\n22|  display: flex;\n23|  align-items: center;\n24|  gap: 16px;\n25|  padding: 10px 0;\n26|  border-bottom: 1px solid var(--color-text);\n27|}\n28|\n29|.wordmark {\n30|  font-family: var(--font-ui);\n31|  font-size: 14px;\n32|  font-weight: 600;\n33|  letter-spacing: 0.28em;\n34|  white-space: nowrap;\n35|}\n36|\n37|.top-center {\n38|  flex: 1;\n39|  text-align: center;\n40|  font-family: var(--font-ui);\n41|  font-size: 12.5px;\n42|  letter-spacing: 0.1em;\n43|  text-transform: uppercase;\n44|  white-space: nowrap;\n45|  overflow: hidden;\n46|  text-overflow: ellipsis;\n47|}\n48|\n49|.chapter-jump {\n50|  position: relative;\n51|  display: inline-block;\n52|}\n53|\n54|.chapter-jump-text {\n55|  color: var(--color-text-muted);\n56|  letter-spacing: 0.08em;\n57|}\n58|\n59|.chapter-jump select {\n60|  position: absolute;\n61|  inset: 0;\n62|  width: 100%;\n63|  opacity: 0;\n64|  cursor: pointer;\n65|  font-size: 12.5px;\n66|}\n67|\n68|.chapter-jump:hover .chapter-jump-text {\n69|  color: var(--color-accent);\n70|}\n71|\n72|.chapter-jump:focus-within .chapter-jump-text {\n73|  outline: 2px solid var(--color-accent);\n74|  outline-offset: 2px;\n75|}\n76|\n77|.theme-btn {\n78|  width: 34px;\n79|  height: 34px;\n80|  border: 1px solid var(--color-border);\n81|  background: var(--color-surface);\n82|  color: var(--color-text);\n83|  border-radius: 6px;\n84|  display: inline-flex;\n85|  align-items: center;\n86|  justify-content: center;\n87|  cursor: pointer;\n88|  flex: none;\n89|}\n90|\n91|.theme-btn:hover {\n92|  border-color: var(--color-accent);\n93|  color: var(--color-accent);\n94|}\n95|\n96|.theme-btn svg {\n97|  stroke: currentColor;\n98|  fill: none;\n99|  stroke-width: 1.5;\n100|}\n101|\n102|.theme-btn:focus-visible {\n103|  outline: 2px solid var(--color-accent);\n104|  outline-offset: 2px;\n105|}\n106|\n107|.pane-divider {\n108|  grid-area: div;\n109|  position: relative;\n110|  cursor: col-resize;\n111|  display: flex;\n112|  justify-content: center;\n113|}\n114|\n115|.pane-divider::before {\n116|  content: \"\";\n117|  width: 1px;\n118|  background: var(--color-border);\n119|  height: 100%;\n120|}\n121|\n122|.pane-divider:hover::before {\n123|  background: var(--color-accent);\n124|}\n125|\n126|.pane-divider:focus-visible {\n127|  outline: 2px solid var(--color-accent);\n128|  outline-offset: -2px;\n129|}\n130|\n131|.grip {\n132|  position: absolute;\n133|  top: 50%;\n134|  transform: translateY(-50%);\n135|  width: 14px;\n136|  height: 44px;\n137|  border: 1px solid var(--color-border);\n138|  border-radius: 7px;\n139|  background: var(--color-surface);\n140|  opacity: 0;\n141|  transition: opacity var(--motion-duration) ease;\n142|  display: flex;\n143|  align-items: center;\n144|  justify-content: center;\n145|  color: var(--color-text-muted);\n146|  font-size: 10px;\n147|  font-family: var(--font-ui);\n148|}\n149|\n150|.pane-divider:hover .grip {\n151|  opacity: 1;\n152|}\n153|\n154|.read-col {\n155|  grid-area: read;\n156|  min-width: 0;\n157|  min-height: 0;\n158|  overflow-y: auto;\n159|  overflow-x: hidden;\n160|  padding-left: 34px;\n161|  padding-right: 12px;\n162|  padding-bottom: 16px;\n163|  margin-top: 16px;\n164|  scrollbar-width: thin;\n165|  scrollbar-color: var(--color-border) transparent;\n166|}\n167|\n168|.read-col:focus {\n169|  outline: none;\n170|}\n171|\n172|/* Non-interactive heading (tabindex -1), focused only for screen-reader orientation. */\n173|#scene-heading:focus,\n174|#scene-heading:focus-visible {\n175|  outline: none;\n176|}\n177|\n178|.kicker {\n179|  font-family: var(--font-ui);\n180|  font-size: 12.5px;\n181|  font-weight: 600;\n182|  letter-spacing: 0.18em;\n183|  text-transform: uppercase;\n184|}\n185|\n186|h1.chapter-title {\n187|  font-family: var(--font-book);\n188|  font-weight: 300;\n189|  font-size: 44px;\n190|  line-height: 1.05;\n191|  letter-spacing: -0.01em;\n192|  margin: 8px 0 4px;\n193|}\n194|\n195|h1.chapter-title:focus:not(:focus-visible) {\n196|  outline: none;\n197|}\n198|\n199|h1.chapter-title:focus-visible {\n200|  outline: 2px solid var(--color-accent);\n201|  outline-offset: 2px;\n202|}\n203|\n204|.scene-line {\n205|  display: flex;\n206|  align-items: center;\n207|  gap: 10px;\n208|  font-family: var(--font-ui);\n209|  font-size: 12.5px;\n210|  color: var(--color-text-muted);\n211|  letter-spacing: 0.06em;\n212|  margin-bottom: 12px;\n213|}\n214|\n215|.body-text {\n216|  max-width: var(--measure-reading);\n217|  font-family: var(--font-book);\n218|  font-size: 20.5px;\n219|  line-height: 1.7;\n220|  position: relative;\n221|}\n222|\n223|.body-text > p {\n224|  margin: 0;\n225|}\n226|\n227|.body-text > p + p {\n228|  text-indent: 1.5em;\n229|}\n230|\n231|/* Split-paragraph continuations read as one paragraph: no indent. */\n232|.body-text > p[data-cont] {\n233|  text-indent: 0;\n234|}\n235|\n236|.body-text.dropcap > p:first-of-type:not([data-cont])::first-let