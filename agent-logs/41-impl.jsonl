{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f7","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":214,"recorded_at":1780531400000423,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/folio/chrome.tsx`.\n1|// Folio chrome: top line, resizable divider, bottom pager with ticks.\n2|\"use client\";\n3|\n4|import { useEffect, useRef, useState } from \"react\";\n5|import { Icon } from \"../icons\";\n6|import { clampSplitWidth, SPLIT_MIN_PX } from \"./helpers\";\n7|\n8|export { THEME_KEY } from \"../theme\";\n9|export const SPLIT_KEY = \"lectoria.split\";\n10|\n11|export function TopLine({\n12|  bookTitle,\n13|  author,\n14|  ch,\n15|  chaptersTotal,\n16|  chapters,\n17|  onJumpChapter,\n18|  theme,\n19|  onToggleTheme,\n20|}: {\n21|  bookTitle: string;\n22|  author: string;\n23|  ch: number;\n24|  chaptersTotal: number;\n25|  chapters: { ch: number; title: string }[];\n26|  onJumpChapter: (ch: number) => void;\n27|  theme: \"light\" | \"dark\";\n28|  onToggleTheme: () => void;\n29|}) {\n30|  return (\n31|    <header className=\"top-line\">\n32|      <span className=\"wordmark\">LECTORIA</span>\n33|      <div className=\"top-center\">\n34|        {bookTitle} · {author} ·{\" \"}\n35|        <span className=\"chapter-jump\">\n36|          <span aria-hidden=\"true\" className=\"chapter-jump-text\">\n37|            Chapter {ch} of {chaptersTotal}\n38|          </span>\n39|          <select value={ch} onChange={(e) => onJumpChapter(Number(e.target.value))} aria-label=\"Chapter\">\n40|            {chapters.map((c) => (\n41|              <option key={c.ch} value={c.ch}>\n42|                {c.ch}. {c.title}\n43|              </option>\n44|            ))}\n45|          </select>\n46|        </span>\n47|      </div>\n48|      <button\n49|        type=\"button\"\n50|        className=\"theme-btn\"\n51|        onClick={onToggleTheme}\n52|        aria-label={theme === \"dark\" ? \"Light mode\" : \"Dark mode\"}\n53|        aria-pressed={theme === \"dark\"}\n54|        title={theme === \"dark\" ? \"Light mode\" : \"Dark mode\"}\n55|      >\n56|        {theme === \"dark\" ? <Icon name=\"sun\" /> : <Icon name=\"moon\" />}\n57|      </button>\n58|    </header>\n59|  );\n60|}\n61|\n62|function defaultSplit(): number {\n63|  if (typeof window === \"undefined\") return 320;\n64|  return clampSplitWidth(Math.round(Math.min(1200, window.innerWidth - 80) * 0.3), window.innerWidth);\n65|}\n66|\n67|export function Divider() {\n68|  const [width, setWidth] = useState(defaultSplit);\n69|  const [viewport, setViewport] = useState(1280);\n70|  const ref = useRef<HTMLDivElement | null>(null);\n71|\n72|  useEffect(() => {\n73|    const measure = () => setViewport(window.innerWidth);\n74|    measure();\n75|    window.addEventListener(\"resize\", measure);\n76|    try {\n77|      const saved = Number(window.localStorage.getItem(SPLIT_KEY));\n78|      if (Number.isFinite(saved) && saved > 0) {\n79|        setWidth(clampSplitWidth(saved, window.innerWidth));\n80|        return () => window.removeEventListener(\"resize\", measure);\n81|      }\n82|    } catch {\n83|      // Fresh default below.\n84|    }\n85|    setWidth(defaultSplit());\n86|    return () => window.removeEventListener(\"resize\", measure);\n87|  }, []);\n88|\n89|  useEffect(() => {\n90|    document.documentElement.style.setProperty(\"--pane-w\", `${width}px`);\n91|  }, [width]);\n92|\n93|  function commit(next: number) {\n94|    const clamped = clampSplitWidth(next, window.innerWidth);\n95|    setWidth(clamped);\n96|    try {\n97|      window.localStorage.setItem(SPLIT_KEY, String(clamped));\n98|    } catch {\n99|      // Dragging still works for the session.\n100|    }\n101|  }\n102|\n103|  return (\n104|    <div\n105|      ref={ref}\n106|      className=\"pane-divider\"\n107|      role=\"separator\"\n108|      aria-orientation=\"vertical\"\n109|      aria-label=\"Resize image pane\"\n110|      aria-valuemin={SPLIT_MIN_PX}\n111|      aria-valuemax={clampSplitWidth(Number.MAX_SAFE_INTEGER, viewport)}\n112|      aria-valuenow={width}\n113|      tabIndex={0}\n114|      title=\"Drag to resize, double-click to reset\"\n115|      onDoubleClick={() => commit(defaultSplit())}\n116|      onKeyDown={(e) => {\n117|        if (e.key === \"ArrowLeft\") {\n118|          e.preventDefault();\n119|          commit(width - 16);\n120|        } else if (e.key === \"ArrowRight\") {\n121|          e.preventDefault();\n122|          commit(width + 16);\n123|        }\n124|      }}\n125|      onPointerDown={(e) => {\n126|        (e.target as HTMLElement).setPointerCapture?.(e.pointerId);\n127|        const move = (ev: PointerEvent) => {\n128|          const grid = ref.current?.parentElement?.getBoundingClientRect();\n129|          if (grid) commit(ev.clientX - grid.left);\n130|        };\n131|        const up = () => {\n132|          window.removeEventListener(\"pointermove\", move);\n133|          window.removeEventListener(\"pointerup\", up);\n134|        };\n135|        window.addEventListener(\"pointermove\", move);\n136|        window.addEventListener(\"pointerup\", up);\n137|      }}\n138|    >\n139|      <span className=\"grip\" aria-hidden=\"true\">\n140|        |\n141|      </span>\n142|    </div>\n143|  );\n144|}\n145|\n146|export function BandPager({\n147|  k,\n148|  n,\n149|  bookIndex,\n150|  bookTotal,\n151|  onPrev,\n152|  onNext,\n153|  atStart,\n154|  atBookEnd,\n155|}: {\n156|  k: number;\n157|  n: number;\n158|  bookIndex: number;\n159|  bookTotal: number;\n160|  onPrev: () => void;\n161|  onNext: () => void;\n162|  atStart: boolean;\n163|  atBookEnd: boolean;\n164|}) {\n165|  return (\n166|    <div className=\"band-pager\">\n167|      <div className=\"pager-row\">\n168|        <button type=\"button\" className=\"pager-btn\" onClick={onPrev} disabled={atStart} aria-label=\"Previous page\">\n169|          ‹\n170|        </button>\n171|        <span className=\"pager-label\">\n172|          Scene {k} of {n}\n173|        </span>\n174|        <button type=\"button\" className=\"pager-btn\" onClick={onNext} disabled={atBookEnd} aria-label=\"Next page\">\n175|          ›\n176|        </button>\n177|      </div>\n178|      <div className=\"ticks\" aria-hidden=\"true\">\n179|        {Array.from({ length: bookTotal }, (_, i) => (\n180|          <i key={i} className={i <= bookIndex ? \"on\" : \"\"} />\n181|        ))}\n182|      </div>\n183|      <span className=\"tick-label\">\n184|        Scene {bookIndex + 1} of {bookTotal}\n185|      </span>\n186|    </div>\n187|  );\n188|}","final_result":true,"kind":"output","task_id":"01a1833c-95cf-7b42-a6ac-435390df02e6"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-95cf-7b42-a6ac-435390df02e6","task_stream":{"id":"01a1833c-95cf-7b42-a6ac-435390df02e6","kind":"task"}}}
