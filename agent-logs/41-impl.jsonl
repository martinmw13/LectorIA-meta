tml).toContain('aria-hidden=\"true\"');\n31|      }\n32|    }\n33|  });\n34|\n35|  it(\"falls back to the default set for names a skin does not override\", () => {\n36|    const names = Object.keys(ICON_SETS.default) as IconName[];\n37|    for (const name of names) {\n38|      const html = renderToStaticMarkup(createElement(Icon, { name }));\n39|      expect(html.startsWith(\"<svg\")).toBe(true);\n40|    }\n41|  });\n42|\n43|  it(\"keeps inline SVGs only in the registry and the allowlist\", () => {\n44|    const probe = \"<\" + \"svg\";\n45|    const bad: string[] = [];\n46|    for (const file of walk(\"app\")) {\n47|      if (!file.endsWith(\".tsx\") || ALLOWLIST.has(file)) continue;\n48|      if (readFileSync(file, \"utf8\").includes(probe)) bad.push(file);\n49|    }\n50|    expect(bad).toEqual([]);\n51|  });\n52|});"}}
