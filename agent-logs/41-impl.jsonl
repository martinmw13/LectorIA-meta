{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cae7","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":974,"recorded_at":1780531400001943,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"edited\nchanged lines: lines 69-74\n--- original\n+++ updated\n@@\n-@media (prefers-reduced-motion: reduce) {\n-  :root {\n-    --motion-duration: 0ms;\n-    --motion-expand: 0ms;\n-  }\n-}\n+@media (prefers-reduced-motion: reduce) {\n+  :root {\n+    --motion-duration: 0ms;\n+    --motion-expand: 0ms;\n+  }\n+}\n+\n+/* Read-along narration. The word mark and sentence tint are tokens so\n+ * skins switch them without touching components. The default skin (and\n+ * any skin outside the three treatments) uses the engraving values in\n+ * the theme blocks; watercolor and ink-doodle skins override them.\n+ * Geometry (hairline rule, bleed radius, hand-drawn circle) lives in\n+ * app/styles/narration.css and keys off the treatment attribute. */\n+:root,\n+html[data-theme=\"light\"] {\n+  --narration-mark: #ffffff;\n+  --narration-mark-edge: rgba(28, 43, 51, 0.6);\n+  --narration-glow: rgba(28, 43, 51, 0.12);\n+  --narration-sentence: rgba(28, 43, 51, 0.055);\n+  --narration-rule: rgba(28, 43, 51, 0.6);\n+}\n+\n+html[data-theme=\"dark\"] {\n+  --narration-mark: #0b1215;\n+  --narration-mark-edge: rgba(228, 230, 235, 0.6);\n+  --narration-glow: rgba(0, 0, 0, 0.4);\n+  --narration-sentence: rgba(228, 230, 235, 0.07);\n+  --narration-rule: rgba(228, 230, 235, 0.55);\n+}\n+\n+/* Watercolor: warm sienna bleed with a darker pooled edge. */\n+html[data-skin=\"watercolor\"] {\n+  --narration-mark: rgba(214, 134, 96, 0.3);\n+  --narration-mark-edge: rgba(184, 98, 62, 0.35);\n+  --narration-glow: rgba(214, 134, 96, 0.25);\n+  --narration-sentence: rgba(101, 139, 168, 0.12);\n+  --narration-rule: rgba(184, 98, 62, 0.5);\n+}\n+\n+html[data-skin=\"watercolor\"][data-theme=\"dark\"] {\n+  --narration-mark: rgba(214, 134, 96, 0.32);\n+  --narration-mark-edge: rgba(214, 134, 96, 0.5);\n+  --narration-glow: rgba(214, 134, 96, 0.28);\n+  --narration-sentence: rgba(101, 139, 168, 0.16);\n+  --narration-rule: rgba(214, 134, 96, 0.6);\n+}\n+\n+/* Ink doodle: the circle stroke is the mark; the tint stays faint. */\n+html[data-skin=\"ink-doodle\"] {\n+  --narration-mark: rgba(43, 52, 66, 0.85);\n+  --narration-mark-edge: rgba(43, 52, 66, 0.5);\n+  --narration-glow: rgba(43, 52, 66, 0.12);\n+  --narration-sentence: rgba(28, 43, 51, 0.05);\n+  --narration-rule: rgba(43, 52, 66, 0.7);\n+}\n+\n+html[data-skin=\"ink-doodle\"][data-theme=\"dark\"] {\n+  --narration-mark: rgba(228, 230, 235, 0.8);\n+  --narration-mark-edge: rgba(228, 230, 235, 0.45);\n+  --narration-glow: rgba(0, 0, 0, 0.4);\n+  --narration-sentence: rgba(228, 230, 235, 0.06);\n+  --narration-rule: rgba(228, 230, 235, 0.6);\n+}\n","final_result":true,"kind":"output","task_id":"01a18340-3e7e-7890-80f4-126f9b093dd4"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a18340-3e7e-7890-80f4-126f9b093dd4","task_stream":{"id":"01a18340-3e7e-7890-80f4-126f9b093dd4","kind":"task"}}}
