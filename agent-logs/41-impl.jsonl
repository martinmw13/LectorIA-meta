{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c823","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":620,"recorded_at":1780531400001235,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `core/reader.test.ts`.\n(99 line(s) above)\n100|        expect(pages.length).toBeGreaterThan(0);\n101|        for (const page of pages) {\n102|          for (const p of page.paragraphs) seen.push(p.n);\n103|        }\n104|      }\n105|    }\n106|    expect(seen).toEqual([1, 2, 3, 4, 5]);\n107|  });\n108|\n109|  it(\"splits at paragraph boundaries and never crosses scenes\", () => {\n110|    const model = buildReaderModel(book, { scenes });\n111|    const first = model.chapters[0]?.scenes[0];\n112|    if (!first) throw new Error(\"fixture scene missing\");\n113|    const pages = paginateScene(first.paragraphs, 1);\n114|    expect(pages.map((p) => p.paragraphs.map((q) => q.n))).toEqual([[1], [2]]);\n115|    expect(pages[0]).toMatchObject({ startN: 1, endN: 1, words: 1 });\n116|  });\n117|\n118|  it(\"splits an oversize paragraph across pages and keeps one page for an empty scene\", () => {\n119|    const big = paginateScene([{ id: \"x\", n: 9, text: \"one two three four\" }], 3);\n120|    expect(big.length).toBe(2);\n121|    expect(big.flatMap((p) => p.paragraphs.map((q) => q.n))).toEqual([9, 9]);\n122|    expect(big.flatMap((p) => p.paragraphs.map((q) => q.text)).join(\"\")).toBe(\"one two three four\");\n123|    expect(paginateScene([], 3)).toEqual([{ paragraphs: [], startN: 0, endN: 0, words: 0 }]);\n124|  });\n125|\n126|  it(\"closes a page by lines for short dialogue paragraphs\", () => {\n127|    const paras = Array.from({ length: 20 }, (_, i) => ({ id: `d${i}`, n: i + 1, text: '\"Yes.\"' }));\n128|    const pages = paginateScene(paras);\n129|    expect(pages.map((p) => p.paragraphs.length)).toEqual([12, 8]);\n130|    expect(pages.flatMap((p) => p.paragraphs.map((q) => q.n))).toEqual(paras.map((p) => p.n));\n131|  });\n132|\n133|  it(\"counts the first-line indent in line estimates\", () => {\n134|    expect(INDENT_CHARS).toBe(4);\n135|    expect(estimateLines(\"x\".repeat(58))).toBe(1);\n136|    expect(estimateLines(\"x\".repeat(58), true)).toBe(2);\n137|    const paras = Array.from({ length: FIRST_PAGE_LINES }, (_, i) => ({ id: `n${i}`, n: i + 1, text: \"x\".repeat(58) }));\n138|    expect(paginateScene(paras).length).toBeGreaterThan(1);\n139|  });\n140|\n141|  it(\"moves a paragraph whole to a fresh page when it fits there\", () => {\n142|    const paras = [\n143|      ...Array.from({ length: FIRST_PAGE_LINES }, (_, i) => ({ id: `f${i}`, n: i + 1, text: '\"Yes.\"' })),\n144|      { id: \"g\", n: FIRST_PAGE_LINES + 1, text: \"short one. short two. short three.\" },\n145|    ];\n146|    const pages = paginateScene(paras);\n147|    expect(pages.length).toBe(2);\n148|    expect(pages[1]?.paragraphs.map((q) => q.id)).toEqual([\"g\"]);\n149|    expect(pages[1]?.paragraphs[0]?.cont).toBeUndefined();\n150|  });\n151|\n152|  it(\"splits a paragraph longer than a full page, filling the current page\", () => {\n153|    const paras = [\n154|      { id: \"a\", n: 1, text: \"short one\" },\n155|      { id: \"b\", n: 2, text: \"x\".repeat(58 * 14) },\n156|      { id: \"c\", n: 3, text: \"short two\" },\n157|    ];\n158|    const pages = paginateScene(paras);\n159|    expect(pages.length).toBe(2);\n160|    expect(pages[0]?.paragraphs.map((q) => q.id)).toEqual([\"a\", \"b\"]);\n161|    for (const page of pages) {\n162|      const lines = page.paragraphs.reduce((sum, q) => sum + estimateLines(q.text), 0);\n163|      expect(lines).toBeLessThanOrEqual(page === pages[0] ? FIRST_PAGE_LINES : LINES_PER_PAGE);\n164|    }\n165|    expect(pages.flatMap((p) => p.paragraphs.map((q) => q.text)).join(\"\")).toBe(\n166|      paras.map((p) => p.text).join(\"\"),\n167|    );\n168|  });\n169|\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1833e-b96a-7c30-a07a-f7422bca9910"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833e-b96a-7c30-a07a-f7422bca9910","task_stream":{"id":"01a1833e-b96a-7c30-a07a-f7422bca9910","kind":"task"}}}
