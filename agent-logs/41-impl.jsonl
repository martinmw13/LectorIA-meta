{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f3","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":212,"recorded_at":1780531400000419,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/leer/layout.tsx`.\n1|import { buildReaderModel } from \"@/core/reader\";\n2|import { loadOzBook } from \"@/server/books\";\n3|import { Reader } from \"../reader\";\n4|\n5|// Static shell: audio and music state persist across scene routes.\n6|// Only slim metadata reaches the client: id, chapter, emotion triple.\n7|export default function LeerLayout({ children }: { children: React.ReactNode }) {\n8|  const { book, scenes } = loadOzBook();\n9|  const model = buildReaderModel(book, { scenes });\n10|  const slim = model.chapters.flatMap((chapter) =>\n11|    chapter.scenes.map((scene) => ({ id: scene.id, ch: chapter.ch, emotion: scene.emotion })),\n12|  );\n13|  const chapters = model.chapters.map((chapter) => ({\n14|    ch: chapter.ch,\n15|    title: chapter.title,\n16|    firstSceneId: chapter.scenes[0]?.id ?? \"\",\n17|  }));\n18|  return (\n19|    <Reader scenes={slim} chapters={chapters} bookTitle={model.title} bookAuthor={model.author}>\n20|      {children}\n21|    </Reader>\n22|  );\n23|}","final_result":true,"kind":"output","task_id":"01a1833c-95d7-7ee1-b1d6-3bd786003dc0"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-95d7-7ee1-b1d6-3bd786003dc0","task_stream":{"id":"01a1833c-95d7-7ee1-b1d6-3bd786003dc0","kind":"task"}}}
