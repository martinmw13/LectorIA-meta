{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9b3","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":820,"recorded_at":1780531400001635,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `core/reader.test.ts`.\n(254 line(s) above)\n255|describe(\"chapter cover and end pages\", () => {\n256|  it(\"marks the first and last scene of each chapter\", () => {\n257|    const model = buildReaderModel(book, { scenes });\n258|    expect(buildSceneView(model, \"c1s1\", 3)).toMatchObject({ isChapterFirst: true, isChapterLast: false });\n259|    expect(buildSceneView(model, \"c1s2\", 3)).toMatchObject({ isChapterFirst: false, isChapterLast: true });\n260|    expect(buildSceneView(model, \"c2s1\", 3)).toMatchObject({ isChapterFirst: true, isChapterLast: true });\n261|  });\n262|\n263|  it(\"puts the cover at index 0 and the end page last\", () => {\n264|    expect(subPageCount(2, true, false)).toBe(3);\n265|    expect(subPageCount(2, false, true)).toBe(3);\n266|    expect(subPageCount(1, true, true)).toBe(3);\n267|    expect(subPageCount(2, false, false)).toBe(2);\n268|    expect(subPageKind(0, 2, true, false)).toBe(\"cover\");\n269|    expect(subPageKind(1, 2, true, false)).toBe(\"text\");\n270|    expect(subPageKind(2, 2, false, true)).toBe(\"end\");\n271|    expect(subPageKind(0, 1, true, true)).toBe(\"cover\");\n272|    expect(subPageKind(2, 1, true, true)).toBe(\"end\");\n273|    expect(textPageAt(1, true)).toBe(0);\n274|    expect(textPageAt(2, true)).toBe(1);\n275|    expect(textPageAt(0, false)).toBe(0);\n276|  });\n277|\n278|  it(\"walks cover, text, and end pages through one reducer\", () => {\n279|    // c1s1 has a cover + 2 text pages, c1s2 has 1 text page + end.\n280|    const withCovers = buildNavIndex([\n281|      { sceneId: \"c1s1\", pages: subPageCount(2, true, false) },\n282|      { sceneId: \"c1s2\", pages: subPageCount(1, false, true) },\n283|    ]);\n284|    // Back from text page 1 returns to the cover.\n285|    expect(navReducer({ sceneId: \"c1s1\", page: 1 }, { kind: \"prev\" }, withCovers)).toEqual({\n286|      sceneId: \"c1s1\",\n287|      page: 0,\n288|    });\n289|    // Back from the cover lands on the previous chapter's last page.\n290|    expect(navReducer({ sceneId: \"c1s2\", page: 0 }, { kind: \"prev\" }, withCovers)).toEqual({\n291|      sceneId: \"c1s1\",\n292|      page: 2,\n293|    });\n294|    // enterAtEnd lands on the real last page (the end page here).\n295|    expect(navReducer({ sceneId: \"c1s1\", page: 0 }, { kind: \"goto\", sceneId: \"c1s2\", atEnd: true }, withCovers)).toEqual({\n296|      sceneId: \"c1s2\",\n297|      page: 1,\n298|    });\n299|  });\n300|});\n301|\n302|describe(\"panelCaption\", () => {\n303|  it(\"keeps a short summary whole\", () => {\n304|    expect(panelCaption(\"Dorothy wakes to bright sunshine.\")).toBe(\"Dorothy wakes to bright sunshine.\");\n305|  });\n306|\n307|  it(\"takes the first clause of a long summary\", () => {\n308|    const out = panelCaption(\n309|      \"Anxious watching turns to alarm as winds gather from north and south; Uncle Henry runs to the stock while Aunt Em screams.\",\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1833f-2b65-7881-97eb-56b97e68d8ef"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833f-2b65-7881-97eb-56b97e68d8ef","task_stream":{"id":"01a1833f-2b65-7881-97eb-56b97e68d8ef","kind":"task"}}}
