);\n316|  overflow: hidden;\n317|}\n318|\n319|.vault-thumb img {\n320|  width: 100%;\n321|  height: 100px;\n322|  object-fit: cover;\n323|  display: block;\n324|}\n325|\n326|.vault-cap {\n327|  display: -webkit-box;\n328|  -webkit-line-clamp: 2;\n329|  -webkit-box-orient: vertical;\n330|  overflow: hidden;\n331|  padding: 7px 9px 2px;\n332|  font-family: var(--font-book);\n333|  font-size: 14.5px;\n334|  font-style: italic;\n335|  line-height: 1.4;\n336|}\n337|\n338|.vault-meta {\n339|  display: flex;\n340|  align-items: center;\n341|  gap: 6px;\n342|  padding: 2px 9px 8px;\n343|}\n344|\n345|.vault-x {\n346|  width: 22px;\n347|  height: 22px;\n348|  border-radius: 6px;\n349|  background: var(--color-surface);\n350|  border: 1px solid var(--color-border);\n351|  display: inline-flex;\n352|  align-items: center;\n353|  justify-content: center;\n354|  cursor: pointer;\n355|  color: var(--color-text-muted);\n356|  flex: none;\n357|  margin-left: auto;\n358|}\n359|\n360|.vault-x:hover {\n361|  border-color: var(--color-accent);\n362|  color: var(--color-accent);\n363|}\n364|\n365|.vault-x svg {\n366|  stroke: currentColor;\n367|  fill: none;\n368|  stroke-width: 1.5;\n369|}\n370|\n371|.vault-empty {\n372|  font-family: var(--font-ui);\n373|  font-size: 12.5px;\n374|  color: var(--color-text-muted);\n375|  margin-top: 8px;\n376|  line-height: 1.55;\n377|}\n378|\n379|.style-picker {\n380|  margin-top: 16px;\n381|  display: flex;\n382|  flex-direction: column;\n383|  gap: 6px;\n384|}\n385|\n386|.style-picker select,\n387|.style-custom input {\n388|  font-family: var(--font-ui);\n389|  font-size: 12.5px;\n390|  color: var(--color-text);\n391|  background: var(--color-surface);\n392|  border: 1px solid var(--color-border);\n393|  border-radius: 6px;\n394|  padding: 6px 8px;\n395|  max-width: 100%;\n396|}\n397|\n398|.style-picker select:focus-visible,\n399|.style-custom input:focus-visible,\n400|.style-custom button:focus-visible {\n401|  outline: 2px solid var(--color-accent)