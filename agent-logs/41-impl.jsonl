{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd23","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":1260,"recorded_at":1780531400002515,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"edited\nchanged lines: lines 4-43\n--- original\n+++ updated\n@@\n-// “Oz’s,” didn’t run — punctuation and curly quotes never highlight,\n-// and Oz’s / didn't each stay one word: [start, end, t0, t1, ...].\n-const W = [\n-  1, 5, 0.0, 0.4, // Oz’s\n-  7, 12, 0.5, 0.9, // didn’t\n-  13, 16, 1.0, 1.2, // run\n-];\n-\n-describe(\"wordsInFragment\", () => {\n-  it(\"returns every word of a whole fragment in fragment offsets\", () => {\n-    expect(wordsInFragment(W, 0, 17)).toEqual([\n-      { start: 1, end: 5, t0: 0.0, t1: 0.4 },\n-      { start: 7, end: 12, t0: 0.5, t1: 0.9 },\n-      { start: 13, end: 16, t0: 1.0, t1: 1.2 },\n-    ]);\n-  });\n-\n-  it(\"splits a paragraph across two fragments with no word lost or doubled\", () => {\n-    const first = wordsInFragment(W, 0, 7);\n-    const second = wordsInFragment(W, 7, 10);\n-    expect(first.map((w) => [w.start, w.end])).toEqual([\n-      [1, 5],\n-    ]);\n-    expect(second.map((w) => [w.start, w.end])).toEqual([\n-      [0, 5],\n-      [6, 9],\n-    ]);\n-    // Fragment-relative offsets point back at the paragraph text.\n-    const text = \"“Oz’s,” didn’t run\";\n-    for (const [frag, from] of [\n-      [first, 0],\n-      [second, 7],\n-    ] as const) {\n-      for (const word of frag) {\n-        const abs = text.slice(from + word.start, from + word.end);\n-        expect(abs).not.toContain(\" \");\n-        expect(abs.length).toBeGreaterThan(0);\n-      }\n-    }\n-  });\n+// “Oz’s,” didn’t run — punctuation and curly quotes never highlight,\n+// and Oz’s / didn't each stay one word: [start, end, t0, t1, ...].\n+const TEXT = \"“Oz’s,” didn’t run\";\n+const W = [\n+  1, 5, 0.0, 0.4, // Oz’s\n+  8, 13, 0.5, 0.9, // didn’t\n+  14, 17, 1.0, 1.2, // run\n+];\n+\n+describe(\"wordsInFragment\", () => {\n+  it(\"returns every word of a whole fragment in fragment offsets\", () => {\n+    expect(wordsInFragment(W, 0, TEXT.length)).toEqual([\n+      { start: 1, end: 5, t0: 0.0, t1: 0.4 },\n+      { start: 8, end: 13, t0: 0.5, t1: 0.9 },\n+      { start: 14, end: 17, t0: 1.0, t1: 1.2 },\n+    ]);\n+  });\n+\n+  it(\"splits a paragraph across two fragments with no word lost or doubled\", () => {\n+    const first = wordsInFragment(W, 0, 7);\n+    const second = wordsInFragment(W, 7, TEXT.length - 7);\n+    expect(first.map((w) => [w.start, w.end])).toEqual([[1, 5]]);\n+    expect(second.map((w) => [w.start, w.end])).toEqual([\n+      [1, 6],\n+      [7, 10],\n+    ]);\n+    // Fragment-relative offsets point back at the paragraph text.\n+    for (const [frag, from] of [\n+      [first, 0],\n+      [second, 7],\n+    ] as const) {\n+      for (const word of frag) {\n+        const abs = TEXT.slice(from + word.start, from + word.end);\n+        expect(abs).not.toContain(\" \");\n+        expect(abs.length).toBeGreaterThan(0);\n+      }\n+    }\n+  });\n","final_result":true,"kind":"output","task_id":"01a18341-56a0-7c72-b62b-67c287ce121f"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a18341-56a0-7c72-b62b-67c287ce121f","task_stream":{"id":"01a18341-56a0-7c72-b62b-67c287ce121f","kind":"task"}}}
