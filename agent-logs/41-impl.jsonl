{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bb","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":440,"recorded_at":1780531400000875,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"{\n  \"chunk_id\": \"exec-6-1\",\n  \"command\": \"grep -rn \\\"tokens\\\\|hex\\\\|#[0-9a-fA-F]\\\\|rgb\\\" scripts/check-secrets.mjs app/skin.test.ts 2>/dev/null | head -20; echo ---; cat scripts/check-secrets.mjs | head -60; echo ---; grep -rln \\\"tokens.css\\\\|--color\\\" app --include=\\\"*.test.*\\\" | head; echo ---; cat core/narration.test.ts | head -80\",\n  \"description\": \"Check secrets hook and narration tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"---\\n// Pre-commit secret scan: staged text files must hold no credentials.\\n// With --all it scans every tracked file at HEAD plus full git history.\\n// Plain Node, no dependencies. Findings never print the secret itself.\\nimport { execFileSync } from 'node:child_process';\\nimport { fileURLToPath } from 'node:url';\\n\\nexport const ALLOW_MARKER = 'secret-scan:allow';\\n// Paths the secret scan skips: lockfiles only, which we do not author.\\n// Binary blobs are skipped separately via isBinaryBuffer. Everything else\\n// is scanned, including agent-logs/, public/ and .agents/skills/.\\nexport const SECRET_IGNORE_PATTERNS = [\\n  'package-lock.json',\\n  'pnpm-lock.yaml',\\n  'yarn.lock',\\n  'bun.lockb',\\n  'uv.lock',\\n  'poetry.lock',\\n  '*.lock',\\n];\\n\\nexport function isSecretSkipped(path) {\\n  const slash = path.lastIndexOf('/');\\n  const name = slash === -1 ? path : path.slice(slash + 1);\\n  for (const pattern of SECRET_IGNORE_PATTERNS) {\\n    if (pattern.includes('*')) {\\n      if (name.endsWith(pattern.slice(1))) return true;\\n    } else if (name === pattern) {\\n      return true;\\n    }\\n  }\\n  return false;\\n}\\nexport const ENTROPY_THRESHOLD = 3.5;\\nexport const ENTROPY_MIN_LENGTH = 20;\\n\\n// Each rule needs a token-looking suffix so prose that names a prefix\\n// (like this file) does not match. Keep it that way when adding rules.\\nexport const RULES = [\\n  { name: 'jev', pattern: /\\\\bjv_live_[A-Za-z0-9_-]{16,}/ },\\n  { name: 'openai', pattern: /sk-[A-Za-z0-9_-]{20,}/ },\\n  { name: 'meta-llm', pattern: /LLM\\\\|[A-Za-z0-9_-]{10,}/ },\\n  { name: 'meta-bearer', pattern: /Bearer\\\\s+[A-Za-z0-9._~-]{20,}/ },\\n  { name: 'github', pattern: /(?:ghp|gho)_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}/ },\\n  { name: 'aws', pattern: /AKIA[0-9A-Z]{16}/ },\\n  { name: 'private-key', pattern: /-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----/ },\\n  { name: 'redis-url', pattern: /rediss?:\\\\/\\\\/[^:\\\\s]+:[^@\\\\s]+@/ },\\n];\\n\\nconst ASSIGNMENT = /^\\\\s*(?:export\\\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\\\s*=\\\\s*(.*?)\\\\s*$/;\\nconst SECRET_NAME = /(KEY|TOKEN|SECRET|PASSWORD)$/i;\\nconst PLACEHOLDERS = ['your-', 'your_', 'changeme', 'change-me', 'xxx', '<', '>'];\\n\\n// File names refused whatever they hold. .env.example stays allowed.\\nexport function isForbiddenFilename(path) {\\n  const slash = path.lastIndexOf('/');\\n  const name = slash === -1 ? path : path.slice(slash + 1);\\n  return (\\n    name === '.env' ||\\n    name === '.env.local' ||\\n    (name.startsWith('.env.') && name.endsWith('.local')) ||\\n---\\n---\\nimport { createHash } from \\\"node:crypto\\\";\\nimport { describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  NARRATION_FORMAT,\\n  NARRATION_MODEL,\\n  NARRATION_SPEED,\\n  NARRATION_VOICE,\\n  PARAGRAPH_GAP_SEC,\\n  SENTENCE_GAP_SEC,\\n  activeChunkAt,\\n  activeWordAt,\\n  actualNarrationMicro,\\n  alignWords,\\n  chapterChunks,\\n  chaptersToPrepare,\\n  estimateNarrationMicro,\\n  narrationKey,\\n  narrationKeyInput,\\n  parseChapterNarration,\\n  sceneSpan,\\n  splitSentences,\\n  wordAt,\\n} from \\\"./narration\\\";\\nimport type { WordToken } from \\\"./narration\\\";\\nimport probeRaw from \\\"./fixtures/kokoro-probe.json\\\";\\n\\nconst OZ = `“I am Oz, the Great and Terrible,” said the little man, in a trembling voice. “But don't strike me — please don't — and I will do anything you want me to do.” “Oh, you're a humbug!” said Dorothy. Mr. H. M. Wogglebug rushed — very fast — toward the door!” said Dorothy, turning pale.`;\\n\\n// Oz-style text: curly quotes, a dialogue tag after a quoted sentence,\\n// and a quote ending the paragraph (see OZ for em dashes and Mr.).\\nconst OZ_PARA = \\\"\\\\u201cYou have plenty of courage, I am sure,\\\\u201d answered Oz. \\\\u201cAll you need is confidence in yourself.\\\\u201d\\\\n\\\"\\n\\ndescribe(\\\"splitSentences\\\", () => {\\n  it(\\\"covers every non-space char with trimmed offsets\\\", () => {\\n    const spans = splitSentences(OZ_PARA);\\n    expect(spans.length).toBeGreaterThan(0);\\n    for (const span of spans) {\\n      expect(OZ_PARA[span.start]).toMatch(/\\\\S/);\\n      expect(OZ_PARA[span.end - 1]).toMatch(/\\\\S/);\\n    }\\n    const covered = spans.map((s) => OZ_PARA.slice(s.start, s.end).replace(/\\\\s+/g, \\\" \\\").trim()).join(\\\" \\\");\\n    expect(covered.replace(/\\\\s+/g, \\\" \\\").trim()).toBe(OZ_PARA.replace(/\\\\s+/g, \\\" \\\").trim());\\n  });\\n\\n  it(\\\"does not end after Mr. or a single capital initial\\\", () => {\\n    const spans = splitSentences(`Mr. H. M. Wogglebug rushed toward the door and knocked loudly.`);\\n    expect(spans).toHaveLength(1);\\n  });\\n\\n  it(\\\"ends at ! and ? plus closing quotes before whitespace\\\", () => {\\n    const spans = splitSentences(`“Oh, you're a humbug!” said Dorothy. Are you quite sure about that?`);\\n    expect(spans).toHaveLength(2);\\n    // \\\"said Dorothy.\\\" is two words, so it merges into the sentence before it.\\n    expect(spans[0]).toEqual({ start: 0, end: `“Oh, you're a humbug!” said Dorothy.`.length });\\n  });\\n\\n  it(\\\"ends a paragraph-final quote without trailing space\\\", () => {\\n    const text = `She whispered, “do not be afraid.”`;\\n    const spans = splitSentences(text);\\n    expect(spans).toHaveLength(1);\\n    expect(spans[0]).toEqual({ start: 0, end: text.length });\\n  });\\n\\n  it(\\\"merges a sub-3-word piece into its neighbor\\\", () => {\\n    const spans = splitSentences(`The lion roared with tremendous courage. Yes! He ran away quickly.`);\\n    const texts = spans.map((s) => `The lion roared with tremendous courage. Yes! He ran away quickly.`.slice(s.start, s.end));\\n    expect(texts.some((t) => t === \\\"Yes!\\\")).toBe(false);\\n    expect(spans).toHaveLength(2);\\n  });\\n\\n  it(\\\"handles the Oz sample end to end\\\", () => {\\n    const spans = splitSentences(OZ);\\n    expect(spans.length).toBeGreaterThanOrEqual(3);\\n    expect(OZ.slice(spans[0]?.start, spans[0]?.end)).toContain(\\\"Great and Terrible\\\");\\n  });\\n});\\n\\ndescribe(\\\"chapterChunks\\\", () => {\\n  it(\\\"uses paragraph gaps across paragraphs and sentence gaps within\\\", () => {\\n    const { chunks, gaps } = chapterChunks([\\n\",\n  \"original_output_bytes\": 5808,\n  \"original_output_tokens\": 1452,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a1833c-f42c-7d33-b029-f12d5b76e4a1"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-f42c-7d33-b029-f12d5b76e4a1","task_stream":{"id":"01a1833c-f42c-7d33-b029-f12d5b76e4a1","kind":"task"}}}
