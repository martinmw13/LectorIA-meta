{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3dd","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":73,"recorded_at":1780531400000141,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/icons.tsx`.\n1|import type { ReactNode, SVGProps } from \"react\";\n2|import { DEFAULT_SKIN, type SkinId } from \"./skin\";\n3|\n4|export type IconName = \"moon\" | \"sun\" | \"eye-off\" | \"pencil\" | \"picture\" | \"expand\";\n5|\n6|export interface IconDef {\n7|  width: number;\n8|  height: number;\n9|  viewBox: string;\n10|  body: ReactNode;\n11|}\n12|\n13|// Verbatim copies of the inline SVGs the folio call sites had.\n14|const defaultSet: Record<IconName, IconDef> = {\n15|  moon: {\n16|    width: 16,\n17|    height: 16,\n18|    viewBox: \"0 0 16 16\",\n19|    body: <path d=\"M13.5 9.5A5.8 5.8 0 0 1 6.5 2.5a5.8 5.8 0 1 0 7 7Z\" />,\n20|  },\n21|  sun: {\n22|    width: 16,\n23|    height: 16,\n24|    viewBox: \"0 0 16 16\",\n25|    body: (\n26|      <>\n27|        <circle cx=\"8\" cy=\"8\" r=\"3.2\" />\n28|        <path d=\"M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2 3.4 12.6\" />\n29|      </>\n30|    ),\n31|  },\n32|  \"eye-off\": {\n33|    width: 14,\n34|    height: 14,\n35|    viewBox: \"0 0 16 16\",\n36|    body: (\n37|      <path d=\"M2.5 2.5l11 11M6.6 3.2c.5-.1 1-.2 1.4-.2 2.8 0 5.2 2.4 6 5-1 3.2-3.2 5-6 5-1 0-2-.3-2.8-.7M4 4.6C2.7 5.7 2 7 2 8c.8 2.6 3.2 5 6 5 1 0 2-.3 2.9-.8\" />\n38|    ),\n39|  },\n40|  pencil: {\n41|    width: 18,\n42|    height: 18,\n43|    viewBox: \"0 0 16 16\",\n44|    body: <path d=\"M11.5 2.5l2 2L5 13l-2.7.7L3 11l8.5-8.5Z\" />,\n45|  },\n46|  picture: {\n47|    width: 13,\n48|    height: 13,\n49|    viewBox: \"0 0 16 16\",\n50|    body: (\n51|      <>\n52|        <rect x=\"2.5\" y=\"2.5\" width=\"11\" height=\"11\" />\n53|        <circle cx=\"6\" cy=\"7\" r=\"1.4\" />\n54|        <path d=\"M3.5 13 7 9.5l2.5 2.5 2-2 1 1\" />\n55|      </>\n56|    ),\n57|  },\n58|  expand: {\n59|    width: 11,\n60|    height: 11,\n61|    viewBox: \"0 0 16 16\",\n62|    body: <path d=\"M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9\" />,\n63|  },\n64|};\n65|\n66|export const ICON_SETS: Record<SkinId, Partial<Record<IconName, IconDef>>> = {\n67|  default: defaultSet,\n68|};\n69|\n70|export function Icon({\n71|  name,\n72|  size,\n73|  skin = DEFAULT_SKIN,\n74|  ...rest\n75|}: { name: IconName; size?: number; skin?: SkinId } & SVGProps<SVGSVGElement>) {\n76|  const def = ICON_SETS[skin]?.[name] ?? ICON_SETS.default[name];\n77|  if (!def) throw new Error(`unknown icon: ${name}`);\n78|  return (\n79|    <svg width={size ?? def.width} height={size ?? def.height} viewBox={def.viewBox} aria-hidden=\"true\" {...rest}>\n80|      {def.body}\n81|    </svg>\n82|  );\n83|}","final_result":true,"kind":"output","task_id":"01a1833c-723a-7653-8a03-92f0939d678f"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-723a-7653-8a03-92f0939d678f","task_stream":{"id":"01a1833c-723a-7653-8a03-92f0939d678f","kind":"task"}}}
