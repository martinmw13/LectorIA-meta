{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c655","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":389,"recorded_at":1780531400000773,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `core/client-safe.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import { readFileSync } from \"node:fs\";\n3|import { join } from \"node:path\";\n4|\n5|// The home upload page runs these modules in the browser, so they must\n6|// stay free of node imports and env reads. The pipeline keeps its own\n7|// node clients and injects them (DOMParser, judges, file writes).\n8|const CLIENT_SAFE = [\n9|  \"core/clean.ts\",\n10|  \"core/clean-rules.ts\",\n11|  \"core/clean-types.ts\",\n12|  \"core/clean-txt.ts\",\n13|  \"core/epub.ts\",\n14|];\n15|\n16|describe(\"client-safe core\", () => {\n17|  it(\"has no node: imports and no env reads\", () => {\n18|    for (const file of CLIENT_SAFE) {\n19|      const text = readFileSync(join(process.cwd(), file), \"utf8\");\n20|      for (const line of text.split(\"\\n\")) {\n21|        if (/^\\s*import[ (]/.test(line)) expect(line, file).not.toContain(\"node:\");\n22|      }\n23|      expect(text, file).not.toContain(\"process.env\");\n24|    }\n25|  });\n26|});","final_result":true,"kind":"output","task_id":"01a1833c-e0eb-7433-a0a9-530769e0c6c0"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-e0eb-7433-a0a9-530769e0c6c0","task_stream":{"id":"01a1833c-e0eb-7433-a0a9-530769e0c6c0","kind":"task"}}}
