{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c72b","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":496,"recorded_at":1780531400000987,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/folio/copy-gates.test.ts`.\n1|// Copy gates for chapter panels: the panels name lives in one const,\n2|// user copy never says Generated, and Meta blue stays the only accent.\n3|import { describe, expect, it } from \"vitest\";\n4|import { readdirSync, readFileSync, statSync } from \"node:fs\";\n5|import { dirname, join } from \"node:path\";\n6|import { fileURLToPath } from \"node:url\";\n7|\n8|const root = join(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n9|\n10|function sources(): { path: string; text: string }[] {\n11|  const out: { path: string; text: string }[] = [];\n12|  const walk = (dir: string) => {\n13|    for (const name of readdirSync(dir)) {\n14|      const path = join(dir, name);\n15|      if (statSync(path).isDirectory()) {\n16|        walk(path);\n17|        continue;\n18|      }\n19|      if (!/\\.(tsx?|css)$/.test(name) || /\\.test\\.[jt]sx?$/.test(name)) continue;\n20|      out.push({ path, text: readFileSync(path, \"utf8\") });\n21|    }\n22|  };\n23|  walk(join(root, \"app\"));\n24|  walk(join(root, \"core\"));\n25|  return out;\n26|}\n27|\n28|const PURPLES = new Set(\n29|  [\"800080\", \"8e44ad\", \"9b59b6\", \"a855f7\", \"7c3aed\", \"6d28d9\", \"9333ea\", \"5b21b6\", \"4c1d95\", \"c084fc\", \"d8b4fe\", \"e9d5ff\", \"ee82ee\", \"9400d3\", \"9370db\", \"663399\"],\n30|);\n31|\n32|describe(\"chapter panels copy gates\", () => {\n33|  it(\"names the panels view exactly once across app and core sources\", () => {\n34|    const files = sources();\n35|    const hits = files.filter((f) => f.text.includes(\"Chapter in panels\")).map((f) => f.path);\n36|    expect(hits).toEqual([join(root, \"app\", \"folio\", \"panels.ts\")]);\n37|  });\n38|\n39|  it(\"never says Generated in user sources\", () => {\n40|    const hits = sources()\n41|      .filter((f) => f.text.includes(\"Generated\"))\n42|      .map((f) => f.path);\n43|    expect(hits).toEqual([]);\n44|  });\n45|\n46|  it(\"uses no purple hex anywhere in app or core\", () => {\n47|    const hits: string[] = [];\n48|    for (const f of sources()) {\n49|      for (const m of f.text.matchAll(/#([0-9a-fA-F]{6})\\b/g)) {\n50|        if (PURPLES.has(m[1]?.toLowerCase() ?? \"\")) hits.push(`${f.path}: ${m[0]}`);\n51|      }\n52|    }\n53|    expect(hits).toEqual([]);\n54|  });\n55|});","final_result":true,"kind":"output","task_id":"01a1833d-103a-7c50-97d6-eb57d515b511"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833d-103a-7c50-97d6-eb57d515b511","task_stream":{"id":"01a1833d-103a-7c50-97d6-eb57d515b511","kind":"task"}}}
