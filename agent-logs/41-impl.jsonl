{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b5","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":309,"recorded_at":1780531400000613,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/icons.test.ts`.\n1|import { readdirSync, readFileSync, statSync } from \"node:fs\";\n2|import { join } from \"node:path\";\n3|import { createElement } from \"react\";\n4|import { renderToStaticMarkup } from \"react-dom/server\";\n5|import { describe, expect, it } from \"vitest\";\n6|import { ICON_SETS, Icon, type IconName } from \"./icons\";\n7|import { SKINS } from \"./skin\";\n8|\n9|// app/player.tsx and app/rain-button.tsx keep their inline SVGs until\n10|// their open PRs land, then they migrate to the registry.\n11|const ALLOWLIST = new Set([\"app/icons.tsx\", \"app/player.tsx\", \"app/rain-button.tsx\"]);\n12|\n13|function walk(dir: string, out: string[] = []): string[] {\n14|  for (const name of readdirSync(dir)) {\n15|    const path = join(dir, name);\n16|    if (statSync(path).isDirectory()) walk(path, out);\n17|    else out.push(path);\n18|  }\n19|  return out;\n20|}\n21|\n22|describe(\"icon registry\", () => {\n23|  it(\"resolves every name for every skin with identical svg markup\", () => {\n24|    const names = Object.keys(ICON_SETS.default) as IconName[];\n25|    expect(names.length).toBeGreaterThan(0);\n26|    for (const skin of SKINS) {\n27|      for (const name of names) {\n28|        const html = renderToStaticMarkup(createElement(Icon, { name, skin }));\n29|        expect(html).toContain(\"viewBox=\");\n30|        expect(html).toContain('aria-hidden=\"true\"');\n31|      }\n32|    }\n33|  });\n34|\n35|  it(\"falls back to the default set for names a skin does not override\", () => {\n36|    const names = Object.keys(ICON_SETS.default) as IconName[];\n37|    for (const name of names) {\n38|      const html = renderToStaticMarkup(createElement(Icon, { name }));\n39|      expect(html.startsWith(\"<svg\")).toBe(true);\n40|    }\n41|  });\n42|\n43|  it(\"keeps inline SVGs only in the registry and the allowlist\", () => {\n44|    const probe = \"<\" + \"svg\";\n45|    const bad: string[] = [];\n46|    for (const file of walk(\"app\")) {\n47|      if (!file.endsWith(\".tsx\") || ALLOWLIST.has(file)) continue;\n48|      if (readFileSync(file, \"utf8\").includes(probe)) bad.push(file);\n49|    }\n50|    expect(bad).toEqual([]);\n51|  });\n52|});","final_result":true,"kind":"output","task_id":"01a1833c-c522-7192-a426-a7be76fe0e52"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-c522-7192-a426-a7be76fe0e52","task_stream":{"id":"01a1833c-c522-7192-a426-a7be76fe0e52","kind":"task"}}}
