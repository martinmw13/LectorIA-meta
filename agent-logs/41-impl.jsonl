{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e9","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":79,"recorded_at":1780531400000153,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/player.tsx`.\n1|\"use client\";\n2|\n3|import { useEffect, useLayoutEffect, useRef, useState } from \"react\";\n4|import { MUSIC_CONFIG, nowPlaying } from \"@/core/music\";\n5|import { marqueeDurationMs } from \"./marquee\";\n6|import { displayTitle } from \"@/core/music-credit\";\n7|import { effectiveEnd, gainVolume } from \"@/core/music-playback\";\n8|import type { MusicMode, MusicModeId, Track } from \"@/core/music\";\n9|import { MusicStyleControl } from \"./folio/music-style-control\";\n10|import { RainAmbience } from \"./rain-button\";\n11|\n12|// Two audio elements with equal-power crossfades. Volume lives in a\n13|// ref, so the slider never re-runs the track effect or touches src.\n14|// Nothing plays before the first user press. Reduced motion only\n15|// affects visuals; the audio fade always runs its full length.\n16|export function Player({\n17|  track,\n18|  replayNonce,\n19|  fadeSec,\n20|  canPrev,\n21|  onPrev,\n22|  canSkip,\n23|  onSkip,\n24|  volume,\n25|  muted,\n26|  onVolumeChange,\n27|  onMutedChange,\n28|  modes,\n29|  current,\n30|  onAdvance,\n31|  onEnded,\n32|  playlistOn,\n33|}: {\n34|  track: Track | null;\n35|  replayNonce: number;\n36|  fadeSec: number;\n37|  canPrev: boolean;\n38|  onPrev: () => void;\n39|  canSkip: boolean;\n40|  onSkip: () => void;\n41|  volume: number;\n42|  muted: boolean;\n43|  onVolumeChange: (volume: number) => void;\n44|  onMutedChange: (muted: boolean) => void;\n45|  modes: MusicMode[];\n46|  current: MusicModeId | null;\n47|  onAdvance: (to?: MusicModeId) => void;\n48|  onEnded: (trackId: string) => void;\n49|  playlistOn: boolean;\n50|}) {\n51|  const firstRef = useRef<HTMLAudioElement | null>(null);\n52|  const secondRef = useRef<HTMLAudioElement | null>(null);\n53|  const audibleRef = useRef(0);\n54|  const levelRef = useRef<[number, number]>([1, 0]);\n55|  const gainRef = useRef<[number, number]>([0, 0]);\n56|  const segmentEndRef = useRef<string | null>(null);\n57|  // Slider value and mute live in the reader (persisted prefs); refs\n58|  // mirror the props so the engine never re-runs on volume moves.\n59|  const volumeRef = useRef(volume);\n60|  volumeRef.current = volume;\n61|  const mutedRef = useRef(muted);\n62|  mutedRef.current = muted;\n63|  const fadeRef = useRef<number | null>(null);\n64|  const loopArmedRef = useRef<string | null>(null);\n65|  const trackRef = useRef<Track | null>(track);\n66|  trackRef.current = track;\n67|  const fadeSecRef = useRef(fadeSec);\n68|  fadeSecRef.current = fadeSec;\n69|  const onEndedRef = useRef(onEnded);\n70|  onEndedRef.current = onEnded;\n71|  const playingRef = useRef(false);\n72|  const startedRef = useRef(false);\n73|  const firstPlayRef = useRef(true);\n74|\n75|  // Scheduler fade when set, else the config default; never 0 mid session.\n76|  function loopFadeSec() {\n77|    return fadeSecRef.current > 0 ? fadeSecRef.current : MUSIC_CONFIG.crossfadeSec;\n78|  }\n79|  const [started, setStarted] = useState(false);\n80|  const [playing, setPlaying] = useState(false);\n81|  const requestPlayRef = useRef((_: Track, __: number) => {});\n82|\n83|  const [reducedMotion, setReducedMotion] = useState(\n84|    () =>\n85|      typeof window !== \"undefined\" &&\n86|      !!window.matchMedia?.(\"(prefers-reduced-motion: reduce)\").matches,\n87|  );\n88|\n89|  useEffect(() => {\n90|    const query = window.matchMedia?.(\"(prefers-reduced-motion: reduce)\");\n91|    if (!query) return;\n92|    const onChange = (event: MediaQueryListEvent) => setReducedMotion(event.matches);\n93|    query.addEventListener(\"change\", onChange);\n94|    return () => query.removeEventListener(\"change\", onChange);\n95|  }, []);\n96|\n97|  function applyLevels() {\n98|    const els = [firstRef.current, secondRef.current];\n99|    const audible = mutedRef.current ? 0 : volumeRef.current;\n100|    els.forEach((el, i) => {\n101|      if (el)\n102|        el.volume = gainVolume(\n103|          levelRef.current[i] ?? 0,\n104|          audible,\n105|          gainRef.current[i] ?? 0,\n106|        );\n107|    });\n108|  }\n109|\n110|  function cancelFade() {\n111|    if (fadeRef.current !== null) {\n112|      cancelAnimationFrame(fadeRef.current);\n113|      fadeRef.current = null;\n114|    }\n115|  }\n116|\n117|  // Assigned each render so handlers always see fresh refs. Fades from\n118|  // the currently louder element to the newest track; a mid-fade request\n119|  // cancels the pending fade and starts from current levels.\n120|  requestPlayRef.current = (next: Track, durSec: number) => {\n121|    const els = [firstRef.current, secondRef.current];\n122|    const srcIdx = (levelRef.current[0] ?? 0) >= (levelRef.current[1] ?? 0) ? 0 : 1;\n123|    const dstIdx = 1 - srcIdx;\n124|    const srcEl = els[srcIdx];\n125|    const dst = els[dstIdx];\n126|    if (!srcEl || !dst) return;\n127|    cancelFade();\n128|    if (trackRef.current?.id !== next.id) loopArmedRef.current = null;\n129|    trackRef.current = next;\n130|    segmentEndRef.current = null;\n131|    gainRef.current[dstIdx] = next.gainDb ?? 0;\n132|    dst.src = next.src;\n133|    dst.onloadedmetadata = () => {\n134|      if (next.startSec > 0 && Number.isFinite(dst.duration) && next.startSec < dst.duration) {\n135|        try {\n136|          dst.currentTime = next.startSec;\n137|        } catch {\n138|          // Past the end; leave playback at zero.\n139|        }\n140|      }\n141|    };\n142|    if (!playingRef.current || durSec <= 0) {\n143|      levelRef.current = [0, 0];\n144|      levelRef.current[dstIdx] = 1;\