+= 4) {\n225|      const s = words[k] as number;\n226|      const e = words[k + 1] as number;\n227|      const wt0 = words[k + 2] as number;\n228|      const wt1 = words[k + 3] as number;\n229|      if (!Number.isInteger(s) || !Number.isInteger(e) || !(start <= s && s < e && e <= (end as number))) {\n230|        throw new Error(\"invalid narration manifest\");\n231|      }\n232|      if (!(from - 0.05 <= wt0 && wt0 <= to + 0.05 && from - 0.05 <= wt1 && wt1 <= to + 0.05)) {\n233|        throw new Error(\"invalid narration manifest\");\n234|      }\n235|      if (k > 0 && s < (words[k - 4] as number)) throw new Error(\"invalid narration manifest\");\n236|    }\n237|    return { n: n as number, start: start as number, end: end as number, t0: from, t1: to, w: words };\n238|  });\n239|  for (let i = 1; i < chunks.length; i++) {\n240|    if ((chunks[i] as ChapterChunkTiming).t0 < (chunks[i - 1] as ChapterChunkTiming).t0) {\n241|      throw new Error(\"invalid narration manifest\");\n242|    }\n243|  }\n244|  return {\n245|    format: 2,\n246|    key: json.key as string,\n247|    src: json.src as string,\n248|    durationSec: json.durationSec as number,\n249|    voice: json.voice as string,\n250|    model: json.model as string,\n251|    speed: json.speed as number,\n252|    chunks,\n253|  };\n254|}\n255|\n256|function isSafeSrc(src: string): boolean {\n257|  if (src.startsWith(\"/narration/\")) return true;\n258|  if (src.startsWith(\"https://\")) {\n259|    try {\n260|      new URL(src);\n261|      return true;\n262|    } catch {\n263|      return false;\n264|    }\n265|  }\n266|  return false;\n267|}\n268|\n269|// Binary search: index of the last chunk with t0 <= t, so the highlight\n270|// stays on a sentence through the gap after it. -1 before the first.\n271|export function activeChunkAt(chunks: { t0: number }[], tSec: number): number {\n272|  let lo = 0;\n273|  let hi = chunks.length - 1;\n274|  let found = -1;\n275|  while (lo <= hi) {\n276|    const mid = (lo + hi)