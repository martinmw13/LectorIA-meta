{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9e1","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":843,"recorded_at":1780531400001681,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"edited\nchanged lines: line 302\n--- original\n+++ updated\n@@\n-describe(\"panelCaption\", () => {\n+describe(\"fragment from offsets\", () => {\n+  it(\"starts whole paragraphs at 0 and chains split fragments exactly\", () => {\n+    const text = \"The cyclone came swiftly across the prairie, howling loud. \".repeat(14);\n+    const pages = paginateScene([{ id: \"c1p1\", n: 1, text }]);\n+    const frags = pages.flatMap((p) => p.paragraphs);\n+    expect(frags.length).toBeGreaterThan(1);\n+    expect(frags[0]?.from).toBe(0);\n+    let cursor = 0;\n+    for (const frag of frags) {\n+      expect(frag.from).toBe(cursor);\n+      expect(text.slice(frag.from, (frag.from ?? 0) + frag.text.length)).toBe(frag.text);\n+      cursor += frag.text.length;\n+    }\n+    expect(cursor).toBe(text.length);\n+  });\n+\n+  it(\"keeps from at 0 for paragraphs that move whole\", () => {\n+    const pages = paginateScene([\n+      { id: \"a\", n: 1, text: \"short one\" },\n+      { id: \"b\", n: 2, text: \"short two\" },\n+    ]);\n+    for (const frag of pages.flatMap((p) => p.paragraphs)) {\n+      expect(frag.from).toBe(0);\n+      expect(frag.cont).toBeUndefined();\n+    }\n+  });\n+});\n+\n+describe(\"panelCaption\", () => {\n","final_result":true,"kind":"output","task_id":"01a1833f-3816-73f3-83dd-1f1695e1c5c1"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833f-3816-73f3-83dd-1f1695e1c5c1","task_stream":{"id":"01a1833f-3816-73f3-83dd-1f1695e1c5c1","kind":"task"}}}
