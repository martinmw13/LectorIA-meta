{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e1","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":75,"recorded_at":1780531400000145,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `core/narration.ts`.\n1|// Pure narration logic: sentence split, chunking, cache keys, manifest\n2|// validation, playback helpers, and cost math. No env, no network,\n3|// no crypto, no node: imports; callers inject hashing.\n4|export const NARRATION_VOICE = \"af_heart\";\n5|export const NARRATION_MODEL = \"kokoro-82m/0.9.4\";\n6|export const NARRATION_SPEED = 0.95;\n7|export const NARRATION_FORMAT = 2;\n8|export const SENTENCE_GAP_SEC = 0.3;\n9|export const PARAGRAPH_GAP_SEC = 0.7;\n10|\n11|export interface SentenceSpan {\n12|  start: number;\n13|  end: number;\n14|}\n15|\n16|export interface NarrationChunk {\n17|  n: number;\n18|  start: number;\n19|  end: number;\n20|  text: string;\n21|}\n22|\n23|const CLOSERS = new Set([\"”\", \"’\", '\"', \"'\", \")\", \"]\"]);\n24|\n25|// Lowercase words that end with a period without ending a sentence.\n26|const ABBREVIATIONS = new Set([\n27|  \"mr\", \"mrs\", \"ms\", \"dr\", \"st\", \"mt\", \"prof\", \"sr\", \"jr\",\n28|  \"rev\", \"lt\", \"col\", \"gen\", \"capt\", \"sgt\", \"ave\", \"blvd\", \"rd\", \"no\",\n29|]);\n30|\n31|function isTerminator(char: string): boolean {\n32|  return char === \".\" || char === \"!\" || char === \"?\" || char === \"…\";\n33|}\n34|\n35|function isSpace(char: string | undefined): boolean {\n36|  return char === undefined || /\\s/.test(char);\n37|}\n38|\n39|// Word of letters directly before index (exclusive), lowercased.\n40|function wordBefore(text: string, index: number): string {\n41|  let i = index - 1;\n42|  while (i >= 0 && /[A-Za-z]/.test(text[i] as string)) i -= 1;\n43|  return text.slice(i + 1, index).toLowerCase();\n44|}\n45|\n46|function wordCount(piece: string): number {\n47|  const words = piece.split(/\\s+/).filter((w) => w.length > 0);\n48|  return words.length;\n49|}\n50|\n51|// Char offsets into the paragraph text, trimmed of surrounding\n52|// whitespace, covering every non-space char. A sentence ends at a\n53|// terminator plus closing quotes/brackets followed by whitespace.\n54|export function splitSentences(text: string): SentenceSpan[] {\n55|  const raw: SentenceSpan[] = [];\n56|  let pieceStart = -1;\n57|  let i = 0;\n58|  while (i < text.length) {\n59|    const char = text[i] as string;\n60|    if (/\\s/.test(char)) {\n61|      i += 1;\n62|      continue;\n63|    }\n64|    if (pieceStart === -1) pieceStart = i;\n65|    if (isTerminator(char)) {\n66|      let end = i + 1;\n67|      while (end < text.length && CLOSERS.has(text[end] as string)) end += 1;\n68|      if (isSpace(text[end])) {\n69|        if (char === \".\") {\n70|          const word = wordBefore(text, i);\n71|          const singleInitial = /^[A-Z]$/.test(text.slice(i - 1, i));\n72|          if (singleInitial || ABBREVIATIONS.has(word)) {\n73|            i += 1;\n74|            continue;\n75|          }\n76|        }\n77|        // Trim trailing whitespace inside the piece (there is none:\n78|        // the piece ends at a terminator or closer).\n79|        raw.push({ start: pieceStart, end });\n80|        pieceStart = -1;\n81|        i = end;\n82|        continue;\n83|      }\n84|    }\n85|    i += 1;\n86|  }\n87|  if (pieceStart !== -1) {\n88|    let end = text.length;\n89|    while (end > pieceStart && /\\s/.test(text[end - 1] as string)) end -= 1;\n90|    raw.push({ start: pieceStart, end });\n91|  }\n92|  if (raw.length === 0) return [];\n93|  // Merge a piece shorter than 3 words into the previous sentence\n94|  // (or the next one if first), keeping offsets exact.\n95|  const merged: SentenceSpan[] = [];\n96|  for (const span of raw) {\n97|    const piece = text.slice(span.start, span.end);\n98|    if (wordCount(piece) >= 3 || merged.length === 0) {\n99|      merged.push({ ...span });\n100|      continue;\n101|    }\n102|    const prev = merged[merged.length - 1] as SentenceSpan;\n103|    prev.end = span.end;\n104|  }\n105|  if (merged.length > 1) {\n106|    const first = merged[0] as SentenceSpan;\n107|    if (wordCount(text.slice(first.start, first.end)) < 3) {\n108|      const next = merged[1] as SentenceSpan;\n109|      next.start = first.start;\n110|      merged.shift();\n111|    }\n112|  }\n113|  return merged;\n114|}\n115|\n116|export function chapterChunks(paragraphs: { n: number; text: string }[]): {\n117|  chunks: NarrationChunk[];\n118|  gaps: number[];\n119|} {\n120|  const chunks: NarrationChunk[] = [];\n121|  const paraOf: number[] = [];\n122|  paragraphs.forEach((para, paraIndex) => {\n123|    for (const span of splitSentences(para.text)) {\n124|      chunks.push({ n: para.n, start: span.start, end: span.end, text: para.text.slice(span.start, span.end) });\n125|      paraOf.push(paraIndex);\n126|    }\n127|  });\n128|  const gaps = chunks.map((_, i) => {\n129|    if (i === chunks.length - 1) return 0;\n130|    return paraOf[i] !== paraOf[i + 1] ? PARAGRAPH_GAP_SEC : SENTENCE_GAP_SEC;\n131|  });\n132|  return { chunks, gaps };\n133|}\n134|\n135|export function normalizeChunkText(text: string): string {\n136|  return text.normalize(\"NFC\").replace(/\\s+/g, \" \").trim();\n137|}\n138|\n139|// Canonical string the caller hashes with SHA-256. Same text + voice +\n140|// model + speed => same string; any edit changes it.\n141|export function narrationKeyInput(args: {\n142|  chunks: { text: string }[];\n143|  voice: string;\n144|  model: string;\n145|  speed: number;\n146|  format: number;\n147|}): string {\n148|  const body = args.chunks.map((c) => normalizeChunkText(c.text)).join(\"\\n\");\n149|  return `narration/${args.format}\\nvoice:${args.voice}\\nmodel:${args.model}\\nspeed:${args.speed}\\n${body}`;\n150|}\n151|\n152|export function narrationKey(hashHex: string, voice: string): string {\n153|  return `narration/v${NARRATION_FORMAT}/${voice}/${hashHex.slice(0, 32)}`;\n154|}\n155|\n156|export function narrationAudioPath(key: string): string {\n157|  return `${key}.mp3`;\n158|}\n159|\n160|export function narrationManifestPath(key: string): string {\n161|  return `${key}.json`;\n162|}\n163|\n164|export interface ChapterChunkTiming {\n165|  n: number;\n166|  start: number;\n167|  end: number;\n168|  t0: number;\n169|  t1: number;\n170|  // Flat word timings: [start, end, t0, t1, ...] with start/end\n171|  // paragraph-relative char offsets inside start..end and times in\n172|  // seconds. Built by alignWords in ensureChapterNarration.\n173|  w: number[];\n174|}\n175|\n176|export interface ChapterNarration {\n177|  format: 2;\n178|  key: string;\n179|  src: string;\n180|  durationSec: number;\n181|  voice: string;\n182|  model: string;\n183|  speed: number;\n184|  chunks: ChapterChunkTiming[];\n185|}\n186|\n187|function isRecord(json: unknown): json is Record<string, unknown> {\n188|  return typeof json === \"object\" && json !== null && !Array.isArray(json);\n189|}\n190|\n191|// Strict parse at the trust boundary: the reader fetches this JSON,\n192|// so any bad field throws instead of half-playing.\n193|export function parseChapterNarration(json: unknown): ChapterNarration {\n194|  if (!isRecord(json)) throw new Error(\"invalid narration manifest\");\n195|  if (json.format !== NARRATION_FORMAT) throw new Error(\"invalid narration manifest\");\n196|  if (typeof json.key !== \"string\" || json.key.length === 0) throw new Error(\"invalid narration manifest\");\n197|  if (typeof json.src !== \"string\" || !isSafeSrc(json.src)) throw new Error(\"invalid narration manifest\");\n198|  if (typeof json.durationSec !== \"number\" || !Number.isFinite(json.durationSec) || json.durationSec <= 0) {\n199|    throw new Error(\"invalid narration manifest\");\n200|  }\n201|  if (typeof json.voice !== \"string\" || json.voice.length === 0) throw new Error(\"invalid narration manifest\");\n202|  if (typeof json.model !== \"string\" || json.model.length === 0) throw new Error(\"invalid narration manifest\");\n203|  if (typeof json.speed !== \"number\" || !Number.isFinite(json.speed)) throw new Error(\"invalid narration manifest\");\n204|  if (!Array.isArray(json.chunks) || json.chunks.length === 0) throw new Error(\"invalid narration manifest\");\n205|  const chunks: ChapterChunkTiming[] = json.chunks.map((entry) => {\n206|    if (!isRecord(entry)) throw new Error(\"invalid narration manifest\");\n207|    const { n, start, end, t0, t1, w } = entry;\n208|    if (typeof n !== \"number\" || !Number.isInteger(n)) throw new Error(\"invalid narration manifest\");\n209|    if (typeof start !== \"number\" || !Number.isInteger(start) || start < 0) throw new Error(\"invalid narration manifest\");\n210|    if (typeof end !== \"number\" || !Number.isInteger(end) || end <= start) throw new Error(\"invalid narration manifest\");\n211|    for (const t of [t0, t1]) {\n212|      if (typeof t !== \"number\" || !Number.isFinite(t)) throw new Error(\"invalid narration manifest\");\n213|    }\n214|    const from = t0 as number;\n215|    const to = t1 as number;\n216|    if (!(0 <= from && from < to && to <= (json.durationSec as number) + 0.05)) {\n217|      throw new Error(\"invalid narration manifest\");\n218|    }\n219|    if (!Array.isArray(w) || w.length % 4 !== 0) throw new Error(\"invalid narration manifest\");\n220|    const words: number[] = w.map((v) => {\n221|      if (typeof v !== \"number\" || !Number.isFinite(v)) throw new Error(\"invalid narration manifest\");\n222|      return v;\n223|    });\n224|    for (let k = 0; k < words.length; k += 4) {\n225|      const s = words[k] as number;\n226|      const e = words[k + 1] as number;\n227|      const wt0 = words[k + 2] as number;\n228|      const wt1 = words[k + 3] as number;\n229|      if (!Number.isInteger(s) || !Number.isInteger(e) || !(start <= s && s < e && e <= (end as number))) {\n230|        throw new Error(\"invalid narration manifest\");\n231|      }\n232|      if (!(from - 0.05 <= wt0 && wt0 <= to + 0.05 && from - 0.05 <= wt1 && wt1 <= to + 0.05)) {\n233|        throw new Error(\"invalid narration manifest\");\n234|      }\n235|      if (k > 0 && s < (words[k - 4] as number)) throw new Error(\"invalid narration manifest\");\n236|    }\n237|    return { n: n as number, start: start as number, end: end as number, t0: from, t1: to, w: words };\n238|  });\n239|  for (let i = 1; i < chunks.length; i++) {\n240|    if ((chunks[i] as ChapterChunkTiming).t0 < (chunks[i - 1] as ChapterChunkTiming).t0) {\n241|      throw new Error(\"invalid narration manifest\");\n242|    }\n243|  }\n244|  return {\n245|    format: 2,\n246|    key: json.key as string,\n247|    src: json.src as string,\n248|    durationSec: json.durationSec as number,\n249|    voice: json.voice as string,\n250|    model: json.model as string,\n251|    speed: json.speed as number,\n252|    chunks,\n253|  };\n254|}\n255|\n256|function isSafeSrc(src: string): boolean {\n257|  if (src.startsWith(\"/narration/\")) return true;\n258|  if (src.startsWith(\"https://\")) {\n259|    try {\n260|      new URL(src);\n261|      return true;\n262|    } catch {\n263|      return false;\n264|    }\n265|  }\n266|  return false;\n267|}\n268|\n269|// Binary search: index of the last chunk with t0 <= t, so the highlight\n270|// stays on a sentence through the gap after it. -1 before the first.\n271|export function activeChunkAt(chunks: { t0: number }[], tSec: number): number {\n272|  let lo = 0;\n273|  let hi = chunks.length - 1;\n274|  let found = -1;\n275|  while (lo <= hi) {\n276|    const mid = (lo + hi) >> 1;\n277|    if ((chunks[mid] as { t0: number }).t0 <= tSec) {\n278|      found = mid;\n279|      lo = mid + 1;\n280|    } else {\n281|      hi = mid - 1;\n282|    }\n283|  }\n284|  return found;\n285|}\n286|\n287|const DISPLAY_WORD_RE = /[\\p{L}\\p{N}]+(?:['’][\\p{L}\\p{N}]+)*/gu;\n288|\n289|// Kokoro tokens (\"Mr.\", \"Oz’s\") rarely equal display words (\"Mr\",\n290|// \"Oz’s\"), so both sides compare on this form: NFKD, lowercase,\n291|// letters and digits only, apostrophes dropped.\n292|function normalizeWord(word: string): string {\n293|  return word\n294|    .normalize(\"NFKD\")\n295|    .toLowerCase()\n296|    .replace(/['’]/g, \"\")\n297|    .replace(/[^\\p{L}\\p{N}]/gu, \"\");\n298|}\n299|\n300|export interface WordToken {\n301|  text: string;\n302|  t0: number;\n303|  t1: number;\n304|}\n305|\n306|// Map Kokoro word tokens onto every display word in `text`, in order.\n307|// Display words come from DISPLAY_WORD_RE, so \"Oz’s\" and \"didn't\" are\n308|// one word and quotes and punctuation are never highlighted. Returned\n309|// offsets are relative to `text` (the caller adds the chunk's paragraph\n310|// offset); times are chapter-absolute seconds, clamped to `span`.\n311|// Matching tolerates a skipped or extra token, or a number Kokoro\n312|// spells out, with a lookahead of 3 on either side; a token spanning\n313|// several display words (\"well-known\") covers them all, splitting its\n314|// time by character length. Words left without time interpolate between\n315|// their neighbours, and every time ends monotonic inside the span.\n316|export function alignWords(\n317|  text: string,\n318|  tokens: WordToken[],\n319|  span: { t0: number; t1: number },\n320|): [number, number, number, number][] {\n321|  const display = [...text.matchAll(DISPLAY_WORD_RE)].map((m) => ({\n322|    start: m.index ?? 0,\n323|    end: (m.index ?? 0) + m[0].length,\n324|    norm: normalizeWord(m[0]),\n325|  }));\n326|  const norms = tokens.map((t) => normalizeWord(t.text));\n327|  const timed: ({ t0: number; t1: number } | null)[] = display.map(() => null);\n328|  let i = 0;\n329|  let j = 0;\n330|  while (i < display.length) {\n331|    while (j < tokens.length && norms[j] === \"\") j += 1;\n332|    if (j >= tokens.length) break;\n333|    const word = display[i] as { start: number; end: number; norm: string };\n334|    const tok = tokens[j] as WordToken;\n335|    if (word.norm === norms[j]) {\n336|      timed[i] = { t0: tok.t0, t1: tok.t1 };\n337|      i += 1;\n338|      j += 1;\n339|      continue;\n340|    }\n341|    // One token covering several display words: its norm is the\n342|    // concatenation of theirs, joined without whitespace (\"well-known\").\n343|    let joined = word.norm;\n344|    let k = i;\n345|    while (k + 1 < display.length && k + 1 < i + 4 && joined.length < (norms[j] as string).length) {\n346|      const prev = display[k] as { start: number; end: number; norm: string };\n347|      const next = display[k + 1] as { start: number; end: number; norm: string };\n348|      if (/\\s/.test(text.slice(prev.end, next.start))) break;\n349|      joined += next.norm;\n350|      k += 1;\n351|      if (joined === norms[j]) break;\n352|    }\n353|    if (k > i && joined === norms[j]) {\n354|      const total =\n355|        display.slice(i, k + 1).reduce((sum, d) => sum + (d.end - d.start), 0) || 1;\n356|      let edge = tok.t0;\n357|      for (let m = i; m <= k; m++) {\n358|        const part = display[m] as { start: number; end: number; norm: string };\n359|        const share = ((part.end - part.start) / total) * (tok.t1 - tok.t0);\n360|        timed[m] = { t0: edge, t1: edge + share };\n361|        edge += share;\n362|      }\n363|      i = k + 1;\n364|      j += 1;\n365|      continue;\n366|    }\n367|    let advanced = false;\n368|    for (let a = 1; a <= 3 && j + a < tokens.length; a++) {\n369|      if (norms[j + a] === word.norm) {\n370|        j += a;\n371|        advanced = true;\n372|        break;\n373|      }\n374|    }\n375|    if (!advanced) {\n376|      for (let b = 1; b <= 3 && i + b < display.length; b++) {\n377|        if ((display[i + b] as { norm: string }).norm === norms[j]) {\n378|          i += b;\n379|          advanced = true;\n380|          break;\n381|        }\n382|      }\n383|    }\n384|    if (advanced) continue;\n385|    // Neither side matches (a number Kokoro spells out): both move on\n386|    // and the display word interpolates below.\n387|    i += 1;\n388|    j += 1;\n389|  }\n390|  for (let a = 0; a < display.length; a++) {\n391|    if (timed[a] !== null) continue;\n392|    let b = a;\n393|    while (b + 1 < display.length && timed[b + 1] === null) b += 1;\n394|    const lo = a > 0 ? (timed[a - 1] as { t0: number; t1: number }).t1 : span.t0;\n395|    const hi = b + 1 < display.length ? (timed[b + 1] as { t0: number; t1: number }).t0 : span.t1;\n396|    const from = Math.min(lo, hi);\n397|    const to = Math.max(lo, hi);\n398|    const count = b - a + 1;\n399|    for (let m = a; m <= b; m++) {\n400|      timed[m] = { t0: from + ((to - from) * (m - a)) / count, t1: from + ((to - from) * (m - a + 1)) / count };\n401|    }\n402|    a = b;\n403|  }\n404|  const round3 = (v: number): number => Math.round(v * 1000) / 1000;\n405|  const clamp = (v: number): number => Math.min(span.t1, Math.max(span.t0, v));\n406|  let prevT0 = span.t0;\n407|  return display.map((d, index) => {\n408|    const t = timed[index] as { t0: number; t1: number };\n409|    let t0 = clamp(round3(t.t0));\n410|    let t1 = clamp(round3(t.t1));\n411|    if (t0 < prevT0) t0 = prevT0;\n412|    if (t1 < t0) t1 = t0;\n413|    prevT0 = t0;\n414|    return [d.start, d.end, t0, t1];\n415|  });\n416|}\n417|\n418|// Binary search: index of the last word with t0 <= t, so the highlight\n419|// stays on a word through the gap after it. -1 before the first.\n420|export function activeWordAt(chunk: { w: number[] }, tSec: number): number {\n421|  const count = Math.floor(chunk.w.length / 4);\n422|  let lo = 0;\n423|  let hi = count - 1;\n424|  let found = -1;\n425|  while (lo <= hi) {\n426|    const mid = (lo + hi) >> 1;\n427|    if ((chunk.w[mid * 4 + 2] as number) <= tSec) {\n428|      found = mid;\n429|      lo = mid + 1;\n430|    } else {\n431|      hi = mid - 1;\n432|    }\n433|  }\n434|  return found;\n435|}\n436|\n437|// Click-to-seek: the word covering charOffset in paragraph n, with its\n438|// chunk and word indexes and start time. Null when outside any word.\n439|export function wordAt(\n440|  narration: { chunks: { n: number; start: number; end: number; w: number[] }[] },\n441|  n: number,\n442|  charOffset: number,\n443|): { chunk: number; word: number; t0: number } | null {\n444|  for (let c = 0; c < narration.chunks.length; c++) {\n445|    const chunk = narration.chunks[c] as { n: number; start: number; end: number; w: number[] };\n446|    if (chunk.n !== n || charOffset < chunk.start || charOffset >= chunk.end) continue;\n447|    const count = Math.floor(chunk.w.length / 4);\n448|    for (let k = 0; k < count; k++) {\n449|      const s = chunk.w[k * 4] as number;\n450|      const e = chunk.w[k * 4 + 1] as number;\n451|      if (s <= charOffset && charOffset < e) {\n452|        return { chunk: c, word: k, t0: chunk.w[k * 4 + 2] as number };\n453|      }\n454|    }\n455|    return null;\n456|  }\n457|  return null;\n458|}\n459|\n460|// Playback range for a scene: t0 of the first chunk with n >= startN\n461|// through t1 of the last chunk with n <= endN. Null when empty.\n462|export function sceneSpan(\n463|  narration: { chunks: { n: number; t0: number; t1: number }[] },\n464|  startN: number,\n465|  endN: number,\n466|): { startSec: number; endSec: number } | null {\n467|  let startSec: number | null = null;\n468|  let endSec: number | null = null;\n469|  for (const chunk of narration.chunks) {\n470|    if (chunk.n < startN || chunk.n > endN) continue;\n471|    if (startSec === null) startSec = chunk.t0;\n472|    endSec = chunk.t1;\n473|  }\n474|  if (startSec === null || endSec === null) return null;\n475|  return { startSec, endSec };\n476|}\n477|\n478|export type PrepareEvent = \"upload\" | \"enter\" | \"jump\";\n479|\n480|// Owner's rolling window: upload warms chapters 1-2 while the book is\n481|// processed; entering N warms N+1 and N+2; jumping to N warms N and N+1.\n482|export function chaptersToPrepare(event: PrepareEvent, ch: number, totalChapters: number): number[] {\n483|  const wanted = event === \"upload\" ? [1, 2] : event === \"enter\" ? [ch + 1, ch + 2] : [ch, ch + 1];\n484|  const seen = new Set<number>();\n485|  const out: number[] = [];\n486|  for (const n of wanted) {\n487|    if (n < 1 || n > totalChapters || seen.has(n)) continue;\n488|    seen.add(n);\n489|    out.push(n);\n490|  }\n491|  return out;\n492|}\n493|\n494|// Modal GPU fallback list is [\"L4\", \"A10G\", \"T4\"]; caps use the A10G\n495|// rate, about USD 1.10/h, the most expensive of the three.\n496|export const KOKORO_GPU_USD_PER_SEC = 0.000306;\n497|\n498|// About 15 chars of audio per second, GPU time about 2% of audio after\n499|// encode, plus 8 s of cold start/overhead. Integer micro-dollars.\n500|export function estimateNarrationMicro(chars: number): number {\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1833c-7230-7510-aa10-b35926bb022b"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-7230-7510-aa10-b35926bb022b","task_stream":{"id":"01a1833c-7230-7510-aa10-b35926bb022b","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e3","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":76,"recorded_at":1780531400000147,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"kind":"completed","task_id":"01a1833c-7230-7510-aa10-b35926bb022b"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-7230-7510-aa10-b35926bb022b","task_stream":{"id":"01a1833c-7230-7510-aa10-b35926bb022b","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e5","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":77,"recorded_at":1780531400000149,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `docs/contracts/narration.md`.\n1|# Narration\n2|\n3|Read-aloud narration, one compact mp3 per chapter plus a per-chapter\n4|manifest with sentence timings. The unit is the chapter (owner\n5|decision): the reader plays any scene by seeking to its first sentence\n6|(`sceneSpan`) and highlights the sentence being read (`activeChunkAt`).\n7|Voice Kokoro-82M `af_heart` at speed 0.95, generated on a Modal GPU\n8|function that scales to zero.\n9|\n10|## Manifest\n11|\n12|`ChapterNarration` in `core/narration.ts`: `format: 2`, `key`, `src`,\n13|`durationSec`, `voice`, `model`, `speed`, and `chunks` with `n`\n14|(paragraph ordinal), `start`/`end` (char offsets into the paragraph),\n15|`t0`/`t1` (seconds), and `w` (word timings, below).\n16|`parseChapterNarration` throws on any bad field: it is a trust\n17|boundary, since the reader fetches this JSON. `src` is an `https:`\n18|URL or a same-origin path under `/narration/`.\n19|\n20|## Word timings\n21|\n22|No forced alignment: the Modal function returns each Kokoro token\n23|timestamp with chapter-absolute seconds per span, and `alignWords`\n24|maps them onto display words (`/[\\p{L}\\p{N}]+(?:['’][\\p{L}\\p{N}]+)*/u`,\n25|so \"Oz’s\" and \"didn't\" are one word and punctuation never\n26|highlights). Both sides compare on NFKD lowercase letters and digits\n27|with apostrophes dropped, in order with a lookahead of 3 either way;\n28|a token spanning several display words (\"well-known\") splits its time\n29|by character length. Words left without time interpolate between\n30|their neighbours; all times are clamped to the span and monotonic.\n31|`w` is flat `[start, end, t0, t1, ...]` with paragraph-relative char\n32|offsets and seconds, validated (multiple of 4, offsets in range,\n33|times in range, sorted) and required. `activeWordAt` drives the\n34|highlight, `wordAt` drives click-to-seek. Cost: 4 numbers per word,\n35|about 25 KB per chapter manifest.\n36|\n37|## Cache key\n38|\n39|`narrationKeyInput` builds a canonical string from the\n40|NFC-normalized, whitespace-collapsed chunk texts joined with `\"\\n\"`,\n41|plus voice, model, speed, and format. Callers hash it with SHA-256;\n42|`narrationKey` returns `narration/v2/<voice>/<first 32 hex>`. Same\n43|text + voice + model + speed gives the same key, any edit gives a new\n44|one. Audio lives at `<key>.mp3`, the manifest at `<key>.json`, as\n45|deterministic public Blob paths; the Redis index `narr:idx:<key>`\n46|holds the manifest JSON. Oz is pregenerated through the same keys, so\n47|a second reader of the same text gets it free.\n48|\n49|## Concurrency\n50|\n51|One reusable function, `ensureChapterNarration` in\n52|`core/narration-cache.ts`, serves the offline Oz run and the future\n53|upload route: index hit, then store hit with index backfill, then lock\n54|`narr:lock:<key>` (TTL 300 s, `setNxEx`; a null acquire means\n55|`pending`), one index re-check, budget reserve, synthesize, put audio\n56|and manifest, index set, release. Cache hits never touch the lock or\n57|the budget; failures refund once and release. No error text leaves the\n58|function.\n59|\n60|## Spend\n61|\n62|Integer micro-dollars. `estimateNarrationMicro(chars)` reserves the\n63|cap before generating: about 15 chars of audio per second, GPU time\n64|about 2% of audio after encode, plus 8 s of cold start/overhead, at\n65|the A10G rate (`KOKORO_GPU_USD_PER_SEC`, about USD 1.10/h). The Modal\n66|function tries GPUs in order `[\"L4\", \"A10G\", \"T4\"]`, and caps use the\n67|A10G rate so they stay conservative whichever GPU serves. The\n68|server reserves on both the global spend key and the daily spend key\n69|(`spendKey()`, `dailySpendKey(day)` from `core/images`), refunding\n70|both past either cap; the global `DAILY_SPEND_CAP_USD` applies. The\n71|offline run caps with `NARRATION_CAP_USD` (default 2) and stops with a\n72|report instead of spending more. Worked number: an average Oz chapter\n73|of ~9,000 chars is about 10 min of audio, about 20 s of warm GPU,\n74|about USD 0.006.\n75|\n76|## Rolling window\n77|\n78|The owner warms two chapters ahead: at upload, chapters 1 and 2 while\n79|the book is processed; entering chapter N ensures N+1 and N+2; jumping\n80|to N ensures N and N+1. `chaptersToPrepare` in `core/narration.ts`\n81|computes the window; the client asks, the server dedupes through the\n82|index and lock.\n83|\n84|## Cold start\n85|\n86|About 15–30 s for the first chapter after the function scaled to zero\n87|(`scaledown_window=60`), warm calls a few seconds per chapter. The\n88|2-ahead window hides it after chapter 1. While a chapter is pending,\n89|the Read aloud control shows a quiet \"Getting the voice ready…\"\n90|state.\n91|\n92|## Operations\n93|\n94|Deploy with `modal deploy pipeline/modal/narrate.py`; the app\n95|`lectoria-narration` scales to zero a minute after the last call, and\n96|`modal app stop lectoria-narration` removes it entirely.\n97|\n98|## Open items\n99|\n100|Upload route wiring (uses `server/narration/cache.ts`, no route yet);\n101|Blob vs `public/` for Oz (same keys either way, so switching is a\n102|re-run).","final_result":true,"kind":"output","task_id":"01a1833c-722c-72e1-a290-f866a7113809"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-722c-72e1-a290-f866a7113809","task_stream":{"id":"01a1833c-722c-72e1-a290-f866a7113809","kind":"task"}}}
