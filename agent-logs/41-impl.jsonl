xt.src)) el.src = next.src;\n191|        gainRef.current[audibleRef.current] = next.gainDb ?? 0;\n192|        applyLevels();\n193|      }\n194|      return;\n195|    }\n196|    // The single start path: fade 0 on the very first press. replayNonce\n197|    // re-cues the same track (one-track playlist wrap); nothing else is a dep\n198|    // so volume, pause/play, and re-renders never restart the track.\n199|    const dur = firstPlayRef.current ? 0 : fadeSecRef.current;\n200|    firstPlayRef.current = false;\n201|    requestPlayRef.current(next, dur);\n202|  }, [started, trackId, replayNonce]);\n203|\n204|  useEffect(() => cancelFade, []);\n205|\n206|  function handleTimeUpdate(index: number, el: HTMLAudioElement) {\n207|    const next = trackRef.current;\n208|    if (!next || index !== audibleRef.current) return;\n209|    const end = effectiveEnd(next.endSec, el.duration);\n210|    if (!Number.isFinite(end)) return;\n211|    // A non-looping or playlist track ends at the segment end, where the\n212|    // media may keep playing, so fire the ended path once per play.\n213|    if (!next.loop || playlistOn) {\n214|      if (el.currentTime >= end && segmentEndRef.current !== next.id) {\n215|        segmentEndRef.current = next.id;\n216|        onEndedRef.current(next.id);\n217|      }\n218|      return;\n219|    }\n220|    const fade = loopFadeSec();\n221|    if (end <= fade * 2) return;\n222|    const remain = end - el.currentTime;\n223|    if (remain <= fade && loopArmedRef.current !== next.id) {\n224|      loopArmedRef.current = next.id;\n225|      requestPlayRef.current(next, fade);\n226|    } else if (remain > fade + 1) {\n227|      loopArmedRef.current = null;\n228|    }\n229|  }\n230|\n231|  function handleEnded(index: number) {\n232|    const els = [firstRef.current, secondRef.current];\n233|    // An element that ends while a fade is running is the one fading out.\n234|    if (index !== audibleRef.current || fadeRef.current !== null) {\n235|      els[index]?.pa