 === 0 ? \" dropcap\" : \"\"}`} ref={pic.viewRef}>\n390|              {sub?.paragraphs.map((p, i, arr) => (\n391|                <Fragment key={p.id}>\n392|                  <p id={p.id} data-n={p.n} data-cont={p.cont ? true : undefined}>\n393|                    {p.text}\n394|                  </p>\n395|                  {/* A figure for n lands after its last visible fragment. */}\n396|                  {figuresAfter(arr, i, figsByN).map((fig) => (\n397|                    <InlineFigureView\n398|                      key={fig.id}\n399|                      figure={fig}\n400|                      onRemove={() => pic.removeFigure(fig.id)}\n401|                      onRetry={() => pic.retryFigure(fig.id)}\n402|                      onOpen={pic.lightbox.open}\n403|                      refCb={(el) => {\n404|                        if (el) figEls.current.set(fig.id, el);\n405|                        else figEls.current.delete(fig.id);\n406|                      }}\n407|                    />\n408|                  ))}\n409|                </Fragment>\n410|              ))}\n411|              {pic.popover !== null ? (\n412|                <SelectionPopover\n413|                  pos={pic.popover}\n414|                  popRef={pic.popRef}\n415|                  onPick={() => pic.illustratePassage()}\n416|                />\n417|              ) : null}\n418|              {/* Every read-on label ends with \" ↓\"; the arrow gets its own span for the hover nudge. */}\n419|              {readOn !== null ? (\n420|                <button type=\"button\" className=\"read-on\" onClick={goNext}>\n421|                  {readOn.slice(0, -1)}\n422|                  <span className=\"read-on-arrow\" aria-hidden=\"true\">\n423|                    ↓\n424|                  </span>\n425|                </button>\n426|              ) : null}\n427|            </div>\n428|          </>\n429|        )}\n430|      </div>\n431|      <PictureVault\n432|        scene={pic.card.phase === \"ready\" ? { url: pic.card.url, caption: pic.card.caption } : null}\n433|        figures={pic.figures}\n434|        onGotoScene={gotoScenePicture}\n435|        onGotoFigure={gotoFigure}\n436|        onOpen={pic.lightbox.open}\n437|        pref={pref}\n438|        onPrefChange={changePref}\n439|      />\n440|      <BandPager\n441|        k={view.k}\n442|        n={view.n}\n443|        bookIndex={bookIndex}\n444|        bookTotal={bookTotal}\n445|        onPrev={goPrev}\n446|        onNext={goNext}\n447|        atStart={atStart}\n448|        atBookEnd={atBookEnd}\n449|      />\n450|      <Lightbox item={pic.lightbox.item} onClose={pic.lightbox.close} />\n451|      {gateOpen ? <SpoilerGateDialog onShow={showAnyway} onNotYet={notYet} /> : null}\n452|      {panelsOpen ? (\n453|        <PanelsModal\n454|          ch={view.ch}\n455|          chapterTitle={view.chapterTitle}\n456|          panels={panels}\n457|          onClose={() => setPanelsOpen(false)}\n458|          onOpenArt={pic.lightbox.open}\n459|        />\n460|      ) : null}\n461|    </>\n462|  );\n463|}","final_result":true,"kind":"output","task_id":"01a1833c-95dc-7a81-b22c-d67fa3288861"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-95dc-7a81-b22c-d67fa3288861","task_stream":{"id":"01a1833c-95dc-7a81-b22c-d67fa3288861","kind":"task"}}}
