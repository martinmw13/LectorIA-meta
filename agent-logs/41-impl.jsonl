font-book);\n69|  font-style: italic;\n70|  font-size: 15.5px;\n71|  line-height: 1.35;\n72|  flex: 0 1 300px;\n73|  width: 300px;\n74|  min-width: 0;\n75|  max-width: 300px;\n76|  overflow: hidden;\n77|}\n78|\n79|.player-track-inner {\n80|  display: inline-block;\n81|  white-space: nowrap;\n82|}\n83|\n84|.player-track[data-overflow=\"1\"] {\n85|  mask-image: linear-gradient(to right, #000 calc(100% - 16px), transparent);\n86|}\n87|\n88|.player-track[data-overflow=\"1\"] .player-track-inner {\n89|  animation: player-marquee var(--marquee-duration, 6000ms) linear infinite alternate;\n90|  padding-right: 16px;\n91|}\n92|\n93|@keyframes player-marquee {\n94|  0%,\n95|  15% {\n96|    transform: translateX(0);\n97|  }\n98|  85%,\n99|  100% {\n100|    transform: translateX(calc(-1 * var(--marquee-shift, 0px)));\n101|  }\n102|}\n103|\n104|@media (prefers-reduced-motion: reduce) {\n105|  .player-track {\n106|    mask-image: none;\n107|  }\n108|  .player-track .player-track-inner {\n109|    animation: none;\n110|    transform: none;\n111|    display: block;\n112|    overflow: hidden;\n113|    text-overflow: ellipsis;\n114|  }\n115|}\n116|\n117|.player[data-reduced-motion=\"true\"] .player-track {\n118|  mask-image: none;\n119|}\n120|\n121|.player[data-reduced-motion=\"true\"] .player-track .player-track-inner {\n122|  animation: none;\n123|  transform: none;\n124|  display: block;\n125|  overflow: hidden;\n126|  text-overflow: ellipsis;\n127|}\n128|\n129|.player-track a {\n130|  color: var(--color-accent);\n131|  text-decoration: underline;\n132|  text-underline-offset: 3px;\n133|  white-space: nowrap;\n134|}\n135|\n136|.player-track a svg {\n137|  stroke: currentColor;\n138|  fill: none;\n139|  stroke-width: 1.5;\n140|  vertical-align: -1px;\n141|}\n142|\n143|.player-volume {\n144|  display: inline-flex;\n145|  align-items: center;\n146|  color: var(--color-text-muted);\n147|  flex: none;\n148|}\n149|\n150|.player-volume input {\n151|  width: 64px;\n152|  accent-color: var(