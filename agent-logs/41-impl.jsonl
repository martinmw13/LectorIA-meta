{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c919","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":743,"recorded_at":1780531400001481,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `core/reader.test.ts`.\n(389 line(s) above)\n390|    run(\"c1s1\", true);\n391|    expect(calls).toEqual([\"c1s1\", \"c1s2\", \"c1s1\"]);\n392|    expect(isSceneEntry(\"c1s1\", \"c1s1\")).toBe(false);\n393|    expect(isSceneEntry(\"c1s1\", \"c1s2\")).toBe(true);\n394|    expect(isSceneEntry(null, \"c1s1\")).toBe(true);\n395|  });\n396|\n397|  it(\"moves the track after entry plus dwell, then holds across ticks\", () => {\n398|    const schedEnv: SelectEnv = {\n399|      selection: { style: \"orchestral\" },\n400|      rng: () => 0,\n401|    };\n402|    const vec = (top: string): Vector8 => {\n403|      const v = Object.fromEntries(EMOTIONS.map((id) => [id, 0.01])) as Record<string, number>;\n404|      v[top] = 0.93;\n405|      return v as Vector8;\n406|    };\n407|    const track = (id: string, top: string): Track => ({\n408|      id,\n409|      src: `/music/${id}.mp3`,\n410|      title: id,\n411|      emotion: top as Track[\"emotion\"],\n412|      vector: vec(top),\n413|      intensity: 0.5,\n414|      tempo: 0.5,\n415|      durationSec: 120,\n416|      startSec: 0,\n417|      gainDb: 0,\n418|      loop: true,\n419|      soundtrack: \"snd\",\n420|      style: \"orchestral\",\n421|    });\n422|    const schedManifest: MusicManifest = {\n423|      version: 3,\n424|      styles: [{ id: \"orchestral\", name: \"Orquesta\" }],\n425|      soundtracks: [{ id: \"snd\", name: \"Snd\", style: \"orchestral\" }],\n426|      playlists: [],\n427|      tracks: [track(\"calm\", \"calma\"), track(\"storm\", \"combate\")],\n428|    };\n429|    const dwell = { dwellSec: 5 };\n430|    const calm: SceneSignal = { vector: vec(\"calma\"), intensity: 0.5, tempo: 0.5 };\n431|    const storm: SceneSignal = { vector: vec(\"combate\"), intensity: 0.5, tempo: 0.5 };\n432|    let d = observeScene(initScheduler(), \"s1\", calm, schedManifest, 0, schedEnv, dwell);\n433|    expect(d.switchToId).toBe(\"calm\");\n434|    d = observeScene(d.state, \"s2\", storm, schedManifest, 100, schedEnv, dwell);\n435|    expect(d.switchToId).toBeNull();\n436|    const early = tickScheduler(d.state, storm, schedManifest, 102, schedEnv, dwell);\n437|    expect(early.switchToId).toBeNull();\n438|    const late = tickScheduler(d.state, storm, schedManifest, 106, schedEnv, dwell);\n439|    expect(late.state.activeSceneId).toBe(\"s2\");\n440|    expect(late.switchToId).toBe(\"storm\");\n441|    const hold = tickScheduler(late.state, storm, schedManifest, 200, schedEnv, dwell);\n442|    expect(hold.switchToId).toBeNull();\n443|    expect(hold.state.currentId).toBe(\"storm\");\n444|  });\n445|});","final_result":true,"kind":"output","task_id":"01a1833f-1377-76f3-8e60-532fcc2f7005"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833f-1377-76f3-8e60-532fcc2f7005","task_stream":{"id":"01a1833f-1377-76f3-8e60-532fcc2f7005","kind":"task"}}}
