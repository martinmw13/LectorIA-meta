{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45b","stream":{"kind":"session","id":"01a1833c-5db9-7c13-8ce4-12f397c1cfa6"},"sequence":136,"recorded_at":1780531400000267,"record_type":"event","durability":"durable","causation_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","event":{"chunk":"Read text file `app/skin.ts`.\n1|export const SKINS = [\"default\"] as const;\n2|export type SkinId = (typeof SKINS)[number];\n3|export const DEFAULT_SKIN: SkinId = \"default\";\n4|\n5|export function isSkinId(v: unknown): v is SkinId {\n6|  return (SKINS as readonly unknown[]).includes(v);\n7|}","final_result":true,"kind":"output","task_id":"01a1833c-7f1c-7b21-a0ab-b43bdb78d6a6"},"kind":"task_lifecycle","run_stream":{"id":"01a1833c-5f91-7a83-9a6c-d885674ebe8f","kind":"run"},"task_id":"01a1833c-7f1c-7b21-a0ab-b43bdb78d6a6","task_stream":{"id":"01a1833c-7f1c-7b21-a0ab-b43bdb78d6a6","kind":"task"}}}
