the drop cap and cont fragments carry\n171|      // no indent; every other first fragment pays INDENT_CHARS.\n172|      const indented = pi > 0 && fragNo === 0;\n173|      const budget = budgetFor(pages.length);\n174|      const remainingLines = budget - lines;\n175|      const remainingWords = budgetWords - words;\n176|      const wRest = countWords(rest);\n177|      const lRest = estimateLines(rest, indented);\n178|      const from = p.text.length - rest.length;\n179|      if (lRest <= remainingLines && wRest <= remainingWords) {\n180|        pushFrag(p, rest, fragNo, indented, from);\n181|        rest = \"\";\n182|      } else if (remainingLines <= 0 || remainingWords <= 0) {\n183|        flush();\n184|      } else if (current.length > 0 && lRest <= budgetFor(pages.length + 1) && wRest <= budgetWords) {\n185|        flush();\n186|      } else {\n187|        const cut = findCut(rest, remainingLines * CHARS_PER_LINE - (indented ? INDENT_CHARS : 0), remainingWords);\n188|        pushFrag(p, rest.slice(0, cut), fragNo, indented, from);\n189|        fragNo += 1;\n190|        rest = rest.slice(cut);\n191|        flush();\n192|      }\n193|    }\n194|  }\n195|  flush();\n196|  if (pages.length === 0) pages.push({ paragraphs: [], startN: 0, endN: 0, words: 0 });\n197|  return pages;\n198|}\n199|\n(more lines below)","final_result":true,"kind":"output","task_id":"01a18353-a9a5-76e1-8fcf-e672a2286bcb"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a18353-a9a5-76e1-8fcf-e672a2286bcb","task_stream":{"id":"01a18353-a9a5-76e1-8fcf-e672a2286bcb","kind":"task"}}}
