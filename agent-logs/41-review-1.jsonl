{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c785","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":541,"recorded_at":1780531400001077,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"ls public/narration/v2/af_heart/ | head; echo ---; ls app/leer/\\\\[sceneId\\\\]/; cat \\\"app/leer/[sceneId]/page.tsx\\\" 2>/dev/null | head -n 60\",\n  \"description\": \"Check manifests and scene page route\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"061559f28673e2b68829ebe74dd4f4a5.json\\n061559f28673e2b68829ebe74dd4f4a5.mp3\\n0767d6e210877d749208ce5b896f258c.json\\n0767d6e210877d749208ce5b896f258c.mp3\\n22c44a70692ef33e2f9964804f0c74c1.json\\n22c44a70692ef33e2f9964804f0c74c1.mp3\\n2794d18783496cb429d86c5e33aec97c.json\\n2794d18783496cb429d86c5e33aec97c.mp3\\n2fa9a5a9a3d676c4f7ab12b73d0a50cc.json\\n2fa9a5a9a3d676c4f7ab12b73d0a50cc.mp3\\n---\\npage.tsx\\nimport {\\n  buildReaderModel,\\n  buildSceneView,\\n  PAGE_WORD_BUDGET,\\n  paginateScene,\\n  panelCaption,\\n  subPageCount,\\n} from \\\"@/core/reader\\\";\\nimport { loadOzBook } from \\\"@/server/books\\\";\\nimport { PANEL_ART } from \\\"../../folio/panels\\\";\\nimport type { ChapterPanel } from \\\"../../folio/panels\\\";\\nimport { ScenePage } from \\\"../scene-page\\\";\\n\\n// One static route per scene. Unknown ids 404; no other scene text\\n// ships with this view. Page counts include the cover and end pages;\\n// panels carry the current chapter's short captions only.\\nexport const dynamicParams = false;\\n\\nexport function generateStaticParams() {\\n  const { book, scenes } = loadOzBook();\\n  const model = buildReaderModel(book, { scenes });\\n  return model.chapters.flatMap((chapter) => chapter.scenes.map((scene) => ({ sceneId: scene.id })));\\n}\\n\\nexport default async function SceneRoute({ params }: { params: Promise<{ sceneId: string }> }) {\\n  const { sceneId } = await params;\\n  const { book, scenes } = loadOzBook();\\n  const model = buildReaderModel(book, { scenes });\\n  const view = buildSceneView(model, sceneId);\\n  // Page counts for the pager reducer: ids and numbers only, no text.\\n  const views = model.chapters.flatMap((chapter) =>\\n    chapter.scenes.map((scene, i) => ({\\n      sceneId: scene.id,\\n      pages: subPageCount(\\n        paginateScene(scene.paragraphs, PAGE_WORD_BUDGET, chapter.title).length,\\n        i === 0,\\n        i === chapter.scenes.length - 1,\\n      ),\\n    })),\\n  );\\n  const summaries = new Map(scenes.map((s) => [s.id, s.summary]));\\n  const chapter = model.chapters.find((c) => c.ch === view.ch);\\n  const panels: ChapterPanel[] = (chapter?.scenes ?? []).map((s) => ({\\n    sceneId: s.id,\\n    caption: panelCaption(summaries.get(s.id) ?? \\\"\\\"),\\n    art: PANEL_ART[s.id] ?? null,\\n  }));\\n  const atChapter = model.chapters.findIndex((c) => c.ch === view.ch);\\n  const next = atChapter >= 0 ? model.chapters[atChapter + 1] : undefined;\\n  const flat = model.chapters.flatMap((c) => c.scenes.map((s) => s.id));\\n  return (\\n    <ScenePage\\n      key={sceneId}\\n      view={view}\\n      views={views}\\n      bookId={model.bookId}\\n      textVersion={model.textVersion}\\n      bookIndex={flat.indexOf(sceneId)}\\n      bookTotal={flat.length}\\n      panels={panels}\\n\",\n  \"original_output_bytes\": 2621,\n  \"original_output_tokens\": 656,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a18351-d2ad-7f73-8eac-8d8374c523a8"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a18351-d2ad-7f73-8eac-8d8374c523a8","task_stream":{"id":"01a18351-d2ad-7f73-8eac-8d8374c523a8","kind":"task"}}}
