borted.jsonl\\n08-impl.jsonl\\n08-review.jsonl\\n08-review2.jsonl\\n09-fix.jsonl\\n09-impl.jsonl\\n09-review.jsonl\\n10-continue.jsonl\\n10-fix1.jsonl\\n10-fix2.jsonl\\n10-fix3.jsonl\\n10-fix4.jsonl\\n10-fix5.jsonl\\n10-impl-aborted-a.jsonl\\n10-review.jsonl\\n10-review2.jsonl\\n11-fix1.jsonl\\n11-impl.jsonl\\n11-review.jsonl\\n12-fix1.jsonl\\n12-impl.jsonl\\n12-review.jsonl\\n12-review2.jsonl\\n13-impl.jsonl\\n13-review.jsonl\\n16-fix1.jsonl\\n16-fix2.jsonl\\n16-fix3.jsonl\\n16-impl.jsonl\\n---\\n{\\n  \\\"name\\\": \\\"lectoria-meta\\\",\\n  \\\"private\\\": true,\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"22.x\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"next dev\\\",\\n    \\\"build\\\": \\\"next build\\\",\\n    \\\"build:book\\\": \\\"tsx pipeline/build.ts\\\",\\n    \\\"build:music\\\": \\\"tsx pipeline/labels-to-manifest.ts\\\",\\n    \\\"clean:epub\\\": \\\"tsx pipeline/clean-epub.ts\\\",\\n    \\\"start\\\": \\\"next start\\\",\\n    \\\"typecheck\\\": \\\"tsc --noEmit\\\",\\n    \\\"test\\\": \\\"vitest run\\\",\\n    \\\"check:secrets\\\": \\\"node scripts/check-secrets.mjs\\\",\\n    \\\"check:isolation\\\": \\\"node scripts/check-isolation.mjs\\\",\\n    \\\"check:size\\\": \\\"node scripts/check-file-size.mjs\\\",\\n    \\\"prepare\\\": \\\"git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true\\\",\\n    \\\"test:hooks\\\": \\\"node --test scripts/*.test.mjs\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@vercel/blob\\\": \\\"2.8.2\\\",\\n    \\\"fflate\\\": \\\"0.8.3\\\",\\n    \\\"modal\\\": \\\"0.11.1\\\",\\n    \\\"next\\\": \\\"16.4.3\\\",\\n    \\\"react\\\": \\\"19.3.1\\\",\\n    \\\"react-dom\\\": \\\"19.3.1\\\",\\n    \\\"server-only\\\": \\\"0.0.1\\\"\\n  },\\n  \\\"devDependencies\\\": {\\n    \\\"@types/jsdom\\\": \\\"30.0.0\\\",\\n    \\\"@types/node\\\": \\\"22.20.5\\\",\\n    \\\"@types/react\\\": \\\"19.3.0\\\",\\n    \\\"@types/react-dom\\\": \\\"19.3