{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c7","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":190,"recorded_at":1780531400000375,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/narration/ranges.ts`.\n1|// DOM range mapping for read-along highlight: word timings are\n2|// paragraph-relative, while the page renders fragments cut by\n3|// paginateScene. Cut points land on spaces, so a word never straddles\n4|// fragments; each fragment carries its start in data-from. planRanges is\n5|// pure (offsets in, offsets out) and unit-tested; rangesForChunk applies\n6|// a plan to the live text nodes.\n7|import type { ChapterNarration } from \"@/core/narration\";\n8|\n9|type Chunk = ChapterNarration[\"chunks\"][number];\n10|\n11|export interface PlannedFragment {\n12|  from: number;\n13|  len: number;\n14|}\n15|\n16|export interface PlannedWord {\n17|  frag: number;\n18|  start: number;\n19|  end: number;\n20|}\n21|\n22|export interface PlannedRanges {\n23|  word: PlannedWord | null;\n24|  sentence: PlannedWord[];\n25|}\n26|\n27|export function planRanges(\n28|  frags: PlannedFragment[],\n29|  chunk: Pick<Chunk, \"start\" | \"end\" | \"w\">,\n30|  wordIdx: number,\n31|): PlannedRanges {\n32|  const sentence: PlannedWord[] = [];\n33|  frags.forEach((frag, index) => {\n34|    const start = Math.max(chunk.start, frag.from);\n35|    const end = Math.min(chunk.end, frag.from + frag.len);\n36|    if (end > start) sentence.push({ frag: index, start: start - frag.from, end: end - frag.from });\n37|  });\n38|  let word: PlannedWord | null = null;\n39|  // The active word is a chunk-global index; the holding fragment is the\n40|  // one whose span contains its paragraph-relative start.\n41|  const abs = wordIdx >= 0 ? (chunk.w[wordIdx * 4] as number | undefined) : undefined;\n42|  if (abs !== undefined) {\n43|    const end = chunk.w[wordIdx * 4 + 1] as number;\n44|    const at = frags.findIndex((frag) => abs >= frag.from && abs < frag.from + frag.len);\n45|    if (at >= 0) {\n46|      const frag = frags[at] as PlannedFragment;\n47|      word = { frag: at, start: abs - frag.from, end: Math.min(end - frag.from, frag.len) };\n48|    }\n49|  }\n50|  return { word, sentence };\n51|}\n52|\n53|export interface SpotRanges {\n54|  word: Range | null;\n55|  wordText: string;\n56|  sentence: Range[];\n57|}\n58|\n59|function firstTextChild(p: Element): Text | null {\n60|  for (const node of p.childNodes) {\n61|    if (node.nodeType === 3) return node as Text;\n62|  }\n63|  return null;\n64|}\n65|\n66|export function rangesForChunk(container: HTMLElement, chunk: Chunk, wordIdx: number): SpotRanges {\n67|  const nodes = [...container.querySelectorAll(`p[data-n=\"${chunk.n}\"]`)];\n68|  const texts: (Text | null)[] = nodes.map(firstTextChild);\n69|  const frags: PlannedFragment[] = nodes.map((p, i) => ({\n70|    from: Number(p.getAttribute(\"data-from\") ?? 0),\n71|    len: texts[i]?.length ?? 0,\n72|  }));\n73|  const plan = planRanges(frags, chunk, wordIdx);\n74|  const sentence: Range[] = [];\n75|  for (const part of plan.sentence) {\n76|    const text = texts[part.frag];\n77|    if (!text) continue;\n78|    try {\n79|      const r = document.createRange();\n80|      r.setStart(text, part.start);\n81|      r.setEnd(text, part.end);\n82|      sentence.push(r);\n83|    } catch {\n84|      // A split text node keeps the sentence tint partial.\n85|    }\n86|  }\n87|  let word: Range | null = null;\n88|  let wordText = \"\";\n89|  if (plan.word) {\n90|    const text = texts[plan.word.frag];\n91|    if (text) {\n92|      try {\n93|        const r = document.createRange();\n94|        r.setStart(text, plan.word.start);\n95|        r.setEnd(text, plan.word.end);\n96|        word = r;\n97|        wordText = r.toString();\n98|      } catch {\n99|        word = null;\n100|      }\n101|    }\n102|  }\n103|  return { word, wordText, sentence };\n104|}","final_result":true,"kind":"output","task_id":"01a1834e-ada6-76c0-975a-6a92c6bf007b"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-ada6-76c0-975a-6a92c6bf007b","task_stream":{"id":"01a1834e-ada6-76c0-975a-6a92c6bf007b","kind":"task"}}}
