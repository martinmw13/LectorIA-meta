{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ff","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":730,"recorded_at":1780531400001455,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18352779177d7b31263aa947bc888","command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"text":"Read text file `vitest.config.ts`.\n1|import { fileURLToPath } from 'node:url';\n2|import { defineConfig } from 'vitest/config';\n3|\n4|const root = fileURLToPath(new URL('./', import.meta.url));\n5|\n6|export default defineConfig({\n7|  resolve: {\n8|    alias: {\n9|      // Server modules import `server-only` to fail at client import time;\n10|      // tests run on the server, so an empty module is enough.\n11|      'server-only': `${root}vitest.stub.server-only.ts`,\n12|      '@/core': `${root}core`,\n13|      '@/server': `${root}server`,\n14|    },\n15|  },\n16|  test: {\n17|    // Only app tests live here; scripts/ are owned by `node --test`.\n18|    include: [\n19|      'core/**/*.test.ts',\n20|      'server/**/*.test.ts',\n21|      'app/**/*.test.{ts,tsx}',\n22|      'pipeline/**/*.test.ts',\n23|      'data/**/*.test.ts',\n24|    ],\n25|  },\n26|});"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c901","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":731,"recorded_at":1780531400001457,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18352790672d8a64f26472338eaa8","command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"text":"Read text file `app/narration/prefs.ts`.\n1|// Persisted read-aloud prefs: on/off plus a narration-only volume.\n2|// Storage can throw (private mode), so every access is guarded.\n3|import type { NarrationPrefs } from \"./types\";\n4|\n5|export const NARRATION_PREFS_KEY = \"lectoria.narration.v1\";\n6|\n7|export const DEFAULT_NARRATION_VOLUME = 0.8;\n8|\n9|export const DEFAULT_NARRATION_PREFS: NarrationPrefs = { on: false, volume: DEFAULT_NARRATION_VOLUME };\n10|\n11|type PrefsStorage = Pick<Storage, \"getItem\" | \"setItem\">;\n12|\n13|function validVolume(value: unknown): number | null {\n14|  return typeof value === \"number\" && Number.isFinite(value) && value >= 0 && value <= 1 ? value : null;\n15|}\n16|\n17|export function loadNarrationPrefs(storage?: PrefsStorage): NarrationPrefs {\n18|  try {\n19|    const raw = storage?.getItem(NARRATION_PREFS_KEY);\n20|    if (!raw) return { ...DEFAULT_NARRATION_PREFS };\n21|    const json: unknown = JSON.parse(raw);\n22|    if (typeof json !== \"object\" || json === null) return { ...DEFAULT_NARRATION_PREFS };\n23|    const { on, volume } = json as Record<string, unknown>;\n24|    return {\n25|      on: typeof on === \"boolean\" ? on : false,\n26|      volume: validVolume(volume) ?? DEFAULT_NARRATION_VOLUME,\n27|    };\n28|  } catch {\n29|    return { ...DEFAULT_NARRATION_PREFS };\n30|  }\n31|}\n32|\n33|export function saveNarrationPrefs(storage: PrefsStorage | undefined, prefs: NarrationPrefs): void {\n34|  try {\n35|    storage?.setItem(NARRATION_PREFS_KEY, JSON.stringify(prefs));\n36|  } catch {\n37|    // Private mode: playback continues without persistence.\n38|  }\n39|}"}}
