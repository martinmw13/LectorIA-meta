{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c711","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":483,"recorded_at":1780531400000961,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/narration/highlight-style.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import { highlightStyleFor } from \"./highlight-style\";\n3|\n4|describe(\"highlightStyleFor\", () => {\n5|  it(\"maps each decided skin to its treatment\", () => {\n6|    expect(highlightStyleFor(\"engraving\")).toBe(\"engraving\");\n7|    expect(highlightStyleFor(\"watercolor\")).toBe(\"watercolor\");\n8|    expect(highlightStyleFor(\"ink-doodle\")).toBe(\"ink-doodle\");\n9|  });\n10|\n11|  it(\"falls back to engraving for today and unknown skins\", () => {\n12|    expect(highlightStyleFor(\"default\")).toBe(\"engraving\");\n13|    expect(highlightStyleFor(\"\")).toBe(\"engraving\");\n14|    expect(highlightStyleFor(\"noir\")).toBe(\"engraving\");\n15|  });\n16|});","final_result":true,"kind":"output","task_id":"01a18351-b94f-73e3-bf43-fadd80ac6156"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a18351-b94f-73e3-bf43-fadd80ac6156","task_stream":{"id":"01a18351-b94f-73e3-bf43-fadd80ac6156","kind":"task"}}}
