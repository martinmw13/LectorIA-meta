{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c523","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":236,"recorded_at":1780531400000467,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/reader.tsx`.\n1|\"use client\";\n2|\n3|import { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n4|import { useParams, useRouter } from \"next/navigation\";\n5|import { currentMode, musicModes, parseManifest } from \"@/core/music\";\n6|import type { MusicManifest, MusicMode, MusicModeId, SceneSignal, Track } from \"@/core/music\";\n7|import { EMOTIONS } from \"@/core/types\";\n8|import { dispatch, startSession } from \"@/core/music-session\";\n9|import type { MusicIntent, MusicSession, SessionView } from \"@/core/music-session\";\n10|import { nextSceneEntry } from \"@/core/reader\";\n11|import { DEFAULT_VOLUME, createMusicPrefsStore } from \"./music-prefs\";\n12|import { NarrationProvider, useNarration } from \"./narration/context\";\n13|import { ReadAloud } from \"./narration/read-aloud\";\n14|import type { NarrationChapterEntry } from \"./narration/types\";\n15|import { Player } from \"./player\";\n16|import { THEME_KEY, TopLine } from \"./folio/chrome\";\n17|import { initialTheme } from \"./theme\";\n18|import { DevPanel } from \"./folio/dev-panel\";\n19|\n20|export interface SlimScene {\n21|  id: string;\n22|  ch: number;\n23|  startN: number;\n24|  endN: number;\n25|  emotion: SceneSignal | null;\n26|}\n27|\n28|export interface ChapterJump {\n29|  ch: number;\n30|  title: string;\n31|  firstSceneId: string;\n32|}\n33|\n34|const DEV_LABELS: Record<(typeof EMOTIONS)[number], string> = {\n35|  calma: \"calm\",\n36|  alegria: \"joy\",\n37|  tristeza: \"sadness\",\n38|  suspenso: \"suspense\",\n39|  misterio: \"mystery\",\n40|  aventura: \"adventure\",\n41|  combate: \"combat\",\n42|  asombro: \"wonder\",\n43|};\n44|\n45|// Client container: bridges the music session to React state. It cues\n46|// music on scene entry only, from the route id. Sub-page moves never\n47|// reach the session. Params can lag a render, so the last observed id\n48|// is compared before every scene entry.\n49|// Band contents run inside the narration provider so the music duck\n50|// and the read-aloud control share the controller.\n51|function BandPlay({\n52|  musicFailed,\n53|  empty,\n54|  track,\n55|  replayNonce,\n56|  fadeSec,\n57|  canPrev,\n58|  onPrev,\n59|  canSkip,\n60|  onSkip,\n61|  volume,\n62|  muted,\n63|  onVolumeChange,\n64|  onMutedChange,\n65|  modes,\n66|  current,\n67|  onAdvance,\n68|  onEnded,\n69|  playlistOn,\n70|}: {\n71|  musicFailed: boolean;\n72|  empty: boolean;\n73|  track: Track | null;\n74|  replayNonce: number;\n75|  fadeSec: number;\n76|  canPrev: boolean;\n77|  onPrev: () => void;\n78|  canSkip: boolean;\n79|  onSkip: () => void;\n80|  volume: number;\n81|  muted: boolean;\n82|  onVolumeChange: (volume: number) => void;\n83|  onMutedChange: (muted: boolean) => void;\n84|  modes: MusicMode[];\n85|  current: MusicModeId | null;\n86|  onAdvance: (to?: MusicModeId) => void;\n87|  onEnded: (trackId: string) => void;\n88|  playlistOn: boolean;\n89|}) {\n90|  const { duck } = useNarration();\n91|  return (\n92|    <div className=\"band-play\">\n93|      <ReadAloud />\n94|      {musicFailed || empty ? (\n95|        <p className=\"player-note\">The music is resting. The book is all yours.</p>\n96|      ) : (\n97|        <Player\n98|          track={track}\n99|          replayNonce={replayNonce}\n100|          fadeSec={fadeSec}\n101|          canPrev={canPrev}\n102|          onPrev={onPrev}\n103|          canSkip={canSkip}\n104|          onSkip={onSkip}\n105|          volume={volume}\n106|          muted={muted}\n107|          onVolumeChange={onVolumeChange}\n108|          onMutedChange={onMutedChange}\n109|          modes={modes}\n110|          current={current}\n111|          onAdvance={onAdvance}\n112|          onEnded={onEnded}\n113|          playlistOn={playlistOn}\n114|          duck={duck}\n115|        />\n116|      )}\n117|    </div>\n118|  );\n119|}\n120|\n121|export function Reader({\n122|  scenes,\n123|  chapters,\n124|  bookTitle,\n125|  bookAuthor,\n126|  narration,\n127|  children,\n128|}: {\n129|  scenes: SlimScene[];\n130|  chapters: ChapterJump[];\n131|  bookTitle: string;\n132|  bookAuthor: string;\n133|  narration: NarrationChapterEntry[];\n134|  children: React.ReactNode;\n135|}) {\n136|  const routeParams = useParams();\n137|  const router = useRouter();\n138|  const param = routeParams?.sceneId;\n139|  const routeSceneId = typeof param === \"string\" ? param : null;\n140|  const [manifest, setManifest] = useState<MusicManifest | null>(null);\n141|  const [view, setView] = useState<SessionView | null>(null);\n142|  const [musicFailed, setMusicFailed] = useState(false);\n143|  // Volume, mute, style, and Chopin mode persist in one prefs object;\n144|  // the player stays a controlled view over them. State starts at the server\n145|  // defaults so hydration matches, then a mount effect applies stored\n146|  // prefs (parsed once) to volume, muted, and style via the prefs store.\n147|  const [volume, setVolume] = useState(DEFAULT_VOLUME);\n148|  const [muted, setMuted] = useState(false);\n149|  const [theme, setTheme] = useState<\"light\" | \"dark\">(\"light\");\n150|  const [devOpen, setDevOpen] = useState(false);\n151|  const prefsStoreRef = useRef(createMusicPrefsStore());\n152|  // Ref mirrors so send and persist handlers always read fresh values.\n153|  const volumeRef = useRef(volume);\n154|  volumeRef.current = volume;\n155|  const mutedRef = useRef(muted);\n156|  mutedRef.current = muted;\n157|  const byId = useMemo(() => new Map(scenes.map((s) => [s.id, s.emotion])), [scenes]);\n158|  const byIdRef = useRef(byId);\n159|  byIdRef.current = byId;\n160|  const manifestRef = useRef(manifest);\n161|  manifestRef.current = manifest;\n162|  const routeRef = useRef(routeSceneId);\n163|  routeRef.current = routeSceneId;\n164|  const sessionRef = useRef<MusicSession | null>(null);\n165|  const observedRef = useRef<string | null>(null);\n166|\n167|  // The one bridge into the session: builds the context (clock, rng,\n168|  // scene signals) and mirrors the view and a style change to state.\n169|  const send = useCallback((intent: MusicIntent) => {\n170|    const session = sessionRef.current;\n171|    const fetched = manifestRef.current;\n172|    if (!session || !fetched) return;\n173|    const next = dispatch(session, intent, {\n174|      manifest: fetched,\n175|      signalOf: (sceneId) => byIdRef.current.get(sceneId) ?? null,\n176|      routeSceneId: routeRef.current,\n177|      nowSec: Date.now() / 1000,\n178|      rng: Math.random,\n179|    });\n180|    sessionRef.current = next;\n181|    if (next.view !== session.view) setView(next.view);\n182|    if (next.selection !== session.selection || next.view.playlistOn !== session.view.playlistOn) {\n183|      prefsStoreRef.current.update({\n184|        style: next.selection.style,\n185|        playlist: next.view.playlistOn,\n186|      });\n187|    }\n188|  }, []);\n189|\n190|  // Stored prefs load once here, after the server-matching first render.\n191|  // Saves happen only on user actions below, so the defaults above never\n192|  // overwrite storage before this runs. The fetch below resolves later and\n193|  // reads the style through the store.\n194|  useEffect(() => {\n195|    const prefs = prefsStoreRef.current.load();\n196|    if (prefs !== null) {\n197|      if (prefs.volume !== null) setVolume(prefs.volume);\n198|      setMuted(prefs.muted);\n199|    }\n200|    try {\n201|      setTheme(initialTheme(window.localStorage.getItem(THEME_KEY)));\n202|    } catch {\n203|      // The inline script already set a theme; keep the default.\n204|    }\n205|    if (new URLSearchParams(window.location.search).has(\"dev\")) setDevOpen(true);\n206|  }, []);\n207|\n208|  useEffect(() => {\n209|    let cancelled = false;\n210|    fetch(\"/music/manifest.json\")\n211|      .then((res) => {\n212|        if (!res.ok) throw new Error(`manifest ${res.status}`);\n213|        return res.json();\n214|      })\n215|      .then((json: unknown) => {\n216|        if (cancelled) return;\n217|        const parsed = parseManifest(json);\n218|        setManifest(parsed);\n219|        const session = startSession(parsed, prefsStoreRef.current.load());\n220|        sessionRef.current = session;\n221|        setView(session.view);\n222|      })\n223|      .catch(() => {\n224|        if (!cancelled) setMusicFailed(true);\n225|      });\n226|    return () => {\n227|      cancelled = true;\n228|    };\n229|  }, []);\n230|\n231|  // Scene entry: exactly one sceneEntered per scene id, once the manifest\n232|  // lands. The first scene cues at once, so it plays on the first press.\n233|  useEffect(() => {\n234|    const gate = nextSceneEntry({\n235|      observedId: observedRef.current,\n236|      routeId: routeSceneId,\n237|      manifestReady: manifest !== null,\n238|    });\n239|    observedRef.current = gate.nextObservedId;\n240|    if (gate.shouldObserve && routeSceneId) send({ type: \"sceneEntered\", sceneId: routeSceneId });\n241|  }, [routeSceneId, manifest, send]);\n242|\n243|  useEffect(() => {\n244|    // Settle an expired entry dwell, or re-check the scene after a hold.\n245|    const timer = window.setInterval(() => {\n246|      send({ type: \"tick\" });\n247|    }, 1000);\n248|    return () => window.clearInterval(timer);\n249|  }, [send]);\n250|\n251|  // Developer view: Shift+D outside inputs, Escape closes.\n252|  useEffect(() => {\n253|    const onKey = (event: KeyboardEvent) => {\n254|      const target = event.target as HTMLElement | null;\n255|      const typing =\n256|        !!target &&\n257|        (target.tagName === \"INPUT\" ||\n258|          target.tagName === \"SELECT\" ||\n259|          target.tagName === \"TEXTAREA\" ||\n260|          target.isContentEditable);\n261|      if (event.key === \"Escape\") {\n262|        setDevOpen(false);\n263|        return;\n264|      }\n265|      if (typing) return;\n266|      if (event.shiftKey && (event.key === \"D\" || event.key === \"d\")) {\n267|        event.preventDefault();\n268|        setDevOpen((open) => !open);\n269|      }\n270|    };\n271|    window.addEventListener(\"keydown\", onKey);\n272|    return () => window.removeEventListener(\"keydown\", onKey);\n273|  }, []);\n274|\n275|  function skip() {\n276|    send({ type: \"skip\" });\n277|  }\n278|\n279|  // Previous: back to the last played track, held like a Next. With no\n280|  // history the current track restarts from zero through the replay path,\n281|  // including in playlist mode.\n282|  function goPrev() {\n283|    send({ type: \"previous\" });\n284|  }\n285|\n286|  function advanceMode(to?: MusicModeId) {\n287|    send({ type: \"modeAdvanced\", to });\n288|  }\n289|\n290|  function changeVolume(next: number) {\n291|    setVolume(next);\n292|    volumeRef.current = next;\n293|    prefsStoreRef.current.update({ volume: next });\n294|  }\n295|\n296|  function changeMuted(next: boolean) {\n297|    setMuted(next);\n298|    mutedRef.current = next;\n299|    prefsStoreRef.current.update({ muted: next });\n300|  }\n301|\n302|  function ended(trackId: string) {\n303|    send({ type: \"trackEnded\", trackId });\n304|  }\n305|\n306|  function toggleTheme() {\n307|    setTheme((current) => {\n308|      const next = current === \"dark\" ? \"light\" : \"dark\";\n309|      document.documentElement.setAttribute(\"data-theme\", next);\n310|      try {\n311|        window.localStorage.setItem(THEME_KEY, next);\n312|      } catch {\n313|        // The attribute already applies for the session.\n314|      }\n315|      return next;\n316|    });\n317|  }\n318|\n319|  function jumpChapter(ch: number) {\n320|    const found = chapters.find((c) => c.ch === ch);\n321|    if (found) router.push(`/leer/${found.firstSceneId}`);\n322|  }\n323|\n324|  const currentId = view?.currentId ?? null;\n325|  const track = manifest?.tracks.find((t) => t.id === currentId) ?? null;\n326|  const empty = manifest !== null && manifest.tracks.length === 0;\n327|  // Ordered music modes for the control: styles with tracks, then Chopin.\n328|  const modes = manifest ? musicModes(manifest) : [];\n329|  const modeCurrent = view ? currentMode(view) : null;\n330|  const playlistOn = view?.playlistOn ?? false;\n331|  // Previous restarts the track with no history (including the current\n332|  // playlist piece), so it stays on whenever a track is cued.\n333|  const canPrev = view?.canPrev ?? false;\n334|  const canSkip = view?.canSkip ?? false;\n335|\n336|  const bookIndex = routeSceneId ? scenes.findIndex((s) => s.id === routeSceneId) : -1;\n337|  const current = routeSceneId ? byId.get(routeSceneId) ?? null : null;\n338|  const devBars = current\n339|    ? EMOTIONS.map((id) => ({ label: DEV_LABELS[id], value: current.vector[id] ?? 0 }))\n340|    : [];\n341|\n342|  const sceneOrder = useMemo(() => scenes.map((s) => s.id), [scenes]);\n343|  const advanceScene = useCallback(\n344|    (nextSceneId: string) => {\n345|      router.push(`/leer/${nextSceneId}`);\n346|    },\n347|    [router],\n348|  );\n349|\n350|  return (\n351|    <NarrationProvider entries={narration} sceneOrder={sceneOrder} onAdvanceScene={advanceScene}>\n352|      <div className=\"folio\">\n353|        <TopLine\n354|          bookTitle={bookTitle}\n355|          author={bookAuthor}\n356|          ch={routeSceneId ? (scenes[bookIndex]?.ch ?? chapters[0]?.ch ?? 1) : 1}\n357|          chaptersTotal={chapters.length}\n358|          chapters={chapters}\n359|          onJumpChapter={jumpChapter}\n360|          theme={theme}\n361|          onToggleTheme={toggleTheme}\n362|        />\n363|        {children}\n364|        <BandPlay\n365|          musicFailed={musicFailed}\n366|          empty={empty}\n367|          track={track}\n368|          replayNonce={view?.replayNonce ?? 0}\n369|          fadeSec={view?.fadeSec ?? 0}\n370|          canPrev={canPrev}\n371|          onPrev={goPrev}\n372|          canSkip={canSkip}\n373|          onSkip={skip}\n374|          volume={volume}\n375|          muted={muted}\n376|          onVolumeChange={changeVolume}\n377|          onMutedChange={changeMuted}\n378|          modes={modes}\n379|          current={modeCurrent}\n380|          onAdvance={advanceMode}\n381|          onEnded={ended}\n382|          playlistOn={playlistOn}\n383|        />\n384|      <DevPanel\n385|        open={devOpen}\n386|        onClose={() => setDevOpen(false)}\n387|        sceneLabel={bookIndex >= 0 ? `scene ${bookIndex + 1} of ${scenes.length}` : \"no scene\"}\n388|        bars={devBars}\n389|        intensity={current?.intensity ?? null}\n390|        tempo={current?.tempo ?? null}\n391|        trackTitle={track?.title ?? \"No track cued\"}\n392|      />\n393|      </div>\n394|    </NarrationProvider>\n395|  );\n396|}\n397|","final_result":true,"kind":"output","task_id":"01a1834e-b3c0-7352-8344-89c7e05c3fcb"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-b3c0-7352-8344-89c7e05c3fcb","task_stream":{"id":"01a1834e-b3c0-7352-8344-89c7e05c3fcb","kind":"task"}}}
