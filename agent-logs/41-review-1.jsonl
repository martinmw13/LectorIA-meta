{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c3","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":444,"recorded_at":1780531400000883,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/tokens.css`.\n1|/* Design tokens: two layers.\n2| *\n3| * Skin layer (this file's first block): fonts, sizes, measure, spacing,\n4| * motion. A future skin adds an `html[data-skin=\"x\"]` block (plus an\n5| * `html[data-skin=\"x\"][data-theme=\"dark\"]` block for dark-mode tweaks)\n6| * overriding these same names. Components only read tokens, so switching\n7| * skins never touches component code.\n8| *\n9| * Theme colour layer (the blocks below): light and dark palettes,\n10| * selected by `data-theme`. Skins do not redefine colours here. */\n11|\n12|:root,\n13|html[data-skin=\"default\"] {\n14|  --font-ui: var(--font-instrument, \"Instrument Sans\"), -apple-system, blinkmacsystemfont,\n15|    \"Segoe UI\", system-ui, sans-serif;\n16|  --font-book: var(--font-newsreader, \"Newsreader\"), georgia, \"Times New Roman\", charter, serif;\n17|\n18|  --font-size-sm: 0.875rem;\n19|  --font-size-base: 1rem;\n20|  --font-size-lg: 1.25rem;\n21|  --font-size-title: 1.75rem;\n22|  --line-height-body: 1.7;\n23|\n24|  --measure-reading: 60ch;\n25|\n26|  --space-xs: 0.5rem;\n27|  --space-sm: 0.75rem;\n28|  --space-md: 1.25rem;\n29|  --space-lg: 2rem;\n30|\n31|  --motion-duration: 150ms;\n32|  --motion-expand: 260ms;\n33|}\n34|\n35|:root,\n36|html[data-theme=\"light\"] {\n37|  color-scheme: light;\n38|\n39|  --color-accent: #0866ff;\n40|  --color-accent-hover: #0064e0;\n41|  /* Fills keep white icons readable in both modes; text uses --color-accent. */\n42|  --color-accent-fill: #0866ff;\n43|  --color-on-accent: #ffffff;\n44|  --color-text: #1c2b33;\n45|  --color-text-muted: #5b6b76;\n46|  --color-surface: #ffffff;\n47|  --color-surface-soft: #f1f4f7;\n48|  --color-border: #d9e0e7;\n49|  --color-paper-dim: #e7e0cf;\n50|  --color-select: #cfe1ff;\n51|}\n52|\n53|html[data-theme=\"dark\"] {\n54|  color-scheme: dark;\n55|\n56|  --color-accent: #2d88ff;\n57|  --color-accent-hover: #4a9bff;\n58|  --color-accent-fill: #0866ff;\n59|  --color-on-accent: #ffffff;\n60|  --color-text: #e4e6eb;\n61|  --color-text-muted: #9aa5b1;\n62|  --color-surface: #0b1215;\n63|  --color-surface-soft: #151c21;\n64|  --color-border: #232d34;\n65|  --color-paper-dim: #1a2128;\n66|  --color-select: #1e3a5f;\n67|}\n68|\n69|@media (prefers-reduced-motion: reduce) {\n70|  :root {\n71|    --motion-duration: 0ms;\n72|    --motion-expand: 0ms;\n73|  }\n74|}\n75|\n76|/* Read-along narration. The word mark and sentence tint are tokens so\n77| * skins switch them without touching components. The default skin (and\n78| * any skin outside the three treatments) uses the engraving values in\n79| * the theme blocks; watercolor and ink-doodle skins override them.\n80| * Geometry (hairline rule, bleed radius, hand-drawn circle) lives in\n81| * app/styles/narration.css and keys off the treatment attribute. */\n82|:root,\n83|html[data-theme=\"light\"] {\n84|  --narration-mark: #ffffff;\n85|  --narration-mark-edge: rgba(28, 43, 51, 0.6);\n86|  --narration-glow: rgba(28, 43, 51, 0.12);\n87|  --narration-sentence: rgba(28, 43, 51, 0.055);\n88|  --narration-rule: rgba(28, 43, 51, 0.6);\n89|}\n90|\n91|html[data-theme=\"dark\"] {\n92|  --narration-mark: #0b1215;\n93|  --narration-mark-edge: rgba(228, 230, 235, 0.6);\n94|  --narration-glow: rgba(0, 0, 0, 0.4);\n95|  --narration-sentence: rgba(228, 230, 235, 0.07);\n96|  --narration-rule: rgba(228, 230, 235, 0.55);\n97|}\n98|\n99|/* Watercolor: warm sienna bleed with a darker pooled edge. */\n100|html[data-skin=\"watercolor\"] {\n101|  --narration-mark: rgba(214, 134, 96, 0.3);\n102|  --narration-mark-edge: rgba(184, 98, 62, 0.35);\n103|  --narration-glow: rgba(214, 134, 96, 0.25);\n104|  --narration-sentence: rgba(101, 139, 168, 0.12);\n105|  --narration-rule: rgba(184, 98, 62, 0.5);\n106|}\n107|\n108|html[data-skin=\"watercolor\"][data-theme=\"dark\"] {\n109|  --narration-mark: rgba(214, 134, 96, 0.32);\n110|  --narration-mark-edge: rgba(214, 134, 96, 0.5);\n111|  --narration-glow: rgba(214, 134, 96, 0.28);\n112|  --narration-sentence: rgba(101, 139, 168, 0.16);\n113|  --narration-rule: rgba(214, 134, 96, 0.6);\n114|}\n115|\n116|/* Ink doodle: the circle stroke is the mark; the tint stays faint. */\n117|html[data-skin=\"ink-doodle\"] {\n118|  --narration-mark: rgba(43, 52, 66, 0.85);\n119|  --narration-mark-edge: rgba(43, 52, 66, 0.5);\n120|  --narration-glow: rgba(43, 52, 66, 0.12);\n121|  --narration-sentence: rgba(28, 43, 51, 0.05);\n122|  --narration-rule: rgba(43, 52, 66, 0.7);\n123|}\n124|\n125|html[data-skin=\"ink-doodle\"][data-theme=\"dark\"] {\n126|  --narration-mark: rgba(228, 230, 235, 0.8);\n127|  --narration-mark-edge: rgba(228, 230, 235, 0.45);\n128|  --narration-glow: rgba(0, 0, 0, 0.4);\n129|  --narration-sentence: rgba(228, 230, 235, 0.06);\n130|  --narration-rule: rgba(228, 230, 235, 0.6);\n131|}","final_result":true,"kind":"output","task_id":"01a1834f-2d3d-7562-b90a-98db0b7f2ab6"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834f-2d3d-7562-b90a-98db0b7f2ab6","task_stream":{"id":"01a1834f-2d3d-7562-b90a-98db0b7f2ab6","kind":"task"}}}
