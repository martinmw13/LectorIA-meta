{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca5d","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":905,"recorded_at":1780531400001805,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"edited\nchanged lines: lines 11-16\n--- original\n+++ updated\n@@\n-  it(\"falls back to engraving for today and unknown skins\", () => {\n-    expect(highlightStyleFor(\"default\")).toBe(\"engraving\");\n-    expect(highlightStyleFor(\"\")).toBe(\"engraving\");\n-    expect(highlightStyleFor(\"noir\")).toBe(\"engraving\");\n-  });\n-});\n+  it(\"falls back to engraving for today and unknown skins\", () => {\n+    expect(highlightStyleFor(\"default\")).toBe(\"engraving\");\n+    expect(highlightStyleFor(\"\")).toBe(\"engraving\");\n+    expect(highlightStyleFor(\"noir\")).toBe(\"engraving\");\n+  });\n+});\n+\n+describe(\"engravingScale\", () => {\n+  it(\"shrinks the overlay to the measured word width\", () => {\n+    expect(engravingScale(40, 50)).toBeCloseTo(0.8, 5);\n+  });\n+\n+  it(\"never stretches a narrower overlay\", () => {\n+    expect(engravingScale(50, 40)).toBe(1);\n+    expect(engravingScale(40, 40)).toBe(1);\n+  });\n+\n+  it(\"stays at 1 when either width is missing\", () => {\n+    expect(engravingScale(40, 0)).toBe(1);\n+    expect(engravingScale(0, 50)).toBe(1);\n+  });\n+});\n","final_result":true,"kind":"output","task_id":"01a18354-429d-7980-8112-e635bcef4257"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a18354-429d-7980-8112-e635bcef4257","task_stream":{"id":"01a18354-429d-7980-8112-e635bcef4257","kind":"task"}}}
