{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64d","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":385,"recorded_at":1780531400000765,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/icons.tsx`.\n1|import type { ReactNode, SVGProps } from \"react\";\n2|import { DEFAULT_SKIN, type SkinId } from \"./skin\";\n3|\n4|export type IconName = \"moon\" | \"sun\" | \"eye-off\" | \"pencil\" | \"picture\" | \"expand\" | \"read-aloud\" | \"ink-circle\";\n5|\n6|export interface IconDef {\n7|  width: number;\n8|  height: number;\n9|  viewBox: string;\n10|  body: ReactNode;\n11|}\n12|\n13|// Verbatim copies of the inline SVGs the folio call sites had.\n14|const defaultSet: Record<IconName, IconDef> = {\n15|  moon: {\n16|    width: 16,\n17|    height: 16,\n18|    viewBox: \"0 0 16 16\",\n19|    body: <path d=\"M13.5 9.5A5.8 5.8 0 0 1 6.5 2.5a5.8 5.8 0 1 0 7 7Z\" />,\n20|  },\n21|  sun: {\n22|    width: 16,\n23|    height: 16,\n24|    viewBox: \"0 0 16 16\",\n25|    body: (\n26|      <>\n27|        <circle cx=\"8\" cy=\"8\" r=\"3.2\" />\n28|        <path d=\"M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2 3.4 12.6\" />\n29|      </>\n30|    ),\n31|  },\n32|  \"eye-off\": {\n33|    width: 14,\n34|    height: 14,\n35|    viewBox: \"0 0 16 16\",\n36|    body: (\n37|      <path d=\"M2.5 2.5l11 11M6.6 3.2c.5-.1 1-.2 1.4-.2 2.8 0 5.2 2.4 6 5-1 3.2-3.2 5-6 5-1 0-2-.3-2.8-.7M4 4.6C2.7 5.7 2 7 2 8c.8 2.6 3.2 5 6 5 1 0 2-.3 2.9-.8\" />\n38|    ),\n39|  },\n40|  pencil: {\n41|    width: 18,\n42|    height: 18,\n43|    viewBox: \"0 0 16 16\",\n44|    body: <path d=\"M11.5 2.5l2 2L5 13l-2.7.7L3 11l8.5-8.5Z\" />,\n45|  },\n46|  picture: {\n47|    width: 13,\n48|    height: 13,\n49|    viewBox: \"0 0 16 16\",\n50|    body: (\n51|      <>\n52|        <rect x=\"2.5\" y=\"2.5\" width=\"11\" height=\"11\" />\n53|        <circle cx=\"6\" cy=\"7\" r=\"1.4\" />\n54|        <path d=\"M3.5 13 7 9.5l2.5 2.5 2-2 1 1\" />\n55|      </>\n56|    ),\n57|  },\n58|  expand: {\n59|    width: 11,\n60|    height: 11,\n61|    viewBox: \"0 0 16 16\",\n62|    body: <path d=\"M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9\" />,\n63|  },\n64|  // Open book with two sound-wave arcs: the read-aloud control.\n65|  \"read-aloud\": {\n66|    width: 16,\n67|    height: 16,\n68|    viewBox: \"0 0 16 16\",\n69|    body: (\n70|      <>\n71|        <path d=\"M1.8 4.2c1.2-.5 2.5-.5 3.7 0 1.2-.5 2.5-.5 3.7 0V12c-1.2-.5-2.5-.5-3.7 0-1.2-.5-2.5-.5-3.7 0Z\" />\n72|        <path d=\"M5.5 4.2v7.8\" />\n73|        <path d=\"M10.8 6.4a2.4 2.4 0 0 1 0 3.2\" />\n74|        <path d=\"M12.4 4.9a4.6 4.6 0 0 1 0 6.2\" />\n75|      </>\n76|    ),\n77|  },\n78|  // Loose hand-drawn circle for the ink-doodle word mark. Sized by the\n79|  // caller with preserveAspectRatio=\"none\" so it hugs the word rect.\n80|  \"ink-circle\": {\n81|    width: 100,\n82|    height: 44,\n83|    viewBox: \"0 0 100 44\",\n84|    body: <path d=\"M50 -2 C 80 -3, 104 10, 100 28 C 96 44, 20 46, 4 30 C -6 16, 18 1, 56 2\" />,\n85|  },\n86|};\n87|\n88|export const ICON_SETS: Record<SkinId, Partial<Record<IconName, IconDef>>> = {\n89|  default: defaultSet,\n90|};\n91|\n92|export function Icon({\n93|  name,\n94|  size,\n95|  skin = DEFAULT_SKIN,\n96|  ...rest\n97|}: { name: IconName; size?: number; skin?: SkinId } & SVGProps<SVGSVGElement>) {\n98|  const def = ICON_SETS[skin]?.[name] ?? ICON_SETS.default[name];\n99|  if (!def) throw new Error(`unknown icon: ${name}`);\n100|  return (\n101|    <svg width={size ?? def.width} height={size ?? def.height} viewBox={def.viewBox} aria-hidden=\"true\" {...rest}>\n102|      {def.body}\n103|    </svg>\n104|  );\n105|}","final_result":true,"kind":"output","task_id":"01a1834f-1555-7c21-b