{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d3","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":196,"recorded_at":1780531400000387,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1834ea64e72d8ad6d280e0e2021e6","command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"text":"Read text file `app/narration/read-sync.tsx`.\n1|// Read-sync: a requestAnimationFrame loop follows audio.currentTime\n2|// through the manifest (surviving seek, pause, and rate changes because\n3|// it never keeps its own clock), maps words onto the rendered\n4|// fragments, and turns the sub-page automatically unless the reader\n5|// just moved by hand.\n6|\"use client\";\n7|\n8|import { useEffect, useLayoutEffect, useRef, useState, type RefObject } from \"react\";\n9|import { activeChunkAt, activeWordAt, wordAt, type ChapterNarration } from \"@/core/narration\";\n10|import { Icon } from \"../icons\";\n11|import { highlightStyleFor, type HighlightTreatment } from \"./highlight-style\";\n12|import { rangesForChunk } from \"./ranges\";\n13|import { shouldAutoTurn } from \"./turn\";\n14|\n15|export interface SyncFragment {\n16|  id: string;\n17|  n: number;\n18|  text: string;\n19|  from?: number;\n20|}\n21|\n22|export interface MarkRect {\n23|  left: number;\n24|  top: number;\n25|  width: number;\n26|  height: number;\n27|  word: string;\n28|}\n29|\n30|interface ActiveSpot {\n31|  chunk: number;\n32|  word: number;\n33|}\n34|\n35|const SENTENCE_HIGHLIGHT = \"narration-sentence\";\n36|\n37|function skinTreatment(): HighlightTreatment {\n38|  try {\n39|    return highlightStyleFor(document.documentElement.dataset.skin ?? \"default\");\n40|  } catch {\n41|    return \"engraving\";\n42|  }\n43|}\n44|\n45|function reducedMotion(): boolean {\n46|  try {\n47|    return !!window.matchMedia?.(\"(prefers-reduced-motion: reduce)\").matches;\n48|  } catch {\n49|    return false;\n50|  }\n51|}\n52|\n53|export function useReadSync(opts: {\n54|  enabled: boolean;\n55|  audioRef: RefObject<HTMLAudioElement | null>;\n56|  manifest: ChapterNarration | null;\n57|  span: { startSec: number; endSec: number } | null;\n58|  containerRef: RefObject<HTMLElement | null>;\n59|  scrollerRef: RefObject<HTMLElement | null>;\n60|  pages: { paragraphs: SyncFragment[] }[];\n61|  textPage: number;\n62|  onTurnPage: (textIndex: number) => void;\n63|  lastManualRef: RefObject<number | null>;\n64|}): { mark: MarkRect | null; treatment: HighlightTreatment } {\n65|  const [treatment] = useState<HighlightTreatment>(skinTreatment);\n66|  const [mark, setMark] = useState<MarkRect | null>(null);\n67|  const [active, setActive] = useState<ActiveSpot | null>(null);\n68|\n69|  const live = useRef(opts);\n70|  live.current = opts;\n71|\n72|  // The follow loop: audio time in, chunk/word out, one auto-turn gate.\n73|  useEffect(() => {\n74|    const { enabled, audioRef, manifest, span } = live.current;\n75|    if (!enabled || !manifest) {\n76|      setActive(null);\n77|      return;\n78|    }\n79|    let raf = 0;\n80|    const tick = () => {\n81|      raf = requestAnimationFrame(tick);\n82|      const audio = audioRef.current;\n83|      if (!audio || audio.paused) return;\n84|      const t = audio.currentTime;\n85|      if (span !== null && (t < span.startSec - 0.3 || t > span.endSec + 2)) return;\n86|      const ci = activeChunkAt(manifest.chunks, t);\n87|      if (ci < 0) {\n88|        setActive((prev) => (prev === null ? prev : null));\n89|        return;\n90|      }\n91|      const chunk = manifest.chunks[ci] as ChapterNarration[\"chunks\"][number];\n92|      const wi = activeWordAt(chunk, t);\n93|      setActive((prev) => (prev !== null && prev.chunk === ci && prev.word === wi ? prev : { chunk: ci, word: wi }));\n94|      const { pages, textPage, onTurnPage, lastManualRef } = live.current;\n95|      const at = pages.findIndex((pg) => pg.paragraphs.some((p) => p.n === chunk.n));\n96|      if (at >= 0 && at !== textPage && shouldAutoTurn(lastManualRef.current, performance.now())) {\n97|        onTurnPage(at);\n98|      }\n99|    };\n100|    raf = requestAnimationFrame(tick);\n101|    return () => cancelAnimationFrame(raf);\n102|  }, [opts.enabled, opts.manifest]);\n103|\n104|  // Measure the active word against the fragment DOM and paint the\n105|  // sentence tint through the Highlight API (no-op where unsupported).\n106|  useLayoutEffect(() => {\n107|    const { containerRef, scrollerRef, manifest } = live.current;\n108|    const container = containerRef.current;\n109|    clearSentence();\n110|    if (!container || !manifest || active === null) {\n111|      setMark(null);\n112|      return;\n113|    }\n114|    const chunk = manifest.chunks[active.chunk];\n115|    if (!chunk) {\n116|      setMark(null);\n117|      return;\n118|    }\n119|    const { word: wordRange, wordText, sentence } = rangesForChunk(container, chunk, active.word);\n120|    paintSentence(sentence);\n121|    if (!wordRange) {\n122|      setMark(null);\n123|      return;\n124|    }\n125|    const rects = (wordRange as Range).getClientRects();\n126|    if (rects.length === 0) {\n127|      setMark(null);\n128|      return;\n129|    }\n130|    let left = Infinity;\n131|    let top = Infinity;\n132|    let right = -Infinity;\n133|    let bottom = -Infinity;\n134|    for (const r of rects) {\n135|      left = Math.min(left, r.left);\n136|      top = Math.min(top, r.top);\n137|      right = Math.max(right, r.right);\n138|      bottom = Math.max(bottom, r.bottom);\n139|    }\n140|    const box = container.getBoundingClientRect();\n141|    let padX = 0;\n142|    let padY = 0;\n143|    if (treatment === \"ink-doodle\") {\n144|      padX = 6;\n145|      padY = 3;\n146|    } else if (treatment === \"watercolor\") {\n147|      padX = 3;\n148|    }\n149|    setMark({\n150|      left: left - box.left - padX,\n151|      top: top - box.top - padY,\n152|      width: right - left + padX * 2,\n153|      height: bottom - top + padY * 2,\n154|      word: wordText,\n155|    });\n156|    const scroller = scrollerRef.current;\n157|    if (scroller && rects[0]) {\n158|      const view = scroller.getBoundingClientRect();\n159|      const first = rects[0];\n160|      const margin = 8;\n161|      if (first.top < view.top + margin || first.bottom > view.bottom - margin) {\n162|        try {\n163|          scroller.scrollTo({\n164|            top: scroller.scrollTop + (first.top - view.top) - view.height * 0.3,\n165|            behavior: reducedMotion() ? \"auto\" : \"smooth\",\n166|          });\n167|        } catch {\n168|          // The column keeps native scroll; the mark follows anyway.\n169|        }\n170|      }\n171|    }\n172|  }, [active, opts.manifest, treatment]);\n173|\n174|  // Click a word to seek there, only while narration runs.\n175|  useEffect(() => {\n176|    const { enabled, containerRef, audioRef } = live.current;\n177|    const container = containerRef.current;\n178|    if (!enabled || !container) return;\n179|    const onClick = (event: MouseEvent) => {\n180|      const audio = audioRef.current;\n181|      const heard = live.current.manifest;\n182|      if (!audio || !heard) return;\n183|      const doc = container.ownerDocument;\n184|      const atPoint = doc.caretRangeFromPoint?.bind(doc);\n185|      const range = atPoint ? atPoint(event.clientX, event.clientY) : null;\n186|      if (!range || range.startContainer.nodeType !== 3) return;\n187|      const p = (range.startContainer.parentElement as Element | null)?.closest?.(\"p[data-n]\");\n188|      if (!p || !container.contains(p)) return;\n189|      const n = Number(p.getAttribute(\"data-n\"));\n190|      const from = Number(p.getAttribute(\"data-from\") ?? 0);\n191|      if (!Number.isInteger(n)) return;\n192|      const hit = wordAt({ chunks: heard.chunks }, n, from + range.startOffset);\n193|      if (hit) {\n194|        try {\n195|          audio.currentTime = hit.t0 + 0.001;\n196|        } catch {\n197|          // Past the end; the watchdog advances on timeupdate.\n198|        }\n199|      }\n200|    };\n201|    container.addEventListener(\"click\", onClick);\n202|    return () => container.removeEventListener(\"click\", onClick);\n203|  }, [opts.enabled, opts.manifest]);\n204|\n205|  return { mark, treatment };\n206|}\n207|\n208|// Sentence tint helpers: the CSS Custom Highlight API with a no-op\n209|// fallback where unsupported.\n210|function clearSentence() {\n211|  try {\n212|    const css = CSS as unknown as { highlights?: { delete(name: string): void } };\n213|    css.highlights?.delete(SENTENCE_HIGHLIGHT);\n214|  } catch {\n215|    // Unsupported browsers simply skip the tint.\n216|  }\n217|}\n218|\n219|function paintSentence(ranges: Range[]) {\n220|  try {\n221|    const css = CSS as unknown as { highlights?: { set(name: string, highlight: unknown): void } };\n222|    const Ctor = (globalThis as unknown as { Highlight?: new (...ranges: Range[]) => unknown }).Highlight;\n223|    if (css.highlights && Ctor && ranges.length > 0) {\n224|      css.highlights.set(SENTENCE_HIGHLIGHT, new Ctor(...ranges));\n225|    }\n226|  } catch {\n227|    // Unsupported browsers simply skip the tint.\n228|  }\n229|}\n230|\n231|export function ReadMark({ mark, treatment }: { mark: MarkRect | null; treatment: HighlightTreatment }) {\n232|  if (!mark) return null;\n233|  const style = { left: mark.left, top: mark.top, width: mark.width, height: mark.height };\n234|  if (treatment === \"ink-doodle\") {\n235|    return (\n236|      <span className=\"narr-mark\" data-treatment=\"ink-doodle\" style={style} aria-hidden=\"true\">\n237|        <Icon name=\"ink-circle\" preserveAspectRatio=\"none\" />\n238|      </span>\n239|    );\n240|  }\n241|  if (treatment === \"watercolor\") {\n242|    return <span className=\"narr-mark\" data-treatment=\"watercolor\" style={style} aria-hidden=\"true\" />;\n243|  }\n244|  return (\n245|    <span className=\"narr-mark\" data-treatment=\"engraving\" style={style} aria-hidden=\"true\">\n246|      <span className=\"narr-word\">{mark.word}</span>\n247|    </span>\n248|  );\n249|}"}}
