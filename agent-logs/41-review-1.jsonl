{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cae7","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":974,"recorded_at":1780531400001943,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"edited\nchanged lines: lines 6-13\n--- original\n+++ updated\n@@\n-export function shouldAutoTurn(\n-  lastManualAtMs: number | null,\n-  nowMs: number,\n-  windowMs: number = NARRATION_MANUAL_WINDOW_MS,\n-): boolean {\n-  if (lastManualAtMs === null) return true;\n-  return nowMs - lastManualAtMs >= windowMs;\n-}\n+export function shouldAutoTurn(\n+  lastManualAtMs: number | null,\n+  nowMs: number,\n+  windowMs: number = NARRATION_MANUAL_WINDOW_MS,\n+): boolean {\n+  if (lastManualAtMs === null) return true;\n+  return nowMs - lastManualAtMs >= windowMs;\n+}\n+\n+// Target text-page index for the follow loop, or null to stay. The\n+// lookup runs in text-page space (the cover shifts sub-pages by one,\n+// which scene-page adds back in onTurnPage), and a recent manual move\n+// holds the turn without stopping the voice.\n+export function autoTurnTarget(\n+  pages: { paragraphs: { n: number }[] }[],\n+  chunkN: number,\n+  textPage: number,\n+  lastManualAtMs: number | null,\n+  nowMs: number,\n+): number | null {\n+  const at = pages.findIndex((pg) => pg.paragraphs.some((p) => p.n === chunkN));\n+  if (at < 0 || at === textPage) return null;\n+  return shouldAutoTurn(lastManualAtMs, nowMs) ? at : null;\n+}\n","final_result":true,"kind":"output","task_id":"01a18354-6b7b-79f0-b6ef-f97c9fb01e5f"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a18354-6b7b-79f0-b6ef-f97c9fb01e5f","task_stream":{"id":"01a18354-6b7b-79f0-b6ef-f97c9fb01e5f","kind":"task"}}}
