{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c3","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":188,"recorded_at":1780531400000371,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/narration/highlight-style.ts`.\n1|// Word-mark treatment per skin. Only the three decided treatments\n2|// exist; today's \"default\" skin and anything unknown use engraving.\n3|export type HighlightTreatment = \"engraving\" | \"watercolor\" | \"ink-doodle\";\n4|\n5|export function highlightStyleFor(skin: string): HighlightTreatment {\n6|  if (skin === \"watercolor\") return \"watercolor\";\n7|  if (skin === \"ink-doodle\") return \"ink-doodle\";\n8|  return \"engraving\";\n9|}","final_result":true,"kind":"output","task_id":"01a1834e-ada3-7cf0-bf4c-8b1bf80be316"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-ada3-7cf0-bf4c-8b1bf80be316","task_stream":{"id":"01a1834e-ada3-7cf0-bf4c-8b1bf80be316","kind":"task"}}}
