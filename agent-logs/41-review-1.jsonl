{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/narration/read-aloud.tsx`.\n1|// The read-aloud control: play/pause plus a narration-only volume\n2|// slider. Light mode is the default; colours come from tokens.\n3|\"use client\";\n4|\n5|import { Icon } from \"../icons\";\n6|import { useNarration } from \"./context\";\n7|\n8|export function ReadAloud() {\n9|  const { on, status, playing, volume, toggle, setVolume } = useNarration();\n10|  const busy = on && status !== \"ready\" && status !== \"error\";\n11|  const label = !on ? \"Read aloud\" : playing ? \"Pause\" : \"Read aloud\";\n12|  return (\n13|    <div className=\"read-aloud\" data-state={status} data-on={on}>\n14|      <button\n15|        type=\"button\"\n16|        className=\"read-aloud-btn\"\n17|        onClick={toggle}\n18|        aria-pressed={on && playing}\n19|        aria-label={label}\n20|        title={label}\n21|      >\n22|        <Icon name=\"read-aloud\" />\n23|        <span className=\"read-aloud-label\">{label}</span>\n24|      </button>\n25|      <label className=\"read-aloud-volume\">\n26|        <span className=\"sr-only\">Narration volume</span>\n27|        <input\n28|          type=\"range\"\n29|          min={0}\n30|          max={1}\n31|          step={0.05}\n32|          value={volume}\n33|          onChange={(e) => setVolume(Number(e.target.value))}\n34|          aria-label=\"Narration volume\"\n35|        />\n36|      </label>\n37|      {on && status === \"loading\" ? <p className=\"read-aloud-note\">Getting the voice ready…</p> : null}\n38|      {on && status === \"error\" ? (\n39|        <p className=\"read-aloud-note\" role=\"alert\">\n40|          The voice isn&apos;t available right now.\n41|        </p>\n42|      ) : null}\n43|      {busy ? <span className=\"sr-only\" aria-live=\"polite\">Getting the voice ready…</span> : null}\n44|    </div>\n45|  );\n46|}","final_result":true,"kind":"output","task_id":"01a1834e-b3c3-7810-b6c1-e203fc47eecf"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-b3c3-7810-b6c1-e203fc47eecf","task_stream":{"id":"01a1834e-b3c3-7810-b6c1-e203fc47eecf","kind":"task"}}}
