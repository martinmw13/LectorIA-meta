));\n327|  const timed: ({ t0: number; t1: number } | null)[] = display.map(() => null);\n328|  let i = 0;\n329|  let j = 0;\n330|  while (i < display.length) {\n331|    while (j < tokens.length && norms[j] === \"\") j += 1;\n332|    if (j >= tokens.length) break;\n333|    const word = display[i] as { start: number; end: number; norm: string };\n334|    const tok = tokens[j] as WordToken;\n335|    if (word.norm === norms[j]) {\n336|      timed[i] = { t0: tok.t0, t1: tok.t1 };\n337|      i += 1;\n338|      j += 1;\n339|      continue;\n340|    }\n341|    // One token covering several display words: its norm is the\n342|    // concatenation of theirs, joined without whitespace (\"well-known\").\n343|    let joined = word.norm;\n344|    let k = i;\n345|    while (k + 1 < display.length && k + 1 < i + 4 && joined.length < (norms[j] as string).length) {\n346|      const prev = display[k] as { start: number; end: number; norm: string };\n347|      const next = display[k + 1] as { start: number; end: number; norm: string };\n348|      if (/\\s/.test(text.slice(prev.end, next.start))) break;\n349|      joined += next.norm;\n350|      k += 1;\n351|      if (joined === norms[j]) break;\n352|    }\n353|    if (k > i && joined === norms[j]) {\n354|      const total =\n355|        display.slice(i, k + 1).reduce((sum, d) => sum + (d.end - d.start), 0) || 1;\n356|      let edge = tok.t0;\n357|      for (let m = i; m <= k; m++) {\n358|        const part = display[m] as { start: number; end: number; norm: string };\n359|        const share = ((part.end - part.start) / total) * (tok.t1 - tok.t0);\n360|        timed[m] = { t0: edge, t1: edge + share };\n361|        edge += share;\n362|      }\n363|      i = k + 1;\n364|      j += 1;\n365|      continue;\n366|    }\n367|    let advanced = false;\n368|    for (let a = 1; a <= 3 && j + a < tokens.length; a++) {\n369|      if (norms[j + a] === word.norm) {\n370|        j += a;\n371|        advanced = true;\n372|        break;\n373|      }\n374|    }\n375|    if (!advanced) {\n376|      for (let b = 1; b <= 3 && i + b < display.length; b++) {\n377|        if ((display[i + b] as { norm: string }).norm === norms[j]) {\n378|          i += b;\n379|          advanced = true;\n380|          break;\n381|        }\n382|      }\n383|    }\n384|    if (advanced) continue;\n385|    // Neither side matches (a number Kokoro spells out): both move on\n386|    // and the display word interpolates below.\n387|    i += 1;\n388|    j += 1;\n389|  }\n390|  for (let a = 0; a < display.length; a++) {\n391|    if (timed[a] !== null) continue;\n392|    let b = a;\n393|    while (b + 1 < display.length && timed[b + 1] === null) b += 1;\n394|    const lo = a > 0 ? (timed[a - 1] as { t0: number; t1: number }).t1 : span.t0;\n395|    const hi = b + 1 < display.length ? (timed[b + 1] as { t0: number; t1: number }).t0 : span.t1;\n396|    const from = Math.min(lo, hi);\n397|    const to = Math.max(lo, hi);\n398|    const count = b - a + 1;\n399|    for (let m = a; m <= b; m++) {\n400|      timed[m] = { t0: from + ((to - from) * (m - a)) / count, t1: from + ((to - from) * (m - a + 1)) / count };\n401|    }\n402|    a = b;\n403|  }\n404|  const round3 = (v: number): number => Math.round(v * 1000) / 1000;\n405|  const clamp = (v: number): number => Math.min(span.t1, Math.max(span.t0, v));\n406|  let prevT0 = span.t0;\n407|  return display.map((d, index) => {\n408|    const t = timed[index] as { t0: number; t1: number };\n409|    let t0 = clamp(round3(t.t0));\n410|    let t1 = clamp(round3(t.t1));\n411|    if (t0 < prevT0) t0 = prevT0;\n412|    if (t1 < t0) t1 = t0;\n413|    prevT0 = t0;\n414|    return [d.start, d.end, t0, t1];\n415|  });\n416|}\n417|\n418|// Binary search: index of the last word with t0 <= t, so the highlight\n419|// stays on a word through the gap after it. -1 before the first.\n420|export function activeWordAt(chunk: { w: number[] }, tSec: number): number {\n421|  const count = Math.floor(chunk.w.length / 4);\n422|  let lo = 0;\n423|  let hi = count - 1;\n424|  let found = -1;\n425|  while (lo <= hi) {\n426|    const mid = (lo + hi) >> 1;\n427|    if ((chunk.w[mid * 4 + 2] as number) <= tSec) {\n428|      found = mid;\n429|      lo = mid + 1;\n430|    } else {\n431|      hi = mid - 1;\n432|    }\n433|  }\n434|  return found;\n435|}\n436|\n437|// Click-to-seek: the word covering charOffset in paragraph n, with its\n438|// chunk and word indexes and start time. Null when outside any word.\n439|export function wordAt(\n440|  narration: { chunks: { n: number; start: number; end: number; w: number[] }[] },\n441|  n: number,\n442|  charOffset: number,\n443|): { chunk: number; word: number; t0: number } | null {\n444|  for (let c = 0; c < narration.chunks.length; c++) {\n445|    const chunk = narration.chunks[c] as { n: number; start: number; end: number; w: number[] };\n446|    if (chunk.n !== n || charOffset < chunk.start || charOffset >= chunk.end) continue;\n447|    const count = Math.floor(chunk.w.length / 4);\n448|    for (let k = 0; k < count; k++) {\n449|      const s = chunk.w[k * 4] as number;\n450|      const e = chunk.w[k * 4 + 1] as number;\n451|      if (s <= charOffset && charOffset < e) {\n452|        return { chunk: c, word: k, t0: chunk.w[k * 4 + 2] as number };\n453|      }\n454|    }\n455|    return null;\n456|  }\n457|  return null;\n458|}\n459|\n460|// Playback range for a scene: t0 of the first chunk with n >= startN\n461|// through t1 of the last chunk with n <= endN. Null when empty.\n462|export function sceneSpan(\n463|  narration: { chunks: { n: number; t0: number; t1: number }[] },\n464|  startN: number,\n465|  endN: number,\n466|): { startSec: number; endSec: number } | null {\n467|  let startSec: number | null = null;\n468|  let endSec: number | null = null;\n469|  for (const chunk of narration.chunks) {\n470|    if (chunk.n < startN || chunk.n > endN) continue;\n471|    if (startSec === null) startSec = chunk.t0;\n472|    endSec = chunk.t1;\n473|  }\n474|  if (startSec === null || endSec === null) return null;\n475|  return { startSec, endSec };\n476|}\n477|\n478|export type PrepareEvent = \"upload\" | \"enter\" | \"jump\";\n479|\n480|// Owner's rolling window: upload warms chapters 1-2 while the book is\n481|// processed; entering N warms N+1 and N+2; jumping to N warms N and N+1.\n482|export function chaptersToPrepare(event: PrepareEvent, ch: number, totalChapters: number): number[] {\n483|  const wanted = event === \"upload\" ? [1, 2] : event === \"enter\" ? [ch + 1, ch + 2] : [ch, ch + 1];\n484|  const seen = new Set<number>();\n485|  const out: number[] = [];\n486|  for (const n of wanted) {\n487|    if (n < 1 || n > totalChapters || seen.has(n)) continue;\n488|    seen.add(n);\n489|    out.push(n);\n490|  }\n491|  return out;\n492|}\n493|\n494|// Modal GPU fallback list is [\"L4\", \"A10G\", \"T4\"]; caps use the A10G\n495|// rate, about USD 1.10/h, the most expensive of the three.\n496|export const KOKORO_GPU_USD_PER_SEC = 0.000306;\n497|\n498|// About 15 chars of audio per second, GPU time about 2% of audio after\n499|// encode, plus 8 s of cold start/overhead. Integer micro-dollars.\n500|export function estimateNarrationMicro(chars: number): number {\n(more lines below)"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60b","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":352,"recorded_at":1780531400000699,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1834f03d37362b3baebdf763bc01f","command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"text":"Read text file `app/styles/narration.css`.\n1|/* Read-aloud control and read-along word mark. All colours come from\n2|   narration tokens; geometry keys off the treatment attribute. */\n3|\n4|.read-aloud {\n5|  display: flex;\n6|  align-items: center;\n7|  gap: 8px;\n8|  min-width: 0;\n9|  font-family: var(--font-ui);\n10|  font-size: 13px;\n11|}\n12|\n13|.read-aloud-btn {\n14|  display: inline-flex;\n15|  align-items: center;\n16|  gap: 7px;\n17|  height: 34px;\n18|  padding: 0 12px;\n19|  border: 1px solid var(--color-text);\n20|  border-radius: 6px;\n21|  background: var(--color-surface);\n22|  color: var(--color-text);\n23|  cursor: pointer;\n24|  flex: none;\n25|}\n26|\n27|.read-aloud-btn:hover {\n28|  border-color: var(--color-accent);\n29|  color: var(--color-accent);\n30|}\n31|\n32|.read-aloud-btn svg {\n33|  stroke: currentColor;\n34|  fill: none;\n35|  stroke-width: 1.5;\n36|  stroke-linecap: round;\n37|  stroke-linejoin: round;\n38|}\n39|\n40|.read-aloud-btn:focus-visible,\n41|.read-aloud-volume input:focus-visible {\n42|  outline: 2px solid var(--color-accent);\n43|  outline-offset: 2px;\n44|}\n45|\n46|.read-aloud-label {\n47|  font-size: 13px;\n48|  letter-spacing: 0.02em;\n49|  white-space: nowrap;\n50|}\n51|\n52|.read-aloud-volume {\n53|  display: inline-flex;\n54|  align-items: center;\n55|  flex: none;\n56|}\n57|\n58|.read-aloud-volume input {\n59|  width: 64px;\n60|  accent-color: var(--color-accent);\n61|  cursor: pointer;\n62|}\n63|\n64|.read-aloud-note {\n65|  margin: 0;\n66|  font-size: 12.5px;\n67|  color: var(--color-text-muted);\n68|  white-space: nowrap;\n69|}\n70|\n71|/* Word mark: an absolutely positioned overlay that never touches flow,\n72|   so pagination never reflows under the highlight. */\n73|.narr-mark {\n74|  position: absolute;\n75|  pointer-events: none;\n76|  z-index: 3;\n77|  transition:\n78|    left 120ms ease-out,\n79|    top 120ms ease-out,\n80|    width 120ms ease-out,\n81|    height 120ms ease-out;\n82|}\n83|\n84|.narr-mark[data-treatment=\"engraving\"] .narr-word {\n85|  display: flex;\n86|  align-items: center;\n87|  width: 100%;\n88|  height: 100%;\n89|  overflow: hidden;\n90|  white-space: nowrap;\n91|  font-variant: small-caps;\n92|  letter-spacing: 0.04em;\n93|  font-weight: 600;\n94|  background: var(--narration-mark);\n95|  color: var(--color-text);\n96|}\n97|\n98|.narr-mark[data-treatment=\"engraving\"]::after {\n99|  content: \"\";\n100|  position: absolute;\n101|  left: 0;\n102|  right: 0;\n103|  bottom: -2px;\n104|  height: 1px;\n105|  background: var(--narration-rule);\n106|}\n107|\n108|.narr-mark[data-treatment=\"watercolor\"] {\n109|  background: var(--narration-mark);\n110|  border-radius: 40% 60% 52% 48% / 50% 46% 54% 50%;\n111|  box-shadow:\n112|    inset 0 0 0 1.5px var(--narration-mark-edge),\n113|    0 0 6px var(--narration-glow);\n114|  filter: blur(0.4px);\n115|}\n116|\n117|.narr-mark[data-treatment=\"ink-doodle\"] svg {\n118|  display: block;\n119|  width: 100%;\n120|  height: 100%;\n121|  overflow: visible;\n122|  fill: none;\n123|  stroke: var(--narration-mark);\n124|  stroke-width: 1.8;\n125|  stroke-linecap: round;\n126|}\n127|\n128|::highlight(narration-sentence) {\n129|  background: var(--narration-sentence);\n130|}\n131|\n132|@media (prefers-reduced-motion: reduce) {\n133|  .narr-mark {\n134|    transition: none;\n135|  }\n136|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60d","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":353,"recorded_at":1780531400000701,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1834f058971a4ab038a298e68e69c","command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"text":"Read text file `app/narration/word-map.ts`.\n1|// Word timings are paragraph-relative char offsets (flat [start, end,\n2|// t0, t1, ...] from the manifest), while the page renders fragments cut\n3|// by paginateScene. This maps one fragment's slice of the timings into\n4|// fragment-relative ranges for DOM Range building. Cuts land on spaces,\n5|// so words never straddle fragments; offsets clip defensively.\n6|export interface FragmentWord {\n7|  start: number;\n8|  end: number;\n9|  t0: number;\n10|  t1: number;\n11|}\n12|\n13|export function wordsInFragment(w: number[], from: number, fragLen: number): FragmentWord[] {\n14|  const out: FragmentWord[] = [];\n15|  for (let k = 0; k + 3 < w.length; k += 4) {\n16|    const s = w[k] as number;\n17|    const e = w[k + 1] as number;\n18|    if (!(e > from && s < from + fragLen)) continue;\n19|    out.push({\n20|      start: Math.max(s, from) - from,\n21|      end: Math.min(e, from + fragLen) - from,\n22|      t0: w[k + 2] as number,\n23|      t1: w[k + 3] as number,\n24|    });\n25|  }\n26|  return out;\n27|}"}}
