{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bf","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":186,"recorded_at":1780531400000367,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/narration/turn.test.ts`.\n1|import { describe, expect, it } from \"vitest\";\n2|import { NARRATION_MANUAL_WINDOW_MS, shouldAutoTurn } from \"./turn\";\n3|\n4|describe(\"shouldAutoTurn\", () => {\n5|  it(\"turns when the reader never moved by hand\", () => {\n6|    expect(shouldAutoTurn(null, 1000)).toBe(true);\n7|  });\n8|\n9|  it(\"holds back inside the window after a manual move\", () => {\n10|    expect(shouldAutoTurn(1000, 1000 + NARRATION_MANUAL_WINDOW_MS - 1)).toBe(false);\n11|  });\n12|\n13|  it(\"turns again once the window passes\", () => {\n14|    expect(shouldAutoTurn(1000, 1000 + NARRATION_MANUAL_WINDOW_MS)).toBe(true);\n15|    expect(shouldAutoTurn(1000, 1000 + NARRATION_MANUAL_WINDOW_MS + 5000)).toBe(true);\n16|  });\n17|});","final_result":true,"kind":"output","task_id":"01a1834e-ada0-7fc3-a2d1-da58994f134e"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-ada0-7fc3-a2d1-da58994f134e","task_stream":{"id":"01a1834e-ada0-7fc3-a2d1-da58994f134e","kind":"task"}}}
