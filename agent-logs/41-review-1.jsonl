{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c685","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":413,"recorded_at":1780531400000821,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `core/reader.ts`.\n1|// Reader model: the slim shape the client receives. Joins paragraphs to\n2|// scenes by ordinal range in reading order; analysis internals never leave.\n3|import type { AnalyzedScene, Book } from \"./types\";\n4|import type { Vector8 } from \"./types\";\n5|\n6|export interface ReaderParagraph {\n7|  id: string;\n8|  n: number;\n9|  text: string;\n10|  // Set on fragments after the first when paginateScene splits one\n11|  // paragraph across pages. Fragments share n; ids stay unique.\n12|  cont?: boolean;\n13|  // Char offset into the original paragraph where this fragment starts.\n14|  // Whole paragraphs and first fragments carry 0; later fragments carry\n15|  // the cut point, so read-along highlights can map word timings (which\n16|  // are paragraph-relative) onto the visible fragment text.\n17|  from?: number;\n18|}\n19|\n20|export interface ReaderScene {\n21|  id: string;\n22|  title: string;\n23|  emotion: { vector: Vector8; intensity: number; tempo: number } | null;\n24|  paragraphs: ReaderParagraph[];\n25|}\n26|\n27|export interface ReaderChapter {\n28|  ch: number;\n29|  title: string;\n30|  scenes: ReaderScene[];\n31|}\n32|\n33|export interface ReaderModel {\n34|  bookId: string;\n35|  textVersion: string;\n36|  title: string;\n37|  author: string;\n38|  chapters: ReaderChapter[];\n39|}\n40|\n41|// 1280x800 fit: the reading column is 595 px tall and the heading block\n42|// (kicker, title, Scene/Page line) takes ~115 px of it on every page,\n43|// leaving ~480 px for text. At 20.5px/1.7 each line costs 34.85 px, so a\n44|// page holds 13 lines; the ~538 px measure fits ~58 chars per line, so\n45|// each paragraph costs ceil((chars + indent) / 58) lines and short\n46|// dialogue lines each take a full line. Page one also carries the drop cap, so it\n47|// budgets one less. Paragraphs stay whole; one over budget takes its own\n48|// page.\n49|export const PAGE_WORD_BUDGET = 250;\n50|const READ_COL_PX = 595;\n51|const HEADING_PX = 115;\n52|const LINE_PX = 20.5 * 1.7;\n53|export const CHARS_PER_LINE = 58;\n54|// First-line indent (1.5em ≈ 30 px ≈ 4 chars) eats measure on every\n55|// indented paragraph: all but the scene opener and cont fragments.\n56|export const INDENT_CHARS = 4;\n57|export const LINES_PER_PAGE = Math.floor((READ_COL_PX - HEADING_PX) / LINE_PX);\n58|export const FIRST_PAGE_LINES = LINES_PER_PAGE - 1;\n59|\n60|export interface SubPage {\n61|  paragraphs: ReaderParagraph[];\n62|  startN: number;\n63|  endN: number;\n64|  words: number;\n65|}\n66|\n67|export function countWords(text: string): number {\n68|  const words = text.split(/\\s+/).filter((w) => w.length > 0);\n69|  return words.length;\n70|}\n71|\n72|export function estimateLines(text: string, indented = false): number {\n73|  return Math.max(1, Math.ceil((text.length + (indented ? INDENT_CHARS : 0)) / CHARS_PER_LINE));\n74|}\n75|\n76|// Title measure: ~26 chars per line at the 44 px chapter-title size in\n77|// the 538 px column. \"The Cyclone\" is 1 line,\n78|// \"The Discovery of Oz, the Terrible\" is 2.\n79|export const TITLE_CHARS_PER_LINE = 26;\n80|const WRAPPED_TITLE_PENALTY = 2;\n81|\n82|export function chapterTitleLines(title: string): number {\n83|  if (title.length === 0) return 1;\n84|  return Math.max(1, Math.ceil(title.length / TITLE_CHARS_PER_LINE));\n85|}\n86|\n87|// Latest sentence end (`. `, `! `, `? `, `; `, closing quotes included)\n88|// at or before maxChars, as a cut index into text, or -1 when none fits.\n89|// The cut sits just past the space, so fragments join back exactly.\n90|function sentenceCut(text: string, maxChars: number): number {\n91|  const re = /[.!?;][\"'”’)\\]]* /g;\n92|  let cut = -1;\n93|  for (;;) {\n94|    const m = re.exec(text);\n95|    if (m === null) break;\n96|    const end = m.index + m[0].length;\n97|    if (end > maxChars || end >= text.length) break;\n98|    cut = end;\n99|  }\n100|  return cut;\n101|}\n102|\n103|// Latest cut at or before maxChars that fits maxWords: the sentence cut\n104|// when one fits, else the last space, else a hard cut. Backs off to an\n105|// earlier space while the prefix holds too many words.\n106|function findCut(text: string, maxChars: number, maxWords: number): number {\n107|  const cap = Math.min(maxChars, text.length - 1);\n108|  let cut = sentenceCut(text, cap);\n109|  if (cut <= 0) {\n110|    const at = text.lastIndexOf(\" \", cap);\n111|    // at + 1 can pass maxChars by one char (a 2-line 59-char slip\n112|    // into a 1-line slot), so clamp: the space opens the next fragment.\n113|    cut = at <= 0 ? cap : Math.min(at + 1, cap);\n114|  }\n115|  while (cut > 1 && countWords(text.slice(0, cut)) > maxWords) {\n116|    const at = text.lastIndexOf(\" \", cut - 2);\n117|    if (at <= 0) break;\n118|    cut = at + 1;\n119|  }\n120|  return Math.max(1, Math.min(cut, text.length - 1));\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1834f-1ea3-7d31-8c8d-c7079ffb0062"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834f-1ea3-7d31-8c8d-c7079ffb0062","task_stream":{"id":"01a1834f-1ea3-7d31-8c8d-c7079ffb0062","kind":"task"}}}
