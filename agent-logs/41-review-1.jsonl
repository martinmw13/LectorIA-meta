{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c575","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":277,"recorded_at":1780531400000549,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/narration/context.tsx`.\n1|// Layout-level narration state: the provider owns the one audio\n2|// element, so scene and sub-page navigation never interrupt playback.\n3|// ScenePage registers its scene and consumes the manifest for highlight.\n4|\"use client\";\n5|\n6|import { createContext, useContext } from \"react\";\n7|import { useNarrationController, type NarrationController } from \"./use-narration\";\n8|import type { NarrationChapterEntry } from \"./types\";\n9|\n10|const NarrationContext = createContext<NarrationController | null>(null);\n11|\n12|export function NarrationProvider({\n13|  entries,\n14|  sceneOrder,\n15|  onAdvanceScene,\n16|  children,\n17|}: {\n18|  entries: NarrationChapterEntry[];\n19|  sceneOrder: string[];\n20|  onAdvanceScene: (nextSceneId: string) => void;\n21|  children: React.ReactNode;\n22|}) {\n23|  const controller = useNarrationController({ entries, sceneOrder, onAdvanceScene });\n24|  return (\n25|    <NarrationContext.Provider value={controller}>\n26|      <audio ref={controller.audioRef} preload=\"auto\" aria-label=\"Read aloud\" />\n27|      {children}\n28|    </NarrationContext.Provider>\n29|  );\n30|}\n31|\n32|export function useNarration(): NarrationController {\n33|  const value = useContext(NarrationContext);\n34|  if (!value) throw new Error(\"useNarration outside NarrationProvider\");\n35|  return value;\n36|}","final_result":true,"kind":"output","task_id":"01a1834e-bd0c-7a52-8b30-d76319364892"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-bd0c-7a52-8b30-d76319364892","task_stream":{"id":"01a1834e-bd0c-7a52-8b30-d76319364892","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c577","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":278,"recorded_at":1780531400000551,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"kind":"completed","task_id":"01a1834e-bd0c-7a52-8b30-d76319364892"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-bd0c-7a52-8b30-d76319364892","task_stream":{"id":"01a1834e-bd0c-7a52-8b30-d76319364892","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c579","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":279,"recorded_at":1780531400000553,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `app/leer/scene-page.tsx`.\n1|// One scene view: heading, reading column, pictures, vault, pager.\n2|// Sub-page moves stay in client state; scene moves push a new route.\n3|// The chapter cover and end page are sub-pages of their scene, so\n4|// they never touch music state.\n5|\"use client\";\n6|\n7|import { Fragment, useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n8|import { useRouter } from \"next/navigation\";\n9|import { buildNavIndex, navReducer, subPageCount, subPageKind, textPageAt } from \"@/core/reader\";\n10|import type { NavAction, SceneView } from \"@/core/reader\";\n11|import { loadImageStylePref, saveImageStylePref } from \"../image-style\";\n12|import type { ImageStylePref } from \"../image-style\";\n13|import { BandPager, Divider } from \"../folio/chrome\";\n14|import { useNarration } from \"../narration/context\";\n15|import { ReadMark, useReadSync } from \"../narration/read-sync\";\n16|import { figuresAfter, groupFiguresByEndN, pageOfOrdinal } from \"../folio/figure-placement\";\n17|import { ImagePane } from \"../folio/image-pane\";\n18|import { InlineFigureView, SelectionPopover } from \"../folio/inline-figures\";\n19|import { Lightbox } from \"../folio/lightbox\";\n20|import { edges, readOnLabel, wheelTurn } from \"../folio/scroll-turn\";\n21|import type { WheelTurnState } from \"../folio/scroll-turn\";\n22|import { usePictures } from \"../folio/use-pictures\";\n23|import type { InlineFigure } from \"../folio/use-pictures\";\n24|import { PictureVault } from \"../folio/vault\";\n25|import {\n26|  chapterSetAside,\n27|  coverTitleLong,\n28|  markChapterEndReached,\n29|  markChapterSetAside,\n30|  markPanelsShownAnyway,\n31|  panelsUnlocked,\n32|} from \"../folio/panels\";\n33|import type { ChapterPanel } from \"../folio/panels\";\n34|import {\n35|  BlurredThumbs,\n36|  PanelsModal,\n37|  PanelsOfferCard,\n38|  PanelsQuietLink,\n39|  SpoilerGateDialog,\n40|} from \"../folio/panels-modal\";\n41|\n42|// One-shot entry intent: set just before pushing the previous scene\n43|// route, so the new page opens on its last sub-page. Client memory only,\n44|// never the URL, so prerendered pages stay static and a direct URL load\n45|// always starts at page 0.\n46|let enterAtEnd = false;\n47|\n48|// Survives scene remounts so one swipe never turns twice.\n49|let wheelState: WheelTurnState = { acc: 0, lockedUntil: 0, lastAt: 0 };\n50|\n51|// Set on every in-app scene push. The heading takes focus only when this\n52|// is set, so first load shows no focus ring.\n53|let hasNavigated = false;\n54|\n55|// True when the wheel target sits inside a nested scroller (picture\n56|// vault, player bar, modal grids): those scroll natively and never turn\n57|// pages. The reading column itself is not a nested scroller.\n58|function inNestedScroller(target: HTMLElement | null, readCol: HTMLElement | null): boolean {\n59|  let el: HTMLElement | null = target;\n60|  while (el !== null) {\n61|    if (el !== readCol) {\n62|      const overflowY = window.getComputedStyle(el).overflowY;\n63|      if ((overflowY === \"auto\" || overflowY === \"scroll\") && el.scrollHeight > el.clientHeight) {\n64|        return true;\n65|      }\n66|    }\n67|    el = el.parentElement;\n68|  }\n69|  return false;\n70|}\n71|\n72|function pulse(el: HTMLElement | null) {\n73|  if (!el) return;\n74|  el.classList.remove(\"pulse\");\n75|  void el.offsetWidth;\n76|  el.classList.add(\"pulse\");\n77|  window.setTimeout(() => el.classList.remove(\"pulse\"), 650);\n78|}\n79|\n80|// One scene view: sub-pages, keys, buttons, progress, chapter jump.\n81|// Sub-page moves stay in client state; scene moves push a new route.\n82|export function ScenePage({\n83|  view,\n84|  views,\n85|  bookId,\n86|  textVersion,\n87|  bookIndex,\n88|  bookTotal,\n89|  panels,\n90|  nextChapter,\n91|}: {\n92|  view: SceneView;\n93|  views: { sceneId: string; pages: number }[];\n94|  bookId: string;\n95|  textVersion: string;\n96|  bookIndex: number;\n97|  bookTotal: number;\n98|  panels: ChapterPanel[];\n99|  nextChapter: { ch: number; firstSceneId: string } | null;\n100|}) {\n101|  const [pref, setPref] = useState<ImageStylePref>({ kind: \"preset\", id: \"denslow\" });\n102|  const pic = usePictures({ bookId, textVersion, sceneId: view.sceneId, pref });\n103|  const router = useRouter();\n104|  const index = useMemo(() => buildNavIndex(views), [views]);\n105|  const cover = view.isChapterFirst;\n106|  const end = view.isChapterLast;\n107|  const coverLong = coverTitleLong(view.chapterTitle);\n108|  const total = subPageCount(view.pages.length, cover, end);\n109|  const lastPage = total - 1;\n110|  const [page, setPage] = useState(() => {\n111|    if (enterAtEnd) {\n112|      enterAtEnd = false;\n113|      return lastPage;\n114|    }\n115|    return 0;\n116|  });\n117|  const [panelsOpen, setPanelsOpen] = useState(false);\n118|  const [gateOpen, setGateOpen] = useState(false);\n119|  const [offerAside, setOfferAside] = useState(() => chapterSetAside(view.ch));\n120|  const gateOpener = useRef<HTMLElement | null>(null);\n121|  const headingRef = useRef<HTMLHeadingElement>(null);\n122|  const readColRef = useRef<HTMLDivElement | null>(null);\n123|  const bodyTextRef = useRef<HTMLDivElement | null>(null);\n124|  const figEls = useRef(new Map<string, HTMLElement>());\n125|  // Last hand navigation, for the auto-turn gate: the voice keeps\n126|  // reading but never yanks the page within ~8 s of a manual move.\n127|  const lastManualRef = useRef<number | null>(null);\n128|  const narration = useNarration();\n129|  const sceneStartN = view.pages[0]?.startN ?? 0;\n130|  const sceneEndN = view.pages[view.pages.length - 1]?.endN ?? 0;\n131|\n132|  useEffect(() => {\n133|    narration.registerScene({ sceneId: view.sceneId, ch: view.ch, startN: sceneStartN, endN: sceneEndN });\n134|  }, [narration, view.sceneId, view.ch, sceneStartN, sceneEndN]);\n135|\n136|  // One node serves both the picture popover and the read-along mark.\n137|  const viewRef = pic.viewRef;\n138|  const setBodyText = useCallback(\n139|    (node: HTMLDivElement | null) => {\n140|      bodyTextRef.current = node;\n141|      viewRef(node);\n142|    },\n143|    [viewRef],\n144|  );\n145|  const kind = subPageKind(page, view.pages.length, cover, end);\n146|  const sub = kind === \"text\" ? (view.pages[textPageAt(page, cover)] ?? view.pages[0]) : undefined;\n147|  const textIndex = textPageAt(page, cover);\n148|  const atStart = view.prevSceneId === null && page === 0;\n149|  const atBookEnd = view.nextSceneId === null && page === lastPage;\n150|  const readOn =\n151|    kind === \"text\"\n152|      ? readOnLabel({\n153|          textIndex,\n154|          textCount: view.pages.length,\n155|          hasEndPage: end,\n156|          hasNextSceneInChapter: view.k < view.n,\n157|          ch: view.ch,\n158|        })\n159|      : null;\n160|\n161|  useEffect(() => {\n162|    setPref(loadImageStylePref());\n163|  }, []);\n164|\n165|  // The end page marks the chapter finished, unlocking the panels.\n166|  useEffect(() => {\n167|    if (kind === \"end\") markChapterEndReached(view.ch);\n168|  }, [kind, view.ch]);\n169|\n170|  function changePref(next: ImageStylePref) {\n171|    setPref(next);\n172|    saveImageStylePref(next);\n173|  }\n174|\n175|  function requestPanels(opener: HTMLElement | null) {\n176|    if (panelsUnlocked(view.ch)) {\n177|      setPanelsOpen(true);\n178|      return;\n179|    }\n180|    gateOpener.current = opener;\n181|    setGateOpen(true);\n182|  }\n183|\n184|  function showAnyway() {\n185|    markPanelsShownAnyway(view.ch);\n186|    setGateOpen(false);\n187|    setPanelsOpen(true);\n188|  }\n189|\n190|  function notYet() {\n191|    setGateOpen(false);\n192|    gateOpener.current?.focus?.();\n193|    gateOpener.current = null;\n194|  }\n195|\n196|  function readFirst() {\n197|    markChapterSetAside(view.ch);\n198|    setOfferAside(true);\n199|  }\n200|\n201|  function goNextChapter() {\n202|    if (!nextChapter) return;\n203|    hasNavigated = true;\n204|    router.push(`/leer/${nextChapter.firstSceneId}`);\n205|  }\n206|\n207|  const figsByN = useMemo(() => groupFiguresByEndN(pic.figures), [pic.figures]);\n208|\n209|  function gotoFigure(fig: InlineFigure) {\n210|    lastManualRef.current = Date.now();\n211|    const at = pageOfOrdinal(view.pages, fig.endN);\n212|    if (at < 0) return;\n213|    setPage(at + (cover ? 1 : 0));\n214|    readColRef.current?.scrollTo(0, 0);\n215|    requestAnimationFrame(() => {\n216|      requestAnimationFrame(() => {\n217|        const el = figEls.current.get(fig.id) ?? null;\n218|        el?.scrollIntoView({ block: \"nearest\" });\n219|        pulse(el);\n220|      });\n221|    });\n222|  }\n223|\n224|  function gotoScenePicture() {\n225|    const img = document.querySelector(\".img-pane .pane-img\");\n226|    pulse(img instanceof HTMLElement ? img : null);\n227|  }\n228|\n229|  // Every pager move runs through navReducer; a new scene id means a\n230|  // route push, a same-scene result means a client sub-page move.\n231|  function move(action: NavAction) {\n232|    pic.hidePopover();\n233|    lastManualRef.current = Date.now();\n234|    const next = navReducer({ sceneId: view.sceneId, page }, action, index);\n235|    if (next.sceneId !== view.sceneId) {\n236|      hasNavigated = true;\n237|      if (next.page > 0) enterAtEnd = true;\n238|      router.push(`/leer/${next.sceneId}`);\n239|      return;\n240|    }\n241|    if (next.page !== page) {\n242|      setPage(next.page);\n243|      readColRef.current?.scrollTo(0, 0);\n244|    }\n245|  }\n246|\n247|  function goNext() {\n248|    move({ kind: \"next\" });\n249|  }\n250|\n251|  function goPrev() {\n252|    move({ kind: \"prev\" });\n253|  }\n254|\n255|  // Read-along follow: the voice turns the sub-page on its own. This\n256|  // path never stamps a manual move, so the gate lets it through.\n257|  const syncEnabled = narration.on && narration.manifest !== null && kind === \"text\";\n258|  const { mark, treatment } = useReadSync({\n259|    enabled: syncEnabled,\n260|    audioRef: narration.audioRef,\n261|    manifest: narration.manifest,\n262|    span: narration.span,\n263|    containerRef: bodyTextRef,\n264|    scrollerRef: readColRef,\n265|    pages: view.pages,\n266|    textPage: textIndex,\n267|    onTurnPage: (textIndex) => {\n268|      setPage(textIndex + (cover ? 1 : 0));\n269|      readColRef.current?.scrollTo(0, 0);\n270|    },\n271|    lastManualRef,\n272|  });\n273|\n274|  // Scene entry resets orientation; sub-page moves keep the heading.\n275|  useEffect(() => {\n276|    if (hasNavigated) headingRef.current?.focus();\n277|    readColRef.current?.scrollTo(0, 0);\n278|  }, [view.sceneId]);\n279|\n280|  useEffect(() => {\n281|    const onKey = (event: KeyboardEvent) => {\n282|      if (event.metaKey || event.ctrlKey || event.altKey) return;\n283|      const target = event.target as HTMLElement | null;\n284|      if (\n285|        target &&\n286|        (target.tagName === \"INPUT\" ||\n287|          target.tagName === \"SELECT\" ||\n288|          target.tagName === \"TEXTAREA\" ||\n289|          target.isContentEditable)\n290|      ) {\n291|        return;\n292|      }\n293|      if (event.key === \"ArrowRight\") {\n294|        event.preventDefault();\n295|        goNext();\n296|      } else if (event.key === \"ArrowLeft\") {\n297|        event.preventDefault();\n298|        goPrev();\n299|      } else if (\n300|        event.key === \" \" ||\n301|        event.key === \"PageDown\" ||\n302|        event.key === \"ArrowDown\" ||\n303|        event.key === \"PageUp\" ||\n304|        event.key === \"ArrowUp\"\n305|      ) {\n306|        if (target !== null && target.tagName === \"BUTTON\") return;\n307|        const forward =\n308|          event.key === \"PageDown\" || event.key === \"ArrowDown\" || (event.key === \" \" && !event.shiftKey);\n309|        event.preventDefault();\n310|        const col = readColRef.current;\n311|        if (col !== null) {\n312|          const at = edges(col);\n313|          if ((forward && !at.atBottom) || (!forward && !at.atTop)) {\n314|            col.scrollBy({ top: (forward ? 1 : -1) * col.clientHeight * 0.85, behavior: \"smooth\" });\n315|            return;\n316|          }\n317|        }\n318|        if (forward) goNext();\n319|        else goPrev();\n320|      }\n321|    };\n322|    window.addEventListener(\"keydown\", onKey);\n323|    return () => window.removeEventListener(\"keydown\", onKey);\n324|  }, [page, view.sceneId, index, router]);\n325|\n326|  // Wheel and trackpad turn pages: at a column edge, an accumulated swipe\n327|  // calls goNext/goPrev. preventDefault only on a turn, so the column\n328|  // keeps scrolling natively until it rests on its edge.\n329|  useEffect(() => {\n330|    const onWheel = (event: WheelEvent) => {\n331|      if (panelsOpen || gateOpen || pic.lightbox.item !== null) return;\n332|      if (event.ctrlKey) return;\n333|      if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;\n334|      const target = event.target instanceof HTMLElement ? event.target : null;\n335|      const readCol = readColRef.current;\n336|      if (inNestedScroller(target, readCol)) return;\n337|      const at = readCol === null ? { atTop: true, atBottom: true } : edges(readCol);\n338|      const result = wheelTurn(wheelState, {\n339|        deltaY: event.deltaY,\n340|        deltaMode: event.deltaMode,\n341|        now: performance.now(),\n342|        atTop: at.atTop,\n343|        atBottom: at.atBottom,\n344|      });\n345|      wheelState = result.state;\n346|      if (result.turn === \"next\") {\n347|        event.preventDefault();\n348|        goNext();\n349|      } else if (result.turn === \"prev\") {\n350|        event.preventDefault();\n351|        goPrev();\n352|      }\n353|    };\n354|    window.addEventListener(\"wheel\", onWheel, { passive: false });\n355|    return () => window.removeEventListener(\"wheel\", onWheel);\n356|  }, [page, view.sceneId, index, router, panelsOpen, gateOpen, pic.lightbox.item]);\n357|\n358|  return (\n359|    <>\n360|      <ImagePane\n361|        // The cover always shows the placeholder: nothing to picture yet,\n362|        // and a cached scene picture would spoil the chapter.\n363|        card={kind === \"cover\" ? { phase: \"idle\" } : pic.card}\n364|        onPicture={() => pic.illustrateScene()}\n365|        onRetry={() => pic.illustrateScene()}\n366|        onClear={pic.clearScene}\n367|        onOpen={pic.lightbox.open}\n368|        bare={kind === \"cover\"}\n369|        onPictureChapter={\n370|          kind === \"cover\" ? null : kind === \"end\" ? () => setPanelsOpen(true) : requestPanels\n371|        }\n372|      />\n373|      <Divider />\n374|      <div className=\"read-col\" ref={readColRef} aria-label=\"Reading column\">\n375|        {kind === \"cover\" ? (\n376|          <>\n377|            <div className=\"kicker\">Chapter</div>\n378|            <p className=\"cover-num\" data-long={coverLong} aria-label={`Chapter ${view.ch}`}>\n379|              {view.ch}\n380|            </p>\n381|            <h1\n382|              className=\"chapter-title cover-title\"\n383|              data-long={coverLong}\n384|              id=\"scene-heading\"\n385|              ref={headingRef}\n386|              tabIndex={-1}\n387|            >\n388|              {view.chapterTitle}\n389|            </h1>\n390|            <hr className=\"cover-rule\" />\n391|            {offerAside ? (\n392|              <PanelsQuietLink onOpen={requestPanels} />\n393|            ) : (\n394|              <PanelsOfferCard panels={panels} onShowAnyway={showAnyway} onReadFirst={readFirst} />\n395|            )}\n396|            <button type=\"button\" className=\"cover-begin\" onClick={goNext}>\n397|              Begin the chapter →\n398|            </button>\n399|            <span className=\"read-on-hint\">or just scroll</span>\n400|          </>\n401|        ) : kind === \"end\" ? (\n402|          <>\n403|            <div className=\"kicker\">End of Chapter {view.ch}</div>\n404|            <div className=\"end-card\">\n405|              <BlurredThumbs panels={panels} unblurredCount={Math.min(4, panels.length)} />\n406|              <h2>Relive this chapter in panels</h2>\n407|              <div className=\"panels-btns\">\n408|                <button type=\"button\" className=\"panels-primary\" onClick={() => setPanelsOpen(true)}>\n409|                  Open the panels\n410|                </button>\n411|              </div>\n412|            </div>\n413|            {nextChapter ? (\n414|              <button type=\"button\" className=\"end-next\" onClick={goNextChapter}>\n415|                On to Chapter {nextChapter.ch} →\n416|              </button>\n417|            ) : (\n418|              <p className=\"the-end\">The end.</p>\n419|            )}\n420|          </>\n421|        ) : (\n422|          <>\n423|            <div className=\"kicker\">Chapter {view.ch}</div>\n424|            <h1 className=\"chapter-title\" id=\"scene-heading\" ref={headingRef} tabIndex={-1}>\n425|              {view.chapterTitle}\n426|            </h1>\n427|            <div className=\"scene-line\">\n428|              <span>\n429|                Scene {view.k} of {view.n}\n430|                {view.pages.length > 1 ? ` · Page ${textIndex + 1} of ${view.pages.length}` : \"\"}\n431|              </span>\n432|            </div>\n433|            <div className={`body-text${textIndex === 0 ? \" dropcap\" : \"\"}`} ref={setBodyText}>\n434|              <ReadMark mark={syncEnabled ? mark : null} treatment={treatment} />\n435|              {sub?.paragraphs.map((p, i, arr) => (\n436|                <Fragment key={p.id}>\n437|                  <p id={p.id} data-n={p.n} data-cont={p.cont ? true : undefined} data-from={p.from ?? 0}>\n438|                    {p.text}\n439|                  </p>\n440|                  {/* A figure for n lands after its last visible fragment. */}\n441|                  {figuresAfter(arr, i, figsByN).map((fig) => (\n442|                    <InlineFigureView\n443|                      key={fig.id}\n444|                      figure={fig}\n445|                      onRemove={() => pic.removeFigure(fig.id)}\n446|                      onRetry={() => pic.retryFigure(fig.id)}\n447|                      onOpen={pic.lightbox.open}\n448|                      refCb={(el) => {\n449|                        if (el) figEls.current.set(fig.id, el);\n450|                        else figEls.current.delete(fig.id);\n451|                      }}\n452|                    />\n453|                  ))}\n454|                </Fragment>\n455|              ))}\n456|              {pic.popover !== null ? (\n457|                <SelectionPopover\n458|                  pos={pic.popover}\n459|                  popRef={pic.popRef}\n460|                  onPick={() => pic.illustratePassage()}\n461|                />\n462|              ) : null}\n463|              {/* Every read-on label ends with \" ↓\"; the arrow gets its own span for the hover nudge. */}\n464|              {readOn !== null ? (\n465|                <button type=\"button\" className=\"read-on\" onClick={goNext}>\n466|                  {readOn.slice(0, -1)}\n467|                  <span className=\"read-on-arrow\" aria-hidden=\"true\">\n468|                    ↓\n469|                  </span>\n470|                </button>\n471|              ) : null}\n472|            </div>\n473|          </>\n474|        )}\n475|      </div>\n476|      <PictureVault\n477|        scene={pic.card.phase === \"ready\" ? { url: pic.card.url, caption: pic.card.caption } : null}\n478|        figures={pic.figures}\n479|        onGotoScene={gotoScenePicture}\n480|        onGotoFigure={gotoFigure}\n481|        onOpen={pic.lightbox.open}\n482|        pref={pref}\n483|        onPrefChange={changePref}\n484|      />\n485|      <BandPager\n486|        k={view.k}\n487|        n={view.n}\n488|        bookIndex={bookIndex}\n489|        bookTotal={bookTotal}\n490|        onPrev={goPrev}\n491|        onNext={goNext}\n492|        atStart={atStart}\n493|        atBookEnd={atBookEnd}\n494|      />\n495|      <Lightbox item={pic.lightbox.item} onClose={pic.lightbox.close} />\n496|      {gateOpen ? <SpoilerGateDialog onShow={showAnyway} onNotYet={notYet} /> : null}\n497|      {panelsOpen ? (\n498|        <PanelsModal\n499|          ch={view.ch}\n500|          chapterTitle={view.chapterTitle}\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1834e-bd00-7da3-9950-bfa39848abea"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834e-bd00-7da3-9950-bfa39848abea","task_stream":{"id":"01a1834e-bd00-7da3-9950-bfa39848abea","kind":"task"}}}
