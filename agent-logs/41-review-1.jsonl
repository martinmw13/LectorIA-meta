{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c609","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":351,"recorded_at":1780531400000697,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1834f0259729db45053b30846b831","command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"text":"Read text file `core/narration.ts`.\n1|// Pure narration logic: sentence split, chunking, cache keys, manifest\n2|// validation, playback helpers, and cost math. No env, no network,\n3|// no crypto, no node: imports; callers inject hashing.\n4|export const NARRATION_VOICE = \"af_heart\";\n5|export const NARRATION_MODEL = \"kokoro-82m/0.9.4\";\n6|export const NARRATION_SPEED = 0.95;\n7|export const NARRATION_FORMAT = 2;\n8|export const SENTENCE_GAP_SEC = 0.3;\n9|export const PARAGRAPH_GAP_SEC = 0.7;\n10|\n11|export interface SentenceSpan {\n12|  start: number;\n13|  end: number;\n14|}\n15|\n16|export interface NarrationChunk {\n17|  n: number;\n18|  start: number;\n19|  end: number;\n20|  text: string;\n21|}\n22|\n23|const CLOSERS = new Set([\"”\", \"’\", '\"', \"'\", \")\", \"]\"]);\n24|\n25|// Lowercase words that end with a period without ending a sentence.\n26|const ABBREVIATIONS = new Set([\n27|  \"mr\", \"mrs\", \"ms\", \"dr\", \"st\", \"mt\", \"prof\", \"sr\", \"jr\",\n28|  \"rev\", \"lt\", \"col\", \"gen\", \"capt\", \"sgt\", \"ave\", \"blvd\", \"rd\", \"no\",\n29|]);\n30|\n31|function isTerminator(char: string): boolean {\n32|  return char === \".\" || char === \"!\" || char === \"?\" || char === \"…\";\n33|}\n34|\n35|function isSpace(char: string | undefined): boolean {\n36|  return char === undefined || /\\s/.test(char);\n37|}\n38|\n39|// Word of letters directly before index (exclusive), lowercased.\n40|function wordBefore(text: string, index: number): string {\n41|  let i = index - 1;\n42|  while (i >= 0 && /[A-Za-z]/.test(text[i] as string)) i -= 1;\n43|  return text.slice(i + 1, index).toLowerCase();\n44|}\n45|\n46|function wordCount(piece: string): number {\n47|  const words = piece.split(/\\s+/).filter((w) => w.length > 0);\n48|  return words.length;\n49|}\n50|\n51|// Char offsets into the paragraph text, trimmed of surrounding\n52|// whitespace, covering every non-space char. A sentence ends at a\n53|// terminator plus closing quotes/brackets followed by whitespace.\n54|export function splitSentences(text: string): SentenceSpan[] {\n55|  const raw: SentenceSpan[] = [];\n56|  let pieceStart = -1;\n57|  let i = 0;\n58|  while (i < text.length) {\n59|    const char = text[i] as string;\n60|    if (/\\s/.test(char)) {\n61|      i += 1;\n62|      continue;\n63|    }\n64|    if (pieceStart === -1) pieceStart = i;\n65|    if (isTerminator(char)) {\n66|      let end = i + 1;\n67|      while (end < text.length && CLOSERS.has(text[end] as string)) end += 1;\n68|      if (isSpace(text[end])) {\n69|        if (char === \".\") {\n70|          const word = wordBefore(text, i);\n71|          const singleInitial = /^[A-Z]$/.test(text.slice(i - 1, i));\n72|          if (singleInitial || ABBREVIATIONS.has(word)) {\n73|            i += 1;\n74|            continue;\n75|          }\n76|        }\n77|        // Trim trailing whitespace inside the piece (there is none:\n78|        // the piece ends at a terminator or closer).\n79|        raw.push({ start: pieceStart, end });\n80|        pieceStart = -1;\n81|        i = end;\n82|        continue;\n83|      }\n84|    }\n85|    i += 1;\n86|  }\n87|  if (pieceStart !== -1) {\n88|    let end = text.length;\n89|    while (end > pieceStart && /\\s/.test(text[end - 1] as string)) end -= 1;\n90|    raw.push({ start: pieceStart, end });\n91|  }\n92|  if (raw.length === 0) return [];\n93|  // Merge a piece shorter than 3 words into the previous sentence\n94|  // (or the next one if first), keeping offsets exact.\n95|  const merged: SentenceSpan[] = [];\n96|  for (const span of raw) {\n97|    const piece = text.slice(span.start, span.end);\n98|    if (wordCount(piece) >= 3 || merged.length === 0) {\n99|      merged.push({ ...span });\n100|      continue;\n101|    }\n102|    const prev = merged[merged.length - 1] as SentenceSpan;\n103|    prev.end = span.end;\n104|  }\n105|  if (merged.length > 1) {\n106|    const first = merged[0] as SentenceSpan;\n107|    if (wordCount(text.slice(first.start, first.end)) < 3) {\n108|      const next = merged[1] as SentenceSpan;\n109|      next.start = first.start;\n110|      merged.shift();\n111|    }\n112|  }\n113|  return merged;\n114|}\n115|\n116|export function chapterChunks(paragraphs: { n: number; text: string }[]): {\n117|  chunks: NarrationChunk[];\n118|  gaps: number[];\n119|} {\n120|  const chunks: NarrationChunk[] = [];\n121|  const paraOf: number[] = [];\n122|  paragraphs.forEach((para, paraIndex) => {\n123|    for (const span of splitSentences(para.text)) {\n124|      chunks.push({ n: para.n, start: span.start, end: span.end, text: para.text.slice(span.start, span.end) });\n125|      paraOf.push(paraIndex);\n126|    }\n127|  });\n128|  const gaps = chunks.map((_, i) => {\n129|    if (i === chunks.length - 1) return 0;\n130|    return paraOf[i] !== paraOf[i + 1] ? PARAGRAPH_GAP_SEC : SENTENCE_GAP_SEC;\n131|  });\n132|  return { chunks, gaps };\n133|}\n134|\n135|export function normalizeChunkText(text: string): string {\n136|  return text.normalize(\"NFC\").replace(/\\s+/g, \" \").trim();\n137|}\n138|\n139|// Canonical string the caller hashes with SHA-256. Same text + voice +\n140|// model + speed => same string; any edit changes it.\n141|export function narrationKeyInput(args: {\n142|  chunks: { text: string }[];\n143|  voice: string;\n144|  model: string;\n145|  speed: number;\n146|  format: number;\n147|}): string {\n148|  const body = args.chunks.map((c) => normalizeChunkText(c.text)).join(\"\\n\");\n149|  return `narration/${args.format}\\nvoice:${args.voice}\\nmodel:${args.model}\\nspeed:${args.speed}\\n${body}`;\n150|}\n151|\n152|export function narrationKey(hashHex: string, voice: string): string {\n153|  return `narration/v${NARRATION_FORMAT}/${voice}/${hashHex.slice(0, 32)}`;\n154|}\n155|\n156|export function narrationAudioPath(key: string): string {\n157|  return `${key}.mp3`;\n158|}\n159|\n160|export function narrationManifestPath(key: string): string {\n161|  return `${key}.json`;\n162|}\n163|\n164|export interface ChapterChunkTiming {\n165|  n: number;\n166|  start: number;\n167|  end: number;\n168|  t0: number;\n169|  t1: number;\n170|  // Flat word timings: [start, end, t0, t1, ...] with start/end\n171|  // paragraph-relative char offsets inside start..end and times in\n172|  // seconds. Built by alignWords in ensureChapterNarration.\n173|  w: number[];\n174|}\n175|\n176|export interface ChapterNarration {\n177|  format: 2;\n178|  key: string;\n179|  src: string;\n180|  durationSec: number;\n181|  voice: string;\n182|  model: string;\n183|  speed: number;\n184|  chunks: ChapterChunkTiming[];\n185|}\n186|\n187|function isRecord(json: unknown): json is Record<string, unknown> {\n188|  return typeof json === \"object\" && json !== null && !Array.isArray(json);\n189|}\n190|\n191|// Strict parse at the trust boundary: the reader fetches this JSON,\n192|// so any bad field throws instead of half-playing.\n193|export function parseChapterNarration(json: unknown): ChapterNarration {\n194|  if (!isRecord(json)) throw new Error(\"invalid narration manifest\");\n195|  if (json.format !== NARRATION_FORMAT) throw new Error(\"invalid narration manifest\");\n196|  if (typeof json.key !== \"string\" || json.key.length === 0) throw new Error(\"invalid narration manifest\");\n197|  if (typeof json.src !== \"string\" || !isSafeSrc(json.src)) throw new Error(\"invalid narration manifest\");\n198|  if (typeof json.durationSec !== \"number\" || !Number.isFinite(json.durationSec) || json.durationSec <= 0) {\n199|    throw new Error(\"invalid narration manifest\");\n200|  }\n201|  if (typeof json.voice !== \"string\" || json.voice.length === 0) throw new Error(\"invalid narration manifest\");\n202|  if (typeof json.model !== \"string\" || json.model.length === 0) throw new Error(\"invalid narration manifest\");\n203|  if (typeof json.speed !== \"number\" || !Number.isFinite(json.speed)) throw new Error(\"invalid narration manifest\");\n204|  if (!Array.isArray(json.chunks) || json.chunks.length === 0) throw new Error(\"invalid narration manifest\");\n205|  const chunks: ChapterChunkTiming[] = json.chunks.map((entry) => {\n206|    if (!isRecord(entry)) throw new Error(\"invalid narration manifest\");\n207|    const { n, start, end, t0, t1, w } = entry;\n208|    if (typeof n !== \"number\" || !Number.isInteger(n)) throw new Error(\"invalid narration manifest\");\n209|    if (typeof start !== \"number\" || !Number.isInteger(start) || start < 0) throw new Error(\"invalid narration manifest\");\n210|    if (typeof end !== \"number\" || !Number.isInteger(end) || end <= start) throw new Error(\"invalid narration manifest\");\n211|    for (const t of [t0, t1]) {\n212|      if (typeof t !== \"number\" || !Number.isFinite(t)) throw new Error(\"invalid narration manifest\");\n213|    }\n214|    const from = t0 as number;\n215|    const to = t1 as number;\n216|    if (!(0 <= from && from < to && to <= (json.durationSec as number) + 0.05)) {\n217|      throw new Error(\"invalid narration manifest\");\n218|    }\n219|    if (!Array.isArray(w) || w.length % 4 !== 0) throw new Error(\"invalid narration manifest\");\n220|    const words: number[] = w.map((v) => {\n221|      if (typeof v !== \"number\" || !Number.isFinite(v)) throw new Error(\"invalid narration manifest\");\n222|      return v;\n223|    });\n224|    for (let k = 0; k < words.length; k