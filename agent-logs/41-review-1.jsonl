{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c7","stream":{"kind":"session","id":"01a1834e-5c30-7891-bc12-a51ead89f1ec"},"sequence":446,"recorded_at":1780531400000887,"record_type":"event","durability":"durable","causation_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","event":{"chunk":"Read text file `core/reader.ts`.\n(199 line(s) above)\n200|export interface SceneView {\n201|  sceneId: string;\n202|  ch: number;\n203|  chapterTitle: string;\n204|  title: string;\n205|  emotion: ReaderScene[\"emotion\"];\n206|  pages: SubPage[];\n207|  prevSceneId: string | null;\n208|  nextSceneId: string | null;\n209|  k: number;\n210|  n: number;\n211|  isChapterFirst: boolean;\n212|  isChapterLast: boolean;\n213|}\n214|\n215|// The chapter cover (page 0 of the first scene) and the chapter-end\n216|// page (trailing page of the last scene) belong to their scene: they\n217|// shift sub-page indexes only, so music entry still fires per route id.\n218|export type SubPageKind = \"cover\" | \"text\" | \"end\";\n219|\n220|export function subPageCount(textPages: number, cover: boolean, end: boolean): number {\n221|  return textPages + (cover ? 1 : 0) + (end ? 1 : 0);\n222|}\n223|\n224|export function subPageKind(page: number, textPages: number, cover: boolean, end: boolean): SubPageKind {\n225|  if (cover && page === 0) return \"cover\";\n226|  if (end && page === subPageCount(textPages, cover, end) - 1) return \"end\";\n227|  return \"text\";\n228|}\n229|\n230|// Sub-page index to text-page index (the cover shifts text by one).\n231|export function textPageAt(page: number, cover: boolean): number {\n232|  return page - (cover ? 1 : 0);\n233|}\n234|\n235|// One short caption per panel: the first clause of the scene summary,\n236|// cut at a word boundary to 90 chars with an ellipsis when longer.\n237|export const PANEL_CAPTION_MAX = 90;\n238|\n239|export function panelCaption(summary: string): string {\n240|  const clean = summary.replace(/\\s+/g, \" \").trim();\n241|  if (clean.length <= PANEL_CAPTION_MAX) return clean;\n242|  const end = clean.search(/[.!?;][\"'”’)\\]]?\\s/);\n243|  const first = end > 0 && end < PANEL_CAPTION_MAX ? clean.slice(0, end + 1) : null;\n244|  if (first) return first;\n245|  const cut = clean.slice(0, PANEL_CAPTION_MAX - 1);\n246|  return `${cut.slice(0, Math.max(1, cut.lastIndexOf(\" \"))).trimEnd()}…`;\n247|}\n248|\n249|// The only text a scene route ships: this scene, its chapter, its pages,\n250|// and neighbor ids for the pager. Throws on unknown scene id.\n251|export function buildSceneView(\n252|  model: ReaderModel,\n253|  sceneId: string,\n254|  budgetWords: number = PAGE_WORD_BUDGET,\n255|): SceneView {\n256|  const flat = model.chapters.flatMap((c) => c.scenes.map((s) => ({ ch: c.ch, chapterTitle: c.title, scene: s })));\n257|  const at = flat.findIndex((e) => e.scene.id === sceneId);\n258|  if (at < 0 || !flat[at]) throw new Error(`unknown scene ${sceneId}`);\n259|  const entry = flat[at] as { ch: number; chapterTitle: string; scene: ReaderScene };\n260|  const chapterScenes = flat.filter((e) => e.ch === entry.ch);\n261|  const atInChapter = chapterScenes.findIndex((e) => e.scene.id === sceneId);\n262|  const prev = at > 0 ? flat[at - 1] : null;\n263|  const next = at < flat.length - 1 ? flat[at + 1] : null;\n264|  return {\n265|    sceneId,\n266|    ch: entry.ch,\n267|    chapterTitle: entry.chapterTitle,\n268|    title: entry.scene.title,\n269|    emotion: entry.scene.emotion,\n270|    pages: paginateScene(entry.scene.paragraphs, budgetWords, entry.chapterTitle),\n271|    prevSceneId: prev?.scene.id ?? null,\n272|    nextSceneId: next?.scene.id ?? null,\n273|    k: atInChapter + 1,\n274|    n: chapterScenes.length,\n275|    isChapterFirst: atInChapter === 0,\n276|    isChapterLast: atInChapter === chapterScenes.length - 1,\n277|  };\n278|}\n279|\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1834f-2d38-7e11-b0a1-22861ed6db38"},"kind":"task_lifecycle","run_stream":{"id":"01a1834e-5e54-7173-a07b-84d0dcd98bd2","kind":"run"},"task_id":"01a1834f-2d38-7e11-b0a1-22861ed6db38","task_stream":{"id":"01a1834f-2d38-7e11-b0a1-22861ed6db38","kind":"task"}}}
