{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56b","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":272,"recorded_at":1780531400000539,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `app/narration/prefs.ts`.\n1|// Persisted read-aloud prefs: on/off plus a narration-only volume.\n2|// Storage can throw (private mode), so every access is guarded.\n3|import type { NarrationPrefs } from \"./types\";\n4|\n5|export const NARRATION_PREFS_KEY = \"lectoria.narration.v1\";\n6|\n7|export const DEFAULT_NARRATION_VOLUME = 0.8;\n8|\n9|export const DEFAULT_NARRATION_PREFS: NarrationPrefs = { on: false, volume: DEFAULT_NARRATION_VOLUME };\n10|\n11|type PrefsStorage = Pick<Storage, \"getItem\" | \"setItem\">;\n12|\n13|function validVolume(value: unknown): number | null {\n14|  return typeof value === \"number\" && Number.isFinite(value) && value >= 0 && value <= 1 ? value : null;\n15|}\n16|\n17|export function loadNarrationPrefs(storage?: PrefsStorage): NarrationPrefs {\n18|  try {\n19|    const raw = storage?.getItem(NARRATION_PREFS_KEY);\n20|    if (!raw) return { ...DEFAULT_NARRATION_PREFS };\n21|    const json: unknown = JSON.parse(raw);\n22|    if (typeof json !== \"object\" || json === null) return { ...DEFAULT_NARRATION_PREFS };\n23|    const { on, volume } = json as Record<string, unknown>;\n24|    return {\n25|      on: typeof on === \"boolean\" ? on : false,\n26|      volume: validVolume(volume) ?? DEFAULT_NARRATION_VOLUME,\n27|    };\n28|  } catch {\n29|    return { ...DEFAULT_NARRATION_PREFS };\n30|  }\n31|}\n32|\n33|export function saveNarrationPrefs(storage: PrefsStorage | undefined, prefs: NarrationPrefs): void {\n34|  try {\n35|    storage?.setItem(NARRATION_PREFS_KEY, JSON.stringify(prefs));\n36|  } catch {\n37|    // Private mode: playback continues without persistence.\n38|  }\n39|}","final_result":true,"kind":"output","task_id":"01a18347-f26c-76b2-9bc9-b967fea93ec6"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-f26c-76b2-9bc9-b967fea93ec6","task_stream":{"id":"01a18347-f26c-76b2-9bc9-b967fea93ec6","kind":"task"}}}
