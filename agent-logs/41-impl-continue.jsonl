{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56f","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":274,"recorded_at":1780531400000543,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `app/narration/word-map.ts`.\n1|// Word timings are paragraph-relative char offsets (flat [start, end,\n2|// t0, t1, ...] from the manifest), while the page renders fragments cut\n3|// by paginateScene. This maps one fragment's slice of the timings into\n4|// fragment-relative ranges for DOM Range building. Cuts land on spaces,\n5|// so words never straddle fragments; offsets clip defensively.\n6|export interface FragmentWord {\n7|  start: number;\n8|  end: number;\n9|  t0: number;\n10|  t1: number;\n11|}\n12|\n13|export function wordsInFragment(w: number[], from: number, fragLen: number): FragmentWord[] {\n14|  const out: FragmentWord[] = [];\n15|  for (let k = 0; k + 3 < w.length; k += 4) {\n16|    const s = w[k] as number;\n17|    const e = w[k + 1] as number;\n18|    if (!(e > from && s < from + fragLen)) continue;\n19|    out.push({\n20|      start: Math.max(s, from) - from,\n21|      end: Math.min(e, from + fragLen) - from,\n22|      t0: w[k + 2] as number,\n23|      t1: w[k + 3] as number,\n24|    });\n25|  }\n26|  return out;\n27|}","final_result":true,"kind":"output","task_id":"01a18347-f276-71a3-84cb-585d191bcc4a"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-f276-71a3-84cb-585d191bcc4a","task_stream":{"id":"01a18347-f276-71a3-84cb-585d191bcc4a","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c571","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":275,"recorded_at":1780531400000545,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"kind":"completed","task_id":"01a18347-f276-71a3-84cb-585d191bcc4a"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-f276-71a3-84cb-585d191bcc4a","task_stream":{"id":"01a18347-f276-71a3-84cb-585d191bcc4a","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c573","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":276,"recorded_at":1780531400000547,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `app/narration/turn.ts`.\n1|// Auto page-turn gate: the voice follows the text across sub-pages and\n2|// scenes on its own, unless the reader just moved by hand. A recent\n3|// manual move means the voice keeps reading without yanking the page.\n4|export const NARRATION_MANUAL_WINDOW_MS = 8000;\n5|\n6|export function shouldAutoTurn(\n7|  lastManualAtMs: number | null,\n8|  nowMs: number,\n9|  windowMs: number = NARRATION_MANUAL_WINDOW_MS,\n10|): boolean {\n11|  if (lastManualAtMs === null) return true;\n12|  return nowMs - lastManualAtMs >= windowMs;\n13|}","final_result":true,"kind":"output","task_id":"01a18347-f273-7de3-90eb-b7c83b0dc519"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-f273-7de3-90eb-b7c83b0dc519","task_stream":{"id":"01a18347-f273-7de3-90eb-b7c83b0dc519","kind":"task"}}}
