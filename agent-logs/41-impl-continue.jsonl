{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c577","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":278,"recorded_at":1780531400000551,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `app/narration/ranges.test.ts`.\n1|// @vitest-environment jsdom\n2|import { describe, expect, it } from \"vitest\";\n3|import { rangesForChunk } from \"./ranges\";\n4|\n5|// “Oz’s,” didn’t run split across two fragments: the cut lands on the\n6|// space, so each word sits whole in one fragment. Punctuation and curly\n7|// quotes never highlight: the word ranges hold letters only.\n8|function container(): HTMLElement {\n9|  const el = document.createElement(\"div\");\n10|  el.innerHTML =\n11|    `<p data-n=\"3\" data-from=\"0\">“Oz’s,”</p>` + `<p data-n=\"3\" data-from=\"7\"> didn’t run</p>`;\n12|  return el;\n13|}\n14|\n15|const CHUNK = { n: 3, start: 0, end: 18, t0: 0, t1: 1.2, w: [1, 5, 0.0, 0.4, 8, 14, 0.5, 0.9, 15, 18, 1.0, 1.2] };\n16|\n17|describe(\"rangesForChunk\", () => {\n18|  it(\"maps the word index to the fragment holding it, letters only\", () => {\n19|    expect(rangesForChunk(container(), CHUNK, 0).wordText).toBe(\"Oz’s\");\n20|    expect(rangesForChunk(container(), CHUNK, 1).wordText).toBe(\"didn’t\");\n21|    expect(rangesForChunk(container(), CHUNK, 2).wordText).toBe(\"run\");\n22|  });\n23|\n24|  it(\"covers the sentence across split fragments with no gaps\", () => {\n25|    const { sentence } = rangesForChunk(container(), CHUNK, 1);\n26|    expect(sentence.map((r) => r.toString()).join(\"\")).toBe(\"“Oz’s,” didn’t run\");\n27|  });\n28|\n29|  it(\"returns no word range off the words or off the paragraph\", () => {\n30|    expect(rangesForChunk(container(), CHUNK, -1).word).toBeNull();\n31|    expect(rangesForChunk(container(), { ...CHUNK, n: 9 }, 0).word).toBeNull();\n32|  });\n33|});","final_result":true,"kind":"output","task_id":"01a18347-f27e-72b3-84f5-bc77da617442"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-f27e-72b3-84f5-bc77da617442","task_stream":{"id":"01a18347-f27e-72b3-84f5-bc77da617442","kind":"task"}}}
