{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c567","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":270,"recorded_at":1780531400000535,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `app/narration/duck.ts`.\n1|// Music duck while the voice plays: about -18 dB, ramped down over\n2|// ~400 ms and back up over ~800 ms so the dip never clicks.\n3|export const NARRATION_DUCK_DB = -18;\n4|export const NARRATION_DUCK_DOWN_MS = 400;\n5|export const NARRATION_DUCK_UP_MS = 800;\n6|\n7|// 10^(-18/20): the music multiplier at full duck.\n8|export const NARRATION_DUCK_LEVEL = 10 ** (NARRATION_DUCK_DB / 20);\n9|\n10|// One ramp step toward target: an exponential approach that lands\n11|// exactly when the elapsed slice covers the duration. Pure, so the\n12|// controller and the tests share the curve.\n13|export function rampDuck(current: number, target: number, dtMs: number, durationMs: number): number {\n14|  if (!(dtMs > 0)) return current;\n15|  if (!(durationMs > 0)) return target;\n16|  const next = current + (target - current) * Math.min(1, dtMs / durationMs);\n17|  // Snap when close so the ramp settles instead of easing forever.\n18|  return Math.abs(next - target) < 1e-4 ? target : next;\n19|}","final_result":true,"kind":"output","task_id":"01a18347-f266-7f31-9598-6c87e350a7ac"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-f266-7f31-9598-6c87e350a7ac","task_stream":{"id":"01a18347-f266-7f31-9598-6c87e350a7ac","kind":"task"}}}
