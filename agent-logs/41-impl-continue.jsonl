{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4dd","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":201,"recorded_at":1780531400000397,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347d2d875029253374862a34df0","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/use-narration.ts`.\n1|// Read-aloud controller: one dedicated audio element per reader mount,\n2|// per-chapter manifests fetched lazily, duck signal for the music\n3|// player. The element lives in the layout-level provider, so sub-page\n4|// and scene navigation never interrupt playback.\n5|\"use client\";\n6|\n7|import { useCallback, useEffect, useRef, useState } from \"react\";\n8|import { parseChapterNarration, sceneSpan, type ChapterNarration } from \"@/core/narration\";\n9|import {\n10|  NARRATION_DUCK_DOWN_MS,\n11|  NARRATION_DUCK_LEVEL,\n12|  NARRATION_DUCK_UP_MS,\n13|  rampDuck,\n14|} from \"./duck\";\n15|import { DEFAULT_NARRATION_PREFS, loadNarrationPrefs, saveNarrationPrefs } from \"./prefs\";\n16|import type { NarrationChapterEntry, NarrationPrefs, NarrationStatus } from \"./types\";\n17|\n18|export interface NarrationSceneRef {\n19|  sceneId: string;\n20|  ch: number;\n21|  startN: number;\n22|  endN: number;\n23|}\n24|\n25|function sameScene(a: NarrationSceneRef | null, b: NarrationSceneRef): boolean {\n26|  return a !== null && a.sceneId === b.sceneId && a.ch === b.ch && a.startN === b.startN && a.endN === b.endN;\n27|}\n28|\n29|export function useNarrationController(opts: {\n30|  entries: NarrationChapterEntry[];\n31|  sceneOrder: string[];\n32|  onAdvanceScene: (nextSceneId: string) => void;\n33|}) {\n34|  const [prefs, setPrefs] = useState<NarrationPrefs>(DEFAULT_NARRATION_PREFS);\n35|  const [status, setStatus] = useState<NarrationStatus>(\"idle\");\n36|  const [playing, setPlaying] = useState(false);\n37|  const [duck, setDuck] = useState(1);\n38|  const [scene, setScene] = useState<NarrationSceneRef | null>(null);\n39|  const [manifest, setManifest] = useState<ChapterNarration | null>(null);\n40|\n41|  const audioRef = useRef<HTMLAudioElement | null>(null);\n42|  const cacheRef = useRef(new Map<number, ChapterNarration>());\n43|  const advanceRef = useRef(opts.onAdvanceScene);\n44|  advanceRef.current = opts.onAdvanceScene;\n45|  const entriesRef = useRef(opts.entries);\n46|  entriesRef.current = opts.entries;\n47|  const orderRef = useRef(opts.sceneOrder);\n48|  orderRef.current = opts.sceneOrder;\n49|  const sceneRef = useRef(scene);\n50|  sceneRef.current = scene;\n51|  const prefsRef = useRef(prefs);\n52|  prefsRef.current = prefs;\n53|  const loadToken = useRef(0);\n54|  const wantPlay = useRef(false);\n55|  const duckRef = useRef(1);\n56|  const pendingSeek = useRef<number | null>(null);\n57|  const advancingRef = useRef(false);\n58|\n59|  // Stored prefs apply after the server-matching first render.\n60|  useEffect(() => {\n61|    try {\n62|      setPrefs(loadNarrationPrefs(window.localStorage));\n63|    } catch {\n64|      // Defaults already render; playback starts on user press.\n65|    }\n66|  }, []);\n67|\n68|  function persist(next: NarrationPrefs) {\n69|    setPrefs(next);\n70|    try {\n71|      saveNarrationPrefs(window.localStorage, next);\n72|    } catch {\n73|      // Private mode: playback continues without persistence.\n74|    }\n75|  }\n76|\n77|  // Current chapter manifest: cache hit or a lazy fetch, parsed at the\n78|  // trust boundary. Chapters map to src with .mp3 replaced by .json.\n79|  useEffect(() => {\n80|    if (!prefs.on || scene === null) {\n81|      if (!prefs.on) {\n82|        setStatus(\"idle\");\n83|        setManifest(null);\n84|      }\n85|      return;\n86|    }\n87|    const cached = cacheRef.current.get(scene.ch);\n88|    if (cached) {\n89|      setManifest(cached);\n90|      setStatus(\"ready\");\n91|      return;\n92|    }\n93|    const token = (loadToken.current += 1);\n94|    setStatus(\"loading\");\n95|    setManifest(null);\n96|    const entry = entriesRef.current.find((e) => e.ch === scene.ch);\n97|    if (!entry) {\n98|      if (loadToken.current === token) {\n99|        setStatus(\"error\");\n100|        wantPlay.current = false;\n101|      }\n102|      return;\n103|    }\n104|    fetch(entry.manifest)\n105|      .then((res) => {\n106|        if (!res.ok) throw new Error(`narration ${res.status}`);\n107|        return res.json();\n108|      })\n109|      .then((json: unknown) => {\n110|        if (loadToken.current !== token) return;\n111|        const parsed = parseChapterNarration(json);\n112|        cacheRef.current.set(scene.ch, parsed);\n113|        setManifest(parsed);\n114|        setStatus(\"ready\");\n115|      })\n116|      .catch(() => {\n117|        if (loadToken.current === token) {\n118|          setStatus(\"error\");\n119|          wantPlay.current = false;\n120|        }\n121|      });\n122|  }, [prefs.on, scene]);\n123|\n124|  // Seek to the scene span, swapping chapter audio when needed. A fresh\n125|  // src seeks on loadedmetadata; a kept src seeks at once.\n126|  const seekScene = useCallback(() => {\n127|    const audio = audioRef.current;\n128|    const current = sceneRef.current;\n129|    const heard = current !== null ? cacheRef.current.get(current.ch) : undefined;\n130|    if (!audio || !current || !heard) return;\n131|    const span = sceneSpan(heard, current.startN, current.endN);\n132|    if (!span) return;\n133|    if (audio.dataset.key !== heard.key) {\n134|      pendingSeek.current = span.startSec;\n135|      audio.dataset.key = heard.key;\n136|      audio.src = heard.src;\n137|    } else {\n138|      try {\n139|        audio.currentTime = span.startSec;\n140|      } catch {\n141|        pendingSeek.current = span.startSec;\n142|      }\n143|    }\n144|  }, []);\n145|\n146|  const playCurrent = useCallback(() => {\n147|    const audio = audioRef.current;\n148|    if (!audio || sceneRef.current === null || cacheRef.current.get(sceneRef.current.ch) === undefined) {\n149|      return;\n150|    }\n151|    seekScene();\n152|    wantPlay.current = true;\n153|    void audio.play().catch(() => {\n154|      wantPlay.current = false;\n155|    });\n156|  }, [seekScene]);\n157|\n158|  // Scene moves seek at once; playback resumes when the manifest lands.\n159|  const prevSceneId = useRef<string | null>(null);\n160|  useEffect(() => {\n161|    if (scene !== null && prevSceneId.current !== scene.sceneId) {\n162|      prevSceneId.current = scene.sceneId;\n163|      advancingRef.current = false;\n164|      if (cacheRef.current.get(scene.ch) !== undefined) {\n165|        seekScene();\n166|        if (wantPlay.current && prefsRef.current.on) playCurrent();\n167|      }\n168|    }\n169|  }, [scene, manifest, seekScene, playCurrent]);\n170|\n171|  // The want-to-play flag survives the manifest fetch.\n172|  useEffect(() => {\n173|    if (status === \"ready\" && wantPlay.current && prefs.on) playCurrent();\n174|  }, [status, prefs.on, playCurrent]);\n175|\n176|  // One audio element: play/pause mirror to state, the chapter end and\n177|  // span end advance without user action, errors surface quietly.\n178|  useEffect(() => {\n179|    const audio = audioRef.current;\n180|    if (!audio) return;\n181|    const onPlay = () => setPlaying(true);\n182|    const onPause = () => setPlaying(false);\n183|    const onMeta = () => {\n184|      if (pendingSeek.current !== null) {\n185|        try {\n186|          audio.currentTime = pendingSeek.current;\n187|        } catch {\n188|          // Past the end; the watchdog advances on timeupdate.\n189|        }\n190|        pendingSeek.current = null;\n191|      }\n192|    };\n193|    const on