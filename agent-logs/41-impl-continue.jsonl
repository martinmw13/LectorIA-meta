urn \"engraving\";\n42|  }\n43|}\n44|\n45|function reducedMotion(): boolean {\n46|  try {\n47|    return !!window.matchMedia?.(\"(prefers-reduced-motion: reduce)\").matches;\n48|  } catch {\n49|    return false;\n50|  }\n51|}\n52|\n53|export function useReadSync(opts: {\n54|  enabled: boolean;\n55|  audioRef: RefObject<HTMLAudioElement | null>;\n56|  manifest: ChapterNarration | null;\n57|  span: { startSec: number; endSec: number } | null;\n58|  containerRef: RefObject<HTMLElement | null>;\n59|  scrollerRef: RefObject<HTMLElement | null>;\n60|  pages: { paragraphs: SyncFragment[] }[];\n61|  textPage: number;\n62|  onTurnPage: (textIndex: number) => void;\n63|  lastManualRef: RefObject<number | null>;\n64|}): { mark: MarkRect | null; treatment: HighlightTreatment } {\n65|  const [treatment] = useState<HighlightTreatment>(skinTreatment);\n66|  const [mark, setMark] = useState<MarkRect | null>(null);\n67|  const [active, setActive] = useState<ActiveSpot | null>(null);\n68|\n69|  const live = useRef(opts);\n70|  live.current = opts;\n71|\n72|  // The follow loop: audio time in, chunk/word out, one auto-turn gate.\n73|  useEffect(() => {\n74|    const { enabled, audioRef, manifest, span } = live.current;\n75|    if (!enabled || !manifest) {\n76|      setActive(null);\n77|      return;\n78|    }\n79|    let raf = 0;\n80|    const tick = () => {\n81|      raf = requestAnimationFrame(tick);\n82|      const audio = audioRef.current;\n83|      if (!audio || audio.paused) return;\n84|      const t = audio.currentTime;\n85|      if (span !== null && (t < span.startSec - 0.3 || t > span.endSec + 2)) return;\n86|      const ci = activeChunkAt(manifest.chunks, t);\n87|      if (ci < 0) {\n88|        setActive((prev) => (prev === null ? prev : null));\n89|        return;\n90|      }\n91|      const chunk = manifest.chunks[ci] as ChapterNarration[\"chunks\"][number];\n92|      const wi = activeWordAt(chunk, t);\n93|      setActive((prev) => (prev !== null && prev.chunk === ci && prev.word === wi ? prev : { chunk: ci, word: wi }));\n94|      const { pages, textPage, onTurnPage, lastManualRef } = live.current;\n95|      const at = pages.findIndex((pg) => pg.paragraphs.some((p) => p.n === chunk.n));\n96|      if (at >= 0 && at !== textPage && shouldAutoTurn(lastManualRef.current, performance.now())) {\n97|        onTurnPage(at);\n98|      }\n99|    };\n100|    raf = requestAnimationFrame(tick);\n101|    return () => cancelAnimationFrame(raf);\n102|  }, [opts.enabled, opts.manifest]);\n103|\n104|  // Measure the active word against the fragment DOM and paint the\n105|  // sentence tint through the Highlight API (no-op where unsupported).\n106|  useLayoutEffect(() => {\n107|    const { containerRef, scrollerRef, manifest } = live.current;\n108|    const container = containerRef.current;\n109|    clearSentence();\n110|    if (!container || !manifest || active === null) {\n111|      setMark(null);\n112|      return;\n113|    }\n114|    const chunk = manifest.chunks[active.chunk];\n115|    if (!chunk) {\n116|      setMark(null);\n117|      return;\n118|    }\n119|    const { word: wordRange, wordText, sentence } = rangesForChunk(container, chunk, active.word);\n120|    paintSentence(sentence);\n121|    if (!wordRange) {\n122|      setMark(null);\n123|      return;\n124|    }\n125|    const rects = (wordRange as Range).getClientRects();\n126|    if (rects.length === 0) {\n127|      setMark(null);\n128|      return;\n129|    }\n130|    let left = Infinity;\n131|    let top = Infinity;\n132|    let right = -Infinity;\n133|    let bottom = -Infinity;\n134|    for (const r of rects) {\n135|      left = Math.min(left, r.left);\n136|      top = Math.min(top, r.top);\n137|      right = Math.max(right, r.right);\n138|      bottom = Math.max(bottom, r.bottom);\n139|    }\n140|    const box = container.getBoundingClientRect();\n141|    let padX = 0;\n142|    let padY = 0;\n143|    if (treatment === \"ink-doodle\") {\n144|      padX = 6;\n145|      padY = 3;\n146|    } else if (treatment === \"watercolor\") {\n147|      padX = 3;\n148|    }\n149|    setMark({\n150|      left: left - box.left - padX,\n151|      top: top - box.top - padY,\n152|      width: right - left + padX * 2,\n153|      height: bottom - top + padY * 2,\n154|      word: wordText,\n155|    });\n156|    const scroller = scrollerRef.current;\n157|    if (scroller && rects[0]) {\n158|      const view = scroller.getBoundingClientRect();\n159|      const first = rects[0];\n160|      const margin = 8;\n161|      if (first.top < view.top + margin || first.bottom > view.bottom - margin) {\n162|        try {\n163|          scroller.scrollTo({\n164|            top: scroller.scrollTop + (first.top - view.top) - view.height * 0.3,\n165|            behavior: reducedMotion() ? \"auto\" : \"smooth\",\n166|          });\n167|        } catch {\n168|          // The column keeps native scroll; the mark follows anyway.\n169|        }\n170|      }\n171|    }\n172|  }, [active, opts.manifest, treatment]);\n173|\n174|  // Click a word to seek there, only while narration runs.\n175|  useEffect(() => {\n176|    const { enabled, containerRef, audioRef } = live.current;\n177|    const container = containerRef.current;\n178|    if (!enabled || !container) return;\n179|    const onClick = (event: MouseEvent) => {\n180|      const audio = audioRef.current;\n181|      const heard = live.current.manifest;\n182|      if (!audio || !heard) return;\n183|      const doc = container.ownerDocument;\n184|      const atPoint = doc.caretRangeFromPoint?.bind(doc);\n185|      const range = atPoint ? atPoint(event.clientX, event.clientY) : null;\n186|      if (!range || range.startContainer.nodeType !== 3) return;\n187|      const p = (range.startContainer.parentElement as Element | null)?.closest?.(\"p[data-n]\");\n188|      if (!p || !container.contains(p)) return;\n189|      const n = Number(p.getAttribute(\"data-n\"));\n190|      const from = Number(p.getAttribute(\"data-from\") ?? 0);\n191|      if (!Number.isInteger(n)) return;\n192|      const hit = wordAt({ chunks: heard.chunks }, n, from + range.startOffset);\n193|      if (hit) {\n194|        try {\n195|          audio.currentTime = hit.t0 + 0.001;\n196|        } catch {\n197|          // Past the end; the watchdog advances on timeupdate.\n198|        }\n199|      }\n200|    };\n201|    container.addEventListener(\"click\", onClick);\n202|    return () => container.removeEventListener(\"click\", onClick);\n203|  }, [opts.enabled, opts.manifest]);\n204|\n205|  return { mark, treatment };\n206|}\n207|\n208|// Sentence tint helpers: the CSS Custom Highlight API with a no-op\n209|// fallback where unsupported.\n210|function clearSentence() {\n211|  try {\n212|    const css = CSS as unknown as { highlights?: { delete(name: string): void } };\n213|    css.highlights?.delete(SENTENCE_HIGHLIGHT);\n214|  } catch {\n215|    // Unsupported browsers simply skip the tint.\n216|  }\n217|}\n218|\n219|function paintSentence(ranges: Range[]) {\n220|  try {\n221|    const css = CSS as unknown as { highlights?: { set(name: string, highlight: unknown): void } };\n222|    const Ctor = (globalThis as unknown as { Highlight?: new (...ranges: Range[]) => unknown }).Highlight;\n223|    if (css.highlights && Ctor && ranges.length > 0) {\n224|      css.highlights.set(SENTENCE_HIGHLIGHT, new Ctor(...ranges));\n225|    }\n226|  } catch {\n227|    // Unsupported browsers simply skip the tint.\n228|  }\n229|}\n230|\n231|export function ReadMark({ mark, treatment }: { mark: MarkRect | null; treatment: HighlightTreatment }) {\n232|  if (!mark) return null;\n233|  const style = { left: mark.left, top: mark.top, width: mark.width, height: mark.height };\n234|  if (treatment === \"ink-doodle\") {\n235|    return (\n236|      <span className=\"narr-mark\" data-treatment=\"ink-doodle\" style={style} aria-hidden=\"true\">\n237|        <Icon name=\"ink-circle\" preserveAspectRatio=\"none\" />\n238|      </span>\n239|    );\n240|  }\n241|  if (treatment === \"watercolor\") {\n242|    return <span className=\"narr-mark\" data-treatment=\"watercolor\" style={style} aria-hidden=\"true\" />;\n243|  }\n244|  return (\n245|    <span className=\"narr-mark\" data-treatment=\"engraving\" style={style} aria-hidden=\"true\">\n246|      <span className=\"narr-word\">{mark.word}</span>\n247|    </span>\n248|  );\n249|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e5","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":205,"recorded_at":1780531400000405,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347d9c2752d83c919397d3eaf1b","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/ranges.ts`.\n1|// DOM range mapping for read-along highlight: word timings are\n2|// paragraph-relative, while the page renders fragments cut by\n3|// paginateScene. Cut points land on spaces, so a word never straddles\n4|// fragments; each fragment carries its start in data-from. Pure DOM in,\n5|// ranges out; measuring and painting stay with the caller so this is\n6|// unit-testable under jsdom.\n7|import type { ChapterNarration } from \"@/core/narration\";\n8|\n9|type Chunk = ChapterNarration[\"chunks\"][number];\n10|\n11|export interface SpotRanges {\n12|  word: Range | null;\n13|  wordText: string;\n14|  sentence: Range[];\n15|}\n16|\n17|function firstTextChild(p: Element): Text | null {\n18|  for (const node of p.childNodes) {\n19|    if (node.nodeType === 3) return node as Text;\n20|  }\n21|  return null;\n22|}\n23|\n24|export function rangesForChunk(container: HTMLElement, chunk: Chunk, wordIdx: number): SpotRanges {\n25|  const nodes = [...container.querySelectorAll(`p[data-n=\"${chunk.n}\"]`)];\n26|  const sentence: Range[] = [];\n27|  let word: Range | null = null;\n28|  let wordText = \"\";\n29|  for (const p of nodes) {\n30|    const text = firstTextChild(p);\n31|    if (!text) continue;\n32|    const from = Number(p.getAttribute(\"data-from\") ?? 0);\n33|    const fragStart = Math.max(chunk.start, from);\n34|    const fragEnd = Math.min(chunk.end, from + text.length);\n35|    if (fragEnd > fragStart) {\n36|      try {\n37|        const r = document.createRange();\n38|        r.setStart(text, fragStart - from);\n39|        r.setEnd(text, fragEnd - from);\n40|        sentence.push(r);\n41|      } catch {\n42|        // A split text node keeps the sentence tint partial.\n43|      }\n44|    }\n45|    // The active word is a chunk-global index; this fragment holds it\n46|    // when its paragraph-relative start sits inside the fragment.\n47|    const abs = wordIdx >= 0 ? (chunk.w[wordIdx * 4] as number | undefined) : undefined;\n48|    if (word === null && abs !== undefined && abs >= from && abs < from + text.length) {\n49|      const end = chunk.w[wordIdx * 4 + 1] as number;\n50|      try {\n51|        const r = document.createRange();\n52|        r.setStart(text, abs - from);\n53|        r.setEnd(text, Math.min(end - from, text.length));\n54|        word = r;\n55|        wordText = r.toString();\n56|      } catch {\n57|        word = null;\n58|      }\n59|    }\n60|  }\n61|  return { word, wordText, sentence };\n62|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e7","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":206,"recorded_at":1780531400000407,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347dbc170d1b772138c576bfb02","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `server/narration.ts`.\n1|import \"server-only\";\n2|import { readFileSync } from \"node:fs\";\n3|import { join } from \"node:path\";\n4|import type { NarrationChapterEntry } from \"../app/narration/types\";\n5|\n6|// Small chapter map for the reader shell: each chapter's audio src and\n7|// its manifest URL (src with .mp3 replaced by .json). The 1 MB Oz index\n8|// never reaches the client; only this list of chapters ships.\n9|export function loadNarrationEntries(): NarrationChapterEntry[] {\n10|  const raw = readFileSync(join(process.cwd(), \"data/books/oz/narration.json\"), \"utf8\");\n11|  const json = JSON.parse(raw) as { chapters?: Record<string, { src?: string }> };\n12|  const chapters = json.chapters ?? {};\n13|  return Object.keys(chapters)\n14|    .map(Number)\n15|    .filter((ch) => Number.isInteger(ch))\n16|    .sort((a, b) => a - b)\n17|    .flatMap((ch) => {\n18|      const src = chapters[String(ch)]?.src;\n19|      if (typeof src !== \"string\" || !src.endsWith(\".mp3\")) return [];\n20|      return [{ ch, src, manifest: src.slice(0, -4) + \".json\" }];\n21|    });\n22|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e9","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":207,"recorded_at":1780531400000409,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347dd6a72c5b5f62045e718e20f","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/styles/narration.css`.\n1|/* Read-aloud control and read-along word mark. All colours come from\n2|   narration tokens; geometry keys off the treatment attribute. */\n3|\n4|.read-aloud {\n5|  display: flex;\n6|  align-items: center;\n7|  gap: 8px;\n8|  min-width: 0;\n9|  font-family: var(--font-ui);\n10|  font-size: 13px;\n11|}\n12|\n13|.read-aloud-btn {\n14|  display: inline-flex;\n15|  align-items: center;\n16|  gap: 7px;\n17|  height: 34px;\n18|  padding: 0 12px;\n19|  border: 1px solid var(--color-text);\n20|  border-radius: 6px;\n21|  background: var(--color-surface);\n22|  color: var(--color-text);\n23|  cursor: pointer;\n24|  flex: none;\n25|}\n26|\n27|.read-aloud-btn:hover {\n28|  border-color: var(--color-accent);\n29|  color: var(--color-accent);\n30|}\n31|\n32|.read-aloud-btn svg {\n33|  stroke: currentColor;\n34|  fill: none;\n35|  stroke-width: 1.5;\n36|  stroke-linecap: round;\n37|  stroke-linejoin: round;\n38|}\n39|\n40|.read-aloud-btn:focus-visible,\n41|.read-aloud-volume input:focus-visible {\n42|  outline: 2px solid var(--color-accent);\n43|  outline-offset: 2px;\n44|}\n45|\n46|.read-aloud-label {\n47|  font-size: 13px;\n48|  letter-spacing: 0.02em;\n49|  white-space: nowrap;\n50|}\n51|\n52|.read-aloud-volume {\n53|  display: inline-flex;\n54|  align-items: center;\n55|  flex: none;\n56|}\n57|\n58|.read-aloud-volume input {\n59|  width: 64px;\n60|  accent-color: var(--color-accent);\n61|  cursor: pointer;\n62|}\n63|\n64|.read-aloud-note {\n65|  margin: 0;\n66|  font-size: 12.5px;\n67|  color: var(--color-text-muted);\n68|  white-space: nowrap;\n69|}\n70|\n71|/* Word mark: an absolutely positioned overlay that never touches flow,\n72|// so pagination never reflows under the highlight. */\n73|.narr-mark {\n74|  position: absolute;\n75|  pointer-events: none;\n76|  z-index: 3;\n77|  transition:\n78|    left 120ms ease-out,\n79|    top 120ms ease-out,\n80|    width 120ms ease-out,\n81|    height 120ms ease-out;\n82|}\n83|\n84|.narr-mark[data-treatment=\"engraving\"] .narr-word {\n85|  display: flex;\n86|  align-items: center;\n87|  width: 100%;\n88|  height: 100%;\n89|  overflow: hidden;\n90|  white-space: nowrap;\n91|  font-variant: small-caps;\n92|  letter-spacing: 0.04em;\n93|  font-weight: 600;\n94|  background: var(--narration-mark);\n95|  color: var(--color-text);\n96|}\n97|\n98|.narr-mark[data-treatment=\"engraving\"]::after {\n99|  content: \"\";\n100|  position: absolute;\n101|  left: 0;\n102|  right: 0;\n103|  bottom: -2px;\n104|  height: 1px;\n105|  background: var(--narration-rule);\n106|}\n107|\n108|.narr-mark[data-treatment=\"watercolor\"] {\n109|  background: var(--narration-mark);\n110|  border-radius: 40% 60% 52% 48% / 50% 46% 54% 50%;\n111|  box-shadow:\n112|    inset 0 0 0 1.5px var(--narration-mark-edge),\n113|    0 0 6px var(--narration-glow);\n114|  filter: blur(0.4px);\n115|}\n116|\n117|.narr-mark[data-treatment=\"ink-doodle\"] svg {\n118|  display: block;\n119|  width: 100%;\n120|  height: 100%;\n121|  overflow: visible;\n122|  fill: none;\n123|  stroke: var(--narration-mark);\n124|  stroke-width: 1.8;\n125|  stroke-linecap: round;\n126|}\n127|\n128|::highlight(narration-sentence) {\n129|  background: var(--narration-sentence);\n130|}\n131|\n132|@media (prefers-reduced-motion: reduce) {\n133|  .narr-mark {\n134|    transition: none;\n135|  }\n136|}"}}
