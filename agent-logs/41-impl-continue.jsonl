rc, manifest} map.\\n export default function LeerLayout({ children }: { children: React.ReactNode }) {\\n   const { book, scenes } = loadOzBook();\\n   const model = buildReaderModel(book, { scenes });\\n   const slim = model.chapters.flatMap((chapter) =>\\n-    chapter.scenes.map((scene) => ({ id: scene.id, ch: chapter.ch, emotion: scene.emotion })),\\n+    chapter.scenes.map((scene) => {\\n+      const paras = scene.paragraphs;\\n+      return {\\n+        id: scene.id,\\n+        ch: chapter.ch,\\n+        startN: paras[0]?.n ?? 0,\\n+        endN: paras[paras.length - 1]?.n ?? 0,\\n+        emotion: scene.emotion,\\n+      };\\n+    }),\\n   );\\n   const chapters = model.chapters.map((chapter) => ({\\n     ch: chapter.ch,\\n     title: chapter.title,\\n     firstSceneId: chapter.scenes[0]?.id ?? \\\"\\\",\\n   }));\\n+  const narration = loadNarrationEntries();\\n   return (\\n-    <Reader scenes={slim} chapters={chapters} bookTitle={model.title} bookAuthor={model.author}>\\n+    <Reader scenes={slim} chapters={chapters} bookTitle={model.title} bookAuthor={model.author} narration={narration}>\\n       {children}\\n     </Reader>\\n   );\\ndiff --git a/app/leer/scene-page.tsx b/app/leer/scene-page.tsx\\nindex b8d8490..1ce6eb3 100644\\n--- a/app/leer/scene-page.tsx\\n+++ b/app/leer/scene-page.tsx\\n@@ -4,13 +4,15 @@\\n // they never touch music state.\\n \\\"use client\\\";\\n \\n-import { Fragment, useEffect, useMemo, useRef, useState } from \\\"react\\\";\\n+import { Fragment, useCallback, useEffect, useMemo, useRef, useState } from \\\"react\\\";\\n import { useRouter } from \\\"next/navigation\\\";\\n import { buildNavIndex, navReducer, subPageCount, subPageKind, textPageAt } from \\\"@/core/reader\\\";\\n import type { NavAction, SceneView } from \\\"@/core/reader\\\";\\n import { loadImageStylePref, saveImageStylePref } from \\\"../image-style\\\";\\n import type { ImageStylePref } from \\\"../image-style\\\";\\n import { BandPager, Divider } from \\\"../folio/chrome\\\";\\n+import { useNarration } from \\\"../narration/context\\\";\\n+import { ReadMark, useReadSync } from \\\"../narration/read-sync\\\";\\n import { figuresAfter, groupFiguresByEndN, pageOfOrdinal } from \\\"../folio/figure-placement\\\";\\n import { ImagePane } from \\\"../folio/image-pane\\\";\\n import { InlineFigureView, SelectionPopover } from \\\"../folio/inline-figures\\\";\\n@@ -118,7 +120,28 @@ export function ScenePage({\\n   const gateOpener = useRef<HTMLElement | null>(null);\\n   const headingRef = useRef<HTMLHeadingElement>(null);\\n   const readColRef = useRef<HTMLDivElement | null>(null);\\n+  const bodyTextRef = useRef<HTMLDivElement | null>(null);\\n   const figEls = useRef(new Map<string, HTMLElement>());\\n+  // Last hand navigation, for the auto-turn gate: the voice keeps\\n+  // reading but never yanks the page within ~8 s of a manual move.\\n+  const lastManualRef = useRef<number | null>(null);\\n+  const narration = useNarration();\\n+  const sceneStartN = view.pages[0]?.startN ?? 0;\\n+  const sceneEndN = view.pages[view.pages.length - 1]?.endN ?? 0;\\n+\\n+  useEffect(() => {\\n+    narration.registerScene({ sceneId: view.sceneId, ch: view.ch, startN: sceneStartN, endN: sceneEndN });\\n+  }, [narration, view.sceneId, view.ch, sceneStartN, sceneEndN]);\\n+\\n+  // One node serves both the picture popover and the read-along mark.\\n+  const viewRef = pic.viewRef;\\n+  const setBodyText = useCallback(\\n+    (node: HTMLDivElement | null) => {\\n+      bodyTextRef.current = node;\\n+      viewRef(node);\\n+    },\\n+    [viewRef],\\n+  );\\n   const kind = subPageKind(page, view.pages.length, cover, end);\\n   const sub = kind === \\\"text\\\" ? (view.pages[textPageAt(page, cover)] ?? view.pages[0]) : undefined;\\n   const textIndex = textPageAt(page, cover);\\n@@ -184,6 +207,7 @@ export function ScenePage({\\n   const figsByN = useMemo(() => groupFiguresByEndN(pic.figures), [pic.figures]);\\n \\n   function gotoFigure(fig: InlineFigure) {\\n+    lastManualRef.current = Date.now();\\n     const at = pageOfOrdinal(view.pages, fig.endN);\\n     if (at < 0) return;\\n     setPage(at + (cover ? 1 : 0));\\n@@ -206,6 +230,7 @@ export function ScenePage({\\n   // route push, a same-scene result means a client sub-page move.\\n   function move(action: NavAction) {\\n     pic.hidePopover();\\n+    lastManualRef.current = Date.now();\\n     const next = navReducer({ sceneId: view.sceneId, page }, action, index);\\n     if (next.sceneId !== view.sceneId) {\\n       hasNavigated = true;\\n@@ -227,6 +252,25 @@ export function ScenePage({\\n     move({ kind: \\\"prev\\\" });\\n   }\\n \\n+  // Read-along follow: the voice turns the sub-page on its own. This\\n+  // path never stamps a manual move, so the gate lets it through.\\n+  const syncEnabled = narration.on && narration.manifest !== null && kind === \\\"text\\\";\\n+  const { mark, treatment } = useReadSync({\\n+    enabled: syncEnabled,\\n+    audioRef: narration.audioRef,\\n+    manifest: narration.manifest,\\n+    span: narration.span,\\n+    containerRef: bodyTextRef,\\n+    scrollerRef: readColRef,\\n+    pages: view.pages,\\n+    textPage: textIndex,\\n+    onTurnPage: (textIndex) => {\\n+      setPage(textIndex + (cover ? 1 : 0));\\n+      readColRef.current?.scrollTo(0, 0);\\n+    },\\n+    lastManualRef,\\n+  });\\n+\\n   // Scene entry resets orientation; sub-page moves keep the heading.\\n   useEffect(() => {\\n     if (hasNavigated) headingRef.current?.focus();\\n@@ -386,10 +430,11 @@ export function ScenePage({\\n                 {view.pages.length > 1 ? ` · Page ${textIndex + 1} of ${view.pages.length}` : \\\"\\\"}\\n               </span>\\n             </div>\\n-            <div className={`body-text${textIndex === 0 ? \\\" dropcap\\\" : \\\"\\\"}`} ref={pic.viewRef}>\\n+            <div className={`body-text${textIndex === 0 ? \\\" dropcap\\\" : \\\"\\\"}`} ref={setBodyText}>\\n+              <ReadMark mark={syncEnabled ? mark : null} treatment={treatment} />\\n               {sub?.paragraphs.map((p, i, arr) => (\\n                 <Fragment key={p.id}>\\n-                  <p id={p.id} data-n={p.n} data-cont={p.cont ? true : undefined}>\\n+                  <p id={p.id} data-n={p.n} data-cont={p.cont ? true : undefined} data-from={p.from ?? 0}>\\n                     {p.text}\\n                   </p>\\n                   {/* A figure for n lands after its last visible fragment. */}\\ndiff --git a/app/player.tsx b/app/player.tsx\\nindex 8c43419..68c3c05 100644\\n--- a/app/player.tsx\\n+++ b/app/player.tsx\\n@@ -30,6 +30,7 @@ export function Player({\\n   onAdvance,\\n   onEnded,\\n   playlistOn,\\n+  duck = 1,\\n }: {\\n   track: Track | null;\\n   replayNonce: number;\\n@@ -47,6 +48,9 @@ export function Player({\\n   onAdvance: (to?: MusicModeId) => void;\\n   onEnded: (trackId: string) => void;\\n   playlistOn: boolean;\\n+  // Read-aloud duck multiplier: 1 normally, about -18 dB while the\\n+  // voice plays. The rain layer is separate and never ducked.\\n+  duck?: number;\\n }) {\\n   const firstRef = useRef<HTMLAudioElement | null>(null);\\n   const secondRef = useRef<HTMLAudioElement | null>(null);\\n@@ -60,6 +64,8 @@ export function Player({\\n   volumeRef.current = volume;\\n   const mutedRef = useRef(muted);\\n   mutedRef.current = muted;\\n+  const duckRef = useRef(duck);\\n+  duckRef.current = duck;\\n   const fadeRef = useRef<number | null>(null);\\n   const loopArmedRef = useRef<string | null>(null);\\n   const trackRef = useRef<Track | null>(track);\\n@@ -100,7 +106,7 @@ export function Player({\\n     els.forEach((el, i) => {\\n       if (el)\\n         el.volume = gainVolume(\\n-          levelRef.current[i] ?? 0,\\n+          (levelRef.current[i] ?? 0) * duckRef.current,\\n           audible,\\n           gainRef.current[i] ?? 0,\\n         );\\n@@ -203,6 +209,11 @@ export function Player({\\n \\n   useEffect(() => cancelFade, []);\\n \\n+  // Duck moves outside the fade engine, so re-apply on every step.\\n+  useEffect(() => {\\n+    applyLevels();\\n+  }, [duck]);\\n+\\n   function handleTimeUpdate(index: number, el: HTMLAudioElement) {\\n     const next = trackRef.current;\\n     if (!next || index !== audibleRef.current) return;\\ndiff --git a/app/reader.tsx b/app/reader.tsx\\nindex a0052f1..13c4620 100644\\n--- a/app/reader.tsx\\n+++ b/app/reader.tsx\\n@@ -3,12 +3,15 @@\\n import { useCallback, useEffect, useMemo, useRef, useState } from \\\"react\\\";\\n import { useParams, useRouter } from \\\"next/navigation\\\";\\n import { currentMode, musicModes, parseManifest } from \\\"@/core/music\\\";\\n-import type { MusicManifest, MusicModeId, SceneSignal } from \\\"@/core/music\\\";\\n+import type { MusicManifest, MusicMode, MusicModeId, SceneSignal, Track } from \\\"@/core/music\\\";\\n import { EMOTIONS } from \\\"@/core/types\\\";\\n import { dispatch, startSession } from \\\"@/core/music-session\\\";\\n import type { MusicIntent, MusicSession, SessionView } from \\\"@/core/music-session\\\";\\n import { nextSceneEntry } from \\\"@/core/reader\\\";\\n import { DEFAULT_VOLUME, createMusicPrefsStore } from \\\"./music-prefs\\\";\\n+import { NarrationProvider, useNarration } from \\\"./narration/context\\\";\\n+import { ReadAloud } from \\\"./narration/read-aloud\\\";\\n+import type { NarrationChapterEntry } from \\\"./narration/types\\\";\\n import { Player } from \\\"./player\\\";\\n import { THEME_KEY, TopLine } from \\\"./folio/chrome\\\";\\n import { initialTheme } from \\\"./theme\\\";\\n@@ -17,6 +20,8 @@ import { DevPanel } from \\\"./folio/dev-panel\\\";\\n export interface SlimScene {\\n   id: string;\\n   ch: number;\\n+  startN: number;\\n+  endN: number;\\n   emotion: SceneSignal | null;\\n }\\n \\n@@ -41,17 +46,91 @@ const DEV_LABELS: Record<(typeof EMOTIONS)[number], string> = {\\n // music on scene entry only, from the route id. Sub-page moves never\\n // reach the session. Params can lag a render, so the last observed id\\n // is compared before every scene entry.\\n+// Band contents run inside the narration provider so the music duck\\n+// and the read-aloud control share the controller.\\n+function BandPlay({\\n+  musicFailed,\\n+  empty,\\n+  track,\\n+  replayNonce,\\n+  fadeSec,\\n+  canPrev,\\n+  onPrev,\\n+  canSkip,\\n+  onSkip,\\n+  volume,\\n+  muted,\\n+  onVolumeChange,\\n+  onMutedChange,\\n+  modes,\\n+  current,\\n+  onAdvance,\\n+  onEnded,\\n+  playlistOn,\\n+}: {\\n+  musicFailed: boolean;\\n+  empty: boolean;\\n+  track: Track | null;\\n+  replayNonce: number;\\n+  fadeSec: number;\\n+  canPrev: boolean;\\n+  onPrev: () => void;\\n+  canSkip: boolean;\\n+  onSkip: () => void;\\n+  volume: number;\\n+  muted: boolean;\\n+  onVolumeChange: (volume: number) => void;\\n+  onMutedChange: (muted: boolean) => void;\\n+  modes: MusicMode[];\\n+  current: MusicModeId | null;\\n+  onAdvance: (to?: MusicModeId) => void;\\n+  onEnded: (trackId: string) => void;\\n+  playlistOn: boolean;\\n+}) {\\n+  const { duck } = useNarration();\\n+  return (\\n+    <div className=\\\"band-play\\\">\\n+      <ReadAloud />\\n+      {musicFailed || empty ? (\\n+        <p className=\\\"player-note\\\">The music is resting. The book is all yours.</p>\\n+      ) : (\\n+        <Player\\n+          track={track}\\n+          replayNonce={replayNonce}\\n+          fadeSec={fadeSec}\\n+          canPrev={canPrev}\\n+          onPrev={onPrev}\\n+          canSkip={canSkip}\\n+          onSkip={onSkip}\\n+          volume={volume}\\n+          muted={muted}\\n+          onVolumeChange={onVolumeChange}\\n+          onMutedChange={onMutedChange}\\n+          modes={modes}\\n+          current={current}\\n+          onAdvance={onAdvance}\\n+          onEnded={onEnded}\\n+          playlistOn={playlistOn}\\n+          duck={duck}\\n+        />\\n+      )}\\n+    </div>\\n+  );\\n+}\\n+\\n export function Reader({\\n   scenes,\\n   chapters,\\n   bookTitle,\\n   bookAuthor,\\n+  narration,\\n   child