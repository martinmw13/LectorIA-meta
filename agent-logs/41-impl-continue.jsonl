{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57d","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":281,"recorded_at":1780531400000557,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347e796732cbfe5ae02d88ceedf","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/prefs.ts`.\n1|// Persisted read-aloud prefs: on/off plus a narration-only volume.\n2|// Storage can throw (private mode), so every access is guarded.\n3|import type { NarrationPrefs } from \"./types\";\n4|\n5|export const NARRATION_PREFS_KEY = \"lectoria.narration.v1\";\n6|\n7|export const DEFAULT_NARRATION_VOLUME = 0.8;\n8|\n9|export const DEFAULT_NARRATION_PREFS: NarrationPrefs = { on: false, volume: DEFAULT_NARRATION_VOLUME };\n10|\n11|type PrefsStorage = Pick<Storage, \"getItem\" | \"setItem\">;\n12|\n13|function validVolume(value: unknown): number | null {\n14|  return typeof value === \"number\" && Number.isFinite(value) && value >= 0 && value <= 1 ? value : null;\n15|}\n16|\n17|export function loadNarrationPrefs(storage?: PrefsStorage): NarrationPrefs {\n18|  try {\n19|    const raw = storage?.getItem(NARRATION_PREFS_KEY);\n20|    if (!raw) return { ...DEFAULT_NARRATION_PREFS };\n21|    const json: unknown = JSON.parse(raw);\n22|    if (typeof json !== \"object\" || json === null) return { ...DEFAULT_NARRATION_PREFS };\n23|    const { on, volume } = json as Record<string, unknown>;\n24|    return {\n25|      on: typeof on === \"boolean\" ? on : false,\n26|      volume: validVolume(volume) ?? DEFAULT_NARRATION_VOLUME,\n27|    };\n28|  } catch {\n29|    return { ...DEFAULT_NARRATION_PREFS };\n30|  }\n31|}\n32|\n33|export function saveNarrationPrefs(storage: PrefsStorage | undefined, prefs: NarrationPrefs): void {\n34|  try {\n35|    storage?.setItem(NARRATION_PREFS_KEY, JSON.stringify(prefs));\n36|  } catch {\n37|    // Private mode: playback continues without persistence.\n38|  }\n39|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57f","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":282,"recorded_at":1780531400000559,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347e97073a6b78fdd4e165afe01","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/highlight-style.ts`.\n1|// Word-mark treatment per skin. Only the three decided treatments\n2|// exist; today's \"default\" skin and anything unknown use engraving.\n3|export type HighlightTreatment = \"engraving\" | \"watercolor\" | \"ink-doodle\";\n4|\n5|export function highlightStyleFor(skin: string): HighlightTreatment {\n6|  if (skin === \"watercolor\") return \"watercolor\";\n7|  if (skin === \"ink-doodle\") return \"ink-doodle\";\n8|  return \"engraving\";\n9|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c581","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":283,"recorded_at":1780531400000561,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347eb397579893a42f3b854d081","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/turn.ts`.\n1|// Auto page-turn gate: the voice follows the text across sub-pages and\n2|// scenes on its own, unless the reader just moved by hand. A recent\n3|// manual move means the voice keeps reading without yanking the page.\n4|export const NARRATION_MANUAL_WINDOW_MS = 8000;\n5|\n6|export function shouldAutoTurn(\n7|  lastManualAtMs: number | null,\n8|  nowMs: number,\n9|  windowMs: number = NARRATION_MANUAL_WINDOW_MS,\n10|): boolean {\n11|  if (lastManualAtMs === null) return true;\n12|  return nowMs - lastManualAtMs >= windowMs;\n13|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347ed2f73209a969d0999b47613","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/word-map.ts`.\n1|// Word timings are paragraph-relative char offsets (flat [start, end,\n2|// t0, t1, ...] from the manifest), while the page renders fragments cut\n3|// by paginateScene. This maps one fragment's slice of the timings into\n4|// fragment-relative ranges for DOM Range building. Cuts land on spaces,\n5|// so words never straddle fragments; offsets clip defensively.\n6|export interface FragmentWord {\n7|  start: number;\n8|  end: number;\n9|  t0: number;\n10|  t1: number;\n11|}\n12|\n13|export function wordsInFragment(w: number[], from: number, fragLen: number): FragmentWord[] {\n14|  const out: FragmentWord[] = [];\n15|  for (let k = 0; k + 3 < w.length; k += 4) {\n16|    const s = w[k] as number;\n17|    const e = w[k + 1] as number;\n18|    if (!(e > from && s < from + fragLen)) continue;\n19|    out.push({\n20|      start: Math.max(s, from) - from,\n21|      end: Math.min(e, from + fragLen) - from,\n22|      t0: w[k + 2] as number,\n23|      t1: w[k + 3] as number,\n24|    });\n25|  }\n26|  return out;\n27|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c585","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":285,"recorded_at":1780531400000565,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347ef0970e5b9c7b2d83ce79224","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/types.ts`.\n1|// Shared read-aloud shapes. The controller hook owns these at runtime;\n2|// ScenePage consumes them for the highlight overlay and click-to-seek.\n3|export type NarrationStatus = \"idle\" | \"loading\" | \"ready\" | \"error\";\n4|\n5|export interface NarrationChapterEntry {\n6|  ch: number;\n7|  src: string;\n8|  manifest: string;\n9|}\n10|\n11|export interface NarrationPrefs {\n12|  on: boolean;\n13|  volume: number;\n14|}"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c587","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":286,"recorded_at":1780531400000567,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347f08d7658a5267a74c7ed4327","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/ranges.test.ts`.\n1|// @vitest-environment jsdom\n2|import { describe, expect, it } from \"vitest\";\n3|import { rangesForChunk } from \"./ranges\";\n4|\n5|// “Oz’s,” didn’t run split across two fragments: the cut lands on the\n6|// space, so each word sits whole in one fragment. Punctuation and curly\n7|// quotes never highlight: the word ranges hold letters only.\n8|function container(): HTMLElement {\n9|  const el = document.createElement(\"div\");\n10|  el.innerHTML =\n11|    `<p data-n=\"3\" data-from=\"0\">“Oz’s,”</p>` + `<p data-n=\"3\" data-from=\"7\"> didn’t run</p>`;\n12|  return el;\n13|}\n14|\n15|const CHUNK = { n: 3, start: 0, end: 18, t0: 0, t1: 1.2, w: [1, 5, 0.0, 0.4, 8, 14, 0.5, 0.9, 15, 18, 1.0, 1.2] };\n16|\n17|describe(\"rangesForChunk\", () => {\n18|  it(\"maps the word index to the fragment holding it, letters only\", () => {\n19|    expect(rangesForChunk(container(), CHUNK, 0).wordText).toBe(\"Oz’s\");\n20|    expect(rangesForChunk(container(), CHUNK, 1).wordText).toBe(\"didn’t\");\n21|    expect(rangesForChunk(container(), CHUNK, 2).wordText).toBe(\"run\");\n22|  });\n23|\n24|  it(\"covers the sentence across split fragments with no gaps\", () => {\n25|    const { sentence } = rangesForChunk(container(), CHUNK, 1);\n26|    expect(sentence.map((r) => r.toString()).join(\"\")).toBe(\"“Oz’s,” didn’t run\");\n27|  });\n28|\n29|  it(\"returns no word range off the words or off the paragraph\", () => {\n30|    expect(rangesForChunk(container(), CHUNK, -1).word).toBeNull();\n31|    expect(rangesForChunk(container(), { ...CHUNK, n: 9 }, 0).word).toBeNull();\n32|  });\n33|});"}}
