{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cd","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":193,"recorded_at":1780531400000381,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `server/narration.ts`.\n1|import \"server-only\";\n2|import { readFileSync } from \"node:fs\";\n3|import { join } from \"node:path\";\n4|import type { NarrationChapterEntry } from \"../app/narration/types\";\n5|\n6|// Small chapter map for the reader shell: each chapter's audio src and\n7|// its manifest URL (src with .mp3 replaced by .json). The 1 MB Oz index\n8|// never reaches the client; only this list of chapters ships.\n9|export function loadNarrationEntries(): NarrationChapterEntry[] {\n10|  const raw = readFileSync(join(process.cwd(), \"data/books/oz/narration.json\"), \"utf8\");\n11|  const json = JSON.parse(raw) as { chapters?: Record<string, { src?: string }> };\n12|  const chapters = json.chapters ?? {};\n13|  return Object.keys(chapters)\n14|    .map(Number)\n15|    .filter((ch) => Number.isInteger(ch))\n16|    .sort((a, b) => a - b)\n17|    .flatMap((ch) => {\n18|      const src = chapters[String(ch)]?.src;\n19|      if (typeof src !== \"string\" || !src.endsWith(\".mp3\")) return [];\n20|      return [{ ch, src, manifest: src.slice(0, -4) + \".json\" }];\n21|    });\n22|}","final_result":true,"kind":"output","task_id":"01a18347-df30-7a63-8c1d-82c857a5990f"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-df30-7a63-8c1d-82c857a5990f","task_stream":{"id":"01a18347-df30-7a63-8c1d-82c857a5990f","kind":"task"}}}
