{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3fd","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":89,"recorded_at":1780531400000173,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"{\n  \"chunk_id\": \"exec-2-1\",\n  \"command\": \"git diff -- app/reader.tsx app/player.tsx app/globals.css app/leer/layout.tsx app/leer/scene-page.tsx\",\n  \"description\": \"Show uncommitted diff of touch points\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"diff --git a/app/globals.css b/app/globals.css\\nindex 687f1f6..1a9cabf 100644\\n--- a/app/globals.css\\n+++ b/app/globals.css\\n@@ -5,6 +5,7 @@\\n @import \\\"./styles/music-style-control.css\\\";\\n @import \\\"./styles/ambience.css\\\";\\n @import \\\"./styles/chapters.css\\\";\\n+@import \\\"./styles/narration.css\\\";\\n \\n * {\\n   box-sizing: border-box;\\ndiff --git a/app/leer/layout.tsx b/app/leer/layout.tsx\\nindex 773d1b3..71d1fd0 100644\\n--- a/app/leer/layout.tsx\\n+++ b/app/leer/layout.tsx\\n@@ -1,22 +1,35 @@\\n import { buildReaderModel } from \\\"@/core/reader\\\";\\n import { loadOzBook } from \\\"@/server/books\\\";\\n+import { loadNarrationEntries } from \\\"@/server/narration\\\";\\n import { Reader } from \\\"../reader\\\";\\n \\n // Static shell: audio and music state persist across scene routes.\\n-// Only slim metadata reaches the client: id, chapter, emotion triple.\\n+// Only slim metadata reaches the client: id, chapter, ordinal range,\\n+// emotion. The chapter narration index (~1 MB) stays server-side; the\\n+// client gets one small {chapter → src, manifest} map.\\n export default function LeerLayout({ children }: { children: React.ReactNode }) {\\n   const { book, scenes } = loadOzBook();\\n   const model = buildReaderModel(book, { scenes });\\n   const slim = model.chapters.flatMap((chapter) =>\\n-    chapter.scenes.map((scene) => ({ id: scene.id, ch: chapter.ch, emotion: scene.emotion })),\\n+    chapter.scenes.map((scene) => {\\n+      const paras = scene.paragraphs;\\n+      return {\\n+        id: scene.id,\\n+        ch: chapter.ch,\\n+        startN: paras[0]?.n ?? 0,\\n+        endN: paras[paras.length - 1]?.n ?? 0,\\n+        emotion: scene.emotion,\\n+      };\\n+    }),\\n   );\\n   const chapters = model.chapters.map((chapter) => ({\\n     ch: chapter.ch,\\n     title: chapter.title,\\n     firstSceneId: chapter.scenes[0]?.id ?? \\\"\\\",\\n   }));\\n+  const narration = loadNarrationEntries();\\n   return (\\n-    <Reader scenes={slim} chapters={chapters} bookTitle={model.title} bookAuthor={model.author}>\\n+    <Reader scenes={slim} chapters={chapters} bookTitle={model.title} bookAuthor={model.author} narration={narration}>\\n       {children}\\n     </Reader>\\n   );\\ndiff --git a/app/leer/scene-page.tsx b/app/leer/scene-page.tsx\\nindex b8d8490..1ce6eb3 100644\\n--- a/app/leer/scene-page.tsx\\n+++ b/app/leer/scene-page.tsx\\n@@ -4,13 +4,15 @@\\n // they never touch music state.\\n \\\"use client\\\";\\n \\n-import { Fragment, useEffect, useMemo, useRef, useState } from \\\"react\\\";\\n+import { Fragment, useCallback, useEffect, useMemo, useRef, useState } from \\\"react\\\";\\n import { useRouter } from \\\"next/navigation\\\";\\n import { buildNavIndex, navReducer, subPageCount, subPageKind, textPageAt } from \\\"@/core/reader\\\";\\n import type { NavAction, SceneView } from \\\"@/core/reader\\\";\\n import { loadImageStylePref, saveImageStylePref } from \\\"../image-style\\\";\\n import type { ImageStylePref } from \\\"../image-style\\\";\\n import { BandPager, Divider } from \\\"../folio/chrome\\\";\\n+import { useNarration } from \\\"../narration/context\\\";\\n+import { ReadMark, useReadSync } from \\\"../narration/read-sync\\\";\\n import { figuresAfter, groupFi