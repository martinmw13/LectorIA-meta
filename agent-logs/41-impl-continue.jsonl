{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d5","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":197,"recorded_at":1780531400000389,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `app/narration/context.tsx`.\n1|// Layout-level narration state: the provider owns the one audio\n2|// element, so scene and sub-page navigation never interrupt playback.\n3|// ScenePage registers its scene and consumes the manifest for highlight.\n4|\"use client\";\n5|\n6|import { createContext, useContext } from \"react\";\n7|import { useNarrationController, type NarrationController } from \"./use-narration\";\n8|import type { NarrationChapterEntry } from \"./types\";\n9|\n10|const NarrationContext = createContext<NarrationController | null>(null);\n11|\n12|export function NarrationProvider({\n13|  entries,\n14|  sceneOrder,\n15|  onAdvanceScene,\n16|  children,\n17|}: {\n18|  entries: NarrationChapterEntry[];\n19|  sceneOrder: string[];\n20|  onAdvanceScene: (nextSceneId: string) => void;\n21|  children: React.ReactNode;\n22|}) {\n23|  const controller = useNarrationController({ entries, sceneOrder, onAdvanceScene });\n24|  return (\n25|    <NarrationContext.Provider value={controller}>\n26|      <audio ref={controller.audioRef} preload=\"auto\" aria-label=\"Read aloud\" />\n27|      {children}\n28|    </NarrationContext.Provider>\n29|  );\n30|}\n31|\n32|export function useNarration(): NarrationController {\n33|  const value = useContext(NarrationContext);\n34|  if (!value) throw new Error(\"useNarration outside NarrationProvider\");\n35|  return value;\n36|}","final_result":true,"kind":"output","task_id":"01a18347-df1e-7c52-85e0-567f0164947b"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-df1e-7c52-85e0-567f0164947b","task_stream":{"id":"01a18347-df1e-7c52-85e0-567f0164947b","kind":"task"}}}
