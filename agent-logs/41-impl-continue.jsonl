{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a18347d64d7217b72b7299b6cbbb2b","command_id":"01a18347-a539-7003-a92b-84861f36de97","correlation_facts":{"outcome":"success","tool_name":"read_file"},"kind":"tool_result","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"text":"Read text file `app/narration/read-aloud.tsx`.\n1|// The read-aloud control: play/pause plus a narration-only volume\n2|// slider. Light mode is the default; colours come from tokens.\n3|\"use client\";\n4|\n5|import { Icon } from \"../icons\";\n6|import { useNarration } from \"./context\";\n7|\n8|export function ReadAloud() {\n9|  const { on, status, playing, volume, toggle, setVolume } = useNarration();\n10|  const busy = on && status !== \"ready\" && status !== \"error\";\n11|  const label = !on ? \"Read aloud\" : playing ? \"Pause\" : \"Read aloud\";\n12|  return (\n13|    <div className=\"read-aloud\" data-state={status} data-on={on}>\n14|      <button\n15|        type=\"button\"\n16|        className=\"read-aloud-btn\"\n17|        onClick={toggle}\n18|        aria-pressed={on && playing}\n19|        aria-label={label}\n20|        title={label}\n21|      >\n22|        <Icon name=\"read-aloud\" />\n23|        <span className=\"read-aloud-label\">{label}</span>\n24|      </button>\n25|      <label className=\"read-aloud-volume\">\n26|        <span className=\"sr-only\">Narration volume</span>\n27|        <input\n28|          type=\"range\"\n29|          min={0}\n30|          max={1}\n31|          step={0.05}\n32|          value={volume}\n33|          onChange={(e) => setVolume(Number(e.target.value))}\n34|          aria-label=\"Narration volume\"\n35|       