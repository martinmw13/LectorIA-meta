{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c9","stream":{"kind":"session","id":"01a18347-a386-7071-8a7b-e45ab0a366f1"},"sequence":191,"recorded_at":1780531400000377,"record_type":"event","durability":"durable","causation_id":"01a18347-a539-7003-a92b-84861f36de97","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a18347-a539-7003-a92b-84861f36de97","event":{"chunk":"Read text file `app/narration/use-narration.ts`.\n1|// Read-aloud controller: one dedicated audio element per reader mount,\n2|// per-chapter manifests fetched lazily, duck signal for the music\n3|// player. The element lives in the layout-level provider, so sub-page\n4|// and scene navigation never interrupt playback.\n5|\"use client\";\n6|\n7|import { useCallback, useEffect, useRef, useState } from \"react\";\n8|import { parseChapterNarration, sceneSpan, type ChapterNarration } from \"@/core/narration\";\n9|import {\n10|  NARRATION_DUCK_DOWN_MS,\n11|  NARRATION_DUCK_LEVEL,\n12|  NARRATION_DUCK_UP_MS,\n13|  rampDuck,\n14|} from \"./duck\";\n15|import { DEFAULT_NARRATION_PREFS, loadNarrationPrefs, saveNarrationPrefs } from \"./prefs\";\n16|import type { NarrationChapterEntry, NarrationPrefs, NarrationStatus } from \"./types\";\n17|\n18|export interface NarrationSceneRef {\n19|  sceneId: string;\n20|  ch: number;\n21|  startN: number;\n22|  endN: number;\n23|}\n24|\n25|function sameScene(a: NarrationSceneRef | null, b: NarrationSceneRef): boolean {\n26|  return a !== null && a.sceneId === b.sceneId && a.ch === b.ch && a.startN === b.startN && a.endN === b.endN;\n27|}\n28|\n29|export function useNarrationController(opts: {\n30|  entries: NarrationChapterEntry[];\n31|  sceneOrder: string[];\n32|  onAdvanceScene: (nextSceneId: string) => void;\n33|}) {\n34|  const [prefs, setPrefs] = useState<NarrationPrefs>(DEFAULT_NARRATION_PREFS);\n35|  const [status, setStatus] = useState<NarrationStatus>(\"idle\");\n36|  const [playing, setPlaying] = useState(false);\n37|  const [duck, setDuck] = useState(1);\n38|  const [scene, setScene] = useState<NarrationSceneRef | null>(null);\n39|  const [manifest, setManifest] = useState<ChapterNarration | null>(null);\n40|\n41|  const audioRef = useRef<HTMLAudioElement | null>(null);\n42|  const cacheRef = useRef(new Map<number, ChapterNarration>());\n43|  const advanceRef = useRef(opts.onAdvanceScene);\n44|  advanceRef.current = opts.onAdvanceScene;\n45|  const entriesRef = useRef(opts.entries);\n46|  entriesRef.current = opts.entries;\n47|  const orderRef = useRef(opts.sceneOrder);\n48|  orderRef.current = opts.sceneOrder;\n49|  const sceneRef = useRef(scene);\n50|  sceneRef.current = scene;\n51|  const prefsRef = useRef(prefs);\n52|  prefsRef.current = prefs;\n53|  const loadToken = useRef(0);\n54|  const wantPlay = useRef(false);\n55|  const duckRef = useRef(1);\n56|  const pendingSeek = useRef<number | null>(null);\n57|  const advancingRef = useRef(false);\n58|\n59|  // Stored prefs apply after the server-matching first render.\n60|  useEffect(() => {\n61|    try {\n62|      setPrefs(loadNarrationPrefs(window.localStorage));\n63|    } catch {\n64|      // Defaults already render; playback starts on user press.\n65|    }\n66|  }, []);\n67|\n68|  function persist(next: NarrationPrefs) {\n69|    setPrefs(next);\n70|    try {\n71|      saveNarrationPrefs(window.localStorage, next);\n72|    } catch {\n73|      // Private mode: playback continues without persistence.\n74|    }\n75|  }\n76|\n77|  // Current chapter manifest: cache hit or a lazy fetch, parsed at the\n78|  // trust boundary. Chapters map to src with .mp3 replaced by .json.\n79|  useEffect(() => {\n80|    if (!prefs.on || scene === null) {\n81|      if (!prefs.on) {\n82|        setStatus(\"idle\");\n83|        setManifest(null);\n84|      }\n85|      return;\n86|    }\n87|    const cached = cacheRef.current.get(scene.ch);\n88|    if (cached) {\n89|      setManifest(cached);\n90|      setStatus(\"ready\");\n91|      return;\n92|    }\n93|    const token = (loadToken.current += 1);\n94|    setStatus(\"loading\");\n95|    setManifest(null);\n96|    const entry = entriesRef.current.find((e) => e.ch === scene.ch);\n97|    if (!entry) {\n98|      if (loadToken.current === token) {\n99|        setStatus(\"error\");\n100|        wantPlay.current = false;\n101|      }\n102|      return;\n103|    }\n104|    fetch(entry.manifest)\n105|      .then((res) => {\n106|        if (!res.ok) throw new Error(`narration ${res.status}`);\n107|        return res.json();\n108|      })\n109|      .then((json: unknown) => {\n110|        if (loadToken.current !== token) return;\n111|        const parsed = parseChapterNarration(json);\n112|        cacheRef.current.set(scene.ch, parsed);\n113|        setManifest(parsed);\n114|        setStatus(\"ready\");\n115|      })\n116|      .catch(() => {\n117|        if (loadToken.current === token) {\n118|          setStatus(\"error\");\n119|          wantPlay.current = false;\n120|        }\n121|      });\n122|  }, [prefs.on, scene]);\n123|\n124|  // Seek to the scene span, swapping chapter audio when needed. A fresh\n125|  // src seeks on loadedmetadata; a kept src seeks at once.\n126|  const seekScene = useCallback(() => {\n127|    const audio = audioRef.current;\n128|    const current = sceneRef.current;\n129|    const heard = current !== null ? cacheRef.current.get(current.ch) : undefined;\n130|    if (!audio || !current || !heard) return;\n131|    const span = sceneSpan(heard, current.startN, current.endN);\n132|    if (!span) return;\n133|    if (audio.dataset.key !== heard.key) {\n134|      pendingSeek.current = span.startSec;\n135|      audio.dataset.key = heard.key;\n136|      audio.src = heard.src;\n137|    } else {\n138|      try {\n139|        audio.currentTime = span.startSec;\n140|      } catch {\n141|        pendingSeek.current = span.startSec;\n142|      }\n143|    }\n144|  }, []);\n145|\n146|  const playCurrent = useCallback(() => {\n147|    const audio = audioRef.current;\n148|    if (!audio || sceneRef.current === null || cacheRef.current.get(sceneRef.current.ch) === undefined) {\n149|      return;\n150|    }\n151|    seekScene();\n152|    wantPlay.current = true;\n153|    void audio.play().catch(() => {\n154|      wantPlay.current = false;\n155|    });\n156|  }, [seekScene]);\n157|\n158|  // Scene moves seek at once; playback resumes when the manifest lands.\n159|  const prevSceneId = useRef<string | null>(null);\n160|  useEffect(() => {\n161|    if (scene !== null && prevSceneId.current !== scene.sceneId) {\n162|      prevSceneId.current = scene.sceneId;\n163|      advancingRef.current = false;\n164|      if (cacheRef.current.get(scene.ch) !== undefined) {\n165|        seekScene();\n166|        if (wantPlay.current && prefsRef.current.on) playCurrent();\n167|      }\n168|    }\n169|  }, [scene, manifest, seekScene, playCurrent]);\n170|\n171|  // The want-to-play flag survives the manifest fetch.\n172|  useEffect(() => {\n173|    if (status === \"ready\" && wantPlay.current && prefs.on) playCurrent();\n174|  }, [status, prefs.on, playCurrent]);\n175|\n176|  // One audio element: play/pause mirror to state, the chapter end and\n177|  // span end advance without user action, errors surface quietly.\n178|  useEffect(() => {\n179|    const audio = audioRef.current;\n180|    if (!audio) return;\n181|    const onPlay = () => setPlaying(true);\n182|    const onPause = () => setPlaying(false);\n183|    const onMeta = () => {\n184|      if (pendingSeek.current !== null) {\n185|        try {\n186|          audio.currentTime = pendingSeek.current;\n187|        } catch {\n188|          // Past the end; the watchdog advances on timeupdate.\n189|        }\n190|        pendingSeek.current = null;\n191|      }\n192|    };\n193|    const onTime = () => {\n194|      const current = sceneRef.current;\n195|      if (advancingRef.current || !current || audio.paused) return;\n196|      const heard = cacheRef.current.get(current.ch);\n197|      if (!heard) return;\n198|      const span = sceneSpan(heard, current.startN, current.endN);\n199|      if (span !== null && audio.currentTime >= span.endSec - 0.15) {\n200|        advancingRef.current = true;\n201|        const at = orderRef.current.indexOf(current.sceneId);\n202|        const next = at >= 0 ? orderRef.current[at + 1] : undefined;\n203|        if (next === undefined) {\n204|          wantPlay.current = false;\n205|          audio.pause();\n206|          advancingRef.current = false;\n207|          return;\n208|        }\n209|        advanceRef.current(next);\n210|      }\n211|    };\n212|    const onEnded = () => {\n213|      if (advancingRef.current) return;\n214|      advancingRef.current = true;\n215|      const current = sceneRef.current;\n216|      const at = current !== null ? orderRef.current.indexOf(current.sceneId) : -1;\n217|      const next = at >= 0 ? orderRef.current[at + 1] : undefined;\n218|      if (next === undefined) {\n219|        wantPlay.current = false;\n220|        advancingRef.current = false;\n221|        return;\n222|      }\n223|      advanceRef.current(next);\n224|    };\n225|    const onError = () => {\n226|      setStatus(\"error\");\n227|      wantPlay.current = false;\n228|    };\n229|    audio.addEventListener(\"play\", onPlay);\n230|    audio.addEventListener(\"pause\", onPause);\n231|    audio.addEventListener(\"loadedmetadata\", onMeta);\n232|    audio.addEventListener(\"timeupdate\", onTime);\n233|    audio.addEventListener(\"ended\", onEnded);\n234|    audio.addEventListener(\"error\", onError);\n235|    return () => {\n236|      audio.removeEventListener(\"play\", onPlay);\n237|      audio.removeEventListener(\"pause\", onPause);\n238|      audio.removeEventListener(\"loadedmetadata\", onMeta);\n239|      audio.removeEventListener(\"timeupdate\", onTime);\n240|      audio.removeEventListener(\"ended\", onEnded);\n241|      audio.removeEventListener(\"error\", onError);\n242|    };\n243|  }, []);\n244|\n245|  // Duck ramp: down fast when the voice starts, back up slow on pause.\n246|  useEffect(() => {\n247|    const target = prefs.on && playing ? NARRATION_DUCK_LEVEL : 1;\n248|    if (duckRef.current === target) {\n249|      setDuck(target);\n250|      return;\n251|    }\n252|    const duration = target < duckRef.current ? NARRATION_DUCK_DOWN_MS : NARRATION_DUCK_UP_MS;\n253|    let raf = 0;\n254|    let prev = performance.now();\n255|    const tick = (now: number) => {\n256|      const next = rampDuck(duckRef.current, target, now - prev, duration);\n257|      prev = now;\n258|      duckRef.current = next;\n259|      setDuck(next);\n260|      if (next !== target) raf = requestAnimationFrame(tick);\n261|    };\n262|    raf = requestAnimationFrame(tick);\n263|    return () => cancelAnimationFrame(raf);\n264|  }, [playing, prefs.on]);\n265|\n266|  // The narration volume rides its own slider, never the music mute.\n267|  useEffect(() => {\n268|    const audio = audioRef.current;\n269|    if (audio) {\n270|      try {\n271|        audio.volume = prefs.volume;\n272|      } catch {\n273|        // A missing media engine keeps the slider harmless.\n274|      }\n275|    }\n276|  }, [prefs.volume, status]);\n277|\n278|  const registerScene = useCallback((next: NarrationSceneRef) => {\n279|    setScene((prev) => (sameScene(prev, next) ? prev : next));\n280|  }, []);\n281|\n282|  const toggle = useCallback(() => {\n283|    const audio = audioRef.current;\n284|    if (playing) {\n285|      wantPlay.current = false;\n286|      audio?.pause();\n287|      return;\n288|    }\n289|    if (!prefsRef.current.on) {\n290|      persist({ on: true, volume: prefsRef.current.volume });\n291|      wantPlay.current = true;\n292|      return;\n293|    }\n294|    playCurrent();\n295|  }, [playing, playCurrent]);\n296|\n297|  const setVolume = useCallback(\n298|    (volume: number) => {\n299|      persist({ on: prefsRef.current.on, volume });\n300|    },\n301|    [],\n302|  );\n303|\n304|  const setOn = useCallback(\n305|    (on: boolean) => {\n306|      if (!on) {\n307|        wantPlay.current = false;\n308|        audioRef.current?.pause();\n309|      }\n310|      persist({ on, volume: prefsRef.current.volume });\n311|      if (on) wantPlay.current = true;\n312|    },\n313|    [],\n314|  );\n315|\n316|  const span =\n317|    scene !== null && manifest !== null ? sceneSpan(manifest, scene.startN, scene.endN) : null;\n318|\n319|  return {\n320|    audioRef,\n321|    on: prefs.on,\n322|    volume: prefs.volume,\n323|    status,\n324|    playing,\n325|    duck,\n326|    scene,\n327|    manifest,\n328|    span,\n329|    registerScene,\n330|    toggle,\n331|    setVolume,\n332|    setOn,\n333|  };\n334|}\n335|\n336|export type NarrationController = ReturnType<typeof useNarrationController>;","final_result":true,"kind":"output","task_id":"01a18347-df15-7510-ada9-d3db4df36338"},"kind":"task_lifecycle","run_stream":{"id":"01a18347-a539-7003-a92b-84861f36de97","kind":"run"},"task_id":"01a18347-df15-7510-ada9-d3db4df36338","task_stream":{"id":"01a18347-df15-7510-ada9-d3db4df36338","kind":"task"}}}
